+bool parseCpuList(const std::string &text, cpu_set_t *mask) {
+    CPU_ZERO(mask);
+    std::stringstream ranges(text);
+    std::string item;
+    bool any = false;
+    while (std::getline(ranges, item, ',')) {
+        const size_t dash = item.find('-');
+        try {
+            const int first = std::stoi(item.substr(0, dash));
+            const int last = dash == std::string::npos
+                                 ? first
+                                 : std::stoi(item.substr(dash + 1));
+            if (first < 0 || last < first || last >= CPU_SETSIZE) return false;
+            for (int cpu = first; cpu <= last; ++cpu) {
+                CPU_SET(cpu, mask);
+                any = true;
+            }
+        } catch (...) {
+            return false;
+        }
+    }
+    return any;
+}
+
+bool acceleratorLocalCpuMask(cpu_set_t *mask) {
+    DIR *devices = opendir("/sys/bus/pci/devices");
+    if (devices == nullptr) return false;
+    bool found = false;
+    while (dirent *entry = readdir(devices)) {
+        if (entry->d_name[0] == '.') continue;
+        const std::string base =
+            std::string("/sys/bus/pci/devices/") + entry->d_name;
+        std::ifstream vendor_file(base + "/vendor");
+        std::string vendor;
+        vendor_file >> vendor;
+        if (vendor != "0x2006") continue;
+        std::ifstream cpus_file(base + "/local_cpulist");
+        std::string cpus;
+        cpus_file >> cpus;
+        if (parseCpuList(cpus, mask)) {
+            found = true;
+            break;
+        }
+    }
+    closedir(devices);
+    return found;
+}
+
+// Keep one scheduler CPU per physical core.  The accelerator-local cpulist on
+// the evaluation host exposes both SMT siblings; allowing service control
+// threads to occupy both siblings makes launch latency depend on which sibling
+// the kernel-submit thread happens to land on.  Collapsing each sibling set to
+// its lowest local CPU preserves the same NUMA placement while avoiding that
+// intra-core contention.  Fall back to the original mask if topology metadata
+// is unavailable.
+void collapseToPhysicalCores(cpu_set_t *mask) {
+    const cpu_set_t original = *mask;
+    cpu_set_t physical;
+    CPU_ZERO(&physical);
+    bool any = false;
+    for (int cpu = 0; cpu < CPU_SETSIZE; ++cpu) {
+        if (!CPU_ISSET(cpu, &original)) continue;
+        std::ifstream siblings_file(
+            "/sys/devices/system/cpu/cpu" + std::to_string(cpu) +
+            "/topology/thread_siblings_list");
+        std::string siblings_text;
+        siblings_file >> siblings_text;
+        cpu_set_t siblings;
+        int representative = cpu;
+        if (!siblings_text.empty() && parseCpuList(siblings_text, &siblings)) {
+            for (int sibling = 0; sibling < CPU_SETSIZE; ++sibling) {
+                if (CPU_ISSET(sibling, &original) &&
+                    CPU_ISSET(sibling, &siblings)) {
+                    representative = sibling;
+                    break;
+                }
+            }
+        }
+        CPU_SET(representative, &physical);
+        any = true;
+    }
+    if (any) *mask = physical;
+}
+
+pid_t parentPid(pid_t pid) {
+    std::ifstream status("/proc/" + std::to_string(pid) + "/status");
+    std::string line;
+    while (std::getline(status, line)) {
+        if (line.rfind("PPid:", 0) != 0) continue;
+        try {
+            return static_cast<pid_t>(std::stoi(line.substr(5)));
+        } catch (...) {
+            return -1;
+        }
+    }
+    return -1;
+}
+
+void pinProcessThreads(pid_t pid, const cpu_set_t &mask) {
+    const std::string task_dir = "/proc/" + std::to_string(pid) + "/task";
+    DIR *tasks = opendir(task_dir.c_str());
+    if (tasks == nullptr) return;
+    while (dirent *entry = readdir(tasks)) {
+        if (!std::isdigit(static_cast<unsigned char>(entry->d_name[0]))) continue;
+        char *end = nullptr;
+        const int64_t tid = std::strtoll(entry->d_name, &end, 10);
+        if (end != entry->d_name && *end == '\0' && tid > 0) {
+            (void)sched_setaffinity(static_cast<pid_t>(tid), sizeof(mask), &mask);
+        }
+    }
+    closedir(tasks);
+}
+
+// Apply accelerator-local CPU placement after the service creates its worker
+// threads. This only changes host scheduling; tensor values, cache writes,
+// kernel arguments, stream order and public operator contracts are unchanged.
+void maybePinServiceToAcceleratorNuma() {
+    static std::once_flag once;
+    std::call_once(once, [] {
+        const char *env = std::getenv("TECOOPS_NUMA_AFFINITY");
+        if (env != nullptr && env[0] == '0') return;
+        cpu_set_t mask;
+        if (!acceleratorLocalCpuMask(&mask)) return;
+        collapseToPhysicalCores(&mask);
+        const pid_t session = getsid(0);
+        pid_t pid = getpid();
+        for (int depth = 0; depth < 8 && pid > 1; ++depth) {
+            if (getsid(pid) != session) break;
+            pinProcessThreads(pid, mask);
+            const pid_t parent = parentPid(pid);
+            if (parent <= 1 || parent == pid) break;
+            pid = parent;
+        }
+    });
+}
