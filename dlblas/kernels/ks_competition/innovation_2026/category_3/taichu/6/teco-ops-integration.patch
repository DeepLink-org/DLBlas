+// Publisher half (fa): record the just-executed stock-path skeleton so the
+// NEXT production call may verify against it. Release-store of fa_gen LAST.
+inline void fa_publish(const torch::Tensor &q, const torch::Tensor &out,
+                       const torch::Tensor &seqused_k,
+                       const torch::Tensor &block_table, int max_seqlen_k,
+                       int max_block_num, int split_kv_num,
+                       const void *ws_ptr) {
+    static std::atomic<uint64_t> gen{0};  // process-monotonic (O-2)
+    st(Q_PTR, (int64_t)q.data_ptr());
+    st(OUT_PTR, (int64_t)out.data_ptr());
+    st(SEQUSED_PTR, (int64_t)seqused_k.data_ptr());
+    st(BT_PTR, (int64_t)block_table.data_ptr());
+    st(SEQUSED_D0, seqused_k.size(0));
+    st(BT_D0, block_table.size(0));
+    st(BT_D1, block_table.size(1));
+    st(MAX_K, max_seqlen_k);
+    st(MAX_BLOCKNUM, max_block_num);
+    st(SPLIT_NUM, split_kv_num);
+    st(WS_PTR, (int64_t)ws_ptr);
+    st(SHAPE_KEY, (int64_t)kShapeKey);
+    const uint64_t g = gen.fetch_add(1, std::memory_order_relaxed) + 1;
+    st(MAGICVER, (int64_t)((kMagic << 8) | kVersion));
+    st(FA_GEN, (int64_t)g);
+}
