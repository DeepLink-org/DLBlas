+// ============================================================================
+// R-B cross-operator commit mailbox (WO-B; design doc v1.1 8260fe3a…ade5).
+//
+// HOST-ONLY metadata record shared by the two target operators' Host code
+// inside THIS module (no new library/IPC/file/env surface). Fixed format,
+// 31 int64 cells per slot (=248 B), 4 slots reserved, slot 0 live:
+//   [0] magic|version   [1] rac_gen (release-store LAST by producer)
+//   [2] fa_gen          [3] writer_stream
+//   [4] k_cache_ptr     [5] v_cache_ptr    [6] kc_num_blocks [7] kc_block_size
+//   [8] q_ptr           [9] out_ptr        [10] ws_ptr
+//  [11] seqused_k_ptr  [12] block_table_ptr[13] seqused_dim0 [14] bt_dim0
+//  [15] bt_dim1        [16] max_seqlen_k  [17] max_block_num [18] split_kv_num
+//  [19] shape_key      [20..30] reserved zero
+//
+// v1.1 BINDING RULE: metadata only — pointers and dimensions. NO value-type
+// field exists anywhere in the record and nothing recorded is ever consumed
+// as a kernel input: every kernel-facing argument is the RECEIVED tensor's
+// data_ptr() exactly as stock; recorded values are COMPARED, never
+// substituted (except ws_ptr/split_kv_num which are operator-internal state
+// whose validity is re-verified under the same shape_key every call).
+// Process-monotonic generations (never reset in-process); slab intentionally
+// leaked (teardown-order precedent of the decode workspace cache). Any
+// mismatch/absence ⇒ the exact stock sequence runs in the same call.
+namespace rbimpl {
+
+constexpr int kSlots = 4;
+constexpr int kCells = 31;
+constexpr uint64_t kMagic = 0x52423100ull;   // "RB1\0"
+constexpr uint64_t kVersion = 1ull;
+enum Off : int {
+    MAGICVER = 0, RAC_GEN = 1, FA_GEN = 2, STREAM = 3,
+    KC_PTR = 4, VC_PTR = 5, KC_BLOCKS = 6, KC_BSIZE = 7,
+    Q_PTR = 8, OUT_PTR = 9, WS_PTR = 10,
+    SEQUSED_PTR = 11, BT_PTR = 12, SEQUSED_D0 = 13, BT_D0 = 14, BT_D1 = 15,
+    MAX_K = 16, MAX_BLOCKNUM = 17, SPLIT_NUM = 18, SHAPE_KEY = 19,
+};
+constexpr int kSlot = 0;  // exactly one live slot for the official flow
+
+// shape_key: constant hash of the production whitelist dims (b1/q1/qh4/kvh2/
+// D64/bs32/fp16) — identical predicate to the head_pack2/raw gates below.
+constexpr uint64_t kShapeKey = 0x534841504531ull;  // "SHAPE1"
+
+// Process-lifetime HOST slab (v1.1: host-only). Intentionally leaked — same
+// teardown-order precedent as the decode workspace cache below.
+inline torch::Tensor *slab() {
+    static torch::Tensor *s = new torch::Tensor(
+        torch::zeros({kSlots, kCells},
+                     torch::TensorOptions().dtype(torch::kInt64)));
+    return s;
+}
+inline int64_t *cells() { return slab()->data_ptr<int64_t>(); }
+inline int64_t ld(int off) {
+    return __atomic_load_n(cells() + kSlot * kCells + off, __ATOMIC_ACQUIRE);
+}
+inline void st(int off, int64_t v) {
+    __atomic_store_n(cells() + kSlot * kCells + off, v, __ATOMIC_RELEASE);
+}
+inline bool production_layout(const torch::Tensor &t, int kvh, int d, int bs) {
+    return t.dim() == 4 && t.size(1) == kvh && t.size(2) == bs &&
+           t.size(3) == d && t.scalar_type() == torch::kFloat16 &&
+           t.is_contiguous();
+}
+
+// FA-65's arrival counters are stream ordered and therefore must never share a
+// backing tensor with overlapping work on another stream. Keep process-life
+// storage per (thread, stream, device); this also removes handle->stream races
+// after the Python binding releases the GIL.
+struct StreamWorkspaceState {
+    StreamWorkspaceState(sdaaStream_t stream_arg, const c10::Device &device_arg)
+        : stream(stream_arg), device(device_arg) {}
+    sdaaStream_t stream;
+    c10::Device device;
+    torch::Tensor tensor;
+    bool slot_live = false;
+};
+
+inline StreamWorkspaceState &workspace_state(
+    sdaaStream_t stream, const torch::Tensor &like) {
+    static thread_local auto *states = new std::vector<StreamWorkspaceState>();
+    for (auto &state : *states) {
+        if (state.stream == stream && state.device == like.device()) return state;
+    }
+    states->emplace_back(stream, like.device());
+    return states->back();
+}
+
+// Producer half (rac): publish after successful enqueue; release-store of
+// rac_gen LAST orders every prior store (E2). Gated to the production cache
+// whitelist — no mailbox activity for any other shape.
+inline void rac_publish(const torch::Tensor &key_cache,
+                        const torch::Tensor &value_cache) {
+    if (!production_layout(key_cache, 2, 64, 32) ||
+        !production_layout(value_cache, 2, 64, 32)) {
+        return;
+    }
+    static std::atomic<uint64_t> gen{0};  // process-monotonic (O-2)
+    st(KC_PTR, (int64_t)key_cache.data_ptr());
+    st(VC_PTR, (int64_t)value_cache.data_ptr());
+    st(KC_BLOCKS, key_cache.size(0));
+    st(KC_BSIZE, key_cache.size(2));
+    st(STREAM, (int64_t)torch::sdaa::getCurrentSDAAStream());
+    const uint64_t g = gen.fetch_add(1, std::memory_order_relaxed) + 1;
+    st(MAGICVER, (int64_t)((kMagic << 8) | kVersion));
+    st(RAC_GEN, (int64_t)g);
+}
+
+// Consumer half (fa): verify-then-use. Returns true ONLY when every received
+// metadata item equals the committed record (both halves), the stream
+// matches, magic/version hold, and the recorded internal state (ws_ptr,
+// split_kv_num) is present; on ANY miss returns false and the caller runs
+// its exact stock sequence in the same call. On success this function itself
+// honors the slot-live re-zero contract and issues THE SAME raw kernel call
+// with RECEIVED data_ptrs — identical math either way.
+inline bool fa_try_fast(
+    tecoopsHandle_t handle, sdaaStream_t current_stream,
+    const torch::Tensor &q, const torch::Tensor &k, const torch::Tensor &v,
+    const torch::Tensor &out, const torch::Tensor &seqused_k,
+    const torch::Tensor &block_table, int max_seqlen_k) {
+    // Full whitelist first: element-for-element the existing raw-route gate
+    // (head_pack2 dims + batch1_q1_fast + dtypes + contiguity). No new
+    // predicate class; a miss here means stock path with zero mailbox work.
+    if (!(q.dim() == 3 && q.size(0) == 1 && q.size(1) == 4 && q.size(2) == 64 &&
+          k.dim() == 4 && k.size(1) == 2 && k.size(2) == 32 && k.size(3) == 64 &&
+          q.scalar_type() == torch::kFloat16 &&
+          k.scalar_type() == torch::kFloat16 &&
+          v.scalar_type() == torch::kFloat16 &&
+          out.scalar_type() == torch::kFloat16 &&
+          seqused_k.scalar_type() == torch::kInt32 &&
+          block_table.scalar_type() == torch::kInt32 &&
+          q.is_contiguous() && k.is_contiguous() && v.is_contiguous() &&
+          block_table.is_contiguous() && seqused_k.is_contiguous() &&
+          block_table.dim() == 2)) {
+        return false;
+    }
+    if ((uint64_t)ld(MAGICVER) != ((kMagic << 8) | kVersion)) return false;
+    if (ld(RAC_GEN) == 0 || ld(FA_GEN) == 0) return false;
+    if (ld(STREAM) != (int64_t)current_stream) return false;
+    if (ld(SHAPE_KEY) != (int64_t)kShapeKey) return false;
+    // Received-metadata compares — rac half (canonical caches as seen by rac)
+    // then fa half (per-call tensors). Pointers COMPARED, never substituted:
+    // kernel args below are taken from the RECEIVED tensors exactly as stock.
+    if (ld(KC_PTR) != (int64_t)k.data_ptr()) return false;
+    if (ld(VC_PTR) != (int64_t)v.data_ptr()) return false;
+    if (ld(KC_BLOCKS) != k.size(0)) return false;
+    if (ld(KC_BSIZE) != 32) return false;
+    if (ld(Q_PTR) != (int64_t)q.data_ptr()) return false;
+    if (ld(OUT_PTR) != (int64_t)out.data_ptr()) return false;
+    if (ld(SEQUSED_PTR) != (int64_t)seqused_k.data_ptr()) return false;
+    if (ld(BT_PTR) != (int64_t)block_table.data_ptr()) return false;
+    if (ld(SEQUSED_D0) != seqused_k.size(0)) return false;
+    if (ld(BT_D0) != block_table.size(0)) return false;
+    if (ld(BT_D1) != block_table.size(1)) return false;
+    if (ld(MAX_K) != max_seqlen_k) return false;
+    if (ld(MAX_BLOCKNUM) != k.size(0)) return false;
+
+    // The mailbox may only reuse state that is still owned by the live
+    // process-global workspace cache.  Shape equality alone is insufficient:
+    // a foreign decode shape can grow/reallocate that cache after publication,
+    // leaving the recorded pointer non-null but stale.  Re-read the cache and
+    // bind a local Tensor reference before accepting the fast path; any drift
+    // falls through to the stock workspace path in this same call.
+    StreamWorkspaceState &state = workspace_state(current_stream, q);
+    torch::Tensor workspace_guard = state.tensor;
+    if (!workspace_guard.defined() ||
+        workspace_guard.dtype() != torch::kFloat32 ||
+        workspace_guard.device() != q.device()) {
+        return false;
+    }
+    const int64_t split_kv_num = ld(SPLIT_NUM);
+    if (split_kv_num != 16 && split_kv_num != 32) return false;
+    void *ws_ptr = (void *)ld(WS_PTR);
+    const int64_t required_elems =
+        q.size(0) * q.size(1) * split_kv_num * (q.size(2) + 2) + 8;
+    if (ws_ptr == nullptr || workspace_guard.data_ptr() != ws_ptr ||
+        workspace_guard.numel() < required_elems) {
+        return false;
+    }
+    // Slot-live contract honored identically to the stock workspace block:
+    // foreign-layout decode traffic marks the fixed arrival slot dirty and
+    // the next production call must re-zero it before any fold call.
+    if (!state.slot_live) {
+        state.tensor.narrow(0, 8448, 8).zero_();
+        state.slot_live = true;
+    }
+    tecoopsFlashAttentionQ1D64Raw(
+        handle, max_seqlen_k, k.size(0), block_table.size(1),
+        (int)split_kv_num, seqused_k.data_ptr<int>(), block_table.data_ptr(),
+        q.data_ptr(), k.data_ptr(), v.data_ptr(), out.data_ptr(), ws_ptr);
+    return true;
+}
