                                    float e4 = simd_vextfs(vmax16, 4);
                                    float e5 = simd_vextfs(vmax16, 5);
                                    float e6 = simd_vextfs(vmax16, 6);
                                    float e7 = simd_vextfs(vmax16, 7);
                                    float e8 = simd_vextfs(vmax16, 8);
                                    float e9 = simd_vextfs(vmax16, 9);
                                    float e10 = simd_vextfs(vmax16, 10);
                                    float e11 = simd_vextfs(vmax16, 11);
                                    float e12 = simd_vextfs(vmax16, 12);
                                    float e13 = simd_vextfs(vmax16, 13);
                                    float e14 = simd_vextfs(vmax16, 14);
                                    float e15 = simd_vextfs(vmax16, 15);
                                    float m01 = MAX(e0, e1), m23 = MAX(e2, e3);
                                    float m45 = MAX(e4, e5), m67 = MAX(e6, e7);
                                    float m89 = MAX(e8, e9), mAB = MAX(e10, e11);
                                    float mCD = MAX(e12, e13), mEF = MAX(e14, e15);
                                    float m03 = MAX(m01, m23), m47 = MAX(m45, m67);
                                    float m8B = MAX(m89, mAB), mCF = MAX(mCD, mEF);
                                    float m07 = MAX(m03, m47), m8F = MAX(m8B, mCF);
                                    m_raw = MAX(m07, m8F);
                                }
                                float m_new = MAX(m_ptr[q_row_off + r],
