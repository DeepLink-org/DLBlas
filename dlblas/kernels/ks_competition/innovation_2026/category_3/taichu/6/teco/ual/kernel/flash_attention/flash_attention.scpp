                        if (args.hexp && rel_q_off + row >= cols &&
                            cur_BN2 >= cols && sub_BM - row >= 4) {
                            // stage 4 fully-valid rows x 64 cols: loads,
                            // max-reduce over 4 vectors, m_new, scale input,
                            // then half exp inputs (2 calls' worth)
                            if (batch_lo == sub_BM) batch_lo = row;
                            for (int g = 0; g < 4; g++) {
                                int r = row + g;
                                // page A row (BN cols) then page B row from
                                // the disjoint BM*BN region of outc2
                                float *src_row = outc2 + r * BN;
                                float *src_row_b = outc2 + BM * BN + r * BN;
                                floatv16 v0, v1, v2, v3;
                                // FA-DIAG: bit15 skips the outc2 loads to
                                // time the load traffic (timing only).
                                if (args.dbg_stub & 32768) {
                                    v0 = 0.0f; v1 = 0.0f;
                                    v2 = 0.0f; v3 = 0.0f;
