#include <simd.h>
#include <slave.h>
#include <sdaa_transpose.h>

#include "ual/com/rt.h"
#include "ual/kernel/flash_attention/flash_attention.h"
#include "teco_hal.h"
#include <sdaa_atomic.h>  // FA-65: teco_atomic_add_64 arrive (P7B-proven visibility)

using namespace sdaa;  //NOLINT
using namespace teco::hal;  //NOLINT

// macro definition of MIN
#define MIN(a, b) ((a) < (b) ? (a) : (b))
// macro definition of MAX
#define MAX(a, b) ((a) > (b) ? (a) : (b))
// FLT_MAX if not already defined
#ifndef FLT_MAX
#define FLT_MAX 3.402823466e+38F
#endif

// load a tile from KV cache (key or value) into dst
// src = cache[block_id][kv_head_idx ][0..num_tokens-1][0..head_size-1]
// dst = [num_tokens, head_size]
__device__ __always_inline void load_kv_cache(
    half *dst, const half *cache, const int *block_table, int logical_block,
    int kv_head_idx , int kv_head_num, int block_size, int head_size, int num_tokens) {
    int block_id = block_table[logical_block];
    const half *src = cache
        + block_id * kv_head_num * block_size * head_size
        + kv_head_idx  * block_size * head_size;
    memcpy(dst, src, num_tokens * head_size * sizeof(half));
}

__device__ __always_inline void fill_inf(float *buf, int len) {
    // if use simd should assert aligned
    int neg_inf_bit = 0xFF800000;
    float neg_inf;
    memcpy(&neg_inf, &neg_inf_bit, sizeof(float));
    for (int i = 0; i < len; i++) {
        buf[i] = neg_inf;
    }
}

// causal mask on score tile [cur_BM, cur_BN] inside [BM, BN]
__device__ __always_inline void apply_causal_mask(
    float *score, int cur_BM, int cur_BN,
    int qi_off, int kj_off, int q_seq_len, int k_seq_len,
    int BM, int BN) {

    int q_start = k_seq_len - q_seq_len;
    if (q_start < 0) q_start = 0;

    for (int qi = 0; qi < cur_BM; qi++) {
        int rel_q_pos = q_start + qi_off + qi;
        int allowed = rel_q_pos - kj_off + 1;
        if (allowed < 0) allowed = 0;
        if (allowed >= cur_BN) continue;
        fill_inf(score + qi * BN + allowed, cur_BN - allowed);
    }
}

__device__ float compute_max(float *input, int size) {
    floatv16 vf = -FLT_MAX;
    floatv16 vres = -FLT_MAX;
    float result = -FLT_MAX;
    int i = 0;

    for (; i + 16 <= size; i += 16) {
        simd_load(vf, input + i);
        vres = simd_max(vf, vres);
    }

    for (; i < size; i++) {
        result = MAX(result, input[i]);
    }

    float *tmp = (float *)&vres;
    for (int j = 0; j < 16; j++) {
        result = MAX(result, tmp[j]);
    }
    return result;
}

__device__ float compute_exp_sum(float *input, float max, int size) {
    floatv16 vf = 0.0f;
    floatv16 vres = 0.0f;
    floatv16 vmax = max;
    float result = 0.0f;
    int i = 0;
    int remainder = size % 16;

    for (i = 0; i < size; i += 16) {
        simd_load(vf, input + i);
        vf = simd_exp(vf - vmax);
        vres = simd_add(vres, vf);
    }

    for (; i < remainder; i++) {
        result += expf(input[i] - max);
    }

    float *tmp = (float *)&vres;
    for (int j = 0; j < 16; j++) {
        result += tmp[j];
    }
    return result;
}

__device__ void online_softmax_step(
    float *scores,           // S: [BM, BN] scores -> exp(S - m_new)
    const float *pre_max,    // m_old: [m]
    const float *pre_sum,    // l_old: [m]
    float *cur_max,          // m_new: [m]
    float *cur_sum,          // l_new: [m]
    float *scale,            // scale = exp(m_old - m_new): [m]
    int m, int n,            // cur_BM, cur_BN
    int ld_scores) {         // BN

    // Step 1: per-row : cal m_new, scale
    for (int i = 0; i < m; i++) {
        float *src_row = scores + i * ld_scores;
        float m_block = compute_max(src_row, n);
        float m_new = MAX(pre_max[i], m_block);
        m_new = MAX(m_new, 0.0f);
        cur_max[i] = m_new;
        // FA-23a: running max unchanged -> scale == expf(0) == 1.0f exactly;
        // skip the 60-cycle scalar expf (bit-identical result).
        scale[i] = (pre_max[i] == m_new) ? 1.0f : expf(pre_max[i] - m_new);
    }

    // Step 2: inplace scores: S -> exp(S - m_new), cal l_new
    for (int i = 0; i < m; i++) {
        float *src_row = scores + i * ld_scores;
        float m_new = cur_max[i];
        float l_old = pre_sum[i];
        float s = scale[i];

        float l_block = 0.0f;
        int j = 0;
        for (; j + 16 <= n; j += 16) {
            floatv16 v;
            simd_load(v, src_row + j);
            v = simd_exp(v - m_new);
            simd_store(v, src_row + j);
            l_block += simd_redsum(v);
        }
        for (; j < n; j++) {
            src_row[j] = expf(src_row[j] - m_new);
            l_block += src_row[j];
        }
        cur_sum[i] = l_old * s + l_block;
    }
}

__global__ void teco_slave_flash_attention_half(FlashAttentionArgs args) {
    int tid = threadIdx;
    if (tid >= args.spe_num) {
        return;
    }
    int num_kv_groups = args.local_head_num / args.local_kv_head_num;

    // Phase 2 combines exact online-softmax partials produced by phase 1.
    // One task owns one (query row, query head), so no cross-SPE writes race.
    if (args.phase == 2) {
        int BK = args.size_per_head;
        int partial_stride = BK + 2;
        float *partial = (float*)rt_spm_malloc(partial_stride * sizeof(float));
        float *accum = (float*)rt_spm_malloc(BK * sizeof(float));
        half *reduce_out = (half*)rt_spm_malloc(BK * sizeof(half));
        // FA-35: bulk partial fetch. A task's split_num partials are
        // contiguous in workspace ([split][BK+2]); the legacy loop issued
        // split_num tiny 264B memcpy ops (the reduction kernel's main
        // fixed cost, ~3us/op on this part). Fetch them in 8-split (2KB)
        // chunks with one bulk memcpy each instead. Falls back to the
        // per-split path when the chunk buffer cannot be allocated.
        const int fa35_chunk = 8;
        float *partial_bulk = (args.fa35 && args.workspace != nullptr)
            ? (float*)rt_spm_malloc(fa35_chunk * partial_stride * sizeof(float))
            : nullptr;
        int cur_q_index = 0;
        for (int b = 0; b < args.batch_size; b++) {
            int q_seq_len = (args.q_seq_lens == nullptr &&
                             args.batch_size == 1 && args.max_q_seq_len == 1)
                                ? 1 : args.q_seq_lens[b];
            int task_num = q_seq_len * args.local_head_num;
            for (int task_idx = tid; task_idx < task_num; task_idx += args.spe_num) {
                int q_row = task_idx / args.local_head_num;
                int head_idx = task_idx % args.local_head_num;
                int global_q = cur_q_index + q_row;

                int k = 0;
                floatv16 vzero = 0.0f;
                for (; k + 16 <= BK; k += 16) simd_store(vzero, accum + k);
                for (; k < BK; k++) accum[k] = 0.0f;

                float running_m = -FLT_MAX;
                float running_l = 0.0f;
                if (partial_bulk != nullptr) {
                    // Bulk path: one chunk at a time, reduce in place from
                    // the SPM chunk buffer. Bit-identical math to the
                    // legacy loop (same per-split reduction order).
                    const float *base = (const float*)args.workspace +
                        ((global_q * args.local_head_num + head_idx) *
                         args.split_num) * partial_stride;
                    for (int c0 = 0; c0 < args.split_num; c0 += fa35_chunk) {
                        int cn = MIN(fa35_chunk, args.split_num - c0);
                        memcpy(partial_bulk, base + c0 * partial_stride,
                               cn * partial_stride * sizeof(float));
                        for (int si = 0; si < cn; si++) {
                            const float *src = partial_bulk +
                                si * partial_stride;
                            float partial_l = src[1];
                            if (partial_l <= 0.0f) continue;
                            float partial_m = src[0];
                            float next_m = MAX(running_m, partial_m);
                            float old_scale = running_l > 0.0f
                                ? expf(running_m - next_m) : 0.0f;
                            float partial_scale = expf(partial_m - next_m);
                            for (int h = 0; h < BK; h++) {
                                accum[h] = accum[h] * old_scale +
                                    src[2 + h] * partial_scale;
                            }
                            running_l = running_l * old_scale +
                                partial_l * partial_scale;
                            running_m = next_m;
                        }
                    }
                } else {
                    for (int split_idx = 0;
                         split_idx < args.split_num; split_idx++) {
                        const float *src = (const float*)args.workspace +
                            (((global_q * args.local_head_num + head_idx) *
                              args.split_num + split_idx) * partial_stride);
                        memcpy(partial, src,
                               partial_stride * sizeof(float));
                        float partial_l = partial[1];
                        if (partial_l <= 0.0f) continue;

                        float partial_m = partial[0];
                        float next_m = MAX(running_m, partial_m);
                        float old_scale = running_l > 0.0f
                            ? expf(running_m - next_m) : 0.0f;
                        float partial_scale = expf(partial_m - next_m);
                        for (int h = 0; h < BK; h++) {
                            accum[h] = accum[h] * old_scale +
                                partial[2 + h] * partial_scale;
                        }
                        running_l = running_l * old_scale +
                            partial_l * partial_scale;
                        running_m = next_m;
                    }
                }

                float l_inv = running_l > 0.0f ? 1.0f / running_l : 0.0f;
                floatv16 vl_inv = l_inv;
                k = 0;
                for (; k + 16 <= BK; k += 16) {
                    floatv16 vf;
                    halfv16 vh;
                    simd_load(vf, accum + k);
                    vh = (halfv16)(vf * vl_inv);
                    simd_store(vh, reduce_out + k);
                }
                for (; k < BK; k++) reduce_out[k] = (half)(accum[k] * l_inv);

                half *out = (half*)args.fmha_out +
                    global_q * args.local_head_num * BK + head_idx * BK;
                memcpy(out, reduce_out, BK * sizeof(half));
            }
            cur_q_index += q_seq_len;
        }
        return;
    }

    // FA-30: phase 3 = one-shot K pre-transpose into args.kscratch (GM).
    // Every K block of every kv head is transposed exactly once
    // ([block_size tokens][BK dims] -> [BK dims][block_size tokens], the
    // exact layout the phase-0 QK gemm consumes), then phase 0 loads tiles
    // with plain memcpy. The hardware transpose engine is a serialized
    // shared unit: the legacy per-pair transpose paid its per-tile latency
    // once per (row-tile, col-tile) pair (~64x redundancy on the full-
    // prefill shape; measured 55.3ms/layer of the T4 prefill). The scalar
    // transpose below is fully parallel across SPEs and bit-identical to
    // the legacy fallback (same layout, pure data movement).
    if (args.phase == 3) {
        int tid = threadIdx;
        if (tid >= args.spe_num) {
            return;
        }
        int BK = args.size_per_head;
        int tile_elems = args.block_size * BK;
        half *ktmp = (half*)rt_spm_malloc(tile_elems * sizeof(half));
        half *ktmp2 = (half*)rt_spm_malloc(tile_elems * sizeof(half));
        int table_blocks = MIN(args.block_table_dim,
                               args.max_k_seq_len / args.block_size + 2);
        int *ldm_block_table = (int*)rt_spm_malloc(table_blocks * sizeof(int));
        for (int b = 0; b < args.batch_size; b++) {
            int k_seq_len = args.kv_seq_lens[b];
            memcpy(ldm_block_table, args.block_table + b * args.block_table_dim,
                   table_blocks * sizeof(int));
            int kv_tile_num = (k_seq_len + args.block_size - 1) / args.block_size;
            int total_tiles = kv_tile_num * args.local_kv_head_num;
            // FA-48X v6b: the axis-swapped visit (fa48x_b in phase 0)
            // requires an identity-consecutive table (table[j]==t0+j). Its
            // V^T scratch is sized by the ACTUAL attended block count
            // (ceil4(k/32) groups, ~8.4MB for k=32767) and indexed
            // RELATIVE to the table base t0, because the full KV-cache
            // capacity can be 71K blocks (2.27M tokens): sizing V^T by
            // capacity doubled the FA-30 workspace to 1.16GB and OOM'd the
            // official CI. Non-identity tables fall back to the exact
            // FA-30 K^T path (physical block id; kscratch stays
            // capacity-sized), fixing the previous silent un-written K^T.
            // FA-48Y v7: the t0%4==0 requirement is DROPPED. The V^T
            // layout is purely local (group = local block index >> 2,
            // slot = local index & 3), so any consecutive t0 works; the %4
            // gate was a leftover of the v3 physical-id design. vLLM
            // reserves block 0 for padding, so real tables have t0%4!=0
            // almost always and the old gate silently ran the fallback
            // (and crashed: see the outc fix) for every vLLM prefill.
            int t0 = ldm_block_table[0];
            bool id_table = true;
            for (int j = 1; j < kv_tile_num && id_table; j++)
                if (ldm_block_table[j] != t0 + j) id_table = false;
            for (int tile = tid; tile < total_tiles; tile += args.spe_num) {
                int lb = tile / args.local_kv_head_num;
                int kv_head_idx = tile % args.local_kv_head_num;
                // FA-48Y v7d: the scratch (K^T and V^T) is indexed by the
                // batch-LOCAL block lb (not the physical block id), so no
                // table lookup is needed here beyond load_kv_cache's.
                // FA-48X: the axis-swapped phase-0 chain consumes V^T (from
                // vscratch) and reads NATIVE K directly, so phase 3 stages
                // V^T alone for identity tables; the K^T write (and its K
                // load) is skipped. Non-fa48x and non-identity tables keep
                // the exact FA-30 behavior (K^T only).
                if (args.vscratch != nullptr && id_table) {
                    load_kv_cache(ktmp, (const half *)args.value_cache,
                                  ldm_block_table, lb, kv_head_idx,
                                  args.local_kv_head_num, args.block_size, BK,
                                  args.block_size);
                    for (int t = 0; t < args.block_size; t++) {
                        for (int h = 0; h < BK; h++) {
                            ktmp2[h * args.block_size + t] =
                                ktmp[t * BK + h];
                        }
                    }
                    // FA-48X v3: V^T is aggregated per 4-block group
                    // (RELATIVE group (block_id-t0)>>2, i.e. lb>>2 for an
                    // identity table) into [group][kv head][64d][128k], so
                    // phase 0 loads one whole visit with a single
                    // contiguous 16KB memcpy (the DMA engine cannot scatter
                    // into strided SPM: the v2 per-page 2D-strided copies
                    // wrote garbage - probes vt48_dma_check/dma_sem). The
                    // last real block of the table zeroes its group's
                    // remaining slots so the PV gemm's masked columns
                    // multiply zeros, never NaN.
                    int g = lb >> 2;
                    int slot = lb & 3;
                    half *vdst = (half *)args.vscratch
                        + (((g * args.local_kv_head_num + kv_head_idx) << 2) +
                           slot) * tile_elems;
                    memcpy(vdst, ktmp2, tile_elems * sizeof(half));
                    if (lb == kv_tile_num - 1 && slot < 3) {
                        halfv16 hz = (halfv16)0;
                        for (int z = 0; z < tile_elems; z += 16)
                            simd_store(hz, ktmp + z);
                        for (int s = slot + 1; s < 4; s++) {
                            memcpy(vdst + (s - slot) * tile_elems, ktmp,
                                   tile_elems * sizeof(half));
                        }
                    }
                } else {
                    load_kv_cache(ktmp, (const half *)args.key_cache,
                                  ldm_block_table, lb, kv_head_idx,
                                  args.local_kv_head_num, args.block_size, BK,
                                  args.block_size);
                    for (int t = 0; t < args.block_size; t++) {
                        for (int h = 0; h < BK; h++) {
                            ktmp2[h * args.block_size + t] = ktmp[t * BK + h];
                        }
                    }
                    // FA-48Y v7d: K^T is staged at the batch-LOCAL block
                    // index lb (not the physical block id), so the scratch
                    // is sized by the ACTUAL attended blocks (ceil4(k/32)
                    // tiles, ~8.4MB at k=32767) instead of the KV-cache
                    // capacity (71K blocks = 556MB at the official cache).
                    // The capacity-sized lazy allocation could only first
                    // fire at a real request (vLLM warmup uses a small
                    // dummy cache, then the first real call re-allocates
                    // 556MB when the GPU is already near-full -> OOM, CI
                    // samples 63/200 and 0/200 at 14.30GB/14.94GB used).
                    half *dst = (half *)args.kscratch
                        + (lb * args.local_kv_head_num + kv_head_idx) *
                              tile_elems;
                    memcpy(dst, ktmp2, tile_elems * sizeof(half));
                }
            }
        }
        return;
    }

    int BM = 128;   // M block, 128 for ace
    int BN = 32;    // N block, 32 for ace; block_size
    int BK = args.size_per_head;   // head_dim
    int token_size = args.size_per_head * sizeof(half);
    // FA-17: prefill large tile. A whitelisted prefill task covers
    // BM_TILE = 2*BM query rows (256), executed as two M128 gemm sub-blocks
    // that share every K/V tile: one K transpose serves 256 rows instead of
    // 128, halving the per-tile fixed costs (transpose wait, gemm launch
    // chain, loop overhead) per row. Row-state buffers below are sized for
    // BM_TILE ONLY when fa17_tile (SPM is tight: HS=128 shapes with BM_TILE
    // buffers would need ~300KB and overflow the scratchpad). outc/p_score
    // stay BM-sized and are reused by the sub-blocks sequentially (each
    // sub's softmax feeds its own PV gemm before the next sub overwrites
    // them). All non-whitelisted paths keep tile_blocks=1 and the exact
    // base-BM footprint.
    // fa17_tile is derived from args.max_q_seq_len (== q_seq_lens[0] for
    // batch 1); the in-loop tile_blocks guard repeats the same predicate on
    // q_seq_len, which can only narrow it (safe: small buffers never meet a
    // tile_blocks=2 task).
    bool fa17_tile = args.phase == 0 && args.split_num == 1 &&
                     args.batch_size == 1 && args.local_head_num == 4 &&
                     args.local_kv_head_num == 2 && args.size_per_head == 64 &&
                     args.block_size == 32 && args.spe_num == 32 &&
                     args.max_q_seq_len >= 2 * BM;
    // FA-27f: dual-buffer async V-load scope = the prefill ACE-gemm path
    // with HS=64 (OneGenomeRice shape family). vbuf2 is allocated only
    // here, so HS=128 shapes keep their exact legacy SPM footprint.
    bool fa27f = args.phase == 0 && args.split_num == 1 &&
                 args.batch_size == 1 && args.size_per_head == 64;
    // FA-28: 2-page batching scope = the whitelisted OneGenomeRice prefill
    // (fa27f + exact head/block/spe config). Two KV pages are processed per
    // softmax visit (64 columns): per-visit overheads (extract tree, redsum,
    // bookkeeping) amortize over 2 pages, and the PV gemm's K doubles per
    // call. Requires the extra kbuf2/outc2/p_score2 buffers (allocated only
    // here; non-fa28 shapes keep their exact legacy SPM footprint).
    bool fa28 = fa27f && args.local_head_num == 4 &&
                args.local_kv_head_num == 2 && args.block_size == 32 &&
                args.spe_num == 32;
    int BM_TILE = 2 * BM;
    // FA-31: the row-state buffers are sized by the rows a task actually
    // processes (BM_TILE=256 when tile_blocks==2, BM=128 otherwise). Chunked
    // prefill (q=2048/2047 -> q_block_num_256 % 16 != 0) runs tile_blocks==1
    // but previously still allocated the BM_TILE buffers (~48KB SPM waste,
    // which then left no room for the FA-31 K ping-pong buffer).
    int eff_tile_blocks = 1;
    if (fa17_tile) {
        int q_seq_len0 = (args.q_seq_lens == nullptr &&
                          args.batch_size == 1 && args.max_q_seq_len == 1)
                             ? 1 : args.q_seq_lens[0];
        if (q_seq_len0 >= 2 * BM) {
            int q_block_num_256 = (q_seq_len0 + BM * 2 - 1) / (BM * 2);
            if (q_block_num_256 % 16 == 0) {
                eff_tile_blocks = 2;
            }
        }
    }
    bool fa17_tile_blocks2 = fa17_tile && (eff_tile_blocks == 2);
    // FA-47: 4-page batching for the chunked (tile_blocks==1) whitelist.
    // Four KV pages (128 score columns) are processed per softmax visit,
    // halving the number of visits -> the per-(row,visit) max-reduce tree
    // (-12~-15% of prefill, the biggest chain component) and the per-visit
    // fixed costs (m/l loads, rescale group check, loop bookkeeping) run
    // half as often. SPM: kbuf2/outc2/p_score2 double vs FA-28; fits for
    // tile_blocks==1 only (row-state is BM-sized there). FA-47 shares the
    // fa28 chain with cols = 4*BN; PV gemm uses K=4*BN per head-dim half.
    // Host gates on TECOOPS_FA47 (default off; A/B). Bit-identical when
    // off (exact FA-44/FA-28 behavior).
    bool fa48x = fa28 && args.fa48x && args.kscratch != nullptr &&
                 args.vscratch != nullptr && !fa17_tile_blocks2;
    bool fa47 = fa28 && args.fa47 && args.kscratch != nullptr &&
                !fa17_tile_blocks2 && !fa48x;
    int row_bm = fa17_tile ? (eff_tile_blocks == 2 ? BM_TILE : BM) : BM;
    int table_blocks = MIN(args.block_table_dim,
                           args.max_k_seq_len / args.block_size + 2);
    int * ldm_block_table = (int*)rt_spm_malloc(table_blocks * sizeof(int));
    half * qbuf = (half*)rt_spm_malloc(row_bm * token_size); // tile * BK
    half * ktmp = (half*)rt_spm_malloc(BN * token_size);            // BN * BK
    half * ktmp_alt = (args.phase == 1 &&
                       (args.split_num == 16 || args.split_num == 32) &&
                       args.batch_size == 1 &&
                       args.local_head_num == 4 &&
                       args.local_kv_head_num == 2 &&
                       args.size_per_head == 64 &&
                       args.block_size == 32)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    half * kbuf = !fa28 ? (half*)rt_spm_malloc(BN * token_size) : nullptr; // BK * BN (fa28 uses kbuf2)
    // FA-33b: decode pack4 fused-scan buffers. The fused loop scans BOTH
    // KV-head groups per iteration and merges the two kv heads' K tiles
    // FA-33: decode pack2 direct-SIMD 2-block merged-DMA buffers. The
    // direct-SIMD scan fetches TWO consecutive physical blocks per 8KB
    // memcpy (K and V separately) when the block table is contiguous
    // (the official single-sequence case), halving the per-iteration DMA
    // op count (2 -> 1 per block pair), which is the decode wall
    // (measured ~3.2us per DMA op on this part). Gated to the pack2
    // decode shapes (phase-1 split-16/32 + 4 local heads + HS64); SPM is
    // comfortably sized there.
    // FA-33 buffers: 8 x 4KB (NOT 4 x 8KB). The SPM allocator mis-sizes
    // 8KB requests (the 8KB regions overlap their neighbours, corrupting
    // the first block's data on 2-block fetches); 4KB is the proven-safe
    // allocation size on this part.
    half * kdual_a = (args.phase == 1 && args.fa33 &&
                      (args.split_num == 16 || args.split_num == 32) &&
                      args.batch_size == 1 &&
                      args.local_head_num == 4 &&
                      args.local_kv_head_num == 2 &&
                      args.size_per_head == 64 &&
                      args.block_size == 32)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    half * kdual_b = (kdual_a != nullptr)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    half * kdual_alt_a = (kdual_a != nullptr)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    half * kdual_alt_b = (kdual_a != nullptr)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    half * vdual_a = (kdual_a != nullptr)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    half * vdual_b = (kdual_a != nullptr)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    half * vdual_alt_a = (kdual_a != nullptr)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    half * vdual_alt_b = (kdual_a != nullptr)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    // FA-40: third ping-pong set for the 2-iteration lookahead decode
    // loop (+16KB SPM; decode footprint stays under the 225KB cap).
    half * kdual3_a = (kdual_a != nullptr && args.fa40)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    half * kdual3_b = (kdual3_a != nullptr)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    half * vdual3_a = (kdual3_a != nullptr)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    half * vdual3_b = (kdual3_a != nullptr)
        ? (half*)rt_spm_malloc(BN * token_size)
        : nullptr;
    half * vbuf2 = (fa27f && !fa47) ? (half*)rt_spm_malloc(BN * token_size) : nullptr; // FA-27f: 2nd V tile
    // FA-47: dedicated 4-page V buffers (8KB each: 4 pages x 32 half-cols).
    // ktmp/vbuf2 stay at 4KB for the 2-page path (and for K transpose).
    // gemm_bn is a literal 32 in the tile body; sized with 32 here.
    half * vbuf3 = fa47 ? (half*)rt_spm_malloc(4 * BN * 32 * sizeof(half)) : nullptr;
    half * vbuf4 = fa47 ? (half*)rt_spm_malloc(4 * BN * 32 * sizeof(half)) : nullptr;
    half * kbuf2 = fa28 ? (half*)rt_spm_malloc(((fa47 || fa48x) ? 4 : 2) * BN * token_size) : nullptr; // FA-28/47/48X: K of 2/4 pages
    // FA-48X: axis-swapped buffers. kbuf2 holds NATIVE K [128k][64d];
    // vt48 holds V^T [64d][128k] assembled from vscratch blocks;
    // wg48 holds the four Q^T weights [64d][32q] (built once per task);
    // maskv_raw holds the per-group causal+tail lane masks [4][33][32f]
    // (32 floats per (group,mm) row: 16 lanes lo + 16 lanes hi).
    half * vt48 = fa48x ? (half*)rt_spm_malloc(64 * 128 * sizeof(half)) : nullptr;
    half * wg48 = fa48x ? (half*)rt_spm_malloc(4 * 64 * 32 * sizeof(half)) : nullptr;
    // FA-48X v4: masks stored as HALF (0xFC00 = -inf, 0), halving the
    // footprint (16.9KB -> 8.4KB) to fund the vt48 pipeline temp.
    half * maskv_raw = fa48x ? (half*)rt_spm_malloc(4 * 33 * 32 * sizeof(half)) : nullptr;
    // FA-48X v4: second half of the venue for the double-buffered vt
    // assembly temp (16KB total: p_score2's spare 8KB + this 8KB). The
    // v4 visit issues the next visit's four 4KB tile DMAs right after the
    // current scatter, hiding the GM->SPM latency behind the visit's
    // compute; at the next visit top only the SIMD scatter remains.
    half * ttmp48 = fa48x ? (half*)rt_spm_malloc(64 * 64 * sizeof(half)) : nullptr;
    // FA-48X v2: the exp staging buffer + scratch are heap-allocated (NOT
    // kernel-stack arrays -- a 9KB stack footprint overlaps the heap region
    // and corrupts o_accum's tail dims -> NaN). rt_spm_malloc returns
    // 256B-aligned SPM (probe-verified), satisfying exp128v2.
    // FA-48X v3: hexp48 aliases p_score2 (set right after p_score2's
    // allocation below); declared here as nullptr and filled there so the
    // 256B-aligned SPM base is reused instead of a separate 8KB block.
    // FA-48X v6: hexp48b is the second half of the softmax/PV pipeline
    // double buffer (SPM probe: 228KB total, fails=0, cap 232KB).
    half * hexp48 = nullptr;
    half * hexp48b = fa48x ? (half*)rt_spm_malloc(128 * 32 * sizeof(half)) : nullptr;
    // FA-71: 8 outstanding exp128v2 temps (was 1x64).
    int * etmp48 = fa48x ? (int*)rt_spm_malloc(512 * sizeof(int)) : nullptr;
    // FA-31: second 2-page K buffer for the FA-30 memcpy path (ping-pong).
    // The next pair's K memcpy is issued right after this pair's QK gemm so
    // it overlaps softmax+PV instead of stalling the SPE at the loop top.
    // Gated to the tile_blocks==1 whitelist shapes (chunked q=2048/2047:
    // q_block_num_256 % 16 != 0): full-prefill tile_blocks==2 SPM is tight.
    bool fa31_tile = fa28 && args.kscratch != nullptr && args.fa31 &&
                     ((args.max_q_seq_len + 2 * BM - 1) / (2 * BM)) % 16 != 0;
    half * kbuf2b = (fa31_tile && !fa47 && !fa48x)
        ? (half*)rt_spm_malloc(2 * BN * token_size) : nullptr;
    float * outc2 = fa28
        ? (float*)rt_spm_malloc(BM * ((fa48x ? 4 : (fa47 ? 4 : 2))) * BN * sizeof(float)) : nullptr;
    // FA-48X v3: p_score2 stays allocated for fa48x (2-page size, 16KB) so
    // a non-consecutive block table can fall back to the exact fa28 2-page
    // chain (which needs p_score2). hexp48 then ALIASES p_score2's first
    // 8KB (the fa48x visit never touches p_score2, the fallback never
    // touches hexp48).
    half * p_score2 = fa28
        ? (half*)rt_spm_malloc(BM * (fa48x ? 2 : (fa47 ? 4 : 2)) * BN * sizeof(half)) : nullptr;
    if (fa48x) hexp48 = p_score2;  // alias: exp staging inside p_score2's 16KB
    float * outc = (fa48x ? nullptr : (float*)rt_spm_malloc(BM * BN * sizeof(float)));  // BM * BN (also PV C0 staging, fa28)
    half * obuf = (half*)rt_spm_malloc(row_bm * token_size); // tile * BK
    float *o_accum = (float*)rt_spm_malloc(row_bm * BK * sizeof(float)); // tile * BK
    float *l_prev = (float*)rt_spm_malloc(row_bm * sizeof(float)); // l  (old)
    float *m_prev = (float*)rt_spm_malloc(row_bm * sizeof(float)); // m  (old)
    float *l_cur  = (float*)rt_spm_malloc(row_bm * sizeof(float)); // l  (new)
    float *m_cur  = (float*)rt_spm_malloc(row_bm * sizeof(float)); // m  (new)
    float *scale  = (float*)rt_spm_malloc(row_bm * sizeof(float)); // exp(m_old - m_new)
    half *p_score = !fa28
        ? (half*)rt_spm_malloc(BM * BN * sizeof(half)) : nullptr;   // BM * BN
    MemcpyHandle k_get_handle[2];
    MemcpyHandle kd_get_handle[3];  // FA-33: merged K ping-pong (block A)
    MemcpyHandle kd2_get_handle[3];  // FA-33: merged K ping-pong (block B)
    MemcpyHandle v_get_handle;
    MemcpyHandle vd_get_handle[3];  // FA-33: merged V ping-pong (block A)
    MemcpyHandle vd2_get_handle[3];  // FA-33: merged V ping-pong (block B)
    MemcpyHandle v_get_handle2;  // FA-27f: 2nd V tile (one DMA per handle)
    MemcpyHandle v_get_handle3;  // FA-28: V tile hb1 page A
    MemcpyHandle v_get_handle4;  // FA-28: V tile hb1 page B
    MemcpyHandle v_get_handle5;  // FA-47: V tile hb0 page C
    MemcpyHandle v_get_handle6;  // FA-47: V tile hb0 page D
    MemcpyHandle v_get_handle7;  // FA-47: V tile hb1 page C
    MemcpyHandle v_get_handle8;  // FA-47: V tile hb1 page D
    MemcpyHandle k_next_handle[2];  // FA-31: next-pair K memcpy (page A/B)
    int cur_q_index = 0;
    for (int b = 0; b < args.batch_size; b++) {
        int q_seq_len = (args.q_seq_lens == nullptr &&
                         args.batch_size == 1 && args.max_q_seq_len == 1)
                            ? 1 : args.q_seq_lens[b], k_seq_len = args.kv_seq_lens[b];
        memcpy(ldm_block_table, args.block_table + b * args.block_table_dim,
               table_blocks * sizeof(int));
        // FA-48X v3: the axis-swapped path needs the batch's block table to
        // be IDENTITY-consecutive (table[j]==t0+j: phase 3 aggregates V^T
        // per 4-block group by LOCAL index, so any base t0 works). All
        // SPEs derive the same pure function of the SPM table (no shared
        // state, no races); violated tables fall back to the exact fa28
        // 2-page chain (p_score2 is allocated for that).
        bool fa48x_b = fa48x;
        if (fa48x_b) {
            int kv_tiles = (k_seq_len + BN - 1) / BN;
            int t0 = ldm_block_table[0];
            for (int j = 1; j < kv_tiles; j++) {
                if (ldm_block_table[j] != t0 + j) {
                    fa48x_b = false;
                    break;
                }
            }
        }
        // FA-17: prefill (phase 0) may run 2*BM rows per task; the
        // OneGenomeRice full-prefill shapes keep q_block_num % 16 == 0 at
        // this granularity (4095/8191/16383/32767 -> 16/32/64/128), so the
        // FA-09 balanced schedule below still applies. The % 16 == 0 gate is
        // MANDATORY: with fewer q-blocks the round-robin mapping cannot be
        // balanced (e.g. q=2048 -> Q=8, one task per SPE -> the slowest SPE
        // runs 64 two-sub tiles while the fastest runs 8, ~1.9x worse than
        // the balanced BM=128 path). Chunked-prefill shapes (q=2048 etc.)
        // therefore keep tile_blocks = 1 and the exact legacy behavior.
        int tile_blocks = 1;
        int q_block_num = (q_seq_len + BM - 1) / BM;
        if (fa17_tile && q_seq_len >= 2 * BM) {
            int q_block_num_256 = (q_seq_len + BM * 2 - 1) / (BM * 2);
            if (q_block_num_256 % 16 == 0) {
                tile_blocks = 2;
                q_block_num = q_block_num_256;
            }
        }
        int split_num = args.phase == 1 ? args.split_num : 1;
        // OneGenomeRice decode has four local Q heads sharing one local KV
        // head.  For split-16, pack two such Q heads into the M rows of one
        // phase-1 task.  The topology remains 2 head groups * 16 splits = 32
        // tasks, while each K/V tile is loaded and transformed only once for
        // the two heads.  All non-whitelisted shapes keep the stable mapping.
        int heads_per_task = 1;
        if (args.phase == 1 && q_seq_len == 1 &&
            (args.split_num == 16 || args.split_num == 32) &&
            args.local_head_num == 4 && args.local_kv_head_num == 2 &&
            args.size_per_head == 64 && args.block_size == 32) {
            heads_per_task = args.split_num == 32 ? 4 : 2;
        }
        int head_task_num =
            (args.local_head_num + heads_per_task - 1) / heads_per_task;
        int task_num = q_block_num * head_task_num * split_num;
        for (int task_idx = tid; task_idx < task_num; task_idx += args.spe_num) {
            int split_idx = task_idx % split_num;
            int base_task_idx = task_idx / split_num;
            int head_task_idx = base_task_idx % head_task_num;
            int i_block = base_task_idx / head_task_num;
            // FA-09: balance the prefill task->SPE schedule. Round-robin over
            // task_idx gives SPE tid the q-blocks {q, q+8, ..., q+Q-8} whose
            // causal tile counts grow linearly -> up to ~1.5x load imbalance.
            // For the OneGenomeRice prefill shape, pair each low q-block with
            // its high complement so every SPE runs the same number of tiles
            // (qb sum = (Q/16)(Q-1) for all SPEs). The mapping is a bijection
            // and each task's work is unchanged: output is bit-identical.
            // NOTE: the task ordinal is (task_idx - tid)/spe_num, NOT i_block
            // (i_block = q + 8*ordinal here; using i_block directly yields
            // negative q-blocks and out-of-bounds access).
            if (args.phase == 0 && args.split_num == 1 &&
                args.batch_size == 1 && args.local_head_num == 4 &&
                args.local_kv_head_num == 2 && args.size_per_head == 64 &&
                args.block_size == 32 && args.spe_num == 32 &&
                head_task_num == 4 && (q_block_num % 16 == 0)) {
                int q = tid / 4;
                int Q = q_block_num;
                int k = (task_idx - tid) / args.spe_num;  // ordinal in this SPE
                head_task_idx = tid % 4;
                i_block = (k < Q / 16) ? (q + 8 * k)
                                       : (Q - 1 - q - 8 * (k - Q / 16));
            }
            int head_idx = head_task_idx * heads_per_task;
            int i = i_block * BM * tile_blocks;
            bool packed_heads = heads_per_task > 1;
            int cur_BM = packed_heads
                ? MIN(heads_per_task, args.local_head_num - head_idx)
                : MIN(BM * tile_blocks, q_seq_len - i);

            // init online softmax state for this Q block
            int accum_size = cur_BM * BK;
            int idx = 0;
            floatv16 vzero = 0.0f;
            for (; idx + 16 <= accum_size; idx += 16) {
                simd_store(vzero, o_accum + idx);
            }
            for (; idx < accum_size; idx++) o_accum[idx] = 0.0f;
            for (int row = 0; row < cur_BM; row++) {
                l_prev[row] = 0.0f;
                l_cur[row] = 0.0f;
            }
            fill_inf(m_prev, cur_BM);
            fill_inf(m_cur, cur_BM);
            float *l_ptr = l_prev, *l_next = l_cur;
            float *m_ptr = m_prev, *m_next = m_cur;

            // load q [cur_BM, size_per_head]
            half * src_q_ptr = (half *)args.q +
                               (cur_q_index + i) * (args.local_head_num * args.size_per_head) +
                               head_idx * args.size_per_head;
            size_t q_src_stride = (args.local_head_num - 1) * token_size;
            if (packed_heads) {
                memcpy(qbuf, src_q_ptr, cur_BM * token_size);
            } else {
                memcpy_stride(qbuf, src_q_ptr, cur_BM * token_size,
                              token_size, {0, q_src_stride});
            }

            // clear unused rows of qbuf (cur_BM < BM * tile_blocks)
            if (cur_BM < BM * tile_blocks) {
                int begin = cur_BM * args.size_per_head;
                int end = BM * tile_blocks * args.size_per_head;
                int r = begin;
                halfv16 hvzero = (halfv16)0;
                for (; r + 16 <= end; r += 16) simd_store(hvzero, qbuf + r);
                for (; r < end; r++) qbuf[r] = 0;
            }

            // FA-48X per-task setup (axis-swapped chain): Q^T weights and
            // the per-group lane masks (causal threshold + tail rows). Both
            // are j-loop invariant and cost once per task. Row-state l/m for
            // the full 128 lanes is initialized too (tail lanes stay masked).
            if (fa48x) {
                for (int g = 0; g < 4; g++)
                    for (int d = 0; d < args.size_per_head; d++)
                        for (int c = 0; c < 32; c++)
                            wg48[(g * args.size_per_head + d) * 32 + c] =
                                qbuf[(g * 32 + c) * args.size_per_head + d];
                for (int lane = 0; lane < BM; lane++) {
                    if (lane < cur_BM) l_prev[lane] = 0.0f;
                    else l_prev[lane] = 0.0f;
                    l_cur[lane] = 0.0f;
                    m_prev[lane] = -FLT_MAX;
                    m_cur[lane] = -FLT_MAX;
                }
                // FA-48Y v7b (flaky NaN fix): the legacy o_accum zero loop
                // covers the ROW-MAJOR layout o_accum[0..cur_BM*BK) -- only
                // the first cur_BM/2 dims of the axis-swapped [d][lane]
                // layout. A tail task (cur_BM<128, official q=924 prefill
                // has cur_BM=28) leaves dims cur_BM/2..63 UNZEROED, and the
                // visit's accumulate ADDS stale SPM garbage to the real
                // lanes' outputs: NaN/wrong values whose extent varies with
                // whatever the previous kernel left in SPM (observed
                // nan=104 vs 312, dims 63 vs 61-62 vs 57/58/60 across
                // processes). Zero the whole [64][128] accumulator here.
                {
                    floatv16 vzero16 = 0.0f;
                    int oz = 0;
                    for (; oz + 16 <= args.size_per_head * BM; oz += 16)
                        simd_store(vzero16, o_accum + oz);
                    for (; oz < args.size_per_head * BM; oz++)
                        o_accum[oz] = 0.0f;
                }
                halfv16 *mv = (halfv16 *)maskv_raw;
                for (int g = 0; g < 4; g++)
                    for (int mm = 0; mm <= 32; mm++) {
                        half *h0 = (half *)&mv[(g * 33 + mm) * 2];
                        half *h1 = (half *)&mv[(g * 33 + mm) * 2 + 1];
                        for (int c = 0; c < 16; c++) {
                            int row = g * 32 + c;
                            h0[c] = ((c < mm) || (row >= cur_BM))
                                        ? (half)(-3.402823466e+38F) : (half)0;
                        }
                        for (int c = 0; c < 16; c++) {
                            int row = g * 32 + 16 + c;
                            h1[c] = ((16 + c < mm) || (row >= cur_BM))
                                        ? (half)(-3.402823466e+38F) : (half)0;
                        }
                    }
            }

            // Entire KV tiles beyond the bottom-right causal boundary are masked.
            // Skip them before loading K/V or running either matmul. This keeps
            // decode unchanged (q_seq_len == 1 scans the full prefix) while
            // avoiding roughly half of the prefill work when q_seq_len == k_seq_len.
            int q_start = MAX(k_seq_len - q_seq_len, 0);
            int causal_k_limit = MIN(k_seq_len, q_start + i + cur_BM);
            int first_k = 0;
            int last_k = causal_k_limit;
            if (args.phase == 1) {
                int kv_tile_num = (causal_k_limit + BN - 1) / BN;
                int first_tile = kv_tile_num * split_idx / split_num;
                int last_tile = kv_tile_num * (split_idx + 1) / split_num;
                first_k = first_tile * BN;
                last_k = MIN(causal_k_limit, last_tile * BN);
            }
            bool use_direct_simd = packed_heads && args.phase == 1 &&
                                   (args.split_num == 16 ||
                                    args.split_num == 32) &&
                                   args.batch_size == 1 && q_seq_len == 1 &&
                                   args.local_head_num == 4 &&
                                   args.local_kv_head_num == 2 &&
                                   args.size_per_head == 64 &&
                                   args.block_size == 32;
            if (use_direct_simd) {
                // FA-33: pack2 direct-SIMD scan with 2-block merged DMA.
                // The decode wall is the per-DMA-op cost (~3.2us/op:
                // phase-1 time fits 21us + 3.2us x ops across T1-T4
                // exactly). Consecutive physical blocks (the official
                // single-sequence case: block_table[i+1] ==
                // block_table[i] + 1) are fetched TWO blocks per 8KB
                // memcpy (K and V separately), halving the op count;
                // non-contiguous tables fall back to per-block ops.
                // Per-head FP chains (dots -> online softmax -> rescale
                // -> PV accumulate) are identical to the legacy loop, so
                // the output is bit-identical.
                bool fa33_2blk = args.fa33 && cur_BM == 2 &&
                                 num_kv_groups == 2 &&
                                 (args.split_num == 16 ||
                                  args.split_num == 32) &&
                                 kdual_a != nullptr && kdual_b != nullptr &&
                                 kdual_alt_a != nullptr &&
                                 kdual_alt_b != nullptr &&
                                 vdual_a != nullptr && vdual_b != nullptr &&
                                 vdual_alt_a != nullptr &&
                                 vdual_alt_b != nullptr;
                if (fa33_2blk) {
                    int kv_head_idx = head_idx / num_kv_groups;
                    float *grp_l = l_prev, *grp_ln = l_cur;
                    float *grp_m = m_prev, *grp_mn = m_cur;
                    int kd = 0;
                    int j = first_k;
                if (args.fa40 && kdual3_a != nullptr && kdual3_b != nullptr &&
                    vdual3_a != nullptr && vdual3_b != nullptr) {
                    // FA-40: 2-iteration DMA lookahead for the FA-33 loop.
                    // The FA-39 probe (stub 2048) showed 33-47% of the
                    // decode wall is exposed compute/DMA stalls with the
                    // 1-iteration lookahead (per-iteration DMA latency ~2x
                    // the compute time). Here iteration i reads set i%3 and
                    // issues the fetches for iteration i+2 into set (i+2)%3,
                    // giving each DMA ~2 iteration-times to complete before
                    // its first SPM read. Per-iteration math is identical
                    // to FA-33, so the output is bit-identical; the async
                    // ordering guarantee is the same one FA-33 relies on.
                    half *kseta[3];
                    half *ksetb[3];
                    half *vseta[3];
                    half *vsetb[3];
                    kseta[0] = kdual_a;
                    ksetb[0] = kdual_b;
                    kseta[1] = kdual_alt_a;
                    ksetb[1] = kdual_alt_b;
                    kseta[2] = kdual3_a;
                    ksetb[2] = kdual3_b;
                    vseta[0] = vdual_a;
                    vsetb[0] = vdual_b;
                    vseta[1] = vdual_alt_a;
                    vsetb[1] = vdual_alt_b;
                    vseta[2] = vdual3_a;
                    vsetb[2] = vdual3_b;
                    int jd = 0;
                    int j0 = first_k;
                    float fa39_probe = 0.0f;
                    // pre-loop: iteration 0 sync into set 0, iteration 1
                    // async into set 1.
                    if (j0 < last_k) {
                        int b0 = j0 / args.block_size;
                        int bid0 = ldm_block_table[b0];
                        int nb0 = 1;
                        if (j0 + 2 * BN <= last_k) {
                            int fb1 = (j0 + BN) / args.block_size;
                            if (ldm_block_table[fb1] == bid0 + 1) nb0 = 2;
                        }
                        const half *k_src = (const half *)args.key_cache
                            + bid0 * args.local_kv_head_num *
                                  args.block_size * args.size_per_head
                            + kv_head_idx * args.block_size *
                                  args.size_per_head;
                        const half *v_src = (const half *)args.value_cache
                            + bid0 * args.local_kv_head_num *
                                  args.block_size * args.size_per_head
                            + kv_head_idx * args.block_size *
                                  args.size_per_head;
                        memcpy(kseta[0], k_src,
                               BN * args.size_per_head * sizeof(half));
                        if (nb0 == 2) {
                            memcpy(ksetb[0],
                                   k_src + args.local_kv_head_num *
                                       args.block_size * args.size_per_head,
                                   BN * args.size_per_head * sizeof(half));
                        }
