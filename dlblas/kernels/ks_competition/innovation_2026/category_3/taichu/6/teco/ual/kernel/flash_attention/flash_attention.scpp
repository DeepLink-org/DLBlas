                        float *out_row1 = outO0 + (ai + 1) * gemm_bn;
                        floatv16 a00, a01, a10, a11, o00, o01, o10, o11;
                        simd_load(a00, accum_row0);
                        simd_load(a01, accum_row0 + 16);
                        simd_load(a10, accum_row1);
                        simd_load(a11, accum_row1 + 16);
                        simd_load(o00, out_row0);
                        simd_load(o01, out_row0 + 16);
                        simd_load(o10, out_row1);
                        simd_load(o11, out_row1 + 16);
                        simd_store(a00 + o00, accum_row0);
                        simd_store(a01 + o01, accum_row0 + 16);
                        simd_store(a10 + o10, accum_row1);
                        simd_store(a11 + o11, accum_row1 + 16);
                    }
                    for (; ai < sub_BM; ai++) {
                        float *accum_row =
                            o_accum + (q_row_off + ai) * BK + hb * gemm_bn;
                        float *out_row = outO0 + ai * gemm_bn;
                        for (int ak = 0; ak < gemm_bn; ak += 16) {
                            floatv16 vacc, vout;
                            simd_load(vacc, accum_row + ak);
                            simd_load(vout, out_row + ak);
                            simd_store(vacc + vout, accum_row + ak);
                        }
                    }
                    }
                }
                }
                }

                }   // end sub loop (FA-17)

                // swap pointer
                float *tmp = l_ptr; l_ptr = l_next; l_next = tmp;
                tmp = m_ptr; m_ptr = m_next; m_next = tmp;

            }
            }

            if (args.phase == 1) {
                int partial_stride = BK + 2;
                for (int row = 0; row < cur_BM; row++) {
                    int global_q = cur_q_index + i + (packed_heads ? 0 : row);
                    int output_head_idx = head_idx + (packed_heads ? row : 0);
                    float *dst = (float*)args.workspace +
                        (((global_q * args.local_head_num + output_head_idx) *
                          args.split_num +
                          split_idx) * partial_stride);
                    outc[0] = m_ptr[row];
                    outc[1] = l_ptr[row];
                    memcpy(outc + 2, o_accum + row * BK, BK * sizeof(float));
                    memcpy(dst, outc, partial_stride * sizeof(float));
                }
                // FA-65 (A1' K-HOST-SUBMIT r3): inline phase-2 combine.
                // After the partial write, arrive once on this call's
                // arrival cell (host reserves a FIXED 4-cell int64 slot
                // past the 8448-float production partial region). The task
                // whose atomic-add return closes the group IS the last
                // arriver by modification order; it alone runs the EXACT
                // phase-2 reduction body for that group's heads. No spin,
                // no poll, no barrier: every non-last task exits here and
                // both phases still execute inside ONE submission. Output
                // is byte-identical to the two-launch path (same combine
                // math, same reduction order).
                if (args.fa65 && packed_heads && q_seq_len == 1 &&
                    cur_q_index == 0 && args.batch_size == 1) {
                    const int n_groups = (heads_per_task == 4) ? 1 : 2;
                    const int my_group =
                        (heads_per_task == 4) ? 0 : head_task_idx;
                    // pack2/split16: one head-task per group x 16 splits;
                    // pack4/split32: one head-task total x 32 splits. Both
                    // reduce to exactly one arrival per split per group.
                    const int per_group_arrivals = split_num;
                    float *ws_base = (float *)args.workspace;
                    // r3 hardening: CLASS-SEPARATED fixed cells {spl16 g0,
                    // spl16 g1, spl32, pad}. A cell is only ever incremented
                    // by calls of its own split class, so after the host's
                    // zeroed init every call opens its cell at an exact
                    // multiple of its own arrival count — arbitrary
                    // 16<->32 call interleavings stay correct. (A shared
                    // monotonic cell would mis-fire after an odd number of
                    // split16 calls precedes a split32 call.)
                    int64_t *ctr_base = (int64_t *)args.fa65_ctr;
                    int64_t *ctr =
                        ctr_base + ((args.split_num == 16) ? my_group : 2);
                    long long old_arr = sdaa::teco_atomic_add_64(ctr, 1);
                    if ((old_arr + 1) % per_group_arrivals == 0) {
                        // ---- exact phase-2 combine for this group's heads
                        // (byte-identical math to args.phase == 2 below,
                        // incl. the FA-35 bulk fetch and reduction order).
                        int h_lo = (n_groups == 1)
                                       ? 0 : my_group * heads_per_task;
                        int h_hi = (n_groups == 1)
                                       ? args.local_head_num
                                       : h_lo + heads_per_task;
                        float *partial_bulk =
                            (args.fa35)
                                ? (float *)rt_spm_malloc(
                                      8 * partial_stride * sizeof(float))
                                : nullptr;
                        float *accum =
                            (float *)rt_spm_malloc(BK * sizeof(float));
                        half *reduce_out =
                            (half *)rt_spm_malloc(BK * sizeof(half));
                        for (int h_idx = h_lo; h_idx < h_hi; h_idx++) {
                            float running_m = -FLT_MAX;
                            float running_l = 0.0f;
                            int k = 0;
                            floatv16 vzero = 0.0f;
                            for (; k + 16 <= BK; k += 16)
                                simd_store(vzero, accum + k);
                            for (; k < BK; k++) accum[k] = 0.0f;
                            const float *bulk_base =
                                ws_base + (h_idx * args.split_num) *
                                              partial_stride;
                            for (int c0 = 0; c0 < args.split_num;
                                 c0 += 8) {
                                int cn = MIN(8, args.split_num - c0);
                                const float *src;
                                if (partial_bulk != nullptr) {
                                    memcpy(partial_bulk,
                                           bulk_base + c0 * partial_stride,
                                           cn * partial_stride *
                                               sizeof(float));
                                }
                                for (int si = 0; si < cn; si++) {
                                    src = (partial_bulk != nullptr)
                                              ? partial_bulk +
                                                    si * partial_stride
                                              : bulk_base +
                                                    (c0 + si) * partial_stride;
                                    float partial_l = src[1];
                                    if (partial_l <= 0.0f) continue;
                                    float partial_m = src[0];
                                    float next_m = MAX(running_m, partial_m);
                                    float old_scale =
                                        running_l > 0.0f
                                            ? expf(running_m - next_m)
                                            : 0.0f;
                                    float partial_scale =
                                        expf(partial_m - next_m);
                                    for (int h = 0; h < BK; h++) {
                                        accum[h] = accum[h] * old_scale +
                                                   src[2 + h] * partial_scale;
                                    }
                                    running_l = running_l * old_scale +
                                                partial_l * partial_scale;
                                    running_m = next_m;
                                }
                            }
                            float l_inv =
                                running_l > 0.0f ? 1.0f / running_l : 0.0f;
                            floatv16 vl_inv = l_inv;
                            k = 0;
                            for (; k + 16 <= BK; k += 16) {
                                floatv16 vf;
                                halfv16 vh;
                                simd_load(vf, accum + k);
                                vh = (halfv16)(vf * vl_inv);
                                simd_store(vh, reduce_out + k);
                            }
                            for (; k < BK; k++)
                                reduce_out[k] = (half)(accum[k] * l_inv);
                            half *out = (half *)args.fmha_out +
                                        h_idx * BK;
                            memcpy(out, reduce_out, BK * sizeof(half));
                        }
                    }
                }
                continue;
            }

            // normalize O_accum by l and convert to half
            if (fa48x_b) {
                // O^T [d][q] layout: obuf[row][d] = o_accum[d*128 + row] / l
                for (int row = 0; row < cur_BM; row++) {
                    float l_inv = l_ptr[row] > 0.0f ? 1.0f / l_ptr[row] : 0.0f;
                    half *obuf_row = obuf + row * args.size_per_head;
                    for (int d = 0; d < args.size_per_head; d++) {
                        obuf_row[d] =
                            (half)(o_accum[d * 128 + row] * l_inv);
                    }
                }
            } else {
            for (int row = 0; row < cur_BM; row++) {
                float l_inv = l_ptr[row] > 0.0f ? 1.0f / l_ptr[row] : 0.0f;
                floatv16 vl_inv = l_inv;
                float *o_row = o_accum + row * args.size_per_head;
                half *obuf_row = obuf + row * args.size_per_head;
                int k = 0;
                for (; k + 16 <= args.size_per_head; k += 16) {
                    floatv16 vf;
                    halfv16 vh;
                    simd_load(vf, o_row + k);
                    vf = vf * vl_inv;
                    vh = (halfv16)vf;
                    simd_store(vh, obuf_row + k);
                }
                for (; k < args.size_per_head; k++) {
                    obuf_row[k] = (half)(o_row[k] * l_inv);
                }
            }
            }

            // dma O
            int rel_obuf_size = MIN(BM * tile_blocks, q_seq_len - i) * token_size;
            size_t o_dst_stride = (args.local_head_num - 1) * token_size;
            half *out_base = (half *)args.fmha_out +
                             (cur_q_index + i) * args.local_head_num * args.size_per_head +
                             head_idx * args.size_per_head;
            memcpy_stride(out_base, obuf, rel_obuf_size, token_size, {o_dst_stride, 0});
        }
        cur_q_index += q_seq_len;
    }
}

// Keep the production-only decode body in a separate include so the generic
// kernel remains byte-for-byte auditable and every non-whitelisted shape can
// continue to use it unchanged.
#include "ual/kernel/flash_attention/q1d64_decode.scpp.inc"
