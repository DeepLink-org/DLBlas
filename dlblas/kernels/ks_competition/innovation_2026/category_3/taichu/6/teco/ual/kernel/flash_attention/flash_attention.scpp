                            + block_id * args.local_kv_head_num *
                                  args.block_size * args.size_per_head
                            + kv_head_idx * args.block_size * args.size_per_head;
                        memcpy_async(kbuf, v_src,
                                     cur_BN * args.size_per_head * sizeof(half),
                                     MemcpyGlobalToSpm, v_get_handle);

                        int next_j = j + BN;
                        if (next_j < last_k) {
                            int next_dbflag = 1 - k_dbflag;
                            int next_block = next_j / args.block_size;
                            int next_block_id = ldm_block_table[next_block];
                            int next_BN = MIN(BN, last_k - next_j);
                            const half *next_k_src =
                                (const half *)args.key_cache
                                + next_block_id * args.local_kv_head_num *
                                      args.block_size * args.size_per_head
                                + kv_head_idx * args.block_size *
                                      args.size_per_head;
                            half *next_ktmp =
                                next_dbflag == 0 ? ktmp : ktmp_alt;
                            memcpy_async(next_ktmp, next_k_src,
                                         next_BN * args.size_per_head *
                                             sizeof(half),
                                         MemcpyGlobalToSpm,
                                         k_get_handle[next_dbflag]);
                        }

                        // Q is constant across the K scan: convert each
                        // group row's Q vectors to float once per tile.
                        floatv16 qf0[4];
                        floatv16 qf1[4];
                        for (int h = 0; h < BK; h += 16) {
                            halfv16 qh0;
                            simd_load(qh0, qbuf + row_begin * BK + h);
                            qf0[h / 16] = simd_vfcvths(qh0);
                            if (group_BM > 1) {
                                halfv16 qh1;
                                simd_load(qh1,
                                          qbuf + (row_begin + 1) * BK + h);
                                qf1[h / 16] = simd_vfcvths(qh1);
                            }
                        }
                        for (int t = 0; t < cur_BN; t++) {
                            floatv16 dot0 = 0.0f;
                            floatv16 dot1 = 0.0f;
                            for (int h = 0; h < BK; h += 16) {
                                halfv16 kh;
                                simd_load(kh, cur_ktmp + t * BK + h);
                                floatv16 kf = simd_vfcvths(kh);
                                dot0 = simd_vfmas(qf0[h / 16], kf, dot0);
                                if (group_BM > 1) {
                                    dot1 = simd_vfmas(qf1[h / 16], kf, dot1);
                                }
                            }
                            outc[t] = simd_redsum(dot0) * args.softmax_scale;
                            if (group_BM > 1) {
                                outc[BN + t] =
                                    simd_redsum(dot1) * args.softmax_scale;
                            }
                        }

                        online_softmax_step(
                            outc, group_m_ptr, group_l_ptr,
                            group_m_next, group_l_next, scale,
                            group_BM, cur_BN, BN);

                        for (int row = 0; row < group_BM; row++) {
                            // scale == 1.0 exactly when the running max is
                            // unchanged; skip the whole rescale pass then.
                            if (scale[row] == 1.0f) continue;
                            floatv16 row_scale = scale[row];
                            float *accum_row =
                                o_accum + (row_begin + row) * BK;
                            for (int h = 0; h < BK; h += 16) {
                                floatv16 accum_v;
                                simd_load(accum_v, accum_row + h);
                                simd_store(accum_v * row_scale, accum_row + h);
                            }
                        }

                        memcpy_wait(v_get_handle);
                        for (int h = 0; h < BK; h += 16) {
                            floatv16 a0;
                            floatv16 a1;
                            simd_load(a0,
                                      o_accum + row_begin * BK + h);
                            if (group_BM > 1) {
                                simd_load(a1,
                                          o_accum + (row_begin + 1) * BK + h);
                            }
                            for (int t = 0; t < cur_BN; t++) {
                                halfv16 value_h;
                                simd_load(value_h, kbuf + t * BK + h);
                                floatv16 vf = simd_vfcvths(value_h);
                                float p0 = (float)(half)outc[t];
                                a0 = simd_vfmas(vf, p0, a0);
                                if (group_BM > 1) {
                                    float p1 = (float)(half)outc[BN + t];
                                    a1 = simd_vfmas(vf, p1, a1);
                                }
                            }
                            simd_store(a0,
                                       o_accum + row_begin * BK + h);
                            if (group_BM > 1) {
                                simd_store(a1,
                                           o_accum + (row_begin + 1) * BK + h);
                            }
                        }

                        float *tmp = group_l_ptr;
                        group_l_ptr = group_l_next;
                        group_l_next = tmp;
                        tmp = group_m_ptr;
                        group_m_ptr = group_m_next;
                        group_m_next = tmp;
                        k_dbflag = 1 - k_dbflag;
                    }
                    if (group_l_ptr != l_prev + row_begin) {
                        for (int row = 0; row < group_BM; row++) {
                            l_prev[row_begin + row] = group_l_ptr[row];
                            m_prev[row_begin + row] = group_m_ptr[row];
                        }
                    }
                }
                }
                l_ptr = l_prev;
                m_ptr = m_prev;
            } else {
            // FA-28: for the whitelisted prefill, step two KV pages (64
            // columns) per iteration so one softmax visit covers 2 pages
            // (see Step A below). Non-fa28 shapes keep the exact per-page
            // loop.
            // FA-31: on the fa30+chunked path, K tiles ping-pong between
            // kbuf2 and kbuf2b; the next pair's K memcpy is issued right
            // after this pair's QK gemm (sub 0) and waited at the top of
            // the next iteration, so the ~8KB copy overlaps softmax+PV.
            half *fa28_kbuf_cur = kbuf2;
            bool k31_pending = false;
            bool k31_pending_b = false;  // pending issue also has a page-B copy
            int k31_parity = 0;
            // FA-48X v4: vt pipeline state. The four 4KB V^T tile DMAs for
            // visit t+1 are issued right after visit t's scatter, so their
            // GM->SPM latency hides behind visit t's QK/softmax/PV; only
            // the SIMD scatter remains at the next visit's top.
            bool vt_pending = false;
            // FA-60: K prefetch state. Visit t+1's four K-page GM->SPM copies
            // (+ partial-tail zero-fill) are issued right after visit t's QK
            // barrier (kbuf2 is dead from ax_qk.wait_storeC(4) until the next
            // visit's QK tensors are created; nothing else touches it in
            // between), so the DMA lands under visit t's softmax/PV work and
            // is only waited at visit t+1's top, before any read. Bytes are
            // identical to the synchronous copies; the result is verified
            // (waited) before use. First visit and any failed async issue
            // fall back to the original synchronous path.
            bool k48_pending = false;
            MemcpyHandle k48_handle[4];
            int tile_elems = args.block_size * args.size_per_head;
            for (int j = first_k; j < last_k;
                 j += (fa28 ? ((fa47 || fa48x_b) ? 4 * BN : 2 * BN) : BN)) {
                int cur_BN = MIN(BN, last_k - j);
                int cur_BN2 = fa28
                    ? MIN(((fa47 || fa48x_b) ? 4 * BN : 2 * BN), last_k - j)
                    : cur_BN;
                bool has_page_b = fa28 && (j + BN) < last_k;
                bool has_page_c = (fa47 || fa48x_b) && (j + 2 * BN) < last_k;
                bool has_page_d = (fa47 || fa48x_b) && (j + 3 * BN) < last_k;

                int kv_head_idx = head_idx / num_kv_groups;             // GQA
                int cur_block = j / args.block_size;                    // BN == block_size
                int block_id_k = ldm_block_table[cur_block];
                int block_id_kb = has_page_b
                    ? ldm_block_table[cur_block + 1] : 0;
                int block_id_kc = has_page_c
                    ? ldm_block_table[cur_block + 2] : 0;
                int block_id_kd = has_page_d
                    ? ldm_block_table[cur_block + 3] : 0;
                // FA-31: the K tile buffer alternates by parity on the
                // pipelined path; always kbuf2 (or kbuf) elsewhere.
                if (kbuf2b != nullptr) {
                    fa28_kbuf_cur = (k31_parity == 0) ? kbuf2 : kbuf2b;
                }
                half *kbase = fa28 ? fa28_kbuf_cur : kbuf;
                const half *k_src = (const half *)args.key_cache
                    + block_id_k * args.local_kv_head_num * args.block_size *
                        args.size_per_head
                    + kv_head_idx * args.block_size * args.size_per_head;
                const half *k_src_b = has_page_b
                    ? (const half *)args.key_cache
                        + block_id_kb * args.local_kv_head_num *
                            args.block_size * args.size_per_head
                        + kv_head_idx * args.block_size * args.size_per_head
                    : nullptr;
                const half *k_src_c = has_page_c
                    ? (const half *)args.key_cache
                        + block_id_kc * args.local_kv_head_num *
                            args.block_size * args.size_per_head
                        + kv_head_idx * args.block_size * args.size_per_head
                    : nullptr;
                const half *k_src_d = has_page_d
                    ? (const half *)args.key_cache
                        + block_id_kd * args.local_kv_head_num *
                            args.block_size * args.size_per_head
                        + kv_head_idx * args.block_size * args.size_per_head
                    : nullptr;

                const half *v_cache_base = (const half *)args.value_cache
                    + block_id_k * args.local_kv_head_num * args.block_size * args.size_per_head
                    + kv_head_idx  * args.block_size * args.size_per_head;
                const half *v_cache_base_b = has_page_b
                    ? (const half *)args.value_cache
                        + block_id_kb * args.local_kv_head_num *
                            args.block_size * args.size_per_head
                        + kv_head_idx  * args.block_size * args.size_per_head
                    : nullptr;
                const half *v_cache_base_c = has_page_c
                    ? (const half *)args.value_cache
                        + block_id_kc * args.local_kv_head_num *
                            args.block_size * args.size_per_head
                        + kv_head_idx  * args.block_size * args.size_per_head
                    : nullptr;
                const half *v_cache_base_d = has_page_d
                    ? (const half *)args.value_cache
                        + block_id_kd * args.local_kv_head_num *
                            args.block_size * args.size_per_head
                        + kv_head_idx  * args.block_size * args.size_per_head
                    : nullptr;

                // ──────────────────────────────────────────────────────────
                // FA-48X: axis-swapped visit (replaces the fa47 row-major
                // chain for the same whitelist shapes). 4 pages = 128 keys
                // per visit; each SIMD lane is one query; QK produces
                // S^T [key][query] = K_native[128k,64] x Q_g^T[64,32];
                // softmax runs per lane along the key direction (no
                // horizontal max tree); PV is V^T[64,128] x P^T_g[128,32]
                // with V^T staged in the phase-3 scratch; O accumulates in
                // O^T [d][q] with per-lane online rescale. Math is the
                // same attention, fp reassociation only.
                if (fa48x_b) {
                    const int AXK = 128;
                    // FA-48X diag (timing-only): bits gate individual
                    // components so whole-call deltas decompose the visit.
                    int dbg48 = args.dbg_stub;
                    // FA-61: QK/softmax pipelining. fa61_active only when
                    // the DIAG noQK stub is off, so every new leg keeps the
                    // same dbg48 gating as its legacy counterpart.
                    bool fa61_active = args.fa61 != 0 &&
                                       !(dbg48 & 0x100000);
                    // FA-63: visit-head overlap. The (b) V^T wait+scatter
                    // block has NO data dependence on QK (disjoint buffers:
                    // vt48/tilebase vs kbuf2/wg48/outc2), so under fa63 it
                    // is executed AFTER the first QK gemms are enqueued
                    // instead of before them: ACE runs QK while this SPE
                    // thread waits on the V DMAs and scatters vt48. The
                    // block body is byte-identical in both positions and in
                    // both cases completes before the first vt48 consumer
                    // (the PV(0) issue; the legacy wait_storeC(4)), so every
                    // later consumer sees exactly the same bytes at the same
                    // time. As in FA-61, fa63 deactivates itself under the
                    // DIAG noQK stub (0x100000).
                    bool fa63_active = args.fa63 != 0 &&
                                       !(dbg48 & 0x100000);
                    // (a) native K pages -> kbuf2 [128k][64d] (native cache
                    // orientation: rows are keys, so no transpose; zero-pad
                    // the unused tail rows of a partial last visit).
                    int cur_BN_p1 = has_page_b ? MIN(BN, last_k - j - BN) : 0;
                    int cur_BN_p2 = has_page_c ? MIN(BN, last_k - j - 2 * BN) : 0;
                    int cur_BN_p3 = has_page_d ? MIN(BN, last_k - j - 3 * BN) : 0;
                    if (!(dbg48 & 0x400000)) {
                    if (k48_pending) {
                        // FA-60: this visit's K pages were prefetched at the
                        // previous visit's QK barrier. Wait exactly the
                        // handles that were issued: page p of THIS visit was
                        // prefetched iff it exists (has_page_b/c/d use the
                        // same predicates as the issue-time fill counts).
                        // kbuf2 is not read before these waits return.
                        memcpy_wait(k48_handle[0]);
                        if (has_page_b) {
                            memcpy_wait(k48_handle[1]);
                        }
                        if (has_page_c) {
                            memcpy_wait(k48_handle[2]);
                        }
                        if (has_page_d) {
                            memcpy_wait(k48_handle[3]);
                        }
                        k48_pending = false;
                    } else {
                    memcpy(kbuf2, k_src,
                           cur_BN * args.size_per_head * sizeof(half));
                    if (has_page_b) {
                        memcpy(kbuf2 + BN * args.size_per_head, k_src_b,
                               cur_BN_p1 * args.size_per_head * sizeof(half));
                    }
                    if (has_page_c) {
                        memcpy(kbuf2 + 2 * BN * args.size_per_head, k_src_c,
                               cur_BN_p2 * args.size_per_head * sizeof(half));
                    }
                    if (has_page_d) {
                        memcpy(kbuf2 + 3 * BN * args.size_per_head, k_src_d,
                               cur_BN_p3 * args.size_per_head * sizeof(half));
                    }
                    {
                        halfv16 hz = (halfv16)0;
                        int fills[4] = {cur_BN, cur_BN_p1, cur_BN_p2, cur_BN_p3};
                        for (int pg = 0; pg < 4; pg++) {
                            for (int r = fills[pg] * args.size_per_head;
                                 r < BN * args.size_per_head; r += 16) {
                                simd_store(hz, kbuf2 + pg * BN *
                                                   args.size_per_head + r);
                            }
                        }
                    }
                    }
                    }
                    if (!fa63_active) {
                    // (b) V^T from the phase-3 vscratch -> vt48 [64d][128k].
                    // FA-48X v4 pipeline: the four 4KB tile DMAs for THIS
                    // visit were issued at the end of the previous visit
                    // (they overlapped the previous visit's compute); here
                    // we wait + SIMD-scatter all four tiles into vt48, then
                    // issue the NEXT visit's DMAs, which overlap the rest
                    // of this visit's compute. Tile order in the aggregate
                    // is SLOT-MAJOR ([slot][64d][32k]; plain DMA can
                    // deliver contiguous dst), while the PV gemm needs A as
                    // [64d][128k] 128-half rows, hence the per-slot 64-row
                    // scatter.
                    // The v2 2D-strided per-page DMA was a hardware dead
                    // end: the DMA engine cannot scatter into strided SPM
                    // (nonzero dst stride unsupported - probes
                    // vt48_dma_check/dma_sem write the same garbage for
                    // every field order; FA-47 only uses dst_stride=0).
                    // Tail slots of a partial last group are zeroed by
                    // phase 3, so the PV gemm's A columns beyond last_k are
                    // zero (x P^T=0 -> no NaN, far keys stay unconsumed).
                    if (!(dbg48 & 0x200000)) {
                    {
                        int group_id = (block_id_k - ldm_block_table[0]) >> 2;  // RELATIVE group (v6b: vscratch sized by actual k, indexed relative to table base t0; fa48x_b guarantees t0%4==0 identity)
                        const half *vgrp =
                            (const half *)args.vscratch +
                            ((group_id * args.local_kv_head_num +
                              kv_head_idx) << 2) * tile_elems;
                        const half *tilebase[4] = {
                            p_score2 + 4096, p_score2 + 4096 + tile_elems,
                            ttmp48, ttmp48 + tile_elems};
                        if (vt_pending) {
                            // DMAs were issued at the previous visit's end
                            // (one handle per tile, FA-47-proven pattern).
                            memcpy_wait(v_get_handle);
                            memcpy_wait(v_get_handle2);
                            memcpy_wait(v_get_handle3);
                            memcpy_wait(v_get_handle4);
                        } else {
                            // first visit: issue all four tile DMAs now.
                            for (int s = 0; s < 4; s++) {
                                check_memcpy_async(
                                    (half *)tilebase[s], vgrp + s * tile_elems,
                                    tile_elems * sizeof(half),
                                    MemcpyGlobalToSpm, v_get_handle);
                                memcpy_async(
                                    (half *)tilebase[s], vgrp + s * tile_elems,
                                    tile_elems * sizeof(half),
                                    MemcpyGlobalToSpm, v_get_handle);
                            }
                            memcpy_wait(v_get_handle);
                            memcpy_wait(v_get_handle2);
                            memcpy_wait(v_get_handle3);
                            memcpy_wait(v_get_handle4);
                        }
                        for (int slot = 0; slot < 4; slot++) {
                            const half *ts = tilebase[slot];
                            for (int d = 0; d < 64; d++) {
                                halfv16 a, b;
                                simd_load(a, ts + d * 32);
                                simd_load(b, ts + d * 32 + 16);
                                simd_store(a, vt48 + d * 128 + slot * 32);
                                simd_store(b, vt48 + d * 128 + slot * 32 + 16);
                            }
                        }
                        // issue the NEXT visit's four tile DMAs (they land
                        // in the temp only after this visit's scatter; the
                        // wait happens at the next visit's top).
                        if (j + 4 * BN < last_k) {
                            // Next visit's 4 tiles: (group_id+1) with the
                            // SAME kv head. The vscratch layout is
                            // [group][kv_head][64d][32k], so the stride is
                            // 4*local_kv_head_num tiles per group (GQA2:
                            // 8 tiles), NOT 4 -- a +4 shortcut read the
                            // wrong group's V^T for every visit >= 1
                            // (task 0 correct, all later rows wrong).
                            int group_next = group_id + 1;
                            const half *vgrp_next =
                                (const half *)args.vscratch +
                                ((group_next * args.local_kv_head_num +
                                  kv_head_idx)
                                 << 2) *
                                    tile_elems;
                            MemcpyHandle *vh[4] = {&v_get_handle,
                                                   &v_get_handle2,
                                                   &v_get_handle3,
                                                   &v_get_handle4};
                            for (int s = 0; s < 4; s++) {
                                check_memcpy_async(
                                    (half *)tilebase[s],
                                    vgrp_next + s * tile_elems,
                                    tile_elems * sizeof(half),
                                    MemcpyGlobalToSpm, *vh[s]);
                                memcpy_async(
                                    (half *)tilebase[s],
                                    vgrp_next + s * tile_elems,
                                    tile_elems * sizeof(half),
                                    MemcpyGlobalToSpm, *vh[s]);
                            }
                            vt_pending = true;
                        }
                    }
                    }
                    }
                    // (c) QK: S^T = K[128,64] x Q_g^T[64,32], 4 gemms.
                    {
                        MatmulConfig ax_cfg;
                        Matmul ax_qk(ax_cfg), ax_pv(ax_cfg);
                        auto tK =
                            make_tensor<2>((half *)kbuf2,
                                           {(size_t)AXK,
                                            (size_t)args.size_per_head});
                        if (!(dbg48 & 0x100000)) {
                        if (!fa61_active) {
                        // legacy FA-60 form: four back-to-back QK gemms +
                        // one all-group barrier before any softmax.
                        for (int g = 0; g < 4; g++) {
                            auto tW = make_tensor<2>(
                                (half *)wg48 + g * args.size_per_head * 32,
                                {(size_t)args.size_per_head, (size_t)32});
                            auto tC = make_tensor<2>(
                                (float *)outc2 + g * BM * BN,
                                {(size_t)AXK, (size_t)32});
                            ax_qk.compute_async<MatmulBlockConfig::M128_N32>(
                                tK, tW, true);
                            ax_qk.storeC_spm_async(tC);
                        }
                        ax_qk.wait_storeC(4);
                        } else {
                        // FA-61: enqueue QK(0),QK(1) up front; each group
                        // drains its own store at loop top and re-feeds
                        // the ACE with QK(g+2). FIFO per Matmul object
                        // makes the first outstanding completion == QK(g)
                        // (same drain-per-call semantics as the ax_pv
                        // per-group waits). Slots disjoint from PV(g-1).
                        for (int g = 0; g < 2; g++) {
                            auto tW = make_tensor<2>(
                                (half *)wg48 + g * args.size_per_head * 32,
                                {(size_t)args.size_per_head, (size_t)32});
                            auto tC = make_tensor<2>(
                                (float *)outc2 + g * BM * BN,
                                {(size_t)AXK, (size_t)32});
                            ax_qk.compute_async<MatmulBlockConfig::M128_N32>(
                                tK, tW, true);
                            ax_qk.storeC_spm_async(tC);
                        }
                        if (fa63_active) {
                        // FA-63 moved copy of block (b): byte-identical to
                        // the legacy-position original above (which is dead
                        // code when fa63_active). Runs while the two
                        // outstanding QK gemms drain on ACE; still finishes
                        // before the first vt48 consumer (the PV(0) issue at
                        // the end of group 0's processing).
                    // (b) V^T from the phase-3 vscratch -> vt48 [64d][128k].
                    // FA-48X v4 pipeline: the four 4KB tile DMAs for THIS
                    // visit were issued at the end of the previous visit
                    // (they overlapped the previous visit's compute); here
                    // we wait + SIMD-scatter all four tiles into vt48, then
                    // issue the NEXT visit's DMAs, which overlap the rest
                    // of this visit's compute. Tile order in the aggregate
                    // is SLOT-MAJOR ([slot][64d][32k]; plain DMA can
                    // deliver contiguous dst), while the PV gemm needs A as
                    // [64d][128k] 128-half rows, hence the per-slot 64-row
                    // scatter.
                    // The v2 2D-strided per-page DMA was a hardware dead
                    // end: the DMA engine cannot scatter into strided SPM
                    // (nonzero dst stride unsupported - probes
                    // vt48_dma_check/dma_sem write the same garbage for
                    // every field order; FA-47 only uses dst_stride=0).
                    // Tail slots of a partial last group are zeroed by
                    // phase 3, so the PV gemm's A columns beyond last_k are
                    // zero (x P^T=0 -> no NaN, far keys stay unconsumed).
                    if (!(dbg48 & 0x200000)) {
                    {
                        int group_id = (block_id_k - ldm_block_table[0]) >> 2;  // RELATIVE group (v6b: vscratch sized by actual k, indexed relative to table base t0; fa48x_b guarantees t0%4==0 identity)
                        const half *vgrp =
                            (const half *)args.vscratch +
                            ((group_id * args.local_kv_head_num +
                              kv_head_idx) << 2) * tile_elems;
                        const half *tilebase[4] = {
                            p_score2 + 4096, p_score2 + 4096 + tile_elems,
                            ttmp48, ttmp48 + tile_elems};
                        if (vt_pending) {
                            // DMAs were issued at the previous visit's end
                            // (one handle per tile, FA-47-proven pattern).
                            memcpy_wait(v_get_handle);
                            memcpy_wait(v_get_handle2);
                            memcpy_wait(v_get_handle3);
                            memcpy_wait(v_get_handle4);
                        } else {
                            // first visit: issue all four tile DMAs now.
                            for (int s = 0; s < 4; s++) {
                                check_memcpy_async(
                                    (half *)tilebase[s], vgrp + s * tile_elems,
                                    tile_elems * sizeof(half),
                                    MemcpyGlobalToSpm, v_get_handle);
                                memcpy_async(
                                    (half *)tilebase[s], vgrp + s * tile_elems,
                                    tile_elems * sizeof(half),
                                    MemcpyGlobalToSpm, v_get_handle);
                            }
                            memcpy_wait(v_get_handle);
                            memcpy_wait(v_get_handle2);
                            memcpy_wait(v_get_handle3);
                            memcpy_wait(v_get_handle4);
                        }
                        for (int slot = 0; slot < 4; slot++) {
                            const half *ts = tilebase[slot];
                            for (int d = 0; d < 64; d++) {
                                halfv16 a, b;
                                simd_load(a, ts + d * 32);
                                simd_load(b, ts + d * 32 + 16);
                                simd_store(a, vt48 + d * 128 + slot * 32);
                                simd_store(b, vt48 + d * 128 + slot * 32 + 16);
                            }
                        }
                        // issue the NEXT visit's four tile DMAs (they land
                        // in the temp only after this visit's scatter; the
                        // wait happens at the next visit's top).
                        if (j + 4 * BN < last_k) {
                            // Next visit's 4 tiles: (group_id+1) with the
                            // SAME kv head. The vscratch layout is
                            // [group][kv_head][64d][32k], so the stride is
                            // 4*local_kv_head_num tiles per group (GQA2:
                            // 8 tiles), NOT 4 -- a +4 shortcut read the
                            // wrong group's V^T for every visit >= 1
                            // (task 0 correct, all later rows wrong).
                            int group_next = group_id + 1;
                            const half *vgrp_next =
                                (const half *)args.vscratch +
                                ((group_next * args.local_kv_head_num +
                                  kv_head_idx)
                                 << 2) *
                                    tile_elems;
                            MemcpyHandle *vh[4] = {&v_get_handle,
                                                   &v_get_handle2,
                                                   &v_get_handle3,
                                                   &v_get_handle4};
                            for (int s = 0; s < 4; s++) {
                                check_memcpy_async(
                                    (half *)tilebase[s],
                                    vgrp_next + s * tile_elems,
                                    tile_elems * sizeof(half),
                                    MemcpyGlobalToSpm, *vh[s]);
                                memcpy_async(
                                    (half *)tilebase[s],
                                    vgrp_next + s * tile_elems,
                                    tile_elems * sizeof(half),
                                    MemcpyGlobalToSpm, *vh[s]);
                            }
                            vt_pending = true;
                        }
                    }
                    }
                        }
                        }
                        }
                        // FA-60: with the QK barrier passed, this visit no
                        // longer reads kbuf2 (PV/softmax use vt48/hexp/outc2
                        // only), so issue the NEXT visit's four K-page copies
                        // now; they land under this visit's softmax/PV work.
                        // Identical bytes and destinations as the synchronous
                        // path; waited at the next visit's top before any read.
                        // FA-61: kbuf2 is STILL being read by the pending QK
                        // gemms here (only 2 of 4 enqueued), so under
                        // fa61_active the identical prefetch is issued at the
                        // g==3 drain inside the group loop instead (same
                        // bytes/destinations, later safe point).
                        int k48_next = j + 4 * BN;
                        if (!(dbg48 & (0x400000 | 0x100000)) && !fa61_active &&
                            k48_next < last_k) {
                            // Fill counts of the NEXT visit's pages, computed
                            // with the same formulas as the synchronous path
                            // (page exists <=> fill count > 0; pages are NOT
                            // assumed contiguous - each uses its OWN block-table
                            // entry, like k_src/k_src_b/c/d).
                            int cb_n = k48_next / args.block_size;
                            int fills_n[4];
                            int bids_n[4];
                            fills_n[0] = MIN(BN, last_k - k48_next);
                            fills_n[1] =
                                (k48_next + BN) < last_k
                                    ? MIN(BN, last_k - k48_next - BN) : 0;
                            fills_n[2] =
                                (k48_next + 2 * BN) < last_k
                                    ? MIN(BN, last_k - k48_next - 2 * BN) : 0;
                            fills_n[3] =
                                (k48_next + 3 * BN) < last_k
                                    ? MIN(BN, last_k - k48_next - 3 * BN) : 0;
                            bids_n[0] = ldm_block_table[cb_n];
                            bids_n[1] = fills_n[1] > 0
                                    ? ldm_block_table[cb_n + 1] : 0;
                            bids_n[2] = fills_n[2] > 0
                                    ? ldm_block_table[cb_n + 2] : 0;
                            bids_n[3] = fills_n[3] > 0
                                    ? ldm_block_table[cb_n + 3] : 0;
                            for (int pg = 0; pg < 4; pg++) {
                                if (fills_n[pg] <= 0)
                                    continue; // absent/empty page: zero-fill only
                                const half *ks_pg =
                                    (const half *)args.key_cache +
                                    bids_n[pg] * args.local_kv_head_num *
                                        args.block_size * args.size_per_head +
                                    kv_head_idx * args.block_size *
                                        args.size_per_head;
                                check_memcpy_async(
                                    (half *)kbuf2 +
                                        pg * BN * args.size_per_head,
                                    ks_pg,
                                    fills_n[pg] * args.size_per_head *
                                        sizeof(half),
                                    MemcpyGlobalToSpm, k48_handle[pg]);
                                memcpy_async(
                                    (half *)kbuf2 +
                                        pg * BN * args.size_per_head,
                                    ks_pg,
                                    fills_n[pg] * args.size_per_head *
                                        sizeof(half),
                                    MemcpyGlobalToSpm, k48_handle[pg]);
                            }
                            // partial-page tails: identical zero-fill to the
                            // sync path. Ranges are disjoint from the in-flight
                            // DMAs ([0,fills) vs [fills,BN) per page), so store
                            // vs DMA order cannot interact.
                            {
                                halfv16 hz = (halfv16)0;
                                for (int pg = 0; pg < 4; pg++) {
                                    for (int r = fills_n[pg] * args.size_per_head;
                                         r < BN * args.size_per_head; r += 16) {
                                        simd_store(hz, kbuf2 + pg * BN *
                                                           args.size_per_head +
                                                           r);
                                    }
                                }
                            }
                            k48_pending = true;
                        }
                        // (d) per group: lane=query softmax + exp + PV.
                        int qb_task = q_start + i;  // q_row_off == 0 here
                        floatv16 vscale = args.softmax_scale;
                        halfv16 hinf;
                        for (int z = 0; z < 16; z++)
                            ((unsigned short *)&hinf)[z] = 0xFC00;
                        for (int g = 0; g < 4; g++) {
                            // FA-61: drain THIS group's QK store before its
                            // softmax reads outc2[g] (FIFO per Matmul object:
                            // first outstanding completion == QK(g)), then
                            // keep the ACE fed with QK(g+2) so the gemm runs
                            // under this group's softmax/PV work. Slots stay
                            // disjoint: QK(g)->outc2[g], PV(g-1)->outc2[g-1].
                            if (fa61_active) {
                                ax_qk.wait_storeC(1);
                            if (!(dbg48 & 0x100000) && g < 2) {
                                auto tW = make_tensor<2>(
                                    (half *)wg48 + (g + 2) *
                                        args.size_per_head * 32,
                                    {(size_t)args.size_per_head, (size_t)32});
                                auto tC = make_tensor<2>(
                                    (float *)outc2 + (g + 2) * BM * BN,
                                    {(size_t)AXK, (size_t)32});
                                ax_qk.compute_async<
                                    MatmulBlockConfig::M128_N32>(
                                    tK, tW, true);
                                ax_qk.storeC_spm_async(tC);
                            }
                            }
                            // FA-60 under FA-61: ONLY at the g==3 drain is
                            // every reader of kbuf2 done (QK(0..3) all
                            // completed), so issue the NEXT visit's four
                            // K-page copies here -- byte-exact same body as
                            // the legacy post-barrier site.
                            if (fa61_active && g == 3 &&
                                !(dbg48 & 0x400000) && k48_next < last_k) {
                            int cb_n = k48_next / args.block_size;
                            int fills_n[4];
                            int bids_n[4];
                            fills_n[0] = MIN(BN, last_k - k48_next);
                            fills_n[1] =
                                (k48_next + BN) < last_k
                                    ? MIN(BN, last_k - k48_next - BN) : 0;
                            fills_n[2] =
                                (k48_next + 2 * BN) < last_k
                                    ? MIN(BN, last_k - k48_next - 2 * BN) : 0;
                            fills_n[3] =
                                (k48_next + 3 * BN) < last_k
                                    ? MIN(BN, last_k - k48_next - 3 * BN) : 0;
                            bids_n[0] = ldm_block_table[cb_n];
                            bids_n[1] = fills_n[1] > 0
                                    ? ldm_block_table[cb_n + 1] : 0;
                            bids_n[2] = fills_n[2] > 0
                                    ? ldm_block_table[cb_n + 2] : 0;
                            bids_n[3] = fills_n[3] > 0
                                    ? ldm_block_table[cb_n + 3] : 0;
                            for (int pg = 0; pg < 4; pg++) {
                                if (fills_n[pg] <= 0)
                                    continue; // absent/empty page: zero-fill only
                                const half *ks_pg =
                                    (const half *)args.key_cache +
                                    bids_n[pg] * args.local_kv_head_num *
                                        args.block_size * args.size_per_head +
                                    kv_head_idx * args.block_size *
                                        args.size_per_head;
                                check_memcpy_async(
                                    (half *)kbuf2 +
                                        pg * BN * args.size_per_head,
                                    ks_pg,
                                    fills_n[pg] * args.size_per_head *
                                        sizeof(half),
                                    MemcpyGlobalToSpm, k48_handle[pg]);
                                memcpy_async(
                                    (half *)kbuf2 +
                                        pg * BN * args.size_per_head,
                                    ks_pg,
                                    fills_n[pg] * args.size_per_head *
                                        sizeof(half),
                                    MemcpyGlobalToSpm, k48_handle[pg]);
                            }
                            {
                                halfv16 hz = (halfv16)0;
                                for (int pg = 0; pg < 4; pg++) {
                                    for (int r = fills_n[pg] * args.size_per_head;
                                         r < BN * args.size_per_head; r += 16) {
                                        simd_store(hz, kbuf2 + pg * BN *
                                                           args.size_per_head +
                                                           r);
                                    }
                                }
                            }
                            k48_pending = true;
                            }
                            int qb_g = qb_task + g * 32;
                            float *scg = (float *)outc2 + g * BM * BN;
                            // FA-48X v6: hexp48 double buffer by group
                            // parity: softmax(g) fills one half while the
                            // ACE PV(g-1) still reads the other half as its
                            // B operand (issued async at the end of the
                            // previous group; waited HERE, after this
                            // group's softmax, so the SIMD softmax overlaps
                            // the in-flight matmul).
                            half *hexp_g = (g & 1) ? hexp48b : hexp48;
                            halfv16 *mvt =
                                (halfv16 *)maskv_raw + (g * 33) * 2;
                            floatv16 m_lo = *(floatv16 *)(m_ptr + g * 32);
                            floatv16 m_hi =
                                *((floatv16 *)(m_ptr + g * 32) + 1);
                            floatv16 l_lo = *(floatv16 *)(l_ptr + g * 32);
                            floatv16 l_hi =
                                *((floatv16 *)(l_ptr + g * 32) + 1);
                            floatv16 m_old_lo = m_lo, m_old_hi = m_hi;
                            int cover = cur_BN2;  // keys < cover are real
                            int valid_end = MIN(AXK, MAX(0, qb_g - j));
                            if (valid_end > cover) valid_end = cover;
                            int band_lo = MAX(0, qb_g - j);
                            int band_hi = MIN(AXK, MAX(0, qb_g + 32 - j));
                            if (band_hi > cover) band_hi = cover;
                            // v8 FUSED SOFTMAX CHAIN (pass1 + build + exp + l):
                            // (1) PASS-1: 4-way-ILP partial per-lane max over
                            //     the fp32 score tile. Bit-exact max under
                            //     reassociation; cumulative m from m_ptr and
                            //     causal/tail mask handling are preserved.
                            // (2) FUSED PASS-2: per-128-half block (4 keys x
                            //     32 lanes): build the block's 4 exp-input
                            //     rows -> exp128v2 in place -> 4-way-ILP l
                            //     accumulation, so the next block's build can
                            //     overlap this block's exp (targets the
                            //     measured ~2x phase-boundary overhead).
                            floatv16 pm_lo[4], pm_hi[4];
                            for (int t = 0; t < 4; t++) {
                                pm_lo[t] = m_lo;
                                pm_hi[t] = m_hi;
                            }
                            if (!(dbg48 & 0x80000)) {
                                int k = 0;
                                for (; k + 4 <= valid_end; k += 4) {
                                    floatv16 s0, s1;
                                    simd_load(s0, scg + (k + 0) * 32);
                                    simd_load(s1, scg + (k + 0) * 32 + 16);
                                    pm_lo[0] = simd_max(pm_lo[0], s0);
                                    pm_hi[0] = simd_max(pm_hi[0], s1);
                                    simd_load(s0, scg + (k + 1) * 32);
                                    simd_load(s1, scg + (k + 1) * 32 + 16);
                                    pm_lo[1] = simd_max(pm_lo[1], s0);
                                    pm_hi[1] = simd_max(pm_hi[1], s1);
                                    simd_load(s0, scg + (k + 2) * 32);
                                    simd_load(s1, scg + (k + 2) * 32 + 16);
                                    pm_lo[2] = simd_max(pm_lo[2], s0);
                                    pm_hi[2] = simd_max(pm_hi[2], s1);
                                    simd_load(s0, scg + (k + 3) * 32);
                                    simd_load(s1, scg + (k + 3) * 32 + 16);
                                    pm_lo[3] = simd_max(pm_lo[3], s0);
                                    pm_hi[3] = simd_max(pm_hi[3], s1);
                                }
                                for (; k < valid_end; k++) {
                                    floatv16 s0, s1;
                                    simd_load(s0, scg + k * 32);
                                    simd_load(s1, scg + k * 32 + 16);
                                    pm_lo[0] = simd_max(pm_lo[0], s0);
                                    pm_hi[0] = simd_max(pm_hi[0], s1);
                                }
                                for (int k = band_lo; k < band_hi; k++) {
                                    int mm = (j + k) - qb_g;
                                    floatv16 s0, s1;
                                    simd_load(s0, scg + k * 32);
                                    simd_load(s1, scg + k * 32 + 16);
                                    pm_lo[0] = simd_max(
                                        pm_lo[0],
                                        simd_add(s0, simd_vfcvths(mvt[2 * mm])));
                                    pm_hi[0] = simd_max(
                                        pm_hi[0],
                                        simd_add(s1, simd_vfcvths(mvt[2 * mm + 1])));
                                }
                            }
                            m_lo = simd_max(simd_max(pm_lo[0], pm_lo[1]),
                                            simd_max(pm_lo[2], pm_lo[3]));
                            m_hi = simd_max(simd_max(pm_hi[0], pm_hi[1]),
                                            simd_max(pm_hi[2], pm_hi[3]));
                            floatv16 m_new_lo =
                                simd_max(simd_mul(m_lo, vscale), m_old_lo);
                            floatv16 m_new_hi =
                                simd_max(simd_mul(m_hi, vscale), m_old_hi);
                            m_new_lo = simd_max(m_new_lo, 0.0f);
                            m_new_hi = simd_max(m_new_hi, 0.0f);
                            floatv16 scl_lo = simd_exp(m_old_lo - m_new_lo);
                            floatv16 scl_hi = simd_exp(m_old_hi - m_new_hi);
                            // v8c: skip the identity O^T rescale. When NO
                            // lane's running max changed this visit,
                            // m_new == m_old so scl == 1.0 exactly and the
                            // 64-dim rescale store loop is pure waste (in
                            // long sequences the global max stabilizes after
                            // a handful of record-breaking visits). m_new >=
                            // m_old elementwise, so a zero total delta iff
                            // every lane is unchanged -> skipping yields
                            // bit-identical O^T (mul by 1.0).
                            bool need_rescale =
                                simd_reduc_plusfs(simd_sub(m_new_lo, m_old_lo)) +
                                    simd_reduc_plusfs(simd_sub(m_new_hi, m_old_hi)) !=
                                0.0f;
                            // rescale O^T columns of this group (all dims)
                            if (!(dbg48 & 0x40000) && need_rescale) {
                            for (int d = 0; d < 64; d++) {
                                floatv16 vo;
                                simd_load(vo, o_accum + d * 128 + g * 32);
                                simd_store(simd_mul(vo, scl_lo),
                                           o_accum + d * 128 + g * 32);
                                simd_load(vo, o_accum + d * 128 + g * 32 + 16);
                                simd_store(simd_mul(vo, scl_hi),
                                           o_accum + d * 128 + g * 32 + 16);
                            }
                            }
                            // l + exp fused per 128-half block. hexp_g doubles
                             // as the PV B operand (no per-key copies).
                             floatv16 l_new_lo = simd_mul(l_lo, scl_lo);
                             floatv16 l_new_hi = simd_mul(l_hi, scl_hi);
                            if (!(dbg48 & 0x20000)) {
                                // v8b: keep the SEPARATE build -> exp -> l
                                // structure (fusing build+exp+l measured
                                // SLOWER in the real call, +0.7ms), but
                                // unroll the l accumulation into 4
                                // independent partial sums (breaks the
                                // 32-deep serial add chain).
                                // v8d: split the build into (i) a branch-free
                                // hot loop over the fully-valid keys [0,
                                // valid_end) and (ii) the original branchy
                                // mask/else path over [valid_end, AXK)
                                // (unchanged semantics, bit-identical: for k
                                // < valid_end the original always took the
                                // first branch). The dominant long-query case
                                // has valid_end == AXK so loop (ii) is empty.
                                {
                                    int kb = 0;
                                    for (; kb + 2 <= valid_end; kb += 2) {
                                        floatv16 s0, s1, u0, u1;
                                        simd_load(s0, scg + (kb + 0) * 32);
                                        simd_load(s1, scg + (kb + 0) * 32 + 16);
                                        simd_store(
                                            (halfv16)(simd_mul(s0, vscale) -
                                                      m_new_lo),
                                            hexp_g + (kb + 0) * 32);
                                        simd_store(
                                            (halfv16)(simd_mul(s1, vscale) -
                                                      m_new_hi),
                                            hexp_g + (kb + 0) * 32 + 16);
                                        simd_load(u0, scg + (kb + 1) * 32);
                                        simd_load(u1, scg + (kb + 1) * 32 + 16);
                                        simd_store(
                                            (halfv16)(simd_mul(u0, vscale) -
                                                      m_new_lo),
                                            hexp_g + (kb + 1) * 32);
                                        simd_store(
                                            (halfv16)(simd_mul(u1, vscale) -
                                                      m_new_hi),
                                            hexp_g + (kb + 1) * 32 + 16);
                                    }
                                    for (; kb < valid_end; kb++) {
                                        floatv16 s0, s1;
                                        simd_load(s0, scg + kb * 32);
                                        simd_load(s1, scg + kb * 32 + 16);
                                        simd_store(
                                            (halfv16)(simd_mul(s0, vscale) -
                                                      m_new_lo),
                                            hexp_g + kb * 32);
                                        simd_store(
                                            (halfv16)(simd_mul(s1, vscale) -
                                                      m_new_hi),
                                            hexp_g + kb * 32 + 16);
                                    }
                                }
                                for (int k = valid_end; k < AXK; k++) {
                                    floatv16 s0, s1;
                                    if (k < band_hi) {
                                        int mm = (j + k) - qb_g;
                                        simd_load(s0, scg + k * 32);
                                        simd_load(s1, scg + k * 32 + 16);
                                        simd_store(
                                            (halfv16)(simd_mul(
                                                simd_add(s0, simd_vfcvths(mvt[2 * mm])),
                                                vscale) - m_new_lo),
                                            hexp_g + k * 32);
                                        simd_store(
                                            (halfv16)(simd_mul(
                                                simd_add(s1, simd_vfcvths(mvt[2 * mm + 1])),
                                                vscale) - m_new_hi),
                                            hexp_g + k * 32 + 16);
                                    } else {
                                        simd_store(hinf, hexp_g + k * 32);
                                        simd_store(hinf, hexp_g + k * 32 + 16);
                                    }
                                }
                                floatv16 l0_lo = 0.0f, l0_hi = 0.0f;
                                floatv16 l1_lo = 0.0f, l1_hi = 0.0f;
                                floatv16 l2_lo = 0.0f, l2_hi = 0.0f;
                                floatv16 l3_lo = 0.0f, l3_hi = 0.0f;
                                // FA-71: 8-way exp128v2. Same 128-half
                                // blocks and l-sum; eight outstanding
                                // math-unit calls instead of one.
                                for (int c0 = 0; c0 < (AXK * 32) / 128; c0 += 8) {
                                    if (!(dbg48 & 0x800000)) {
                                        exp128v2(hexp_g + (c0 + 0) * 128,
                                                 hexp_g + (c0 + 0) * 128,
                                                 etmp48);
                                        exp128v2(hexp_g + (c0 + 1) * 128,
                                                 hexp_g + (c0 + 1) * 128,
                                                 etmp48 + 64);
                                        exp128v2(hexp_g + (c0 + 2) * 128,
                                                 hexp_g + (c0 + 2) * 128,
                                                 etmp48 + 128);
                                        exp128v2(hexp_g + (c0 + 3) * 128,
                                                 hexp_g + (c0 + 3) * 128,
                                                 etmp48 + 192);
                                        exp128v2(hexp_g + (c0 + 4) * 128,
                                                 hexp_g + (c0 + 4) * 128,
                                                 etmp48 + 256);
                                        exp128v2(hexp_g + (c0 + 5) * 128,
                                                 hexp_g + (c0 + 5) * 128,
                                                 etmp48 + 320);
                                        exp128v2(hexp_g + (c0 + 6) * 128,
                                                 hexp_g + (c0 + 6) * 128,
                                                 etmp48 + 384);
                                        exp128v2(hexp_g + (c0 + 7) * 128,
                                                 hexp_g + (c0 + 7) * 128,
                                                 etmp48 + 448);
                                    }
                                    for (int c = c0; c < c0 + 8; c++) {
                                    // v8e: branch-free 4-way l partial sums
                                    // (position-in-block indexed, no per-row
                                    // if/else).
                                    {
                                        halfv16 h0, h1;
                                        simd_load(h0, hexp_g + (c * 4 + 0) * 32);
                                        simd_load(h1, hexp_g + (c * 4 + 0) * 32 + 16);
                                        l0_lo = simd_add(l0_lo, simd_cvt_h2f(h0));
                                        l0_hi = simd_add(l0_hi, simd_cvt_h2f(h1));
                                        simd_load(h0, hexp_g + (c * 4 + 1) * 32);
                                        simd_load(h1, hexp_g + (c * 4 + 1) * 32 + 16);
                                        l1_lo = simd_add(l1_lo, simd_cvt_h2f(h0));
                                        l1_hi = simd_add(l1_hi, simd_cvt_h2f(h1));
                                        simd_load(h0, hexp_g + (c * 4 + 2) * 32);
                                        simd_load(h1, hexp_g + (c * 4 + 2) * 32 + 16);
                                        l2_lo = simd_add(l2_lo, simd_cvt_h2f(h0));
                                        l2_hi = simd_add(l2_hi, simd_cvt_h2f(h1));
                                        simd_load(h0, hexp_g + (c * 4 + 3) * 32);
                                        simd_load(h1, hexp_g + (c * 4 + 3) * 32 + 16);
                                        l3_lo = simd_add(l3_lo, simd_cvt_h2f(h0));
                                        l3_hi = simd_add(l3_hi, simd_cvt_h2f(h1));
                                    }
                                    }
                                }
                                l_new_lo = simd_add(
                                    l_new_lo,
                                    simd_add(simd_add(l0_lo, l1_lo),
                                             simd_add(l2_lo, l3_lo)));
                                l_new_hi = simd_add(
                                    l_new_hi,
                                    simd_add(simd_add(l0_hi, l1_hi),
                                             simd_add(l2_hi, l3_hi)));
                             }
                             *(floatv16 *)(m_next + g * 32) = m_new_lo;
                             *((floatv16 *)(m_next + g * 32) + 1) = m_new_hi;
                             *(floatv16 *)(l_next + g * 32) = l_new_lo;
                             *((floatv16 *)(l_next + g * 32) + 1) = l_new_hi;
                            // FA-48X v6 pipeline: PV(g-1) was issued async
                            // one group ago; it is waited + accumulated NOW,
                            // after this group's SIMD softmax, so the ACE
                            // matmul overlaps the SIMD softmax(g) (the four
                            // groups' softmaxes run back-to-back while the
                            // ACE queue drains the previous PV).
                            if (g > 0) {
                                if (!(dbg48 & 0x10000)) {
                                    ax_pv.wait_storeC(1);
                                }
                                // accumulate O(g-1) from scg(g-1) into O^T
                                int gp = g - 1;
                                float *scgp = (float *)outc2 + gp * BM * BN;
                                if (!(dbg48 & 0x8000)) {
                                for (int d = 0; d < 64; d++) {
                                    floatv16 vo, vr;
                                    simd_load(vo, scgp + d * 32);
                                    simd_load(vr,
                                              o_accum + d * 128 + gp * 32);
                                    simd_store(simd_add(vo, vr),
                                               o_accum + d * 128 + gp * 32);
                                    simd_load(vo, scgp + d * 32 + 16);
                                    simd_load(vr,
                                              o_accum + d * 128 + gp * 32 + 16);
                                    simd_store(simd_add(vo, vr),
                                               o_accum + d * 128 + gp * 32 + 16);
                                }
                                }
                            }
                            // issue THIS group's PV (async; waited next
                            // iteration or in the epilogue for g==3)
                            if (!(dbg48 & 0x10000)) {
                            auto tA = make_tensor<2>((half *)vt48,
                                                     {(size_t)64, (size_t)AXK});
                            auto tB = make_tensor<2>(
                                (half *)hexp_g, {(size_t)AXK, (size_t)32});
                            auto tC = make_tensor<2>((float *)scg,
                                                     {(size_t)64, (size_t)32});
                            ax_pv.compute_async<MatmulBlockConfig::M128_N32>(
                                tA, tB, true);
                            ax_pv.storeC_spm_async(tC);
                            }
                        }
                        // epilogue: wait the last PV (group 3) + accumulate
                        if (!(dbg48 & 0x10000)) {
                            ax_pv.wait_storeC(1);
                        }
                        {
                            int gp = 3;
                            float *scgp = (float *)outc2 + gp * BM * BN;
                            if (!(dbg48 & 0x8000)) {
                            for (int d = 0; d < 64; d++) {
                                floatv16 vo, vr;
                                simd_load(vo, scgp + d * 32);
                                simd_load(vr, o_accum + d * 128 + gp * 32);
                                simd_store(simd_add(vo, vr),
                                           o_accum + d * 128 + gp * 32);
                                simd_load(vo, scgp + d * 32 + 16);
                                simd_load(vr, o_accum + d * 128 + gp * 32 + 16);
                                simd_store(simd_add(vo, vr),
                                           o_accum + d * 128 + gp * 32 + 16);
                            }
                            }
                        }
                    }
                    // swap m/l pointers (the j-loop epilogue is skipped)
                    {
                        float *atmp = l_ptr;
                        l_ptr = l_next;
                        l_next = atmp;
                        atmp = m_ptr;
                        m_ptr = m_next;
                        m_next = atmp;
                    }
                    continue;
                }
                // ── end FA-48X ────────────────────────────────────────────
                // Transpose the contiguous paged-cache block(s) directly
                // from Global memory into SPM (FA-28: both pages of the pair
                // into kbuf2 tiles [0,BN) and [BN,2BN)). Keep the exact
                // scalar path when the hardware transpose engine cannot
                // serve this shape.
                {
                // kbase is declared at the j-loop level (FA-31 parity).
                if (args.dbg_stub & 8) {
                    halfv16 hz = (halfv16)0;
                    for (int z = 0; z < (fa28 ? 2 : 1) * BN * args.size_per_head; z += 16) {
                        simd_store(hz, kbase + z);
                    }
                } else if (fa28 && args.kscratch != nullptr) {
                    // FA-30: K tiles arrive pre-transposed from the GM
                    // scratch (phase 3), one [BK][BN] tile per (physical
                    // block, kv head). Plain memcpy replaces the per-pair
                    // hardware transpose; the zero-clear below still masks
                    // the unused tail columns of partial blocks (identical
                    // to the engine path: full blocks are copied, the
                    // garbage tail is then zeroed before the gemm).
                    if (kbuf2b != nullptr && k31_pending) {
                        // FA-31: this pair's K was issued async during the
                        // previous iteration; wait for both page copies.
                        memcpy_wait(k_next_handle[0]);
                        if (k31_pending_b) {
                            memcpy_wait(k_next_handle[1]);
                        }
                        k31_pending = false;
                        k31_pending_b = false;
                    } else {
                        // FA-48Y v7d: K^T tiles are staged at the batch-
                        // LOCAL block index (cur_block = j/BN), matching
                        // the phase-3 write (lb) and the shrunk scratch.
                        const half *ksc = (const half *)args.kscratch
                            + (cur_block * args.local_kv_head_num +
                               kv_head_idx) * tile_elems;
                        memcpy(kbase, ksc,
                               BN * args.size_per_head * sizeof(half));
                        if (has_page_b) {
                            const half *ksc_b = (const half *)args.kscratch
                                + ((cur_block + 1) * args.local_kv_head_num +
                                   kv_head_idx) * tile_elems;
                            memcpy(kbase + BN * args.size_per_head, ksc_b,
                                   BN * args.size_per_head * sizeof(half));
                        }
                        // FA-47: pages C/D land in the second half of kbuf2.
                        if (fa47 && has_page_c) {
                            const half *ksc_c = (const half *)args.kscratch
                                + ((cur_block + 2) * args.local_kv_head_num +
                                   kv_head_idx) * tile_elems;
                            memcpy(kbase + 2 * BN * args.size_per_head, ksc_c,
                                   BN * args.size_per_head * sizeof(half));
                        }
                        if (fa47 && has_page_d) {
                            const half *ksc_d = (const half *)args.kscratch
                                + ((cur_block + 3) * args.local_kv_head_num +
                                   kv_head_idx) * tile_elems;
                            memcpy(kbase + 3 * BN * args.size_per_head, ksc_d,
                                   BN * args.size_per_head * sizeof(half));
                        }
                    }
                } else {
                TransposeHandle transpose_handle;
                unsigned int transpose_status = check_transpose_async(
                    kbase, k_src, args.block_size, args.size_per_head,
                    sizeof(half), TransposeGlobalToSpm, transpose_handle);
                if (transpose_status == TRANSPOSE_ASYNC_SUCC) {
                    transpose_async(kbase, k_src, args.block_size,
                                    args.size_per_head, sizeof(half),
                                    TransposeGlobalToSpm, transpose_handle);
                    transpose_wait(transpose_handle);
                } else {
                    load_kv_cache(ktmp, (const half *)args.key_cache,
                                  ldm_block_table, cur_block, kv_head_idx,
                                  args.local_kv_head_num, args.block_size,
                                  args.size_per_head, cur_BN);
                    for (int t = 0; t < cur_BN; t++) {
                        for (int h = 0; h < args.size_per_head; h++) {
                            kbase[h * BN + t] =
                                ktmp[t * args.size_per_head + h];
                        }
                    }
                }
                if (fa28 && has_page_b) {
                    int cur_BN_b = MIN(BN, last_k - j - BN);
                    TransposeHandle transpose_handle_b;
                    unsigned int transpose_status_b = check_transpose_async(
                        kbase + BN * args.size_per_head, k_src_b,
                        args.block_size, args.size_per_head, sizeof(half),
                        TransposeGlobalToSpm, transpose_handle_b);
                    if (transpose_status_b == TRANSPOSE_ASYNC_SUCC) {
                        transpose_async(kbase + BN * args.size_per_head,
                                        k_src_b, args.block_size,
                                        args.size_per_head, sizeof(half),
                                        TransposeGlobalToSpm,
                                        transpose_handle_b);
                        transpose_wait(transpose_handle_b);
                    } else {
                        load_kv_cache(ktmp, (const half *)args.key_cache,
                                      ldm_block_table, cur_block + 1,
                                      kv_head_idx, args.local_kv_head_num,
                                      args.block_size, args.size_per_head,
                                      cur_BN_b);
                        for (int t = 0; t < cur_BN_b; t++) {
                            for (int h = 0; h < args.size_per_head; h++) {
                                kbase[BN * args.size_per_head +
                                      h * BN + t] =
                                    ktmp[t * args.size_per_head + h];
                            }
                        }
                    }
                }
                }
                }

                // clear unused columns of the K tile(s)
                if (fa28) {
                    int cur_BN_b = has_page_b
                        ? MIN(BN, last_k - j - BN) : 0;
                    int cur_BN_c = has_page_c
                        ? MIN(BN, last_k - j - 2 * BN) : 0;
                    int cur_BN_d = has_page_d
                        ? MIN(BN, last_k - j - 3 * BN) : 0;
                    for (int h = 0; h < args.size_per_head; h++) {
                        for (int c = cur_BN; c < BN; c++) {
                            kbase[h * BN + c] = 0;
                        }
                        for (int c = cur_BN_b; c < BN; c++) {
                            kbase[BN * args.size_per_head + h * BN + c] = 0;
                        }
                        if (fa47) {
                            for (int c = cur_BN_c; c < BN; c++) {
                                kbase[2 * BN * args.size_per_head + h * BN + c] = 0;
                            }
                            for (int c = cur_BN_d; c < BN; c++) {
                                kbase[3 * BN * args.size_per_head + h * BN + c] = 0;
                            }
                        }
                    }
                } else if (cur_BN < BN) {
                    for (int h = 0; h < args.size_per_head; h++) {
                        for (int c = cur_BN; c < BN; c++) {
                            kbuf[h * BN + c] = 0;
                        }
                    }
                }

                // FA-27f/FA-28: hoist the V tiles out of the sub loop and
                // issue them as async GM->SPM DMA so they overlap sub 0's
                // QK gemm + softmax. ktmp (=vbuf) is dead after the K
                // transpose above; vbuf2 is the dedicated 2nd tile.
                // tile_blocks=2 now loads V once per KV page instead of
                // twice (FA-28: both pages of the pair, both head-dim
                // halves: 4 loads, one handle each). Non-fa27f shapes keep
                // the exact legacy blocking per-hb load.
                const int gemm_bn = 32;
                half *vbuf = fa47 ? vbuf3 : ktmp;
                half *vbuf1 = fa47 ? vbuf4 : vbuf2;
                bool vload_async = false;
                if (fa47 && !(args.dbg_stub & 4) && !(args.dbg_stub & 16)) {
                    // FA-47: 4 pages x 2 head-dim halves = 8 async V loads.
                    // vbuf (hb0) and vbuf1 (hb1) each hold 4 pages x 32
                    // half-cols contiguously: [page A|B|C|D][32 cols].
                    int cur_BN_b = has_page_b ? MIN(BN, last_k - j - BN) : 0;
                    int cur_BN_c = has_page_c ? MIN(BN, last_k - j - 2 * BN) : 0;
                    int cur_BN_d = has_page_d ? MIN(BN, last_k - j - 3 * BN) : 0;
                    unsigned int st0 = check_memcpy_async(
                        vbuf1, v_cache_base, cur_BN * gemm_bn * sizeof(half),
                        gemm_bn * sizeof(half),
                        {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                        MemcpyGlobalToSpm, v_get_handle);
                    unsigned int st1 = 0, st2 = 0, st3 = 0;
                    unsigned int st4 = 0, st5 = 0, st6 = 0, st7 = 0;
                    if (has_page_b) {
                        st1 = check_memcpy_async(
                            vbuf1 + BN * gemm_bn, v_cache_base_b,
                            cur_BN_b * gemm_bn * sizeof(half),
                            gemm_bn * sizeof(half),
                            {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                            MemcpyGlobalToSpm, v_get_handle2);
                    }
                    if (has_page_c) {
                        st2 = check_memcpy_async(
                            vbuf1 + 2 * BN * gemm_bn, v_cache_base_c,
                            cur_BN_c * gemm_bn * sizeof(half),
                            gemm_bn * sizeof(half),
                            {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                            MemcpyGlobalToSpm, v_get_handle3);
                    }
                    if (has_page_d) {
                        st3 = check_memcpy_async(
                            vbuf1 + 3 * BN * gemm_bn, v_cache_base_d,
                            cur_BN_d * gemm_bn * sizeof(half),
                            gemm_bn * sizeof(half),
                            {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                            MemcpyGlobalToSpm, v_get_handle4);
                    }
                    st4 = check_memcpy_async(
                        vbuf, v_cache_base + gemm_bn,
                        cur_BN * gemm_bn * sizeof(half),
                        gemm_bn * sizeof(half),
                        {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                        MemcpyGlobalToSpm, v_get_handle5);
                    if (has_page_b) {
                        st5 = check_memcpy_async(
                            vbuf + BN * gemm_bn, v_cache_base_b + gemm_bn,
                            cur_BN_b * gemm_bn * sizeof(half),
                            gemm_bn * sizeof(half),
                            {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                            MemcpyGlobalToSpm, v_get_handle6);
                    }
                    if (has_page_c) {
                        st6 = check_memcpy_async(
                            vbuf + 2 * BN * gemm_bn, v_cache_base_c + gemm_bn,
                            cur_BN_c * gemm_bn * sizeof(half),
                            gemm_bn * sizeof(half),
                            {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                            MemcpyGlobalToSpm, v_get_handle7);
                    }
                    if (has_page_d) {
                        st7 = check_memcpy_async(
                            vbuf + 3 * BN * gemm_bn, v_cache_base_d + gemm_bn,
                            cur_BN_d * gemm_bn * sizeof(half),
                            gemm_bn * sizeof(half),
                            {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                            MemcpyGlobalToSpm, v_get_handle8);
                    }
                    if (st0 == MEMCPY_ASYNC_SUCC && st4 == MEMCPY_ASYNC_SUCC &&
                        (!has_page_b || st1 == MEMCPY_ASYNC_SUCC) &&
                        (!has_page_c || st2 == MEMCPY_ASYNC_SUCC) &&
                        (!has_page_d || st3 == MEMCPY_ASYNC_SUCC) &&
                        (!has_page_b || st5 == MEMCPY_ASYNC_SUCC) &&
                        (!has_page_c || st6 == MEMCPY_ASYNC_SUCC) &&
                        (!has_page_d || st7 == MEMCPY_ASYNC_SUCC)) {
                        vload_async = true;
                        memcpy_async(vbuf1, v_cache_base,
                                     cur_BN * gemm_bn * sizeof(half),
                                     gemm_bn * sizeof(half),
                                     {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                     MemcpyGlobalToSpm, v_get_handle);
                        if (has_page_b) {
                            memcpy_async(vbuf1 + BN * gemm_bn, v_cache_base_b,
                                         cur_BN_b * gemm_bn * sizeof(half),
                                         gemm_bn * sizeof(half),
                                         {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                         MemcpyGlobalToSpm, v_get_handle2);
                        }
                        if (has_page_c) {
                            memcpy_async(vbuf1 + 2 * BN * gemm_bn, v_cache_base_c,
                                         cur_BN_c * gemm_bn * sizeof(half),
                                         gemm_bn * sizeof(half),
                                         {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                         MemcpyGlobalToSpm, v_get_handle3);
                        }
                        if (has_page_d) {
                            memcpy_async(vbuf1 + 3 * BN * gemm_bn, v_cache_base_d,
                                         cur_BN_d * gemm_bn * sizeof(half),
                                         gemm_bn * sizeof(half),
                                         {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                         MemcpyGlobalToSpm, v_get_handle4);
                        }
                        memcpy_async(vbuf, v_cache_base + gemm_bn,
                                     cur_BN * gemm_bn * sizeof(half),
                                     gemm_bn * sizeof(half),
                                     {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                     MemcpyGlobalToSpm, v_get_handle5);
                        if (has_page_b) {
                            memcpy_async(vbuf + BN * gemm_bn,
                                         v_cache_base_b + gemm_bn,
                                         cur_BN_b * gemm_bn * sizeof(half),
                                         gemm_bn * sizeof(half),
                                         {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                         MemcpyGlobalToSpm, v_get_handle6);
                        }
                        if (has_page_c) {
                            memcpy_async(vbuf + 2 * BN * gemm_bn,
                                         v_cache_base_c + gemm_bn,
                                         cur_BN_c * gemm_bn * sizeof(half),
                                         gemm_bn * sizeof(half),
                                         {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                         MemcpyGlobalToSpm, v_get_handle7);
                        }
                        if (has_page_d) {
                            memcpy_async(vbuf + 3 * BN * gemm_bn,
                                         v_cache_base_d + gemm_bn,
                                         cur_BN_d * gemm_bn * sizeof(half),
                                         gemm_bn * sizeof(half),
                                         {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                         MemcpyGlobalToSpm, v_get_handle8);
                        }
                    }
                    if (!vload_async) {
                        // fallback: blocking loads, pad rows beyond cur_BN2.
                        memcpy_stride(vbuf1, v_cache_base,
                                      cur_BN * gemm_bn * sizeof(half),
                                      gemm_bn * sizeof(half),
                                      {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        if (has_page_b) {
                            memcpy_stride(vbuf1 + BN * gemm_bn, v_cache_base_b,
                                          cur_BN_b * gemm_bn * sizeof(half),
                                          gemm_bn * sizeof(half),
                                          {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        }
                        if (has_page_c) {
                            memcpy_stride(vbuf1 + 2 * BN * gemm_bn, v_cache_base_c,
                                          cur_BN_c * gemm_bn * sizeof(half),
                                          gemm_bn * sizeof(half),
                                          {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        }
                        if (has_page_d) {
                            memcpy_stride(vbuf1 + 3 * BN * gemm_bn, v_cache_base_d,
                                          cur_BN_d * gemm_bn * sizeof(half),
                                          gemm_bn * sizeof(half),
                                          {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        }
                        memcpy_stride(vbuf, v_cache_base + gemm_bn,
                                      cur_BN * gemm_bn * sizeof(half),
                                      gemm_bn * sizeof(half),
                                      {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        if (has_page_b) {
                            memcpy_stride(vbuf + BN * gemm_bn,
                                          v_cache_base_b + gemm_bn,
                                          cur_BN_b * gemm_bn * sizeof(half),
                                          gemm_bn * sizeof(half),
                                          {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        }
                        if (has_page_c) {
                            memcpy_stride(vbuf + 2 * BN * gemm_bn,
                                          v_cache_base_c + gemm_bn,
                                          cur_BN_c * gemm_bn * sizeof(half),
                                          gemm_bn * sizeof(half),
                                          {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        }
                        if (has_page_d) {
                            memcpy_stride(vbuf + 3 * BN * gemm_bn,
                                          v_cache_base_d + gemm_bn,
                                          cur_BN_d * gemm_bn * sizeof(half),
                                          gemm_bn * sizeof(half),
                                          {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        }
                        for (int r = cur_BN2 * gemm_bn; r < 4 * BN * gemm_bn; r++) {
                            vbuf[r] = 0;
                            vbuf1[r] = 0;
                        }
                    }
                } else if (fa28 && !(args.dbg_stub & 4) && !(args.dbg_stub & 16)) {
                    int cur_BN_b = has_page_b ? MIN(BN, last_k - j - BN) : 0;
                    unsigned int st0 = check_memcpy_async(
                        vbuf1, v_cache_base, cur_BN * gemm_bn * sizeof(half),
                        gemm_bn * sizeof(half),
                        {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                        MemcpyGlobalToSpm, v_get_handle);
                    unsigned int st1 = 0, st2 = 0, st3 = 0;
                    if (has_page_b) {
                        st1 = check_memcpy_async(
                            vbuf1 + BN * gemm_bn, v_cache_base_b,
                            cur_BN_b * gemm_bn * sizeof(half),
                            gemm_bn * sizeof(half),
                            {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                            MemcpyGlobalToSpm, v_get_handle2);
                    }
                    st2 = check_memcpy_async(
                        vbuf, v_cache_base + gemm_bn,
                        cur_BN * gemm_bn * sizeof(half),
                        gemm_bn * sizeof(half),
                        {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                        MemcpyGlobalToSpm, v_get_handle3);
                    if (has_page_b) {
                        st3 = check_memcpy_async(
                            vbuf + BN * gemm_bn, v_cache_base_b + gemm_bn,
                            cur_BN_b * gemm_bn * sizeof(half),
                            gemm_bn * sizeof(half),
                            {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                            MemcpyGlobalToSpm, v_get_handle4);
                    }
                    if (st0 == MEMCPY_ASYNC_SUCC && st2 == MEMCPY_ASYNC_SUCC &&
                        (!has_page_b ||
                         (st1 == MEMCPY_ASYNC_SUCC && st3 == MEMCPY_ASYNC_SUCC))) {
                        vload_async = true;
                        memcpy_async(vbuf1, v_cache_base,
                                     cur_BN * gemm_bn * sizeof(half),
                                     gemm_bn * sizeof(half),
                                     {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                     MemcpyGlobalToSpm, v_get_handle);
                        if (has_page_b) {
                            memcpy_async(vbuf1 + BN * gemm_bn, v_cache_base_b,
                                         cur_BN_b * gemm_bn * sizeof(half),
                                         gemm_bn * sizeof(half),
                                         {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                         MemcpyGlobalToSpm, v_get_handle2);
                        }
                        memcpy_async(vbuf, v_cache_base + gemm_bn,
                                     cur_BN * gemm_bn * sizeof(half),
                                     gemm_bn * sizeof(half),
                                     {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                     MemcpyGlobalToSpm, v_get_handle3);
                        if (has_page_b) {
                            memcpy_async(vbuf + BN * gemm_bn,
                                         v_cache_base_b + gemm_bn,
                                         cur_BN_b * gemm_bn * sizeof(half),
                                         gemm_bn * sizeof(half),
                                         {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                         MemcpyGlobalToSpm, v_get_handle4);
                        }
                    }
                    if (!vload_async) {
                        // fallback: blocking loads, pad rows beyond cur_BN2.
                        memcpy_stride(vbuf1, v_cache_base,
                                      cur_BN * gemm_bn * sizeof(half),
                                      gemm_bn * sizeof(half),
                                      {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        if (has_page_b) {
                            memcpy_stride(vbuf1 + BN * gemm_bn, v_cache_base_b,
                                          cur_BN_b * gemm_bn * sizeof(half),
                                          gemm_bn * sizeof(half),
                                          {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        }
                        memcpy_stride(vbuf, v_cache_base + gemm_bn,
                                      cur_BN * gemm_bn * sizeof(half),
                                      gemm_bn * sizeof(half),
                                      {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        if (has_page_b) {
                            memcpy_stride(vbuf + BN * gemm_bn,
                                          v_cache_base_b + gemm_bn,
                                          cur_BN_b * gemm_bn * sizeof(half),
                                          gemm_bn * sizeof(half),
                                          {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        }
                        for (int r = cur_BN2 * gemm_bn; r < 2 * BN * gemm_bn; r++) {
                            vbuf[r] = 0;
                            vbuf1[r] = 0;
                        }
                    }
                } else if (fa27f && !(args.dbg_stub & 4) && !(args.dbg_stub & 16)) {
                    unsigned int vst = check_memcpy_async(
                        vbuf, v_cache_base, cur_BN * gemm_bn * sizeof(half),
                        gemm_bn * sizeof(half),
                        {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                        MemcpyGlobalToSpm, v_get_handle);
                    unsigned int vst2 = check_memcpy_async(
                        vbuf1, v_cache_base + gemm_bn,
                        cur_BN * gemm_bn * sizeof(half),
                        gemm_bn * sizeof(half),
                        {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                        MemcpyGlobalToSpm, v_get_handle2);
                    if (vst == MEMCPY_ASYNC_SUCC && vst2 == MEMCPY_ASYNC_SUCC) {
                        vload_async = true;
                        memcpy_async(vbuf, v_cache_base,
                                     cur_BN * gemm_bn * sizeof(half),
                                     gemm_bn * sizeof(half),
                                     {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                     MemcpyGlobalToSpm, v_get_handle);
                        memcpy_async(vbuf1, v_cache_base + gemm_bn,
                                     cur_BN * gemm_bn * sizeof(half),
                                     gemm_bn * sizeof(half),
                                     {0, (args.size_per_head - gemm_bn) * sizeof(half)},
                                     MemcpyGlobalToSpm, v_get_handle2);
                    }
                    if (!vload_async) {
                        // fallback: blocking loads, both tiles, pad now.
                        memcpy_stride(vbuf, v_cache_base,
                                      cur_BN * gemm_bn * sizeof(half),
                                      gemm_bn * sizeof(half),
                                      {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        memcpy_stride(vbuf1, v_cache_base + gemm_bn,
                                      cur_BN * gemm_bn * sizeof(half),
                                      gemm_bn * sizeof(half),
                                      {0, (args.size_per_head - gemm_bn) * sizeof(half)});
                        if (cur_BN < BN) {
                            for (int r = cur_BN * gemm_bn; r < BN * gemm_bn; r++) {
                                vbuf[r] = 0;
                                vbuf1[r] = 0;
                            }
                        }
                    }
                }

                // FA-17: run the tile body once per 128-row sub-block. The K
                // tile above (transposed into kbuf) is shared by all
                // sub-blocks; outc/p_score are reused sequentially (each
                // sub's softmax feeds its own PV gemm before the next sub
                // overwrites them), so no extra SPM is needed beyond the
                // doubled row-state buffers. tile_blocks == 1 everywhere
                // except the whitelisted prefill shapes -> exact legacy
                // behavior there (including decode and chunked prefill).
                for (int sub = 0; sub < tile_blocks; sub++) {
                int sub_BM = MIN(BM, cur_BM - sub * BM);
                if (sub_BM <= 0) continue;
                int q_row_off = sub * BM;

                // gemm: Q * K^T = score, using teco_hal matmul M2=128, N2=32
                // FA-28: both pages of the pair are scored into the two
                // halves of outc2 (contiguous 64-col rows for the softmax);
                // two independent M128_N32 K=64 calls share one Matmul
                // object and one wait.
                if (args.dbg_stub & 1) {
                    floatv16 fz = 0.0f;
                    int qk_cols = fa28 ? (fa47 ? 4 * BN : 2 * BN) : BN;
                    float *qk_out = fa28 ? outc2 : outc;
                    for (int z = 0; z < sub_BM * qk_cols; z += 16) {
                        simd_store(fz, qk_out + z);
                    }
                } else if (fa47) {
                {
                    // FA-47: 4 M128_N32 QK gemms into the 4 outc2 quadrants
                    // (each BM*BN floats, contiguous per ACE writeback).
                    MatmulConfig matmul_cfg;
                    Matmul matmul(matmul_cfg);
                    auto tensorQ = make_tensor<2>((half *)qbuf + q_row_off * args.size_per_head,
                        {static_cast<size_t>(BM), static_cast<size_t>(args.size_per_head)});
                    for (int pg = 0; pg < 4; pg++) {
                        auto tensorK = make_tensor<2>(
                            (half *)fa28_kbuf_cur + pg * BN * args.size_per_head,
                            {static_cast<size_t>(args.size_per_head), static_cast<size_t>(BN)});
                        auto tensorC = make_tensor<2>((float *)outc2 + pg * BM * BN,
                            {static_cast<size_t>(BM), static_cast<size_t>(BN)});
                        matmul.compute_async<MatmulBlockConfig::M128_N32>(
                            tensorQ, tensorK, /*is_lastk=*/true);
                        matmul.storeC_spm_async(tensorC);
                    }
                    matmul.wait_storeC(4);
                }

                } else if (fa28) {
                {
                    MatmulConfig matmul_cfg;
                    Matmul matmul(matmul_cfg);
                    auto tensorQ = make_tensor<2>((half *)qbuf + q_row_off * args.size_per_head,
                        {static_cast<size_t>(BM), static_cast<size_t>(args.size_per_head)});
                    auto tensorK = make_tensor<2>((half *)fa28_kbuf_cur,
                        {static_cast<size_t>(args.size_per_head), static_cast<size_t>(BN)});
                    auto tensorC = make_tensor<2>((float *)outc2,
                        {static_cast<size_t>(BM), static_cast<size_t>(BN)});
                    matmul.compute_async<MatmulBlockConfig::M128_N32>(
                        tensorQ, tensorK, /*is_lastk=*/true);
                    matmul.storeC_spm_async(tensorC);
                    auto tensorKb = make_tensor<2>(
                        (half *)fa28_kbuf_cur + BN * args.size_per_head,
                        {static_cast<size_t>(args.size_per_head), static_cast<size_t>(BN)});
                    // NOTE: storeC writes each C tile CONTIGUOUSLY at the
                    // pointer (strides ignored by the ACE writeback), so the
                    // two 32-col tiles live in disjoint BM*BN regions of
                    // outc2: page A rows at r*BN, page B rows at BM*BN+r*BN.
                    auto tensorCb = make_tensor<2>((float *)outc2 + BM * BN,
                        {static_cast<size_t>(BM), static_cast<size_t>(BN)});
                    matmul.compute_async<MatmulBlockConfig::M128_N32>(
                        tensorQ, tensorKb, /*is_lastk=*/true);
                    matmul.storeC_spm_async(tensorCb);
                    matmul.wait_storeC(2);
                    // FA-31: issue the NEXT pair's K memcpy (into the other
                    // ping-pong buffer) right after this pair's QK gemm, so
                    // the copy overlaps this sub-block's softmax+PV and any
                    // remaining sub-blocks. Waited at the next loop top.
                    // The next pair covers the two following blocks; its
                    // page-B presence mirrors the next iteration's test.
                    if (sub == 0 && kbuf2b != nullptr && !(args.dbg_stub & 8)) {
                        int next_j = j + 2 * BN;
                        if (next_j < last_k) {
                            int n_has_page_b = (next_j + BN) < last_k;
                            // FA-48Y v7d: LOCAL block index (phase-3 lb).
                            int nblock_id = cur_block + 2;
                            int nblock_id_b = n_has_page_b
                                ? cur_block + 3 : 0;
                            half *kbase_next = (k31_parity == 0) ? kbuf2b : kbuf2;
                            const half *ksc = (const half *)args.kscratch
                                + (nblock_id * args.local_kv_head_num +
                                   kv_head_idx) * tile_elems;
                            memcpy_async(kbase_next, ksc,
                                         BN * args.size_per_head * sizeof(half),
                                         MemcpyGlobalToSpm, k_next_handle[0]);
                            if (n_has_page_b) {
                                const half *ksc_b = (const half *)args.kscratch
                                    + (nblock_id_b * args.local_kv_head_num +
                                       kv_head_idx) * tile_elems;
                                memcpy_async(
                                    kbase_next + BN * args.size_per_head,
                                    ksc_b,
                                    BN * args.size_per_head * sizeof(half),
                                    MemcpyGlobalToSpm, k_next_handle[1]);
                            }
                            k31_pending = true;
                            k31_pending_b = n_has_page_b;
                            k31_parity = 1 - k31_parity;
                        }
                    }
                }

                } else {
                {
                    MatmulConfig matmul_cfg;
                    Matmul matmul(matmul_cfg);
                    auto tensorQ = make_tensor<2>((half *)qbuf + q_row_off * args.size_per_head,
                        {static_cast<size_t>(BM), static_cast<size_t>(args.size_per_head)});
                    auto tensorK = make_tensor<2>((half *)kbuf,
                        {static_cast<size_t>(args.size_per_head), static_cast<size_t>(BN)});
                    auto tensorC = make_tensor<2>((float *)outc,
                        {static_cast<size_t>(BM), static_cast<size_t>(BN)});

                    matmul.compute_async<MatmulBlockConfig::M128_N32>(
                        tensorQ, tensorK, /*is_lastk=*/true);
                    matmul.storeC_spm_async(tensorC);
                    matmul.wait_storeC(1);
                }

                }

                // Step A: online softmax
                if (!(args.dbg_stub & 2)) {
                // FA-08: single-load fused softmax (prefill/non-direct path).
                // FA-01 refinement: each row's RAW scores are loaded from SPM
                // exactly ONCE into registers; row max, exp, redsum and the
                // half store reuse the loaded vectors (SPM load traffic halved
                // vs the two-pass FA-01). m_new/scale/p_score bit-identical to
                // FA-01; l uses the b22-validated single-redsum-per-row form
                // (<=1-2 ulp vs FA-01's per-chunk redsum; atol=2e-2; safe).
                {
                    floatv16 vscale = args.softmax_scale;
                    // FA-17: allowed columns are relative to the TASK row
                    // (q_start + i + q_row_off + row), not the sub-block row.
                    int rel_q_off = q_start + i + q_row_off - j + 1;  // allowed = rel_q_off + row
                    // FA-22: fully-valid rows (allowed == 32 == cur_BN) batch
                    // their exp through the half-precision exp128v2 unit: 4
                    // rows (128 halves) are staged per call (~265 cycles)
                    // instead of 2 float vexp per row (200 cycles each): exp
                    // time drops ~12x. exp inputs are computed in float and
                    // rounded to half (<=~1e-3 rel err); results land in an
                    // aligned scratch, are copied to p_score and summed back
                    // to float for l. Boundary rows (allowed < 32) keep the
                    // exact FA-08 float path below (bit-identical).
                    int batch_lo = sub_BM;   // first batch row (sub_BM = none)
                    int batch_cnt = 0;
                    // FA-23b: the scale s = exp(m_old - m_new) of the batch
                    // rows is ALSO computed through exp128v2 at the end of
                    // the sub-tile (128 halves = one call; inputs staged per
                    // row, l updates deferred to the same pass). Rows where
                    // m is unchanged stage 0 -> exp(0) == 1.0f, matching
                    // FA-23a exactly (half-rounded, <=1e-3 rel err).
                    // FA-47: the 4-page batched path issues FOUR exp128v2
                    // calls (exp_tmp + 0/64/128/192 ints; 64 ints of scratch
                    // per call) -> size 256 ints (the 2-page FA-28 path only
                    // reaches +64, exactly fitting 128).
                    __attribute__((aligned(256))) int exp_tmp[256];
                    __attribute__((aligned(256))) half scale_in[128];
                    __attribute__((aligned(256))) half scale_out[128];
                    float l_scratch[128];
                    if (fa47) {
                    // FA-47: 4-page softmax. Each row-visit covers cols =
                    // 4*BN = 128 score columns (pages j..j+3, contiguous
                    // in outc2 quadrants). Fully-valid rows (rel_q_off +
                    // row >= 128) batch 4 rows x 128 cols = 512 halves
                    // through FOUR exp128v2 calls (one per 128-half page
                    // block); l uses one merged redsum per row. Boundary/
                    // masked rows use a generalized legacy path over
                    // cols=128 with allowed in [0, 128).
                    __attribute__((aligned(256))) half exp_in[16 * BN];
                    __attribute__((aligned(256))) half exp_out[16 * BN];
                    const int cols = 4 * BN;
                    int row = 0;
                    while (row < sub_BM) {
                        if (args.hexp && rel_q_off + row >= cols &&
                            cur_BN2 >= cols && sub_BM - row >= 4) {
                            // stage 4 fully-valid rows x 128 cols: loads,
                            // max-reduce over 8 vectors, m_new, scale input,
                            // then half exp inputs (4 calls' worth)
                            if (batch_lo == sub_BM) batch_lo = row;
                            for (int g = 0; g < 4; g++) {
                                int r = row + g;
                                float *src_row = outc2 + r * BN;
                                float *src_row_b = outc2 + BM * BN + r * BN;
                                float *src_row_c = outc2 + 2 * BM * BN + r * BN;
                                float *src_row_d = outc2 + 3 * BM * BN + r * BN;
                                floatv16 v0, v1, v2, v3, v4, v5, v6, v7;
                                simd_load(v0, src_row);
                                simd_load(v1, src_row + 16);
                                simd_load(v2, src_row_b);
                                simd_load(v3, src_row_b + 16);
                                simd_load(v4, src_row_c);
                                simd_load(v5, src_row_c + 16);
                                simd_load(v6, src_row_d);
                                simd_load(v7, src_row_d + 16);
                                floatv16 vmax16 = simd_max(
                                    simd_max(simd_max(v0, v1),
                                             simd_max(v2, v3)),
                                    simd_max(simd_max(v4, v5),
                                             simd_max(v6, v7)));
                                float m_raw = -FLT_MAX;
                                {
                                    float e0 = simd_vextfs(vmax16, 0);
                                    float e1 = simd_vextfs(vmax16, 1);
                                    float e2 = simd_vextfs(vmax16, 2);
                                    float e3 = simd_vextfs(vmax16, 3);
                                    float e4 = simd_vextfs(vmax16, 4);
                                    float e5 = simd_vextfs(vmax16, 5);
                                    float e6 = simd_vextfs(vmax16, 6);
                                    float e7 = simd_vextfs(vmax16, 7);
                                    float e8 = simd_vextfs(vmax16, 8);
                                    float e9 = simd_vextfs(vmax16, 9);
                                    float e10 = simd_vextfs(vmax16, 10);
                                    float e11 = simd_vextfs(vmax16, 11);
                                    float e12 = simd_vextfs(vmax16, 12);
                                    float e13 = simd_vextfs(vmax16, 13);
                                    float e14 = simd_vextfs(vmax16, 14);
                                    float e15 = simd_vextfs(vmax16, 15);
                                    float m01 = MAX(e0, e1), m23 = MAX(e2, e3);
                                    float m45 = MAX(e4, e5), m67 = MAX(e6, e7);
                                    float m89 = MAX(e8, e9), mAB = MAX(e10, e11);
                                    float mCD = MAX(e12, e13), mEF = MAX(e14, e15);
                                    float m03 = MAX(m01, m23), m47 = MAX(m45, m67);
                                    float m8B = MAX(m89, mAB), mCF = MAX(mCD, mEF);
                                    float m07 = MAX(m03, m47), m8F = MAX(m8B, mCF);
                                    m_raw = MAX(m07, m8F);
                                }
                                float m_new = MAX(m_ptr[q_row_off + r],
                                                  args.softmax_scale * m_raw);
                                m_new = MAX(m_new, 0.0f);
                                m_next[q_row_off + r] = m_new;
                                // stage scale input (deferred to sub-tile end)
                                scale_in[batch_cnt + g] =
                                    (half)(m_ptr[q_row_off + r] - m_new);
                                // stage exp inputs as half (row g of the batch)
                                halfv16 h0 = (halfv16)(simd_mul(v0, vscale) - m_new);
                                halfv16 h1 = (halfv16)(simd_mul(v1, vscale) - m_new);
                                halfv16 h2 = (halfv16)(simd_mul(v2, vscale) - m_new);
                                halfv16 h3 = (halfv16)(simd_mul(v3, vscale) - m_new);
                                halfv16 h4 = (halfv16)(simd_mul(v4, vscale) - m_new);
                                halfv16 h5 = (halfv16)(simd_mul(v5, vscale) - m_new);
                                halfv16 h6 = (halfv16)(simd_mul(v6, vscale) - m_new);
                                halfv16 h7 = (halfv16)(simd_mul(v7, vscale) - m_new);
                                simd_store(h0, exp_in + g * cols);
                                simd_store(h1, exp_in + g * cols + 16);
                                simd_store(h2, exp_in + g * cols + 32);
                                simd_store(h3, exp_in + g * cols + 48);
                                simd_store(h4, exp_in + g * cols + 64);
                                simd_store(h5, exp_in + g * cols + 80);
                                simd_store(h6, exp_in + g * cols + 96);
                                simd_store(h7, exp_in + g * cols + 112);
                            }
                            // batch exp: 4 x 128 halves (pages A..D)
                            exp128v2(exp_in, exp_out, exp_tmp);
                            exp128v2(exp_in + 4 * BN, exp_out + 4 * BN,
                                     exp_tmp + 64);
                            exp128v2(exp_in + 8 * BN, exp_out + 8 * BN,
                                     exp_tmp + 128);
                            exp128v2(exp_in + 12 * BN, exp_out + 12 * BN,
                                     exp_tmp + 192);
                            for (int g = 0; g < 4; g++) {
                                int r = row + g;
                                half *dst_row = p_score2 + r * cols;
                                halfv16 e0, e1, e2, e3, e4, e5, e6, e7;
                                simd_load(e0, exp_out + g * cols);
                                simd_load(e1, exp_out + g * cols + 16);
                                simd_load(e2, exp_out + g * cols + 32);
                                simd_load(e3, exp_out + g * cols + 48);
                                simd_load(e4, exp_out + g * cols + 64);
                                simd_load(e5, exp_out + g * cols + 80);
                                simd_load(e6, exp_out + g * cols + 96);
                                simd_load(e7, exp_out + g * cols + 112);
                                simd_store(e0, dst_row);
                                simd_store(e1, dst_row + 16);
                                simd_store(e2, dst_row + 32);
                                simd_store(e3, dst_row + 48);
                                simd_store(e4, dst_row + 64);
                                simd_store(e5, dst_row + 80);
                                simd_store(e6, dst_row + 96);
                                simd_store(e7, dst_row + 112);
                                // single merged redsum per row (same
                                // (pair)+(pair) association as FA-28)
                                halfv16 esum01 = e0;
                                esum01 += e1;
                                halfv16 esum23 = e2;
                                esum23 += e3;
                                halfv16 esum45 = e4;
                                esum45 += e5;
                                halfv16 esum67 = e6;
                                esum67 += e7;
                                esum01 += esum23;
                                esum45 += esum67;
                                esum01 += esum45;
                                l_scratch[batch_cnt + g] =
                                    simd_redsum((floatv16)esum01);
                            }
                            batch_cnt += 4;
                            row += 4;
                            continue;
                        }
                        // legacy single-row path over 128 columns
                        // (boundary/masked/tail rows, allowed in [0, 128))
                        int r = row;
                        float *src_row = outc2 + r * BN;
                        float *src_row_b = outc2 + BM * BN + r * BN;
                        float *src_row_c = outc2 + 2 * BM * BN + r * BN;
                        float *src_row_d = outc2 + 3 * BM * BN + r * BN;
                        half *dst_row = p_score2 + r * cols;
                        int allowed = rel_q_off + r;
                        if (allowed < 0) allowed = 0;
                        if (allowed > cur_BN2) allowed = cur_BN2;
                        floatv16 v0 = 0.0f, v1 = 0.0f, v2 = 0.0f, v3 = 0.0f;
                        floatv16 v4 = 0.0f, v5 = 0.0f, v6 = 0.0f, v7 = 0.0f;
                        int nv = 0;
                        if (allowed >= 16) {
                            simd_load(v0, src_row); nv = 1;
                        }
                        if (allowed >= 32) {
                            simd_load(v1, src_row + 16); nv = 2;
                        }
                        if (allowed >= 48) {
                            simd_load(v2, src_row_b); nv = 3;
                        }
                        if (allowed >= 64) {
                            simd_load(v3, src_row_b + 16); nv = 4;
                        }
                        if (allowed >= 80) {
                            simd_load(v4, src_row_c); nv = 5;
                        }
                        if (allowed >= 96) {
                            simd_load(v5, src_row_c + 16); nv = 6;
                        }
                        if (allowed >= 112) {
                            simd_load(v6, src_row_d); nv = 7;
                        }
                        if (allowed >= 128) {
                            simd_load(v7, src_row_d + 16); nv = 8;
                        }
                        floatv16 vmax16 = -FLT_MAX;
                        if (nv >= 1) vmax16 = v0;
                        if (nv >= 2) vmax16 = simd_max(vmax16, v1);
                        if (nv >= 3) vmax16 = simd_max(vmax16, v2);
                        if (nv >= 4) vmax16 = simd_max(vmax16, v3);
                        if (nv >= 5) vmax16 = simd_max(vmax16, v4);
                        if (nv >= 6) vmax16 = simd_max(vmax16, v5);
                        if (nv >= 7) vmax16 = simd_max(vmax16, v6);
                        if (nv >= 8) vmax16 = simd_max(vmax16, v7);
                        float m_raw = -FLT_MAX;
                        if (nv >= 1) {
                            float e0 = simd_vextfs(vmax16, 0);
                            float e1 = simd_vextfs(vmax16, 1);
                            float e2 = simd_vextfs(vmax16, 2);
                            float e3 = simd_vextfs(vmax16, 3);
                            float e4 = simd_vextfs(vmax16, 4);
                            float e5 = simd_vextfs(vmax16, 5);
                            float e6 = simd_vextfs(vmax16, 6);
                            float e7 = simd_vextfs(vmax16, 7);
                            float e8 = simd_vextfs(vmax16, 8);
                            float e9 = simd_vextfs(vmax16, 9);
                            float e10 = simd_vextfs(vmax16, 10);
                            float e11 = simd_vextfs(vmax16, 11);
                            float e12 = simd_vextfs(vmax16, 12);
                            float e13 = simd_vextfs(vmax16, 13);
                            float e14 = simd_vextfs(vmax16, 14);
                            float e15 = simd_vextfs(vmax16, 15);
                            float m01 = MAX(e0, e1), m23 = MAX(e2, e3);
                            float m45 = MAX(e4, e5), m67 = MAX(e6, e7);
                            float m89 = MAX(e8, e9), mAB = MAX(e10, e11);
                            float mCD = MAX(e12, e13), mEF = MAX(e14, e15);
                            float m03 = MAX(m01, m23), m47 = MAX(m45, m67);
                            float m8B = MAX(m89, mAB), mCF = MAX(mCD, mEF);
                            float m07 = MAX(m03, m47), m8F = MAX(m8B, mCF);
                            m_raw = MAX(m07, m8F);
                        }
                        for (int c = nv * 16; c < allowed; c++) {
                            m_raw = MAX(m_raw,
                                        c < BN ? src_row[c]
                                        : c < 2 * BN ? src_row_b[c - BN]
                                        : c < 3 * BN ? src_row_c[c - 2 * BN]
                                        : src_row_d[c - 3 * BN]);
                        }

                        float m_new = MAX(m_ptr[q_row_off + r], args.softmax_scale * m_raw);
                        m_new = MAX(m_new, 0.0f);
                        m_next[q_row_off + r] = m_new;
                        float s = (m_ptr[q_row_off + r] == m_new)
                            ? 1.0f
                            : expf(m_ptr[q_row_off + r] - m_new);
                        scale[q_row_off + r] = s;

                        // exp + half-store from the SAME registers
                        float l_block = 0.0f;
                        floatv16 vsum = 0.0f;
                        floatv16 *vs[8] = {&v0, &v1, &v2, &v3, &v4, &v5, &v6, &v7};
                        for (int vi = 0; vi < nv; vi++) {
                            *vs[vi] = simd_exp(simd_mul(*vs[vi], vscale) - m_new);
                            vsum = simd_add(vsum, *vs[vi]);
                            simd_store((halfv16)*vs[vi], dst_row + vi * 16);
                        }
                        for (int c = nv * 16; c < allowed; c++) {
                            float v = expf((c < BN ? src_row[c]
                                            : c < 2 * BN ? src_row_b[c - BN]
                                            : c < 3 * BN ? src_row_c[c - 2 * BN]
                                            : src_row_d[c - 3 * BN]) *
