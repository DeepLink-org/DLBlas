#include "kernel_operator.h"
#include "pre_split_mixes_tiling.h"

class KernelPreSplitMixes {
public:
    __aicore__ inline KernelPreSplitMixes(AscendC::TPipe* pipe) { pipe_ = pipe; }

    __aicore__ inline void Init(
        GM_ADDR input_mixes, GM_ADDR mhc_scale, GM_ADDR mhc_base,
        const __gm__ PreSplitMixesTilingData* tiling)
    {
        tiling_ = tiling;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        int32_t m = tiling->mhcMult;

        myStartRow_ = blockIdx * tiling->rowsPerCore;
        myRows_ = (blockIdx < static_cast<uint32_t>(tiling->coreNum - 1))
            ? tiling->rowsPerCore : tiling->tailRows;
        preSz_  = static_cast<uint32_t>(m);
        combSz_ = static_cast<uint32_t>(m * m);

        // Store raw pointers
        inpPtr_ = (__gm__ float*)input_mixes;
        prePtr_ = (__gm__ float*)(tiling->preGmAddr);
        postPtr_ = (__gm__ float*)(tiling->postGmAddr);
        combPtr_ = (__gm__ float*)(tiling->combGmAddr);

        // UB queues
        pipe_->InitBuffer(inQ_,  1, combSz_ * sizeof(float));
        pipe_->InitBuffer(sPq_,  1, preSz_ * sizeof(float));
        pipe_->InitBuffer(sPoq_, 1, preSz_ * sizeof(float));
        pipe_->InitBuffer(sCq_,  1, combSz_ * sizeof(float));
        pipe_->InitBuffer(bPq_,  1, preSz_ * sizeof(float));
        pipe_->InitBuffer(bPoq_, 1, preSz_ * sizeof(float));
        pipe_->InitBuffer(bCq_,  1, combSz_ * sizeof(float));
        pipe_->InitBuffer(sigQ_, 1, tiling->sigmoidTmpBufSize);

        LoadWeights(mhc_scale, mhc_base, m);
    }

    __aicore__ inline void Process()
    {
        int32_t m    = tiling_->mhcMult;
        int64_t M3   = tiling_->mhcMult3;
        float   eps  = tiling_->mhcPreEps;
        float   mult = tiling_->mhcPostMultValue;
        uint32_t sz  = preSz_;
        uint32_t csz = combSz_;

        for (int64_t r = 0; r < myRows_; r++) {
            int64_t goff = (myStartRow_ + r) * M3;

            // ===== PRE =====
            {
                AscendC::GlobalTensor<float> sg;
                sg.SetGlobalBuffer(inpPtr_ + goff, sz);
                AscendC::LocalTensor<float> seg = inQ_.AllocTensor<float>();
                AscendC::DataCopyPad(seg, sg, {1,(uint16_t)(sz*4),0,0},{false,0,0,0});
                inQ_.EnQue(seg);
                seg = inQ_.DeQue<float>();
                AscendC::Mul(seg, seg, scalePre_, (int32_t)sz);
                AscendC::Add(seg, seg, biasPre_, (int32_t)sz);
                AscendC::LocalTensor<uint8_t> st = sigQ_.AllocTensor<uint8_t>();
                AscendC::Sigmoid(seg, seg, st, sz); sigQ_.FreeTensor(st);
                AscendC::Adds(seg, seg, eps, (int32_t)sz);
                AscendC::GlobalTensor<float> dg;
                dg.SetGlobalBuffer(prePtr_ + (myStartRow_ + r) * m, sz);
                AscendC::DataCopyPad(dg, seg, {1,(uint16_t)(sz*4),0,0});
                inQ_.FreeTensor(seg);
            }

            // ===== POST =====
            {
                AscendC::GlobalTensor<float> sg;
                sg.SetGlobalBuffer(inpPtr_ + goff + m, sz);
                AscendC::LocalTensor<float> seg = inQ_.AllocTensor<float>();
                AscendC::DataCopyPad(seg, sg, {1,(uint16_t)(sz*4),0,0},{false,0,0,0});
                inQ_.EnQue(seg);
                seg = inQ_.DeQue<float>();
                AscendC::Mul(seg, seg, scalePost_, (int32_t)sz);
                AscendC::Add(seg, seg, biasPost_, (int32_t)sz);
                AscendC::LocalTensor<uint8_t> st = sigQ_.AllocTensor<uint8_t>();
                AscendC::Sigmoid(seg, seg, st, sz); sigQ_.FreeTensor(st);
                AscendC::Muls(seg, seg, mult, (int32_t)sz);
                AscendC::GlobalTensor<float> dg;
                dg.SetGlobalBuffer(postPtr_ + (myStartRow_ + r) * m, sz);
                AscendC::DataCopyPad(dg, seg, {1,(uint16_t)(sz*4),0,0});
                inQ_.FreeTensor(seg);
            }

            // ===== COMB =====
            {
                AscendC::GlobalTensor<float> sg;
                sg.SetGlobalBuffer(inpPtr_ + goff + 2 * m, csz);
                AscendC::LocalTensor<float> seg = inQ_.AllocTensor<float>();
                AscendC::DataCopyPad(seg, sg, {1,(uint16_t)(csz*4),0,0},{false,0,0,0});
                inQ_.EnQue(seg);
                seg = inQ_.DeQue<float>();
                AscendC::Mul(seg, seg, scaleComb_, (int32_t)csz);
                AscendC::Add(seg, seg, biasComb_, (int32_t)csz);
                AscendC::GlobalTensor<float> dg;
                dg.SetGlobalBuffer(combPtr_ + (myStartRow_ + r) * m * m, csz);
                AscendC::DataCopyPad(dg, seg, {1,(uint16_t)(csz*4),0,0});
                inQ_.FreeTensor(seg);
            }
        }
    }

private:
    __aicore__ void LoadWeights(GM_ADDR mhc_scale, GM_ADDR mhc_base, int32_t m)
    {
        AscendC::GlobalTensor<float> sGm; sGm.SetGlobalBuffer((__gm__ float*)mhc_scale,3);
        AscendC::LocalTensor<float> st = sPq_.AllocTensor<float>();
        AscendC::DataCopyPad(st, sGm, {1,12,0,0},{false,0,0,0});
        sPq_.EnQue(st); st=sPq_.DeQue<float>();
        float s0=st.GetValue(0), s1=st.GetValue(1), s2=st.GetValue(2);
        sPq_.FreeTensor(st);

        AscendC::LocalTensor<float> tb;
        tb=sPq_.AllocTensor<float>(); AscendC::Duplicate(tb,s0,(int32_t)preSz_);
        sPq_.EnQue(tb); scalePre_=sPq_.DeQue<float>();
        tb=sPoq_.AllocTensor<float>(); AscendC::Duplicate(tb,s1,(int32_t)preSz_);
        sPoq_.EnQue(tb); scalePost_=sPoq_.DeQue<float>();
        tb=sCq_.AllocTensor<float>(); AscendC::Duplicate(tb,s2,(int32_t)combSz_);
        sCq_.EnQue(tb); scaleComb_=sCq_.DeQue<float>();

        AscendC::GlobalTensor<float> tGm;
        tGm.SetGlobalBuffer((__gm__ float*)mhc_base,preSz_);
        tb=bPq_.AllocTensor<float>();
        AscendC::DataCopyPad(tb,tGm,{1,(uint16_t)(preSz_*4),0,0},{false,0,0,0});
        bPq_.EnQue(tb); biasPre_=bPq_.DeQue<float>();

        tGm.SetGlobalBuffer((__gm__ float*)mhc_base+m,preSz_);
        tb=bPoq_.AllocTensor<float>();
        AscendC::DataCopyPad(tb,tGm,{1,(uint16_t)(preSz_*4),0,0},{false,0,0,0});
        bPoq_.EnQue(tb); biasPost_=bPoq_.DeQue<float>();

        tGm.SetGlobalBuffer((__gm__ float*)mhc_base+2*m,combSz_);
        tb=bCq_.AllocTensor<float>();
        AscendC::DataCopyPad(tb,tGm,{1,(uint16_t)(combSz_*4),0,0},{false,0,0,0});
        bCq_.EnQue(tb); biasComb_=bCq_.DeQue<float>();
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ PreSplitMixesTilingData* tiling_;
    int64_t myStartRow_, myRows_;
    uint32_t preSz_, combSz_;
    __gm__ float *inpPtr_, *prePtr_, *postPtr_, *combPtr_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ_, sPq_, sPoq_, sCq_, bPq_, bPoq_, bCq_, sigQ_;
    AscendC::LocalTensor<float> scalePre_, scalePost_, scaleComb_, biasPre_, biasPost_, biasComb_;
};

extern "C" __global__ __vector__ void pre_split_mixes_kernel(
    GM_ADDR input_mixes, GM_ADDR mhc_scale, GM_ADDR mhc_base,
    GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelPreSplitMixes op(&pipe);
    op.Init(input_mixes, mhc_scale, mhc_base,
        (__gm__ PreSplitMixesTilingData*)tiling);
    op.Process();
}
