#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <chrono>
#include "acl/acl.h"
#include "../op_kernel/pre_split_mixes_tiling.h"
#include "data_utils.h"
#include "../op_kernel/pre_split_mixes_kernel.asc"

constexpr uint32_t SIGMOID_TMP_SIZE = 8192;
constexpr int WARMUP_ITERS = 10;
constexpr int BENCH_ITERS = 200;

PreSplitMixesTilingData ComputeTiling(
    int64_t totalRows, int32_t m, int32_t availableCoreNum)
{
    int64_t M3 = 2LL * m + (int64_t)m * m;
    int64_t totalElems = totalRows * M3;

    PreSplitMixesTilingData td;
    td.totalRows  = totalRows;
    td.mhcMult    = m;
    td.mhcMult3   = M3;

    int64_t coreNumByElems = (totalElems * 32 + 32767) / 32768;
    if (coreNumByElems < 1) coreNumByElems = 1;
    int32_t coreNum = static_cast<int32_t>(std::min(coreNumByElems,
        static_cast<int64_t>(availableCoreNum)));
    td.coreNum = coreNum;

    int64_t rowsPerCore = (totalRows + coreNum - 1) / coreNum;
    td.rowsPerCore = rowsPerCore;
    td.tailRows   = totalRows - (coreNum - 1) * rowsPerCore;
    td.sigmoidTmpBufSize = SIGMOID_TMP_SIZE;
    td.rowsPerChunk = 1;
    td.ubLoopPerCore = rowsPerCore;
    td.ubLoopTailCore = td.tailRows;

    return td;
}

int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);

    int64_t availableCoreNum = 0;
    aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);

    // Read config
    constexpr size_t CONFIG_SIZE = sizeof(int64_t) + sizeof(int32_t)
                                 + sizeof(float) + sizeof(float);
    uint8_t configBuf[CONFIG_SIZE];
    ReadFile("./input/tiling_config.bin", CONFIG_SIZE, configBuf, CONFIG_SIZE);

    int64_t totalRows = *reinterpret_cast<int64_t*>(configBuf);
    int32_t m         = *reinterpret_cast<int32_t*>(configBuf + 8);
    float   eps       = *reinterpret_cast<float*>(configBuf + 12);
    float   postMult  = *reinterpret_cast<float*>(configBuf + 16);
    int64_t M3 = 2LL * m + (int64_t)m * m;

    // Compute tiling
    PreSplitMixesTilingData tiling = ComputeTiling(totalRows, m,
        static_cast<int32_t>(availableCoreNum));
    tiling.mhcPreEps = eps;
    tiling.mhcPostMultValue = postMult;
    uint32_t blockNum = static_cast<uint32_t>(tiling.coreNum);

    size_t inputBytes = totalRows * M3 * sizeof(float);
    size_t scaleBytes = 3 * sizeof(float);
    size_t biasBytes  = M3 * sizeof(float);
    size_t preBytes   = totalRows * m * sizeof(float);
    size_t postBytes  = totalRows * m * sizeof(float);
    size_t combBytes  = totalRows * m * m * sizeof(float);

    // Allocate and copy input once
    uint8_t *inputHost, *inputDevice;
    uint8_t *scaleHost, *scaleDevice;
    uint8_t *biasHost, *biasDevice;
    aclrtMallocHost((void**)&inputHost, inputBytes);
    aclrtMalloc((void**)&inputDevice, inputBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&scaleHost, scaleBytes);
    aclrtMalloc((void**)&scaleDevice, scaleBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&biasHost, biasBytes);
    aclrtMalloc((void**)&biasDevice, biasBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_mixes.bin", inputBytes, inputHost, inputBytes);
    ReadFile("./input/mhc_scale.bin", scaleBytes, scaleHost, scaleBytes);
    ReadFile("./input/mhc_base.bin", biasBytes, biasHost, biasBytes);
    aclrtMemcpy(inputDevice, inputBytes, inputHost, inputBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(scaleDevice, scaleBytes, scaleHost, scaleBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(biasDevice, biasBytes, biasHost, biasBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate output once
    uint8_t *preDev, *postDev, *combDev;
    aclrtMalloc((void**)&preDev, preBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&postDev, postBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&combDev, combBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    // Tiling device memory
    uint8_t *tilingDevice;
    size_t tilingSize = sizeof(PreSplitMixesTilingData);
    tiling.preGmAddr  = reinterpret_cast<uint64_t>(preDev);
    tiling.postGmAddr = reinterpret_cast<uint64_t>(postDev);
    tiling.combGmAddr = reinterpret_cast<uint64_t>(combDev);
    aclrtMalloc((void**)&tilingDevice, tilingSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, tilingSize, &tiling, tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // Warmup
    for (int i = 0; i < WARMUP_ITERS; i++) {
        pre_split_mixes_kernel<<<blockNum, nullptr, stream>>>(
            inputDevice, scaleDevice, biasDevice, tilingDevice);
        aclrtSynchronizeStream(stream);
    }

    // Benchmark
    auto t0 = std::chrono::high_resolution_clock::now();
    for (int i = 0; i < BENCH_ITERS; i++) {
        pre_split_mixes_kernel<<<blockNum, nullptr, stream>>>(
            inputDevice, scaleDevice, biasDevice, tilingDevice);
        aclrtSynchronizeStream(stream);
    }
    auto t1 = std::chrono::high_resolution_clock::now();

    double total_us = std::chrono::duration<double, std::micro>(t1 - t0).count();
    double avg_us = total_us / BENCH_ITERS;

    // Write outputs once for verification
    uint8_t *outHost;
    aclrtMallocHost((void**)&outHost, preBytes);
    aclrtMemcpy(outHost, preBytes, preDev, preBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/pre_mix.bin", outHost, preBytes);
    aclrtFreeHost(outHost);

    aclrtMallocHost((void**)&outHost, postBytes);
    aclrtMemcpy(outHost, postBytes, postDev, postBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/post_mix.bin", outHost, postBytes);
    aclrtFreeHost(outHost);

    aclrtMallocHost((void**)&outHost, combBytes);
    aclrtMemcpy(outHost, combBytes, combDev, combBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/comb_mix.bin", outHost, combBytes);
    aclrtFreeHost(outHost);

    // Cleanup
    aclrtFree(tilingDevice);
    aclrtFree(preDev); aclrtFree(postDev); aclrtFree(combDev);
    aclrtFree(inputDevice); aclrtFree(scaleDevice); aclrtFree(biasDevice);
    aclrtFreeHost(inputHost); aclrtFreeHost(scaleHost); aclrtFreeHost(biasHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    // Print timing result (parsed by benchmark script)
    printf("BENCH_RESULT: avg_us=%.2f total_us=%.2f iters=%d blockNum=%u\n",
           avg_us, total_us, BENCH_ITERS, blockNum);
    return 0;
}
