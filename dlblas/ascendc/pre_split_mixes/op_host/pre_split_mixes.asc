// ============================================================================
// Ascend C Kernel 直调 - pre_split_mixes 算子（Host + Main 入口）
// ============================================================================
//
// 文件结构:
//   op_kernel/pre_split_mixes_tiling.h   - Tiling 常量 + 结构体
//   op_kernel/pre_split_mixes_kernel.asc - Kernel 实现
//   op_host/pre_split_mixes.asc          - 本文件: Host 端代码 + main 入口
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include "acl/acl.h"
#include "../op_kernel/pre_split_mixes_tiling.h"
#include "data_utils.h"

// 引用拆出的纯 kernel 文件
#include "../op_kernel/pre_split_mixes_kernel.asc"
#include <chrono>

// ============================================================================
// Host 端代码
// ============================================================================

struct ArgInfo {
    std::string fileName;
    size_t length;
};

// Sigmoid 临时缓冲区保守估计值
// 对于 max(m, m*m) <= 256 个 FP32 元素，sigmoid 内部查表+插值需要 ~8KB 是安全的
constexpr uint32_t SIGMOID_TMP_SIZE = 8192;  // 8KB

// 计算 Tiling 参数
PreSplitMixesTilingData ComputeTiling(
    int64_t totalRows, int32_t m, int32_t availableCoreNum)
{
    int64_t M3 = 2LL * m + (int64_t)m * m;
    int64_t totalElems = totalRows * M3;

    PreSplitMixesTilingData td;
    td.totalRows         = totalRows;
    td.mhcMult           = m;
    td.mhcMult3          = M3;
    // eps and post_mult filled by caller

    // === 多核切分（按行） ===
    // 每核最小处理 4096 元素 (4KB, FP32)
    int64_t coreNumByElems = (totalElems * 32 + 32767) / 32768;
    if (coreNumByElems < 1) coreNumByElems = 1;
    int32_t coreNum = static_cast<int32_t>(std::min(coreNumByElems,
        static_cast<int64_t>(availableCoreNum)));
    td.coreNum = coreNum;

    int64_t rowsPerCore = (totalRows + coreNum - 1) / coreNum;
    td.rowsPerCore = rowsPerCore;
    td.tailRows   = totalRows - (coreNum - 1) * rowsPerCore;

    // === Sigmoid 临时缓冲区 ===
    td.sigmoidTmpBufSize = SIGMOID_TMP_SIZE;

    // === UB 循环次数 ===
    td.rowsPerChunk    = 1;  // 逐行处理
    td.ubLoopPerCore   = rowsPerCore;
    td.ubLoopTailCore  = td.tailRows;

    return td;
}

// Kernel 调用封装
aclrtSynchronizeStream(stream);
auto _t0 = std::chrono::high_resolution_clock::now();
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData, size_t tilingSize)
{
    // inputsInfo 顺序: [0] input_mixes, [1] mhc_scale, [2] mhc_base
    // outputsInfo 顺序: [0] pre_mix, [1] post_mix, [2] comb_mix
    std::vector<uint8_t*> inputHost(inputsInfo.size());
    std::vector<uint8_t*> inputDevice(inputsInfo.size());
    std::vector<uint8_t*> outputHost(outputsInfo.size());
    std::vector<uint8_t*> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    // 分配 tiling device 内存
    aclrtMalloc((void **)&tilingDevice, tilingSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, tilingSize, tilingData,
        tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 分配并拷贝输入
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length,
            ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length,
            inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    // 分配输出
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length,
            ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // 将输出指针写入 tiling (用于减少 kernel 参数个数)
    {
        PreSplitMixesTilingData* td = reinterpret_cast<PreSplitMixesTilingData*>(tilingData);
        td->preGmAddr  = reinterpret_cast<uint64_t>(outputDevice[0]);
        td->postGmAddr = reinterpret_cast<uint64_t>(outputDevice[1]);
        td->combGmAddr = reinterpret_cast<uint64_t>(outputDevice[2]);
        // 更新 device 端的 tiling 数据
        aclrtMemcpy(tilingDevice, tilingSize, tilingData,
            tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    // Kernel 启动 (output pointers in tiling struct)
    pre_split_mixes_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], inputDevice[1], inputDevice[2],
        tilingDevice);
    aclrtSynchronizeStream(stream);
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    // 释放 tiling
    aclrtFree(tilingDevice);

    // 拷贝输出回 host
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    // 释放输入
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// ============================================================================
// Main 入口: 从 gen_data.py 生成的 .bin 文件读取输入，运行 kernel，写回输出
// ============================================================================
int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // 获取可用核数
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM,
        &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // === 从 tiling_config.bin 读取参数 ===
    // 文件格式: int64_t totalRows, int32_t m, float eps, float postMult
    constexpr size_t CONFIG_SIZE = sizeof(int64_t) + sizeof(int32_t)
                                 + sizeof(float) + sizeof(float);
    uint8_t configBuf[CONFIG_SIZE];
    ReadFile("./input/tiling_config.bin", CONFIG_SIZE, configBuf, CONFIG_SIZE);

    int64_t totalRows = *reinterpret_cast<int64_t*>(configBuf);
    int32_t m         = *reinterpret_cast<int32_t*>(configBuf + 8);
    float   eps       = *reinterpret_cast<float*>(configBuf + 12);
    float   postMult  = *reinterpret_cast<float*>(configBuf + 16);

    int64_t M3 = 2LL * m + (int64_t)m * m;

    // === 计算 Tiling ===
    PreSplitMixesTilingData tiling = ComputeTiling(totalRows, m,
        static_cast<int32_t>(availableCoreNum));
    tiling.mhcPreEps        = eps;
    tiling.mhcPostMultValue = postMult;

    uint32_t blockNum = static_cast<uint32_t>(tiling.coreNum);

    // === 文件配置 ===
    size_t inputBytes   = totalRows * M3 * sizeof(float);
    size_t scaleBytes   = 3 * sizeof(float);
    size_t biasBytes    = M3 * sizeof(float);
    size_t preBytes     = totalRows * m * sizeof(float);
    size_t postBytes    = totalRows * m * sizeof(float);
    size_t combBytes    = totalRows * m * m * sizeof(float);

    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_mixes.bin", inputBytes},
        {"./input/mhc_scale.bin",   scaleBytes},
        {"./input/mhc_base.bin",    biasBytes},
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/pre_mix.bin",  preBytes},
        {"./output/post_mix.bin", postBytes},
        {"./output/comb_mix.bin", combBytes},
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    KernelCall(blockNum, stream, inputsInfo, outputsInfo,
        (uint8_t *)&tiling, sizeof(PreSplitMixesTilingData));

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("pre_split_mixes kernel executed successfully.\n");
    return 0;
}
