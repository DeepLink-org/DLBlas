/**
 * Sinkhorn Normalize - Full Kernel (Work Buffer Approach, 32B Aligned)
 */

#include "kernel_operator.h"
#include "sinkhorn_tiling.h"

class KernelSinkhorn {
public:
    __aicore__ inline KernelSinkhorn(AscendC::TPipe* pipe) { pipe_ = pipe; };

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
                                const __gm__ SinkhornTilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx < tiling->usedCoreNum - 1) {
            numMatrices = tiling->tileBatch;
        } else {
            numMatrices = tiling->tailBatch;
        }
        totalElements = numMatrices * MATRIX_SIZE;
        uint32_t gmOffset = blockIdx * tiling->tileBatch * MATRIX_SIZE;
        xGm.SetGlobalBuffer((__gm__ float*)x + gmOffset, totalElements);
        yGm.SetGlobalBuffer((__gm__ float*)y + gmOffset, totalElements);
        pipe_->InitBuffer(inQueue, 1, totalElements * sizeof(float));
        pipe_->InitBuffer(outQueue, 1, totalElements * sizeof(float));
        // Temp buffer: each section 8-float aligned (32B)
        pipe_->InitBuffer(tempBuf, 32 * 1024 + 8*4 * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<float> xLocal = inQueue.AllocTensor<float>();
        AscendC::DataCopyPad(xLocal, xGm,
            {1, static_cast<uint16_t>(totalElements * sizeof(float)), 0, 0},
            {false, 0, 0, 0});
        inQueue.EnQue(xLocal);
        AscendC::LocalTensor<float> xData = inQueue.DeQue<float>();

        // Temp buffers: all offsets aligned to 8 floats (32 bytes)
        // reduceTmp: 8192 floats at offset 0
        // reduceDst: 8 floats at offset 8192  (8-aligned: 8192 % 8 = 0)
        // rowWork:   8 floats at offset 8200  (8-aligned: 8200 % 8 = 0)
        // colWork:   8 floats at offset 8208  (8-aligned: 8208 % 8 = 0)
        // mult:      8 floats at offset 8216  (8-aligned: 8216 % 8 = 0)
        AscendC::LocalTensor<float> reduceTmp = tempBuf.GetWithOffset<float>(8192, 0);
        AscendC::LocalTensor<float> reduceDst = tempBuf.GetWithOffset<float>(8, 8192 * sizeof(float));
        AscendC::LocalTensor<float> rowWork   = tempBuf.GetWithOffset<float>(8, 8200 * sizeof(float));
        AscendC::LocalTensor<float> colWork   = tempBuf.GetWithOffset<float>(8, 8208 * sizeof(float));
        AscendC::LocalTensor<float> mult      = tempBuf.GetWithOffset<float>(8, 8216 * sizeof(float));

        float eps = tiling->eps;
        uint32_t mhc = tiling->mhc;
        uint32_t repeat = tiling->repeat;

        for (uint32_t m = 0; m < numMatrices; m++) {
            uint32_t matBase = m * MATRIX_SIZE;

            // Phase 1: Softmax(dim=-1) + eps
            for (uint32_t r = 0; r < mhc; r++) {
                uint32_t rowOff = matBase + r * mhc;
                for (uint32_t i = 0; i < mhc; i++) rowWork.SetValue(i, xData.GetValue(rowOff + i));
                AscendC::ReduceMax(reduceDst, rowWork, reduceTmp, (int32_t)mhc);
                AscendC::Adds(rowWork, rowWork, -reduceDst.GetValue(0), (int32_t)mhc);
                AscendC::Exp(rowWork, rowWork, (int32_t)mhc);
                AscendC::ReduceSum(reduceDst, rowWork, reduceTmp, (int32_t)mhc);
                AscendC::Muls(rowWork, rowWork, 1.0f / (reduceDst.GetValue(0) + eps), (int32_t)mhc);
                for (uint32_t i = 0; i < mhc; i++) xData.SetValue(rowOff + i, rowWork.GetValue(i));
            }
            for (uint32_t i = 0; i < MATRIX_SIZE; i++)
                xData.SetValue(matBase + i, xData.GetValue(matBase + i) + eps);

            // Phase 2: Column normalize (sum dim=-2)
            for (uint32_t c = 0; c < mhc; c++) {
                for (uint32_t r = 0; r < mhc; r++)
                    colWork.SetValue(r, xData.GetValue(matBase + r * mhc + c));
                AscendC::ReduceSum(reduceDst, colWork, reduceTmp, (int32_t)mhc);
                mult.SetValue(c, 1.0f / (reduceDst.GetValue(0) + eps));
            }
            for (uint32_t r = 0; r < mhc; r++) {
                for (uint32_t i = 0; i < mhc; i++) rowWork.SetValue(i, xData.GetValue(matBase + r * mhc + i));
                AscendC::Mul(rowWork, rowWork, mult, (uint64_t)mhc);
                for (uint32_t i = 0; i < mhc; i++) xData.SetValue(matBase + r * mhc + i, rowWork.GetValue(i));
            }

            // Phase 3: Iterate row + column normalization (repeat-1 rounds)
            for (uint32_t iter = 1; iter < repeat; iter++) {
                for (uint32_t r = 0; r < mhc; r++) {
                    uint32_t rowOff = matBase + r * mhc;
                    for (uint32_t i = 0; i < mhc; i++) rowWork.SetValue(i, xData.GetValue(rowOff + i));
                    AscendC::ReduceSum(reduceDst, rowWork, reduceTmp, (int32_t)mhc);
                    AscendC::Muls(rowWork, rowWork, 1.0f / (reduceDst.GetValue(0) + eps), (int32_t)mhc);
                    for (uint32_t i = 0; i < mhc; i++) xData.SetValue(rowOff + i, rowWork.GetValue(i));
                }
                for (uint32_t c = 0; c < mhc; c++) {
                    for (uint32_t r = 0; r < mhc; r++)
                        colWork.SetValue(r, xData.GetValue(matBase + r * mhc + c));
                    AscendC::ReduceSum(reduceDst, colWork, reduceTmp, (int32_t)mhc);
                    mult.SetValue(c, 1.0f / (reduceDst.GetValue(0) + eps));
                }
                for (uint32_t r = 0; r < mhc; r++) {
                    for (uint32_t i = 0; i < mhc; i++) rowWork.SetValue(i, xData.GetValue(matBase + r * mhc + i));
                    AscendC::Mul(rowWork, rowWork, mult, (uint64_t)mhc);
                    for (uint32_t i = 0; i < mhc; i++) xData.SetValue(matBase + r * mhc + i, rowWork.GetValue(i));
                }
            }
        }

        AscendC::LocalTensor<float> outLocal = outQueue.AllocTensor<float>();
        for (uint32_t i = 0; i < totalElements; i++) outLocal.SetValue(i, xData.GetValue(i));
        outQueue.EnQue<float>(outLocal);
        inQueue.FreeTensor(xData);

        AscendC::LocalTensor<float> outData = outQueue.DeQue<float>();
        AscendC::DataCopyPad(yGm, outData,
            {1, static_cast<uint16_t>(totalElements * sizeof(float)), 0, 0});
        outQueue.FreeTensor(outData);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ SinkhornTilingData* tiling;
    AscendC::GlobalTensor<float> xGm, yGm;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    AscendC::TBuf<> tempBuf;
    uint32_t totalElements, numMatrices;
};

extern "C" __global__ __vector__ void sinkhorn_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelSinkhorn op(&pipe);
    op.Init(x, y, (__gm__ SinkhornTilingData*)tiling);
    op.Process();
}
