/**
 * norm_fn Host 侧入口 (直调验证)
 *
 * 文件结构：
 *   op_host/norm_fn_tiling.h   - Tiling 结构体 (kernnel 和 host 共用)
 *   op_device/norm_fn_kernel.asc - Kernel 实现
 *   op_host/norm_fn.asc         - 本文件：Host 端代码 + main 入口
 *   op_host/data_utils.h        - 数据读写工具
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "norm_fn_tiling.h"
#include "data_utils.h"

// 引用 kernel 文件
#include "../op_device/norm_fn_kernel.asc"
#include <chrono>

// ============================================================================
// Host 端代码
// ============================================================================

struct ArgInfo {
    std::string fileName;
    size_t length;
};

aclrtSynchronizeStream(stream);
auto _t0 = std::chrono::high_resolution_clock::now();
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(NormFnTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(NormFnTilingData), tilingData,
        sizeof(NormFnTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // Kernel 启动: residual, mhc_fn, weight, result, tiling
    norm_fn_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0],   // residual
        inputDevice[1],   // mhc_fn
        inputDevice[2],   // weight (may be empty)
        outputDevice[0],  // result
        tilingDevice);

    aclrtSynchronizeStream(stream);
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// ============================================================================
// Main 入口
// ============================================================================
int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // 单核启动
    uint32_t blockNum = 1;

    // 输入/输出大小
    size_t residualSize = TOTAL_M * TOTAL_K * sizeof(bfloat16_t);  // 13 * 5120 * 2
    size_t mhcFnSize    = TOTAL_N * TOTAL_K * sizeof(float);       // 24 * 5120 * 4
    size_t weightSize   = TOTAL_K * sizeof(float);                  // 5120 * 4
    size_t resultSize   = TOTAL_M * TOTAL_N * sizeof(float);       // 13 * 24 * 4

    // 判断是否有权重（检查 weight 文件是否存在）
    bool hasWeight = false;
    {
        FILE* f = fopen("./input/input_weight.bin", "rb");
        if (f != nullptr) {
            hasWeight = true;
            fclose(f);
        }
    }

    // Tiling 数据
    NormFnTilingData tiling;
    tiling.total_M     = TOTAL_M;
    tiling.total_N     = TOTAL_N;
    tiling.total_K     = TOTAL_K;
    tiling.tile_K      = TILE_K;
    tiling.tile_K_align = TILE_K_ALIGN;
    tiling.num_K_tiles = NUM_K_TILES;
    tiling.has_weight  = hasWeight;
    tiling.eps         = 1e-6f;
    tiling.invK        = 1.0f / static_cast<float>(TOTAL_K);

    // 输入文件列表
    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_residual.bin", residualSize},
        {"./input/input_mhc_fn.bin",   mhcFnSize},
    };
    if (hasWeight) {
        inputsInfo.push_back({"./input/input_weight.bin", weightSize});
    } else {
        // 无权重时传最小占位 buffer (kernel 不会使用)
        inputsInfo.push_back({"./input/input_weight_dummy.bin", 4});
    }

    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", resultSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    KernelCall(blockNum, stream, inputsInfo, outputsInfo, (uint8_t *)&tiling);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
