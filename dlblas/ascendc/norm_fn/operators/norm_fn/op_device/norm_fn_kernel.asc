/**
 * norm_fn Kernel 实现
 *
 * 融合算子：einsum 点积 + RMS 归一化 + 可选权重乘法
 *
 * 输入:
 *   residual  [1,13,4,1280] bf16  → 展平为 (13,5120) bf16
 *   mhc_fn    [24,5120]      float
 *   weight    [5120]         float (可选)
 * 输出:
 *   result    [1,13,24]      float
 *
 * 算法: 单核 K 轴分块 (TILE_K=512, 10 次迭代)
 *   For each K-tile:
 *     1. Load residual(bf16) + Cast → float
 *     2. Load mhc_fn(float)
 *     3. [Optional] Load weight, 逐行 Mul
 *     4. sqrsum partial: Mul(square) + Pattern::Reduce::AR
 *     5. Dot products: Level 2 ReduceSum per (M,N)
 *   After K-tiles:
 *     6. RMS normalize: result = mixes * rsqrt(sqrsum/K + eps)
 *     7. CopyOut
 */

#include "kernel_operator.h"
#include "norm_fn_tiling.h"

class KernelNormFn {
public:
    __aicore__ inline KernelNormFn(AscendC::TPipe* pipe) { pipe_ = pipe; }

    __aicore__ inline void Init(
        GM_ADDR residual_gm, GM_ADDR mhc_fn_gm, GM_ADDR weight_gm,
        GM_ADDR result_gm, const __gm__ NormFnTilingData* tiling)
    {
        this->tiling = tiling;
        totalM  = tiling->total_M;
        totalN  = tiling->total_N;
        totalK  = tiling->total_K;
        tileK   = tiling->tile_K;
        tileKAlign = tiling->tile_K_align;
        numKTiles = tiling->num_K_tiles;
        hasWeight = tiling->has_weight;
        eps = tiling->eps;

        // GlobalTensor 设置
        residualGm.SetGlobalBuffer((__gm__ bfloat16_t*)residual_gm, totalM * totalK);
        mhcFnGm.SetGlobalBuffer((__gm__ float*)mhc_fn_gm, totalN * totalK);
        if (hasWeight) {
            weightGm.SetGlobalBuffer((__gm__ float*)weight_gm, totalK);
        }
        resultGm.SetGlobalBuffer((__gm__ float*)result_gm, totalM * totalN);

        // UB Buffer 初始化
        pipe_->InitBuffer(inQueueResidual, 1, RESIDUAL_ELEMS * sizeof(bfloat16_t));
        pipe_->InitBuffer(inQueueMhcFn,   1, MHC_FN_ELEMS * sizeof(float));
        if (hasWeight) {
            pipe_->InitBuffer(inQueueWeight, 1, WEIGHT_ELEMS * sizeof(float));
        }
        pipe_->InitBuffer(bufResidualFloat, RESIDUAL_ELEMS * sizeof(float));
        pipe_->InitBuffer(bufMixes,         MIXES_ELEMS * sizeof(float));
        pipe_->InitBuffer(bufSqrsum,        SQSUM_ELEMS * sizeof(float));
        pipe_->InitBuffer(bufReduceTmp,     REDUCE_TMP_SIZE);
        pipe_->InitBuffer(bufScalar,        SQSUM_ELEMS * sizeof(float));
        pipe_->InitBuffer(bufSqTemp,        SQ_TEMP_ELEMS * sizeof(float));
        pipe_->InitBuffer(outQueueResult,   1, RESULT_ELEMS * sizeof(float));

        // 初始化累积缓冲区
        AscendC::LocalTensor<float> mixesLocal = bufMixes.Get<float>();
        AscendC::LocalTensor<float> sqrsumLocal = bufSqrsum.Get<float>();
        AscendC::Duplicate<float>(mixesLocal, 0.0f, MIXES_ELEMS);
        AscendC::Duplicate<float>(sqrsumLocal, 0.0f, SQSUM_ELEMS);
    }

    __aicore__ inline void Process()
    {
        // === K 轴分块迭代 ===
        for (uint32_t kt = 0; kt < numKTiles; kt++) {
            uint32_t kStart = kt * tileK;

            // Phase 1: CopyIn
            CopyInResidual(kStart);
            CopyInMhcFn(kStart);
            if (hasWeight) {
                CopyInWeight(kStart);
            }

            // Phase 2: DeQue + Compute
            Compute(kStart);
        }

        // Phase 3: RMS 归一化
        RMSNormalize();

        // Phase 4: CopyOut
        CopyOut();
    }

private:
    // ================================================================
    // CopyIn: 数据加载
    // ================================================================

    __aicore__ inline void CopyInResidual(uint32_t kStart)
    {
        AscendC::LocalTensor<bfloat16_t> ub = inQueueResidual.AllocTensor<bfloat16_t>();
        AscendC::DataCopyExtParams cp;
        cp.blockCount = totalM;
        cp.blockLen   = static_cast<uint32_t>(tileK * sizeof(bfloat16_t));
        cp.srcStride  = static_cast<uint32_t>((totalK - tileK) * sizeof(bfloat16_t));
        cp.dstStride  = 0; cp.rsv = 0;
        AscendC::DataCopyPadExtParams<bfloat16_t> pp{false, 0, 0, bfloat16_t(0)};
        AscendC::DataCopyPad(ub, residualGm[kStart], cp, pp);
        inQueueResidual.EnQue(ub);
    }

    __aicore__ inline void CopyInMhcFn(uint32_t kStart)
    {
        AscendC::LocalTensor<float> ub = inQueueMhcFn.AllocTensor<float>();
        AscendC::DataCopyExtParams cp;
        cp.blockCount = totalN;
        cp.blockLen   = static_cast<uint32_t>(tileK * sizeof(float));
        cp.srcStride  = static_cast<uint32_t>((totalK - tileK) * sizeof(float));
        cp.dstStride  = 0; cp.rsv = 0;
        AscendC::DataCopyPadExtParams<float> pp{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(ub, mhcFnGm[kStart], cp, pp);
        inQueueMhcFn.EnQue(ub);
    }

    __aicore__ inline void CopyInWeight(uint32_t kStart)
    {
        AscendC::LocalTensor<float> ub = inQueueWeight.AllocTensor<float>();
        AscendC::DataCopyExtParams cp;
        cp.blockCount = 1;
        cp.blockLen   = static_cast<uint32_t>(tileK * sizeof(float));
        cp.srcStride  = 0; cp.dstStride  = 0; cp.rsv = 0;
        AscendC::DataCopyPadExtParams<float> pp{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(ub, weightGm[kStart], cp, pp);
        inQueueWeight.EnQue(ub);
    }

    // ================================================================
    // Compute: 核心计算
    // ================================================================

    __aicore__ inline void Compute(uint32_t kStart)
    {
        // DeQue residual bf16 → Cast → float
        AscendC::LocalTensor<bfloat16_t> residualUb = inQueueResidual.DeQue<bfloat16_t>();
        AscendC::LocalTensor<float> residualFloat = bufResidualFloat.Get<float>();
        AscendC::Cast<float, bfloat16_t>(residualFloat, residualUb,
            AscendC::RoundMode::CAST_NONE, RESIDUAL_ELEMS);
        inQueueResidual.FreeTensor(residualUb);

        // DeQue mhc_fn float
        AscendC::LocalTensor<float> mhcFnFloat = inQueueMhcFn.DeQue<float>();

        // 可选权重乘法: 逐行 Mul(weight)
        if (hasWeight) {
            AscendC::LocalTensor<float> weightUb = inQueueWeight.DeQue<float>();
            for (uint32_t n = 0; n < totalN; n++) {
                AscendC::Mul(mhcFnFloat[n * tileKAlign],
                    mhcFnFloat[n * tileKAlign],
                    weightUb,
                    static_cast<int32_t>(tileK));
            }
            inQueueWeight.FreeTensor(weightUb);
        }

        // --- sqrsum 计算 (Pattern::Reduce::AR 批量归约) ---
        AscendC::LocalTensor<float> sqTemp = bufSqTemp.Get<float>();
        AscendC::Mul(sqTemp, residualFloat, residualFloat, RESIDUAL_ELEMS);

        AscendC::LocalTensor<uint8_t> reduceTmp = bufReduceTmp.Get<uint8_t>();
        AscendC::LocalTensor<float> sqPartial = bufScalar.Get<float>();
        uint32_t srcShape[] = {totalM, tileKAlign};
        AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR, true>(
            sqPartial, sqTemp, reduceTmp, srcShape, true);

        AscendC::LocalTensor<float> sqrsumLocal = bufSqrsum.Get<float>();
        for (uint32_t m = 0; m < totalM; m++) {
            sqrsumLocal.SetValue(m, sqrsumLocal.GetValue(m) + sqPartial.GetValue(m));
        }

        // --- Dot Product 计算 (Level 2 ReduceSum 逐 (M,N) 对) ---
        AscendC::LocalTensor<float> mixesLocal = bufMixes.Get<float>();
        AscendC::LocalTensor<float> tempRow = sqTemp;  // 复用 sqTemp
        AscendC::LocalTensor<float> reduceTmpF32 = reduceTmp.ReinterpretCast<float>();
        AscendC::LocalTensor<float> scalarBuf = bufScalar.Get<float>();

        for (uint32_t m = 0; m < totalM; m++) {
            uint32_t residualRowOff = m * tileKAlign;
            for (uint32_t n = 0; n < totalN; n++) {
                uint32_t mhcRowOff = n * tileKAlign;
                AscendC::Mul(tempRow, residualFloat[residualRowOff],
                    mhcFnFloat[mhcRowOff], tileK);
                AscendC::ReduceSum<float>(scalarBuf, tempRow, reduceTmpF32,
                    static_cast<int32_t>(tileK));
                uint32_t idx = m * totalN + n;
                mixesLocal.SetValue(idx, mixesLocal.GetValue(idx) + scalarBuf.GetValue(0));
            }
        }

        inQueueMhcFn.FreeTensor(mhcFnFloat);
    }

    // ================================================================
    // RMSNormalize: RMS 归一化
    // ================================================================

    __aicore__ inline void RMSNormalize()
    {
        AscendC::LocalTensor<float> mixesLocal = bufMixes.Get<float>();
        AscendC::LocalTensor<float> sqrsumLocal = bufSqrsum.Get<float>();
        float invK = tiling->invK;

        AscendC::LocalTensor<float> out = outQueueResult.AllocTensor<float>();
        AscendC::LocalTensor<float> scalarBuf = bufScalar.Get<float>();

        for (uint32_t m = 0; m < totalM; m++) {
            float sqSum = sqrsumLocal.GetValue(m);

            // AscendC::Rsqrt: 1/sqrt(src), 替代 Sqrt + Div
            scalarBuf.SetValue(0, sqSum * invK + eps);
            AscendC::Rsqrt(scalarBuf, scalarBuf, static_cast<int32_t>(1));
            float rmsFactor = scalarBuf.GetValue(0);

            uint32_t rowOff = m * totalN;
            AscendC::Muls(out[rowOff], mixesLocal[rowOff], rmsFactor,
                static_cast<int32_t>(totalN));
        }
        outQueueResult.EnQue<float>(out);
    }

    // ================================================================
    // CopyOut: 输出写回
    // ================================================================

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<float> out = outQueueResult.DeQue<float>();
        AscendC::DataCopyExtParams cp;
        cp.blockCount = 1;
        cp.blockLen   = static_cast<uint32_t>(RESULT_ELEMS * sizeof(float));
        cp.srcStride  = 0; cp.dstStride  = 0; cp.rsv = 0;
        AscendC::DataCopyPad(resultGm, out, cp);
        outQueueResult.FreeTensor(out);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ NormFnTilingData* tiling;
    uint32_t totalM, totalN, totalK, tileK, tileKAlign, numKTiles;
    bool hasWeight;
    float eps;

    // GlobalTensor
    AscendC::GlobalTensor<bfloat16_t> residualGm;
    AscendC::GlobalTensor<float>      mhcFnGm;
    AscendC::GlobalTensor<float>      weightGm;
    AscendC::GlobalTensor<float>      resultGm;

    // Input Queues (VECIN)
    AscendC::TQue<AscendC::TPosition::VECIN, 1>  inQueueResidual;
    AscendC::TQue<AscendC::TPosition::VECIN, 1>  inQueueMhcFn;
    AscendC::TQue<AscendC::TPosition::VECIN, 1>  inQueueWeight;

    // Output Queue (VECOUT)
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueResult;

    // Compute Buffers (TBuf)
    AscendC::TBuf<> bufResidualFloat;
    AscendC::TBuf<> bufMixes;
    AscendC::TBuf<> bufSqrsum;
    AscendC::TBuf<> bufReduceTmp;
    AscendC::TBuf<> bufScalar;
    AscendC::TBuf<> bufSqTemp;
};

extern "C" __global__ __vector__ void norm_fn_kernel(
    GM_ADDR residual_gm, GM_ADDR mhc_fn_gm, GM_ADDR weight_gm,
    GM_ADDR result_gm, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelNormFn op(&pipe);
    op.Init(residual_gm, mhc_fn_gm, weight_gm, result_gm,
        (__gm__ NormFnTilingData*)tiling);
    op.Process();
}
