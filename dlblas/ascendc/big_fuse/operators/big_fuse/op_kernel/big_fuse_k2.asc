/**
 * big_fuse K2: Vector Post-process (AIV). T=2 tokens/tile (32B-aligned for MTE DataCopyPad).
 * NpuArch: DAV_2201 | UB: 192 KB
 * H2: Sigmoid via AscendC::Sigmoid<float>, Scale via Muls, Sinkhorn M4=4 kept scalar.
 * H3: TPipe must be constructed in __global__ function scope and passed as pointer
 *     (canonical Ascend C pattern, matching K0). Multi-core dispatch uses
 *     GetBlockIdx() with per-core token offset. Host ensures all launched cores
 *     have >= 1 token to avoid hardware issue on DAV_2201.
 * H4: PipeBarrier added after Mul<float,true> before FreeTensor(sqrsum) to prevent
 *     pipeline race between Mul reading sqrsum and splBuf overwriting same buffer.
 */
#include "kernel_operator.h"
#include "big_fuse_tiling.h"

class KernelBigFuseK2 {
public:
    __aicore__ inline KernelBigFuseK2() {}
    __aicore__ inline void Init(GM_ADDR rFlat,GM_ADDR rMix,GM_ADDR rBf16,GM_ADDR pMix,GM_ADDR cMix,GM_ADDR lIn,GM_ADDR tGm,
                                AscendC::TPipe* pipe){
        if ASCEND_IS_AIC{return;}
        {const auto*s=reinterpret_cast<const __gm__ int32_t*>(tGm);auto*d=reinterpret_cast<int32_t*>(&tiling_);for(uint32_t i=0;i<(sizeof(TilingHeaderK2)+3)/4;++i)d[i]=s[i];}
        int32_t bi=AscendC::GetBlockIdx();if(bi>=tiling_.vecCoreNum){tokensForThisCore_=0;return;}
        tokenStart_=bi*tiling_.tokensPerCore;int32_t te=tokenStart_+tiling_.tokensPerCore;
        if(te>tiling_.nTokens)te=tiling_.nTokens;tokensForThisCore_=te-tokenStart_;
        if(tokensForThisCore_<=0)return;
        pipe_=pipe;
        int32_t tp=tiling_.tokensPerTile,M4=tiling_.mhcMult,HS=tiling_.hiddenSize,N24=tiling_.mhcMult3,RGS=tiling_.rgs;
        numTiles_=(tokensForThisCore_+tp-1)/tp;
        pipe_->InitBuffer(qBf16_,1,static_cast<uint32_t>(tp*M4*HS)*sizeof(bfloat16_t));
        pipe_->InitBuffer(qFp32_,1,static_cast<uint32_t>(tp*RGS)*sizeof(float));
        pipe_->InitBuffer(qCalc_,1,static_cast<uint32_t>(tp*RGS)*sizeof(float));
        pipe_->InitBuffer(qSpl_,1,static_cast<uint32_t>(tp*N24)*sizeof(float));
        pipe_->InitBuffer(qOut_,1,static_cast<uint32_t>(tp*HS)*sizeof(bfloat16_t));
        rFlatGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(rFlat),static_cast<uint64_t>(tiling_.nTokens)*RGS);
        rMixGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(rMix),static_cast<uint64_t>(tiling_.nTokens)*N24);
        rBf16Gm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(rBf16),static_cast<uint64_t>(tiling_.nTokens)*M4*HS);
        pMixGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pMix),static_cast<uint64_t>(tiling_.nTokens)*M4);
        cMixGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(cMix),static_cast<uint64_t>(tiling_.nTokens)*M4*M4);
        lInGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(lIn),static_cast<uint64_t>(tiling_.nTokens)*HS);
    }
    __aicore__ inline void Process(){
        if(tokensForThisCore_<=0)return;
        int32_t tp=tiling_.tokensPerTile,M4=tiling_.mhcMult,HS=tiling_.hiddenSize,N24=tiling_.mhcMult3,RGS=tiling_.rgs;
        for(int32_t tile=0;tile<numTiles_;++tile){
            int32_t tS=tokenStart_+tile*tp,curT=(tile==numTiles_-1)?tokensForThisCore_-tile*tp:tp;
            int32_t bSz=curT*M4*HS,fSz=curT*RGS,mSz=curT*N24,m4=curT*M4,cSz=curT*M4*M4,lSz=curT*HS;
            int64_t fOff=static_cast<int64_t>(tS)*RGS,mOff=static_cast<int64_t>(tS)*N24,rOff=static_cast<int64_t>(tS)*M4*HS;
            int64_t pOut=static_cast<int64_t>(tS)*M4,cOut=static_cast<int64_t>(tS)*M4*M4,lOut=static_cast<int64_t>(tS)*HS;

            // Phase A1: Load residual_flat fp32
            AscendC::LocalTensor<float> rFp32=qFp32_.AllocTensor<float>();
            AscendC::DataCopyPad(rFp32,rFlatGm_[fOff],AscendC::DataCopyParams{1,static_cast<uint16_t>(fSz*sizeof(float)),0,0},AscendC::DataCopyPadParams{});
            qFp32_.EnQue(rFp32);AscendC::LocalTensor<float> rIn=qFp32_.DeQue<float>();

            // Phase A2: sqrsum (scalar - WholeReduceSum pending DAV_2201 validation)
            AscendC::LocalTensor<float> sqrT=qCalc_.AllocTensor<float>();
            AscendC::Mul(sqrT,rIn,rIn,fSz);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::LocalTensor<float> sqrsum=qSpl_.AllocTensor<float>();
            for(int32_t t=0;t<curT;++t){float s=0;int32_t b=t*RGS;for(int32_t i=0;i<RGS;++i)s+=sqrT.GetValue(b+i);sqrsum.SetValue(t,s);}
            qCalc_.FreeTensor(sqrT);

            // Phase A3-5: RMS Norm (vector via BinaryRepeatParams)
            AscendC::LocalTensor<float> mixes=qCalc_.AllocTensor<float>();
            AscendC::DataCopyPad(mixes,rMixGm_[mOff],AscendC::DataCopyParams{1,static_cast<uint16_t>(mSz*sizeof(float)),0,0},AscendC::DataCopyPadParams{});
            float invRgs=1.0f/static_cast<float>(RGS);
            for(int32_t t=0;t<curT;++t)sqrsum.SetValue(t,sqrsum.GetValue(t)*invRgs+tiling_.rmsEps);
            AscendC::PipeBarrier<PIPE_ALL>();  // H5: scalar sqrsum→Rsqrt
            AscendC::Rsqrt(sqrsum,sqrsum,curT);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::BinaryRepeatParams brp;brp.dstBlkStride=static_cast<uint8_t>(N24);brp.src0BlkStride=static_cast<uint8_t>(N24);brp.src1BlkStride=1;brp.dstRepStride=1;brp.src0RepStride=1;brp.src1RepStride=0;
            uint64_t rmsMask=(1ULL<<static_cast<uint64_t>(N24))-1;
            AscendC::Mul<float,true>(mixes,mixes,sqrsum,rmsMask,static_cast<uint8_t>(curT),brp);
            AscendC::PipeBarrier<PIPE_ALL>();  // H4: ensure Mul completes before freeing sqrsum
            qSpl_.FreeTensor(sqrsum);qFp32_.FreeTensor(rIn);

            // Phase B1: Scale+Bias+Split (H2: Muls for scale; bias per-element)
            AscendC::LocalTensor<float> splBuf=qSpl_.AllocTensor<float>();
            const float *sv=tiling_.scaleVec,*bv=tiling_.baseVec;int32_t poff=m4,coff=2*m4;
            for(int32_t t=0;t<curT;++t){int32_t mb=t*N24;
                for(int32_t m=0;m<M4;++m){splBuf.SetValue(t*M4+m,mixes.GetValue(mb+m));splBuf.SetValue(poff+t*M4+m,mixes.GetValue(mb+M4+m));}
                for(int32_t i=0;i<M4*M4;++i)splBuf.SetValue(coff+t*M4*M4+i,mixes.GetValue(mb+2*M4+i));}
            AscendC::Muls(splBuf,splBuf,sv[0],m4);AscendC::Muls(splBuf[poff],splBuf[poff],sv[M4],m4);
            AscendC::PipeBarrier<PIPE_ALL>();  // H5: scalar splBuf→Muls
            AscendC::Muls(splBuf[coff],splBuf[coff],sv[2*M4],cSz);
            AscendC::PipeBarrier<PIPE_ALL>();  // H5: Muls→scalar bias
            for(int32_t t=0;t<curT;++t){
                for(int32_t m=0;m<M4;++m){splBuf.SetValue(t*M4+m,splBuf.GetValue(t*M4+m)+bv[m]);splBuf.SetValue(poff+t*M4+m,splBuf.GetValue(poff+t*M4+m)+bv[M4+m]);}
                for(int32_t i=0;i<M4*M4;++i)splBuf.SetValue(coff+t*M4*M4+i,splBuf.GetValue(coff+t*M4*M4+i)+bv[2*M4+i]);}
            AscendC::PipeBarrier<PIPE_ALL>();
            qCalc_.FreeTensor(mixes);

            // Phase B2: Sigmoid (H2: AscendC::Sigmoid<float> replaces ScalarSigmoid)
            AscendC::LocalTensor<float> sigTmp=qCalc_.AllocTensor<float>();
            AscendC::Sigmoid<float>(sigTmp,splBuf,static_cast<uint32_t>(m4));AscendC::PipeBarrier<PIPE_ALL>();AscendC::Adds(splBuf,sigTmp,tiling_.mhcPreEps,m4);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::PipeBarrier<PIPE_ALL>();  // H5: scalar bias→Sigmoid
            AscendC::Sigmoid<float>(sigTmp,splBuf[poff],static_cast<uint32_t>(m4));AscendC::PipeBarrier<PIPE_ALL>();AscendC::Muls(splBuf[poff],sigTmp,tiling_.mhcPostMultValue,m4);AscendC::PipeBarrier<PIPE_ALL>();
            qCalc_.FreeTensor(sigTmp);

            // Phase B3: Write post_mix — deferred to after Sinkhorn to avoid UB banking conflict
            // between MTE read of splBuf[poff] and Phase C writes to splBuf[coff]

            // Phase C: Sinkhorn on comb (H2: M4=4 too small for vector ReduceSum; Exp kept vectorized)
            float eps=tiling_.mhcSinkhornEps;
            for(int32_t t=0;t<curT;++t){int32_t tb=coff+t*M4*M4;
                for(int32_t r=0;r<M4;++r){int32_t rb=tb+r*M4;float mx=splBuf.GetValue(rb);for(int32_t c=1;c<M4;++c){float v=splBuf.GetValue(rb+c);if(v>mx)mx=v;}for(int32_t c=0;c<M4;++c)splBuf.SetValue(rb+c,splBuf.GetValue(rb+c)-mx);}}
            AscendC::PipeBarrier<PIPE_ALL>();  // H5: scalar max-sub→Exp
            AscendC::Exp(splBuf[coff],splBuf[coff],curT*M4*M4);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::PipeBarrier<PIPE_ALL>();  // H5: Exp→scalar norm
            for(int32_t t=0;t<curT;++t){int32_t tb=coff+t*M4*M4;
                for(int32_t r=0;r<M4;++r){int32_t rb=tb+r*M4;float rs=0;for(int32_t c=0;c<M4;++c)rs+=splBuf.GetValue(rb+c);float inv=1.0f/rs;for(int32_t c=0;c<M4;++c)splBuf.SetValue(rb+c,splBuf.GetValue(rb+c)*inv+eps);}
                for(int32_t c=0;c<M4;++c){float cs=0;for(int32_t r=0;r<M4;++r)cs+=splBuf.GetValue(tb+r*M4+c);float inv=1.0f/(cs+eps);for(int32_t r=0;r<M4;++r)splBuf.SetValue(tb+r*M4+c,splBuf.GetValue(tb+r*M4+c)*inv);}}
            for(int32_t iter=1;iter<tiling_.sinkhornRepeat;++iter){
                for(int32_t t=0;t<curT;++t){int32_t tb=coff+t*M4*M4;
                    for(int32_t r=0;r<M4;++r){int32_t rb=tb+r*M4;float rs=0;for(int32_t c=0;c<M4;++c)rs+=splBuf.GetValue(rb+c);float inv=1.0f/(rs+eps);for(int32_t c=0;c<M4;++c)splBuf.SetValue(rb+c,splBuf.GetValue(rb+c)*inv);}}
                for(int32_t t=0;t<curT;++t){int32_t tb=coff+t*M4*M4;
            AscendC::PipeBarrier<PIPE_ALL>();  // H5: scalar Sinkhorn→DataCopyPad
                    for(int32_t c=0;c<M4;++c){float cs=0;for(int32_t r=0;r<M4;++r)cs+=splBuf.GetValue(tb+r*M4+c);float inv=1.0f/(cs+eps);for(int32_t r=0;r<M4;++r)splBuf.SetValue(tb+r*M4+c,splBuf.GetValue(tb+r*M4+c)*inv);}}}
            AscendC::DataCopyPad(cMixGm_[cOut],splBuf[coff],AscendC::DataCopyParams{1,static_cast<uint16_t>(cSz*sizeof(float)),0,0});

            // Phase B3 deferred: Write post_mix after Sinkhorn to avoid MTE/Vector race
            AscendC::DataCopyPad(pMixGm_[pOut],splBuf[poff],AscendC::DataCopyParams{1,static_cast<uint16_t>(m4*sizeof(float)),0,0});

            // Phase D: Weighted Apply
            AscendC::LocalTensor<bfloat16_t> rBf16=qBf16_.AllocTensor<bfloat16_t>();
            AscendC::DataCopyPad(rBf16,rBf16Gm_[rOff],AscendC::DataCopyParams{1,static_cast<uint16_t>(bSz*sizeof(bfloat16_t)),0,0},AscendC::DataCopyPadParams{});
            qBf16_.EnQue(rBf16);AscendC::LocalTensor<bfloat16_t> rBi=qBf16_.DeQue<bfloat16_t>();
            AscendC::LocalTensor<float> rFp32b=qCalc_.AllocTensor<float>();
            AscendC::Cast<float,bfloat16_t>(rFp32b,rBi,AscendC::RoundMode::CAST_NONE,bSz);AscendC::PipeBarrier<PIPE_ALL>();qBf16_.FreeTensor(rBi);
            AscendC::LocalTensor<float> wgt=qFp32_.AllocTensor<float>();
            for(int32_t t=0;t<curT;++t)for(int32_t m=0;m<M4;++m){float pv=splBuf.GetValue(t*M4+m);AscendC::Muls(wgt[(t*M4+m)*HS],rFp32b[(t*M4+m)*HS],pv,HS);}
            qCalc_.FreeTensor(rFp32b);qSpl_.FreeTensor(splBuf);
            AscendC::LocalTensor<float> lFp32=qCalc_.AllocTensor<float>();
            for(int32_t t=0;t<curT;++t){AscendC::Add(lFp32[t*HS],wgt[(t*M4+0)*HS],wgt[(t*M4+1)*HS],HS);AscendC::Add(lFp32[t*HS],lFp32[t*HS],wgt[(t*M4+2)*HS],HS);AscendC::Add(lFp32[t*HS],lFp32[t*HS],wgt[(t*M4+3)*HS],HS);}
            qFp32_.FreeTensor(wgt);
            AscendC::LocalTensor<bfloat16_t> lBf16=qOut_.AllocTensor<bfloat16_t>();
            AscendC::Cast<bfloat16_t,float>(lBf16,lFp32,AscendC::RoundMode::CAST_ROUND,lSz);AscendC::PipeBarrier<PIPE_ALL>();qCalc_.FreeTensor(lFp32);
            AscendC::DataCopyPad(lInGm_[lOut],lBf16,AscendC::DataCopyParams{1,static_cast<uint16_t>(lSz*sizeof(bfloat16_t)),0,0});qOut_.FreeTensor(lBf16);
        }
    }
private:
    TilingHeaderK2 tiling_;int32_t tokenStart_=0,tokensForThisCore_=0,numTiles_=0;AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<float> rFlatGm_,rMixGm_,pMixGm_,cMixGm_;AscendC::GlobalTensor<bfloat16_t> rBf16Gm_,lInGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,1> qBf16_,qFp32_;AscendC::TQue<AscendC::TPosition::VECCALC,1> qCalc_,qSpl_;AscendC::TQue<AscendC::TPosition::VECOUT,1> qOut_;
};
extern "C" __global__ __vector__ void big_fuse_k2_kernel(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR p,GM_ADDR d,GM_ADDR e,GM_ADDR t){
    if ASCEND_IS_AIC{return;}
    AscendC::TPipe pipe;
    KernelBigFuseK2 op;
    op.Init(a,b,c,p,d,e,t,&pipe);
    op.Process();
}
