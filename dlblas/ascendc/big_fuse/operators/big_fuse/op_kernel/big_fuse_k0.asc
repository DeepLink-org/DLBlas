/**
 * big_fuse Kernel 0: bf16->fp32 Conversion + Flatten (AIV)
 *
 * Converts residual [1, 512, 4, 1280] bf16 -> residual_flat [512, 5120] fp32
 * Runs on VectorCore (AIV only).
 *
 * Pipeline pattern (matching add_custom template):
 *   CopyIn:  DataCopyPad → EnQue → DeQue
 *   Compute: Cast(bf16→fp32)
 *   CopyOut: DataCopyPad(UB→GM)
 *
 * KEY FIX: DataCopy(GlobalTensor, LocalTensor, uint32_t count) uses ELEMENT count,
 * NOT byte count. The DataCopy overload with uint32_t parameter is element-based.
 *
 * NpuArch: DAV_2201 | UB: 192 KB | VectorCore: 48
 */

#include "kernel_operator.h"
#include "big_fuse_tiling.h"

class KernelBigFuseK0 {
public:
    __aicore__ inline KernelBigFuseK0() {}

    __aicore__ inline void Init(
        GM_ADDR residualBf16Gm,       // input: [1, 512, 4, 1280] bf16
        GM_ADDR residualFlatFp32Gm,   // output: [512, 5120] fp32
        GM_ADDR tilingGm,
        AscendC::TPipe* pipe)
    {
        if ASCEND_IS_AIC { return; }

        // Load tiling header from GM to stack
        {
            const auto* src = reinterpret_cast<const __gm__ int32_t*>(tilingGm);
            auto* dst = reinterpret_cast<int32_t*>(&tiling_);
            constexpr uint32_t NI = (sizeof(TilingHeaderK0) + sizeof(int32_t) - 1U) / sizeof(int32_t);
            for (uint32_t i = 0; i < NI; ++i) dst[i] = src[i];
        }

        int32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx >= tiling_.vecCoreNum) {
            tokensForThisCore_ = 0;
            return;
        }

        tokenStart_ = blockIdx * tiling_.tokensPerCore;
        int32_t tokenEnd = tokenStart_ + tiling_.tokensPerCore;
        if (tokenEnd > tiling_.nTokens) tokenEnd = tiling_.nTokens;
        tokensForThisCore_ = tokenEnd - tokenStart_;
        if (tokensForThisCore_ <= 0) return;

        int32_t tpt = tiling_.tokensPerTile;
        numTiles_ = (tokensForThisCore_ + tpt - 1) / tpt;

        int32_t maxBf16Elems = tpt * tiling_.mhcMult * tiling_.hiddenSize;
        int32_t maxFp32Elems = tpt * tiling_.rgs;

        // Single buffer for input and output (simple, correct)
        pipe->InitBuffer(inQueBf16_, 1, static_cast<uint32_t>(maxBf16Elems) * sizeof(bfloat16_t));
        pipe->InitBuffer(outQueFp32_, 1, static_cast<uint32_t>(maxFp32Elems) * sizeof(float));

        int32_t M4  = tiling_.mhcMult;
        int32_t HS  = tiling_.hiddenSize;
        int32_t N   = tiling_.nTokens;

        residualBf16Gm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ bfloat16_t*>(residualBf16Gm),
            static_cast<uint64_t>(N) * M4 * HS);
        residualFlatGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ float*>(residualFlatFp32Gm),
            static_cast<uint64_t>(N) * tiling_.rgs);

        pipe_ = pipe;
    }

    __aicore__ inline void Process() {
        if (tokensForThisCore_ <= 0) return;

        int32_t tpt = tiling_.tokensPerTile;
        int32_t M4  = tiling_.mhcMult;
        int32_t HS  = tiling_.hiddenSize;
        int32_t RGS = tiling_.rgs;

        for (int32_t tile = 0; tile < numTiles_; ++tile) {
            int32_t tStart = tokenStart_ + tile * tpt;
            int32_t curT = (tile == numTiles_ - 1)
                ? tokensForThisCore_ - tile * tpt : tpt;

            int32_t bf16Elems = curT * M4 * HS;
            int32_t fp32Elems = curT * RGS;

            // ===== Step 1: CopyIn - Load bf16 residual from GM =====
            AscendC::LocalTensor<bfloat16_t> bf16Buf = inQueBf16_.AllocTensor<bfloat16_t>();
            AscendC::DataCopyPad(bf16Buf,
                residualBf16Gm_[static_cast<int64_t>(tStart) * M4 * HS],
                AscendC::DataCopyParams{1,
                    static_cast<uint16_t>(bf16Elems * sizeof(bfloat16_t)), 0, 0},
                AscendC::DataCopyPadParams{});
            inQueBf16_.EnQue(bf16Buf);
            AscendC::LocalTensor<bfloat16_t> bf16In = inQueBf16_.DeQue<bfloat16_t>();

            // ===== Step 2: Compute - Cast bf16 → fp32 =====
            AscendC::LocalTensor<float> fp32Out = outQueFp32_.AllocTensor<float>();
            AscendC::Cast<float, bfloat16_t>(fp32Out, bf16In,
                AscendC::RoundMode::CAST_NONE, static_cast<uint32_t>(bf16Elems));

            // EnQue/DeQue to synchronize Cast (Vector) before CopyOut (MTE)
            outQueFp32_.EnQue(fp32Out);
            inQueBf16_.FreeTensor(bf16In);

            // ===== Step 3: CopyOut - Write fp32 to GM =====
            // KEY: DataCopy(GlobalTensor, LocalTensor, uint32_t count)
            // uses ELEMENT count, NOT byte count!
            AscendC::LocalTensor<float> fp32Ready = outQueFp32_.DeQue<float>();
            AscendC::DataCopy(residualFlatGm_[static_cast<int64_t>(tStart) * RGS],
                fp32Ready, static_cast<uint32_t>(fp32Elems));
            outQueFp32_.FreeTensor(fp32Ready);
        }
    }

private:
    TilingHeaderK0 tiling_;
    int32_t tokenStart_ = 0;
    int32_t tokensForThisCore_ = 0;
    int32_t numTiles_ = 0;
    AscendC::TPipe* pipe_ = nullptr;

    AscendC::TQue<AscendC::TPosition::VECIN, 1>  inQueBf16_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueFp32_;

    AscendC::GlobalTensor<bfloat16_t> residualBf16Gm_;
    AscendC::GlobalTensor<float> residualFlatGm_;
};

extern "C" __global__ __vector__ void big_fuse_k0_kernel(
    GM_ADDR residualBf16Gm, GM_ADDR residualFlatFp32Gm, GM_ADDR tilingGm)
{
    if ASCEND_IS_AIC { return; }
    AscendC::TPipe pipe;
    KernelBigFuseK0 op;
    op.Init(residualBf16Gm, residualFlatFp32Gm, tilingGm, &pipe);
    op.Process();
}
