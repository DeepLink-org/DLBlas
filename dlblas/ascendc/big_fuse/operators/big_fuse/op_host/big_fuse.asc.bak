/**
 * big_fuse Host + Main Entry
 *
 * Three-kernel pipeline (DESIGN.md §0.3):
 *   K0 (AIV, 48 cores): bf16→fp32 Conversion + Flatten
 *     residual [1,512,4,1280] bf16 → residual_flat [512,5120] fp32 → GM
 *   K1 (AIC, 24 cores): MatMul (Cube)
 *     residual_flat @ fn^T = raw_mixes [512,24] fp32
 *   K2 (AIV, 48 cores): Vector Post-process
 *     RMS Norm + Split/Sigmoid + Sinkhorn + Weighted Apply
 *     → post_mix, comb_mix, layer_input
 *
 * NpuArch: DAV_2201 | CANN: 9.0.0
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <cstring>
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/matmul/matmul_tiling.h"
#include "data_utils.h"

#include "../op_kernel/big_fuse_k0.asc"
#include "../op_kernel/big_fuse_k1.asc"
#include "../op_kernel/big_fuse_k2.asc"
#include "big_fuse_tiling.h"

static constexpr int32_t N_TOKENS    = 512;
static constexpr int32_t MHC_MULT    = 4;
static constexpr int32_t HIDDEN_SIZE = 1280;
static constexpr int32_t RGS         = MHC_MULT * HIDDEN_SIZE;   // 5120
static constexpr int32_t MHC_MULT3   = 2 * MHC_MULT + MHC_MULT * MHC_MULT; // 24
static constexpr int32_t AIC_CORES   = 24;
static constexpr int32_t VEC_CORES   = 48;

static inline int32_t CeilDiv(int32_t a, int32_t b) { return (a + b - 1) / b; }

// ============================================================================
// Compute K0 Tiling (bf16->fp32 conversion, AIV)
// ============================================================================
static void ComputeK0Tiling(TilingHeaderK0& hdr, int32_t vecCoreNum) {
    hdr.nTokens       = N_TOKENS;
    hdr.mhcMult       = MHC_MULT;
    hdr.hiddenSize    = HIDDEN_SIZE;
    hdr.rgs           = RGS;
    hdr.tokensPerCore = CeilDiv(N_TOKENS, vecCoreNum);
    hdr.tokensPerTile = 4;             // T=4, UB ~123KB < 192KB
    hdr.vecCoreNum    = vecCoreNum;
    hdr.reserved[0]   = 0;

    std::cout << "K0: tokensPerCore=" << hdr.tokensPerCore
              << " tokensPerTile=" << hdr.tokensPerTile
              << " blockDim=" << vecCoreNum << std::endl;
}

// ============================================================================
// Compute K1 Tiling (MatMul, AIC)
// ============================================================================
static bool ComputeK1Tiling(TilingHeaderK1& hdr, int32_t aicCoreNum) {
    using namespace matmul_tiling;

    MatmulApiTiling tilingApi;
    tilingApi.SetBufferSpace(512 * 1024, 128 * 1024, 192 * 1024, -1);
    tilingApi.SetShape(N_TOKENS, MHC_MULT3, RGS);

    // A=fp32 (from K0), B=fp32, transB=true
    tilingApi.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                       matmul_tiling::DataType::DT_FLOAT, false);
    tilingApi.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                       matmul_tiling::DataType::DT_FLOAT, true);
    tilingApi.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                       matmul_tiling::DataType::DT_FLOAT);
    tilingApi.SetBias(false);
    tilingApi.SetMadType(MatrixMadType::NORMAL);  // Full FP32 precision

    auto& ct = hdr.cubeTiling;
    ct = {};
    int64_t ret = tilingApi.GetTiling(ct);
    if (ret != 0) {
        std::cerr << "ERROR: MatmulApiTiling::GetTiling failed, ret=" << ret << std::endl;
        return false;
    }

    ct.M  = N_TOKENS;
    ct.N  = MHC_MULT3;
    ct.Ka = RGS;
    ct.Kb = RGS;

    int32_t singleCoreM = ct.singleCoreM;
    int32_t singleCoreN = ct.singleCoreN;
    if (singleCoreM <= 0) singleCoreM = N_TOKENS;
    if (singleCoreN <= 0) singleCoreN = MHC_MULT3;

    int32_t mCnt = CeilDiv(N_TOKENS, singleCoreM);
    int32_t nCnt = CeilDiv(MHC_MULT3, singleCoreN);
    int32_t totalBlk = mCnt * nCnt;

    constexpr int32_t ALIGN = 16;
    int32_t minM = std::max(ALIGN, ct.baseM / 8);
    if (minM < ALIGN) minM = ALIGN;

    while (totalBlk < aicCoreNum && singleCoreM > minM) {
        singleCoreM = std::max(minM, (singleCoreM / 2) / ALIGN * ALIGN);
        mCnt = CeilDiv(N_TOKENS, singleCoreM);
        totalBlk = mCnt * nCnt;
    }

    ct.singleCoreM = singleCoreM;
    ct.singleCoreN = singleCoreN;
    ct.usedCoreNum = std::min(totalBlk, aicCoreNum);

    hdr.mTotalCnt = mCnt;
    hdr.nTotalCnt = nCnt;
    hdr.totalBlock = totalBlk;
    hdr.mBaseTail = N_TOKENS - (mCnt - 1) * singleCoreM;
    hdr.nBaseTail = MHC_MULT3 - (nCnt - 1) * singleCoreN;
    hdr.convTileK = 0;

    std::cout << "K1: sM=" << singleCoreM << " sN=" << singleCoreN
              << " baseM=" << ct.baseM << " baseN=" << ct.baseN
              << " totalBlk=" << totalBlk << " blkDim=" << ct.usedCoreNum << std::endl;

    return true;
}

// ============================================================================
// Compute K2 Tiling (Vector Post-process, AIV)
// ============================================================================
static void ComputeK2Tiling(TilingHeaderK2& hdr, int32_t vecCoreNum,
                             const float* scaleSrc, const float* baseSrc) {
    hdr.nTokens         = N_TOKENS;
    hdr.mhcMult         = MHC_MULT;
    hdr.hiddenSize      = HIDDEN_SIZE;
    hdr.mhcMult3        = MHC_MULT3;
    hdr.rgs             = RGS;
    hdr.tokensPerCore   = CeilDiv(N_TOKENS, vecCoreNum);
    hdr.tokensPerTile   = 2;
    hdr.vecCoreNum      = vecCoreNum;
    hdr.sinkhornRepeat  = 10;
    hdr.rmsEps          = 1e-6f;
    hdr.mhcPreEps       = 1e-6f;
    hdr.mhcSinkhornEps  = 1e-6f;
    hdr.mhcPostMultValue = 1.0f;
    for (int32_t i = 0; i < 4; ++i) hdr.reserved[i] = 0;

    // Expand scale[3] → scaleVec[24]
    for (int32_t i = 0; i < MHC_MULT; ++i) hdr.scaleVec[i] = scaleSrc[0];
    for (int32_t i = 0; i < MHC_MULT; ++i) hdr.scaleVec[MHC_MULT + i] = scaleSrc[1];
    for (int32_t i = 0; i < MHC_MULT * MHC_MULT; ++i)
        hdr.scaleVec[2 * MHC_MULT + i] = scaleSrc[2];
    for (int32_t i = 0; i < MHC_MULT3; ++i) hdr.baseVec[i] = baseSrc[i];

    std::cout << "K2: tokensPerCore=" << hdr.tokensPerCore
              << " tokensPerTile=" << hdr.tokensPerTile
              << " blockDim=" << vecCoreNum << std::endl;
}

// ============================================================================
// Main
// ============================================================================
int32_t main(int32_t argc, char* argv[]) {
    (void)argc; (void)argv;

    aclInit(nullptr);
    int32_t deviceId = 0;
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) {
        std::cerr << "ERROR: aclrtSetDevice failed" << std::endl;
        return -1;
    }

    size_t numResElem = static_cast<size_t>(N_TOKENS) * MHC_MULT * HIDDEN_SIZE;
    size_t resBf16B   = numResElem * sizeof(bfloat16_t);
    size_t resFp32B   = numResElem * sizeof(float);         // K0 output: 10MB
    size_t fnB        = static_cast<size_t>(MHC_MULT3) * RGS * sizeof(float);
    size_t rawB       = static_cast<size_t>(N_TOKENS) * MHC_MULT3 * sizeof(float);
    size_t postB      = static_cast<size_t>(N_TOKENS) * MHC_MULT * sizeof(float);
    size_t cmbB       = static_cast<size_t>(N_TOKENS) * MHC_MULT * MHC_MULT * sizeof(float);
    size_t layB       = static_cast<size_t>(N_TOKENS) * HIDDEN_SIZE * sizeof(bfloat16_t);

    // Read inputs
    std::vector<uint8_t> resBf16Host(resBf16B), fnHost(fnB),
                         scHost(3*sizeof(float)), bsHost(MHC_MULT3*sizeof(float));
    if (!ReadFile("./input/residual.bin", resBf16B, resBf16Host.data(), resBf16B) ||
        !ReadFile("./input/fn.bin", fnB, fnHost.data(), fnB) ||
        !ReadFile("./input/mhc_scale.bin", 3*sizeof(float), scHost.data(), 3*sizeof(float)) ||
        !ReadFile("./input/mhc_base.bin", MHC_MULT3*sizeof(float), bsHost.data(), MHC_MULT3*sizeof(float))) {
        std::cerr << "ERROR: Failed to read inputs" << std::endl;
        return -1;
    }

    // Output host buffers
    std::vector<uint8_t> postHost(postB), cmbHost(cmbB), layHost(layB);

    // Allocate device memory
    uint8_t *resBf16Dev=nullptr, *resFp32Dev=nullptr, *fnDev=nullptr, *rawDev=nullptr;
    uint8_t *postDev=nullptr, *cmbDev=nullptr, *layDev=nullptr;
    uint8_t *tk0Dev=nullptr, *tk1Dev=nullptr, *tk2Dev=nullptr;

    aclrtMalloc((void**)&resBf16Dev, resBf16B, ACL_MEM_MALLOC_HUGE_FIRST);  // bf16 original
    aclrtMalloc((void**)&resFp32Dev, resFp32B, ACL_MEM_MALLOC_HUGE_FIRST);  // K0 output → K1/K2 input
    aclrtMalloc((void**)&fnDev,     fnB,     ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&rawDev,    rawB,    ACL_MEM_MALLOC_HUGE_FIRST);    // K1 output → K2 input
    aclrtMalloc((void**)&postDev,   postB,   ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cmbDev,    cmbB,    ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&layDev,    layB,    ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&tk0Dev, sizeof(TilingHeaderK0), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&tk1Dev, sizeof(TilingHeaderK1), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&tk2Dev, sizeof(TilingHeaderK2), ACL_MEM_MALLOC_HUGE_FIRST);

    // Copy inputs to device
    aclrtMemcpy(resBf16Dev, resBf16B, resBf16Host.data(), resBf16B, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(fnDev,      fnB,     fnHost.data(),       fnB,      ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // ==================== K0: bf16→fp32 Conversion (AIV, 48 cores) ====================
    std::cout << "\n=== K0: bf16→fp32 Conversion (AIV) ===" << std::endl;
    TilingHeaderK0 k0{};
    ComputeK0Tiling(k0, VEC_CORES);
    aclrtMemcpy(tk0Dev, sizeof(TilingHeaderK0), &k0, sizeof(TilingHeaderK0), ACL_MEMCPY_HOST_TO_DEVICE);

    big_fuse_k0_kernel<<<VEC_CORES, nullptr, stream>>>(
        resBf16Dev, resFp32Dev, tk0Dev);
    aclrtSynchronizeStream(stream);
    std::cout << "K0 done." << std::endl;

    // ==================== K1: MatMul (AIC, 24 cores) ====================
    std::cout << "\n=== K1: MatMul (AIC) ===" << std::endl;
    TilingHeaderK1 k1{};
    if (!ComputeK1Tiling(k1, AIC_CORES)) return -1;
    aclrtMemcpy(tk1Dev, sizeof(TilingHeaderK1), &k1, sizeof(TilingHeaderK1), ACL_MEMCPY_HOST_TO_DEVICE);

    big_fuse_k1_kernel<<<k1.cubeTiling.usedCoreNum, nullptr, stream>>>(
        resFp32Dev, fnDev, rawDev, tk1Dev);
    aclrtSynchronizeStream(stream);
    std::cout << "K1 done." << std::endl;

    // ==================== K2: Vector Post-process (AIV, 48 cores) ====================
    std::cout << "\n=== K2: Vector Post-process (AIV) ===" << std::endl;
    TilingHeaderK2 k2{};
    ComputeK2Tiling(k2, VEC_CORES,
        reinterpret_cast<const float*>(scHost.data()),
        reinterpret_cast<const float*>(bsHost.data()));
    aclrtMemcpy(tk2Dev, sizeof(TilingHeaderK2), &k2, sizeof(TilingHeaderK2), ACL_MEMCPY_HOST_TO_DEVICE);

    big_fuse_k2_kernel<<<VEC_CORES, nullptr, stream>>>(
        resFp32Dev,   // residual_flat fp32 (from K0)
        rawDev,       // raw_mixes fp32 (from K1)
        resBf16Dev,   // residual bf16 (original, for Phase D)
        postDev, cmbDev, layDev,
        tk2Dev);
    aclrtSynchronizeStream(stream);
    std::cout << "K2 done." << std::endl;

    // Copy outputs back
    aclrtMemcpy(postHost.data(), postB, postDev, postB, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(cmbHost.data(), cmbB, cmbDev, cmbB, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(layHost.data(), layB, layDev, layB, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/post_mix.bin", postHost.data(), postB);
    WriteFile("./output/comb_mix.bin", cmbHost.data(), cmbB);
    WriteFile("./output/layer_input.bin", layHost.data(), layB);

    // Cleanup
    aclrtDestroyStream(stream);
    aclrtFree(resBf16Dev); aclrtFree(resFp32Dev); aclrtFree(fnDev); aclrtFree(rawDev);
    aclrtFree(postDev); aclrtFree(cmbDev); aclrtFree(layDev);
    aclrtFree(tk0Dev); aclrtFree(tk1Dev); aclrtFree(tk2Dev);
    aclrtResetDevice(deviceId);
    aclFinalize();

    std::cout << "\n=== big_fuse completed ===" << std::endl;
    return 0;
}
