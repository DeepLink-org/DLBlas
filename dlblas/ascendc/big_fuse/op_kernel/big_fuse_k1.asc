/**
 * big_fuse Kernel 1: MatMul (Cube / AIC)
 *
 * Computes: raw_mixes = residual_fp32 @ fn_fp32^T
 *   A: residual_fp32  [M=512, K=5120]  fp32 (host pre-converted from bf16→fp32)
 *   B: fn             [N=24,  K=5120]  fp32
 *   C: raw_mixes      [M=512, N=24]    fp32
 *
 * DI-001 fix: A and B are both fp32, preserving fn's original fp32 precision.
 * Host pre-converts bf16 residual to fp32 before launch.
 * Uses MatmulImpl high-level API (DAV_2201).
 * AIC-only: AIV cores return immediately.
 */

#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "big_fuse_tiling.h"

using namespace matmul;

// DI-001: A and B are both fp32
using A_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
using B_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
using C_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, float>;
using BIAS_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, float>;

static constexpr MatmulConfig MM_CFG = GetMDLConfig(
    false,  // enableMixDualMaster
    false,  // enableUnitFlag
    0,      // doMTE2Preload
    false,  // isVecND2Nz
    false,  // isPerTensor
    false,  // isSplitK
    true    // enUnitFlag ← required for IterateAll to write back
);

class KernelBigFuseK1 {
public:
    __aicore__ inline KernelBigFuseK1() {}

    __aicore__ inline void Init(
        GM_ADDR afp32GM,         // fp32 A matrix [M, K] (host pre-converted from bf16 residual)
        GM_ADDR bfp32GM,         // fp32 B matrix [N, K] (fn weight, original fp32 precision)
        GM_ADDR cfp32GM,         // fp32 C matrix [M, N] (raw_mixes output)
        GM_ADDR tilingGM,
        AscendC::TPipe* pipe)
    {
        if ASCEND_IS_AIV { return; }

        LoadTilingFromGM(tilingGM);

        int32_t M  = header_.cubeTiling.M;
        int32_t K  = header_.cubeTiling.Ka;
        int32_t N  = header_.cubeTiling.N;

        aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(afp32GM),
                             static_cast<uint64_t>(M) * K);
        bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bfp32GM),
                             static_cast<uint64_t>(N) * K);
        cGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(cfp32GM),
                             static_cast<uint64_t>(M) * N);

        mm_.SetSubBlockIdx(0);
        mm_.Init(&header_.cubeTiling, pipe);
        mm_.SetHF32(false, 0);
    }

    __aicore__ inline void Process() {
        if ASCEND_IS_AIV { return; }

        const int32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx >= header_.totalBlock) { return; }

        const int32_t mIdx = blockIdx / header_.nTotalCnt;
        const int32_t nIdx = blockIdx % header_.nTotalCnt;
        const int32_t K    = static_cast<int32_t>(header_.cubeTiling.Ka);
        const int32_t N    = static_cast<int32_t>(header_.cubeTiling.N);

        const int32_t sM = static_cast<int32_t>(header_.cubeTiling.singleCoreM);
        const int32_t sN = static_cast<int32_t>(header_.cubeTiling.singleCoreN);
        const int32_t curM = (mIdx == header_.mTotalCnt - 1) ? header_.mBaseTail : sM;
        const int32_t curN = (nIdx == header_.nTotalCnt - 1) ? header_.nBaseTail : sN;

        const int64_t offA = static_cast<int64_t>(mIdx) * sM * K;
        const int64_t offB = static_cast<int64_t>(nIdx) * sN * K;
        const int64_t offC = static_cast<int64_t>(mIdx) * sM * N +
                             static_cast<int64_t>(nIdx) * sN;

        mm_.SetSingleShape(curM, curN, K);
        mm_.SetTensorA(aGm_[offA], false);   // A = fp32
        mm_.SetTensorB(bGm_[offB], true);    // B = fp32 (transpose)
        mm_.IterateAll(cGm_[offC], 0);

        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void End() {
        if ASCEND_IS_AIV { return; }
        mm_.End();
    }

private:
    __aicore__ inline void LoadTilingFromGM(GM_ADDR tilingGM) {
        constexpr uint32_t HS = sizeof(TilingHeaderK1);
        constexpr uint32_t NI = (HS + sizeof(int32_t) - 1U) / sizeof(int32_t);
        const auto* src = reinterpret_cast<const __gm__ int32_t*>(tilingGM);
        auto* dst = reinterpret_cast<int32_t*>(&header_);
        for (uint32_t i = 0; i < NI; ++i) dst[i] = src[i];
    }

    TilingHeaderK1 header_{};
    MatmulImpl<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG> mm_;
    AscendC::GlobalTensor<float> aGm_;  // fp32 A matrix
    AscendC::GlobalTensor<float> bGm_;  // fp32 B matrix (fn)
    AscendC::GlobalTensor<float> cGm_;  // fp32 C matrix (raw_mixes)
};

extern "C" __global__ __cube__ void big_fuse_k1_kernel(
    GM_ADDR aFp32GM, GM_ADDR bFp32GM, GM_ADDR cFp32GM, GM_ADDR tilingGM)
{
    AscendC::TPipe pipe;
    KernelBigFuseK1 op;
    op.Init(aFp32GM, bFp32GM, cFp32GM, tilingGM, &pipe);
    op.Process();
    op.End();
}
