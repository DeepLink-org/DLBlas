/**
 * engram_gate_fwd - Full fusion kernel: RMSNorm + Dot + Gate + Broadcast
 *
 * Processes (num_tokens * hc_mult) rows in parallel across AI cores.
 * Each row computes: RMSNorm(rstd) -> Dot Product -> SignedSqrt Gate -> Sigmoid -> Broadcast
 *
 * Key design decisions:
 *   - Lazy weight loading: load one wh/we row per head iteration
 *   - Single buffer: no double-buffer for simplicity
 *   - hidden_size_align: used for vector API element counts to satisfy 32B alignment
 *   - Actual data size: used for DataCopyPad blockLen to avoid reading GM garbage
 */
#include "kernel_operator.h"
#include "engram_gate_fwd_tiling.h"

class KernelEngramGateFwd {
    AscendC::TPipe* pipe_;
    const __gm__ EngramGateFwdTilingData* tiling_;
    AscendC::GlobalTensor<bfloat16_t> hs_gm_, k_gm_, v_gm_, wh_gm_, we_gm_, out_gm_;
    AscendC::GlobalTensor<float> raw_dot_gm_, gate_score_gm_, rstd_x_gm_, rstd_k_gm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> weight_hidden_q_, weight_embed_q_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> v_q_, x_q_, k_q_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> out_q_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> buf_a_q_, buf_b_q_, buf_c_q_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> tmp_q_, scalar_q_;

    uint64_t row_start_, row_end_;
    uint64_t hs_bytes_bf16_;        // UB buffer byte size per bf16 row (32B aligned)
    uint64_t hs_bytes_fp32_;        // UB buffer byte size per fp32 row (32B aligned)
    uint64_t hs_align_;             // hidden_size_align for vector API element counts
    uint64_t hs_data_bytes_bf16_;   // actual valid data byte size per bf16 row (hidden_size * 2)
    uint64_t hs_align_bf16_;        // hidden_size_align_bf16 (aligned element count for bf16)

public:
    __aicore__ inline KernelEngramGateFwd(AscendC::TPipe* pipe) : pipe_(pipe) {}
    __aicore__ inline void Init(GM_ADDR hs, GM_ADDR k, GM_ADDR v, GM_ADDR wh, GM_ADDR we,
        GM_ADDR out, GM_ADDR rd, GM_ADDR gs, GM_ADDR rx, GM_ADDR rk,
        const __gm__ EngramGateFwdTilingData* tiling)
    {
        tiling_ = tiling;
        uint64_t total_rows = tiling_->total_rows;
        uint64_t rows_per_core = tiling_->tile_rows_per_core;
        uint64_t block_idx = AscendC::GetBlockIdx();

        row_start_ = block_idx * rows_per_core;
        row_end_ = row_start_ + rows_per_core;
        if (row_end_ > total_rows) row_end_ = total_rows;
        if (row_start_ >= total_rows) { row_start_ = total_rows; row_end_ = total_rows; }

        uint64_t N = tiling_->hidden_size;
        hs_align_ = tiling_->hidden_size_align;
        hs_align_bf16_ = tiling_->hidden_size_align_bf16;
        hs_bytes_bf16_ = hs_align_bf16_ * sizeof(bfloat16_t);  // UB buffer size (32B aligned)
        hs_bytes_fp32_ = hs_align_ * sizeof(float);             // UB buffer size (32B aligned)
        hs_data_bytes_bf16_ = N * sizeof(bfloat16_t);           // actual valid data size for DataCopyPad

        hs_gm_.SetGlobalBuffer((__gm__ bfloat16_t*)hs, total_rows * N);
        k_gm_.SetGlobalBuffer((__gm__ bfloat16_t*)k, total_rows * N);
        v_gm_.SetGlobalBuffer((__gm__ bfloat16_t*)v, tiling_->num_tokens * N);
        wh_gm_.SetGlobalBuffer((__gm__ bfloat16_t*)wh, tiling_->hc_mult * N);
        we_gm_.SetGlobalBuffer((__gm__ bfloat16_t*)we, tiling_->hc_mult * N);
        out_gm_.SetGlobalBuffer((__gm__ bfloat16_t*)out, total_rows * N);
        raw_dot_gm_.SetGlobalBuffer((__gm__ float*)rd, total_rows);
        gate_score_gm_.SetGlobalBuffer((__gm__ float*)gs, total_rows);
        rstd_x_gm_.SetGlobalBuffer((__gm__ float*)rx, total_rows);
        rstd_k_gm_.SetGlobalBuffer((__gm__ float*)rk, total_rows);

        // UB buffers sized for 32B alignment (vector API requirement)
        pipe_->InitBuffer(weight_hidden_q_, 1, hs_bytes_bf16_);
        pipe_->InitBuffer(weight_embed_q_,  1, hs_bytes_bf16_);
        pipe_->InitBuffer(v_q_,             1, hs_bytes_bf16_);
        pipe_->InitBuffer(x_q_,             1, hs_bytes_bf16_);
        pipe_->InitBuffer(k_q_,             1, hs_bytes_bf16_);
        pipe_->InitBuffer(out_q_,           1, hs_bytes_bf16_);
        pipe_->InitBuffer(buf_a_q_,         1, hs_bytes_fp32_);
        pipe_->InitBuffer(buf_b_q_,         1, hs_bytes_fp32_);
        pipe_->InitBuffer(buf_c_q_,         1, hs_bytes_fp32_);
        pipe_->InitBuffer(tmp_q_,           1, 8192);
        pipe_->InitBuffer(scalar_q_,        1, 32);
    }
    __aicore__ inline void Process()
    {
        if (row_start_ >= row_end_) return;

        uint64_t N = tiling_->hidden_size;
        uint64_t hc_mult = tiling_->hc_mult;
        uint64_t row = row_start_;

        while (row < row_end_) {
            uint64_t token_idx = row / hc_mult;
            uint64_t head_start = row % hc_mult;
            uint64_t head_end = hc_mult;

            if (row_end_ < (token_idx + 1) * hc_mult) {
                head_end = row_end_ % hc_mult;
                if (head_end == 0) head_end = hc_mult;
            }

            for (uint64_t hc = head_start; hc < head_end; hc++) {
                uint64_t global_row = token_idx * hc_mult + hc;

                // Load weight rows (lazy: one row per head)
                {
                    auto wh_local = weight_hidden_q_.AllocTensor<bfloat16_t>();
                    AscendC::DataCopyPad(wh_local, wh_gm_[hc * N],
                        {1, (uint16_t)hs_data_bytes_bf16_, 0, 0}, {false, 0, 0, 0});
                    weight_hidden_q_.EnQue(wh_local);
                }
                {
                    auto we_local = weight_embed_q_.AllocTensor<bfloat16_t>();
                    AscendC::DataCopyPad(we_local, we_gm_[hc * N],
                        {1, (uint16_t)hs_data_bytes_bf16_, 0, 0}, {false, 0, 0, 0});
                    weight_embed_q_.EnQue(we_local);
                }

                // Load hidden_states row
                {
                    uint64_t off = global_row * N;
                    auto x_local = x_q_.AllocTensor<bfloat16_t>();
                    AscendC::DataCopyPad(x_local, hs_gm_[off],
                        {1, (uint16_t)hs_data_bytes_bf16_, 0, 0}, {false, 0, 0, 0});
                    x_q_.EnQue(x_local);
                }

                // Load k row
                {
                    uint64_t off = global_row * N;
                    auto k_local = k_q_.AllocTensor<bfloat16_t>();
                    AscendC::DataCopyPad(k_local, k_gm_[off],
                        {1, (uint16_t)hs_data_bytes_bf16_, 0, 0}, {false, 0, 0, 0});
                    k_q_.EnQue(k_local);
                }

                // Load v row (reused across heads within same token)
                {
                    uint64_t off = token_idx * N;
                    auto v_local = v_q_.AllocTensor<bfloat16_t>();
                    AscendC::DataCopyPad(v_local, v_gm_[off],
                        {1, (uint16_t)hs_data_bytes_bf16_, 0, 0}, {false, 0, 0, 0});
                    v_q_.EnQue(v_local);
                }

                float rstd_x, rstd_k, raw_dot, gate;
                Compute(hc, rstd_x, rstd_k, raw_dot, gate);
                WriteOutput(global_row, token_idx, hc, rstd_x, rstd_k, raw_dot, gate);
            }
            row = (token_idx + 1) * hc_mult;
        }
    }
private:
    /// Core computation pipeline for a single (token, head) row
    __aicore__ inline void Compute(uint64_t hc, float& rstd_x_out, float& rstd_k_out,
                                   float& raw_dot_out, float& gate_out)
    {
        uint64_t hs_align = hs_align_;            // hidden_size_align for vector API
        uint64_t hs_real = tiling_->hidden_size;  // actual valid element count
        float hs_float = tiling_->hidden_size_float;
        float eps = tiling_->eps;
        float scalar = tiling_->scalar;
        float clamp_val = tiling_->clamp_value;
        bool need_pad = (hs_align > hs_real);

        // Dequeue all loaded bf16 data
        auto x_local = x_q_.DeQue<bfloat16_t>();
        auto k_local = k_q_.DeQue<bfloat16_t>();
        auto v_local = v_q_.DeQue<bfloat16_t>();
        auto wh_local = weight_hidden_q_.DeQue<bfloat16_t>();
        auto we_local = weight_embed_q_.DeQue<bfloat16_t>();

        auto buf_A = buf_a_q_.AllocTensor<float>();
        auto buf_B = buf_b_q_.AllocTensor<float>();
        auto buf_C = buf_c_q_.AllocTensor<float>();
        auto tmp_buf = tmp_q_.AllocTensor<float>();

        // Pre-zero fp32 buffers to ensure padding area is clean
        if (need_pad) {
            AscendC::Muls<float>(buf_A, buf_A, (float)0.0f, (int32_t)hs_align);
            AscendC::Muls<float>(buf_B, buf_B, (float)0.0f, (int32_t)hs_align);
            AscendC::Muls<float>(buf_C, buf_C, (float)0.0f, (int32_t)hs_align);
        }

        // ================================================================
        // Phase 1: RMSNorm for hidden_states (rstd_x)
        //   1. Cast bf16 → fp32, zero pad, square, ReduceSum → mean → rsqrt
        // ================================================================
        AscendC::Cast<float, bfloat16_t>(buf_A, x_local,
            AscendC::RoundMode::CAST_NONE, (int32_t)hs_align);
        if (need_pad) {
            for (uint64_t i = hs_real; i < hs_align; i++) buf_A.SetValue(i, 0.0f);
        }
        AscendC::Mul<float>(buf_A, buf_A, buf_A, (int32_t)hs_align);
        AscendC::ReduceSum<float>(buf_A, buf_A, tmp_buf, (int32_t)hs_align);

        buf_A.SetValue(0, buf_A.GetValue(0) / hs_float + eps);
        AscendC::Sqrt<float>(buf_A, buf_A, 1);
        rstd_x_out = 1.0f / buf_A.GetValue(0);

        // ================================================================
        // Phase 2: RMSNorm for k (rstd_k)
        // ================================================================
        AscendC::Cast<float, bfloat16_t>(buf_B, k_local,
            AscendC::RoundMode::CAST_NONE, (int32_t)hs_align);
        if (need_pad) {
            for (uint64_t i = hs_real; i < hs_align; i++) buf_B.SetValue(i, 0.0f);
        }
        AscendC::Mul<float>(buf_B, buf_B, buf_B, (int32_t)hs_align);
        AscendC::ReduceSum<float>(buf_B, buf_B, tmp_buf, (int32_t)hs_align);

        buf_B.SetValue(0, buf_B.GetValue(0) / hs_float + eps);
        AscendC::Sqrt<float>(buf_B, buf_B, 1);
        rstd_k_out = 1.0f / buf_B.GetValue(0);

        // ================================================================
        // Phase 3: Dot Product: raw_dot = sum((x * wh) * (k * we))
        //   Cast+pad each input before Mul to keep padding clean
        // ================================================================
        AscendC::Cast<float, bfloat16_t>(buf_A, x_local,
            AscendC::RoundMode::CAST_NONE, (int32_t)hs_align);
        if (need_pad) {
            for (uint64_t i = hs_real; i < hs_align; i++) buf_A.SetValue(i, 0.0f);
        }
        AscendC::Cast<float, bfloat16_t>(buf_B, wh_local,
            AscendC::RoundMode::CAST_NONE, (int32_t)hs_align);
        if (need_pad) {
            for (uint64_t i = hs_real; i < hs_align; i++) buf_B.SetValue(i, 0.0f);
        }
        AscendC::Mul<float>(buf_A, buf_A, buf_B, (int32_t)hs_align);  // buf_A = x * wh

        AscendC::Cast<float, bfloat16_t>(buf_B, k_local,
            AscendC::RoundMode::CAST_NONE, (int32_t)hs_align);
        if (need_pad) {
            for (uint64_t i = hs_real; i < hs_align; i++) buf_B.SetValue(i, 0.0f);
        }
        AscendC::Cast<float, bfloat16_t>(buf_C, we_local,
            AscendC::RoundMode::CAST_NONE, (int32_t)hs_align);
        if (need_pad) {
            for (uint64_t i = hs_real; i < hs_align; i++) buf_C.SetValue(i, 0.0f);
        }
        AscendC::Mul<float>(buf_B, buf_B, buf_C, (int32_t)hs_align);  // buf_B = k * we

        AscendC::Mul<float>(buf_A, buf_A, buf_B, (int32_t)hs_align);
        AscendC::ReduceSum<float>(buf_A, buf_A, tmp_buf, (int32_t)hs_align);
        raw_dot_out = buf_A.GetValue(0);

        // ================================================================
        // Phase 4: Gate computation (scalar path)
        // ================================================================
        float dot = raw_dot_out * rstd_x_out * rstd_k_out * scalar;
        float abs_dot = dot;
        if (abs_dot < 0.0f) abs_dot = -abs_dot;
        if (abs_dot < clamp_val) abs_dot = clamp_val;

        buf_A.SetValue(0, abs_dot);
        AscendC::Sqrt<float>(buf_A, buf_A, 1);
        float signed_sqrt = buf_A.GetValue(0);
        if (dot < 0.0f) signed_sqrt = -signed_sqrt;

        buf_A.SetValue(0, -signed_sqrt);
        AscendC::Exp<float>(buf_A, buf_A, 1);
        gate_out = 1.0f / (1.0f + buf_A.GetValue(0));

        // ================================================================
        // Phase 5: Broadcast output = x + gate * v
        // ================================================================
        AscendC::Cast<float, bfloat16_t>(buf_C, v_local,
            AscendC::RoundMode::CAST_NONE, (int32_t)hs_align);
        if (need_pad) {
            for (uint64_t i = hs_real; i < hs_align; i++) buf_C.SetValue(i, 0.0f);
        }
        AscendC::Muls<float>(buf_C, buf_C, gate_out, (int32_t)hs_align);

        AscendC::Cast<float, bfloat16_t>(buf_A, x_local,
            AscendC::RoundMode::CAST_NONE, (int32_t)hs_align);
        if (need_pad) {
            for (uint64_t i = hs_real; i < hs_align; i++) buf_A.SetValue(i, 0.0f);
        }
        AscendC::Add<float>(buf_A, buf_A, buf_C, (int32_t)hs_align);

        auto out_local = out_q_.AllocTensor<bfloat16_t>();
        AscendC::Cast<bfloat16_t, float>(out_local, buf_A,
            AscendC::RoundMode::CAST_ROUND, (int32_t)hs_align);
        out_q_.EnQue<bfloat16_t>(out_local);

        // Free resources
        tmp_q_.FreeTensor(tmp_buf);
        buf_c_q_.FreeTensor(buf_C);
        buf_b_q_.FreeTensor(buf_B);
        buf_a_q_.FreeTensor(buf_A);

        x_q_.FreeTensor(x_local);
        k_q_.FreeTensor(k_local);
        v_q_.FreeTensor(v_local);
        weight_hidden_q_.FreeTensor(wh_local);
        weight_embed_q_.FreeTensor(we_local);
    }

    /// Write computation results to GM
    __aicore__ inline void WriteOutput(uint64_t global_row, uint64_t token_idx, uint64_t hc,
                                       float rstd_x, float rstd_k, float raw_dot, float gate)
    {
        uint64_t N = tiling_->hidden_size;
        uint64_t scalar_idx = token_idx * tiling_->hc_mult + hc;

        // CopyOut: use actual data byte size for DataCopyPad blockLen
        auto out_local = out_q_.DeQue<bfloat16_t>();
        AscendC::DataCopyPad(out_gm_[global_row * N], out_local,
            {1, (uint16_t)hs_data_bytes_bf16_, 0, 0});
        out_q_.FreeTensor(out_local);

        // Write scalar outputs (fp32) via scalar buffer
        auto scalar_buf = scalar_q_.AllocTensor<float>();
        scalar_buf.SetValue(0, raw_dot);
        AscendC::DataCopyPad(raw_dot_gm_[scalar_idx], scalar_buf, {1, 4, 0, 0});

        scalar_buf.SetValue(0, gate);
        AscendC::DataCopyPad(gate_score_gm_[scalar_idx], scalar_buf, {1, 4, 0, 0});

        scalar_buf.SetValue(0, rstd_x);
        AscendC::DataCopyPad(rstd_x_gm_[scalar_idx], scalar_buf, {1, 4, 0, 0});

        scalar_buf.SetValue(0, rstd_k);
        AscendC::DataCopyPad(rstd_k_gm_[scalar_idx], scalar_buf, {1, 4, 0, 0});
        scalar_q_.FreeTensor(scalar_buf);
    }
};

extern "C" __global__ __vector__ void engram_gate_fwd_kernel(
    GM_ADDR hs, GM_ADDR k, GM_ADDR v, GM_ADDR wh, GM_ADDR we,
    GM_ADDR out, GM_ADDR rd, GM_ADDR gs, GM_ADDR rx, GM_ADDR rk, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelEngramGateFwd op(&pipe);
    op.Init(hs, k, v, wh, we, out, rd, gs, rx, rk,
            (__gm__ EngramGateFwdTilingData*)tiling);
    op.Process();
}
