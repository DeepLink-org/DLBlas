/**
 * engram_gate_fwd AscendC Host + Main entry
 *
 * Direct invoke: reads binary input files, launches kernel, writes binary output files.
 * Config file input/config.bin contains: num_tokens(u64), hc_mult(u64), hidden_size(u64),
 *                                          clamp_value(f32), eps(f32)
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <cstring>
#include "acl/acl.h"
#include "../op_kernel/engram_gate_fwd_tiling.h"
#include "data_utils.h"

// Include pure kernel file
#include "../op_kernel/engram_gate_fwd_kernel.asc"
#include <chrono>

// Config file structure (must match gen_data.py output)
struct TestConfig {
    uint64_t num_tokens;
    uint64_t hc_mult;
    uint64_t hidden_size;
    float clamp_value;
    float eps;
};

struct ArgInfo {
    std::string fileName;
    size_t length;
};

aclrtSynchronizeStream(stream);
auto _t0 = std::chrono::high_resolution_clock::now();
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData, size_t tilingSize)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, tilingSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, tilingSize, tilingData, tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // Launch kernel: 10 args + tiling
    engram_gate_fwd_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], inputDevice[1], inputDevice[2],
        inputDevice[3], inputDevice[4],
        outputDevice[0], outputDevice[1], outputDevice[2],
        outputDevice[3], outputDevice[4],
        tilingDevice);
    aclrtSynchronizeStream(stream);
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return ret;
    }

    // Read test config
    TestConfig cfg;
    {
        size_t cfgSize = sizeof(TestConfig);
        uint8_t *cfgBuf = nullptr;
        aclrtMallocHost((void **)&cfgBuf, cfgSize);
        ReadFile("./input/config.bin", cfgSize, cfgBuf, cfgSize);
        memcpy(&cfg, cfgBuf, cfgSize);
        aclrtFreeHost(cfgBuf);
    }

    uint64_t num_tokens  = cfg.num_tokens;
    uint64_t hc_mult     = cfg.hc_mult;
    uint64_t hidden_size = cfg.hidden_size;
    float clamp_value    = cfg.clamp_value;
    float eps            = cfg.eps;

    fprintf(stderr, "Config: num_tokens=%lu, hc_mult=%lu, hidden_size=%lu, clamp=%.10f, eps=%.10f\n",
           num_tokens, hc_mult, hidden_size, clamp_value, eps);

    // Compute sizes
    uint64_t total_rows       = num_tokens * hc_mult;
    size_t bf16_per_elem      = sizeof(uint16_t);  // bfloat16_t
    size_t fp32_per_elem      = sizeof(float);

    size_t hs_bytes    = total_rows * hidden_size * bf16_per_elem;
    size_t k_bytes     = total_rows * hidden_size * bf16_per_elem;
    size_t v_bytes     = num_tokens * hidden_size * bf16_per_elem;
    size_t wh_bytes    = hc_mult * hidden_size * bf16_per_elem;
    size_t we_bytes    = hc_mult * hidden_size * bf16_per_elem;

    size_t out_bytes   = total_rows * hidden_size * bf16_per_elem;
    size_t rd_bytes    = total_rows * fp32_per_elem;
    size_t gs_bytes    = total_rows * fp32_per_elem;
    size_t rx_bytes    = total_rows * fp32_per_elem;
    size_t rk_bytes    = total_rows * fp32_per_elem;

    // Compute tiling
    EngramGateFwdTilingData tiling;
    ComputeTiling(tiling, num_tokens, hc_mult, hidden_size,
                  clamp_value, eps, static_cast<uint32_t>(availableCoreNum));

    // UB capacity validation (DAV_2201: 192 KB = 196608 bytes)
    uint64_t ub_usage = ComputeUBUsage(hidden_size, hc_mult);
    if (ub_usage > UB_CAPACITY_DAV_2201) {
        printf("ERROR: hidden_size=%lu exceeds UB capacity.\n", hidden_size);
        printf("  Total UB required: %lu bytes > %zu bytes (192 KB limit)\n",
               ub_usage, UB_CAPACITY_DAV_2201);
        printf("  Maximum safe hidden_size for hc_mult=%lu: ~%zu\n",
               hc_mult, MaxHiddenSizeForUB(hc_mult));
        aclrtResetDevice(deviceId);
        aclFinalize();
        return -1;
    }

    uint32_t blockNum = tiling.core_num;
    printf("Using %u cores, tile_rows_per_core=%lu, UB usage=%lu bytes\n",
           blockNum, tiling.tile_rows_per_core, ub_usage);

    // Input files (5 inputs)
    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_hidden_states.bin", hs_bytes},
        {"./input/input_k.bin", k_bytes},
        {"./input/input_v.bin", v_bytes},
        {"./input/input_weight_hidden.bin", wh_bytes},
        {"./input/input_weight_embed.bin", we_bytes}
    };

    // Output files (5 outputs)
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", out_bytes},
        {"./output/output_raw_dot.bin", rd_bytes},
        {"./output/output_gate_score.bin", gs_bytes},
        {"./output/output_rstd_x.bin", rx_bytes},
        {"./output/output_rstd_k.bin", rk_bytes}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    KernelCall(blockNum, stream, inputsInfo, outputsInfo,
               (uint8_t *)&tiling, sizeof(EngramGateFwdTilingData));

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("engram_gate_fwd execution completed successfully.\n");
    return 0;
}
