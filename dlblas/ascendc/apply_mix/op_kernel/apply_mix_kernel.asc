#include "kernel_operator.h"
#include "apply_mix_tiling.h"

using namespace AscendC;

class KernelApplyMix {
public:
    __aicore__ inline KernelApplyMix(AscendC::TPipe* pipe) { pipe_ = pipe; }

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR mix, GM_ADDR y,
        const __gm__ ApplyMixTilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t bi = AscendC::GetBlockIdx();
        st_ = bi * tiling->tilesPerCore;
        et_ = st_ + tiling->tilesPerCore;
        if (et_ > tiling->totalTiles) et_ = tiling->totalTiles;
        if (st_ >= tiling->totalTiles) st_ = et_;

        A0_ = tiling->A0;
        R_ = tiling->R;
        tLen_ = tiling->tileA0Len;
        alignedCols_ = tiling->alignedCols;
        tPA0_ = (A0_ + tLen_ - 1) / tLen_;

        // Double Buffer for x loading and y storing
        pipe_->InitBuffer(inQueueX_, DOUBLE_BUFFER, alignedCols_ * R_ * sizeof(float));
        // mixQ_: for batch-level mix loading (loaded only once per batch)
        pipe_->InitBuffer(mixQ_, 1, R_ * sizeof(float));
        // outQueueY_: double buffer result
        pipe_->InitBuffer(outQueueY_, DOUBLE_BUFFER, alignedCols_ * sizeof(float));

        xBase_ = (__gm__ float*)x;
        mBase_ = (__gm__ float*)mix;
        yBase_ = (__gm__ float*)y;
    }

    __aicore__ inline void Process()
    {
        uint32_t prevA1 = 0xFFFFFFFF;  // force first load

        // mixVals: caches mix values for current batch.
        // Size = MAX_MHC_R (from tiling.h), defensively bounded by tiling.
        // Typical R_ <= 4, array occupies 128 bytes on kernel stack.
        float mixVals[MAX_MHC_R];

        for (uint32_t t = st_; t < et_; t++) {
            uint32_t a1 = t / tPA0_, a0t = t % tPA0_;
            uint32_t a0s = a0t * tLen_;
            uint32_t act = tLen_;
            bool isTail = false;
            if (a0t == tPA0_ - 1) {
                act = A0_ - a0s;
                isTail = (act != tLen_);
            }

            // === CopyIn: load x block [R, alignedCols] (Double Buffered) ===
            LocalTensor<float> xTile = inQueueX_.AllocTensor<float>();
            if (isTail) {
                // Tail tile: zero-init then per-row DataCopyPad.
                // Per-row loading is necessary because multi-block DataCopyPad with
                // non-32B-aligned blockLen produces incorrect results on DAV_2201.
                Duplicate<float>(xTile, 0.0f, R_ * alignedCols_);
                PipeBarrier<PIPE_V>();  // Wait for Duplicate to finish before MTE2 operations
                uint16_t tailBytes = static_cast<uint16_t>(act * sizeof(float));
                for (uint32_t r = 0; r < R_; r++) {
                    GlobalTensor<float> rowGm;
                    rowGm.SetGlobalBuffer(
                        xBase_ + a1 * R_ * A0_ + r * A0_ + a0s, act);
                    LocalTensor<float> row = xTile[r * alignedCols_];
                    DataCopyPad(row, rowGm, {1, tailBytes, 0, 0}, {false, 0, 0, 0});
                    // No barrier needed: all DataCopyPad ops are on MTE2 pipe,
                    // and they write to different regions of xTile (sequential within pipe).
                }
            } else {
                uint16_t blockCount = static_cast<uint16_t>(R_);
                uint16_t normBlockLen = static_cast<uint16_t>(tLen_ * sizeof(float));
                uint16_t normStride = static_cast<uint16_t>((A0_ - tLen_) * sizeof(float));
                xRowGm_.SetGlobalBuffer(xBase_ + a1 * R_ * A0_ + a0s, R_ * A0_);
                DataCopyPad(xTile, xRowGm_,
                    {blockCount, normBlockLen, normStride, 0},
                    {false, 0, 0, 0});
            }
            inQueueX_.EnQue(xTile);
            LocalTensor<float> xData = inQueueX_.DeQue<float>();

            // === Load mix (cached per batch, reload only when a1 changes) ===
            if (a1 != prevA1) {
                LocalTensor<float> mBuf = mixQ_.AllocTensor<float>();
                mixGm_.SetGlobalBuffer(mBase_ + a1 * R_, R_);
                DataCopyPad(mBuf, mixGm_,
                    {1, static_cast<uint16_t>(R_ * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                mixQ_.EnQue(mBuf);
                LocalTensor<float> mData = mixQ_.DeQue<float>();
                for (uint32_t r = 0; r < R_; r++) {
                    mixVals[r] = mData.GetValue(r);
                }
                mixQ_.FreeTensor(mData);
                prevA1 = a1;
            }

            // === Compute: per-row Muls + Add accumulation ===
            // v3.0: Manual accumulation avoids PopStackBuffer LCM allocation overhead.
            //       For R=4, each tile does 4x Muls + 3x Add (all vectorized).
            //       This replaces v2.0's ReduceSum<RA> which incurred 94.7% scalar overhead.
            LocalTensor<float> result = outQueueY_.AllocTensor<float>();

            // r=0: result = xData[0] * mixVals[0]  (init + first multiply in one step)
            Muls<float>(result, xData, mixVals[0], act);

            // r=1..R-1: in-place modify row, then accumulate
            for (uint32_t r = 1; r < R_; r++) {
                LocalTensor<float> row = xData[r * alignedCols_];
                Muls<float>(row, row, mixVals[r], act);
                Add<float>(result, result, row, act);
            }

            outQueueY_.EnQue(result);

            // === CopyOut: store result (Double Buffered) ===
            LocalTensor<float> yData = outQueueY_.DeQue<float>();
            yGm_.SetGlobalBuffer(yBase_ + a1 * A0_ + a0s, act);
            DataCopyPad(yGm_, yData, {1, static_cast<uint16_t>(act * sizeof(float)), 0, 0});
            outQueueY_.FreeTensor(yData);

            inQueueX_.FreeTensor(xData);
        }
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ ApplyMixTilingData* tiling;
    __gm__ float *xBase_, *mBase_, *yBase_;
    GlobalTensor<float> xRowGm_, mixGm_, yGm_;
    TQue<TPosition::VECIN, 2> inQueueX_;
    TQue<TPosition::VECIN, 1> mixQ_;
    TQue<TPosition::VECOUT, 2> outQueueY_;
    uint32_t st_, et_, tLen_, A0_, R_, tPA0_, alignedCols_;
};

extern "C" __global__ __vector__ void apply_mix_kernel(
    GM_ADDR x, GM_ADDR mix, GM_ADDR y, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelApplyMix op(&pipe);
    op.Init(x, mix, y, (__gm__ ApplyMixTilingData*)tiling);
    op.Process();
}
