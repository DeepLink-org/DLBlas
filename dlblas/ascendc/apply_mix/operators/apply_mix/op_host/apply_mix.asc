/**
 * apply_mix Host entry (ACL direct invoke with bf16↔fp32 conversion)
 * - Reads bf16 x from file, converts to fp32 for kernel
 * - Kernel computes in fp32
 * - Converts fp32 output to bf16 for file output
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <cstring>
#include "acl/acl.h"
#include "../op_kernel/apply_mix_tiling.h"
#include "data_utils.h"

#include "../op_kernel/apply_mix_kernel.asc"

struct ArgInfo {
    std::string fileName;
    size_t length;
};

// bf16 (uint16_t) → fp32 (float) conversion on CPU
static void bf16_to_fp32_cpu(const uint16_t* src, float* dst, size_t n)
{
    for (size_t i = 0; i < n; i++) {
        uint32_t bits = static_cast<uint32_t>(src[i]) << 16;
        std::memcpy(&dst[i], &bits, sizeof(float));
    }
}

// fp32 (float) → bf16 (uint16_t) conversion on CPU with rounding
static void fp32_to_bf16_cpu(const float* src, uint16_t* dst, size_t n)
{
    for (size_t i = 0; i < n; i++) {
        uint32_t bits;
        std::memcpy(&bits, &src[i], sizeof(float));
        // Round to nearest even
        uint32_t rounding = ((bits >> 16) & 1) + 0x7FFF;
        bits += rounding;
        dst[i] = static_cast<uint16_t>(bits >> 16);
    }
}

void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo>& inputsInfo, std::vector<ArgInfo>& outputsInfo,
    uint8_t* tilingData, uint32_t n0, uint32_t n1, uint32_t mhc, uint32_t h)
{
    size_t xBf16Count = static_cast<size_t>(n0) * n1 * mhc * h;
    size_t xFp32Count = xBf16Count;
    size_t mixFp32Count = static_cast<size_t>(n0) * n1 * mhc;
    size_t yFp32Count = static_cast<size_t>(n0) * n1 * h;
    size_t yBf16Count = yFp32Count;

    // --- Allocate and load bf16 x from file, convert to fp32 ---
    std::vector<uint16_t> xBf16Host(xBf16Count);
    ReadFile(inputsInfo[0].fileName, xBf16Count * sizeof(uint16_t),
        xBf16Host.data(), xBf16Count * sizeof(uint16_t));
    std::vector<float> xFp32Host(xFp32Count);
    bf16_to_fp32_cpu(xBf16Host.data(), xFp32Host.data(), xBf16Count);

    // --- Allocate and load fp32 mix from file ---
    std::vector<float> mixFp32Host(mixFp32Count);
    ReadFile(inputsInfo[1].fileName, mixFp32Count * sizeof(float),
        mixFp32Host.data(), mixFp32Count * sizeof(float));

    // --- Tiling ---
    uint8_t* tilingDevice = nullptr;
    aclrtMalloc((void**)&tilingDevice, sizeof(ApplyMixTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(ApplyMixTilingData), tilingData,
        sizeof(ApplyMixTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    // --- Device memory for x, mix, y (all fp32) ---
    uint8_t *xDevice = nullptr, *mixDevice = nullptr, *yDevice = nullptr;
    aclrtMalloc((void**)&xDevice, xFp32Count * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&mixDevice, mixFp32Count * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, yFp32Count * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(xDevice, xFp32Count * sizeof(float), xFp32Host.data(),
        xFp32Count * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(mixDevice, mixFp32Count * sizeof(float), mixFp32Host.data(),
        mixFp32Count * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);

    // --- Launch kernel ---
    apply_mix_kernel<<<blockNum, nullptr, stream>>>(
        xDevice, mixDevice, yDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    // --- Read fp32 output from device, convert to bf16, write to file ---
    std::vector<float> yFp32Host(yFp32Count);
    aclrtMemcpy(yFp32Host.data(), yFp32Count * sizeof(float), yDevice,
        yFp32Count * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<uint16_t> yBf16Host(yBf16Count);
    fp32_to_bf16_cpu(yFp32Host.data(), yBf16Host.data(), yFp32Count);
    WriteFile(outputsInfo[0].fileName, yBf16Host.data(), yBf16Count * sizeof(uint16_t));

    // --- Cleanup ---
    aclrtFree(tilingDevice);
    aclrtFree(xDevice);
    aclrtFree(mixDevice);
    aclrtFree(yDevice);
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }
    uint32_t coreNum = static_cast<uint32_t>(availableCoreNum);

    uint32_t shape[4] = {0};
    ReadFile("./input/shape.bin", sizeof(shape), shape, sizeof(shape));
    uint32_t n0 = shape[0], n1 = shape[1], mhc = shape[2], h = shape[3];

    printf("Shape: n0=%u, n1=%u, mhc=%u, h=%u\n", n0, n1, mhc, h);

    ApplyMixTilingData tiling = ComputeTiling(n0, n1, mhc, h, coreNum);

    printf("Tiling: A1=%u, R=%u, A0=%u, tileA0Len=%u, alignedCols=%u, totalTiles=%u, tilesPerCore=%u, blockNum=%u (coreNum=%u)\n",
        tiling.A1, tiling.R, tiling.A0, tiling.tileA0Len, tiling.alignedCols,
        tiling.totalTiles, tiling.tilesPerCore, tiling.blockNum, coreNum);

    // File sizes: bf16 for x and y, fp32 for mix
    size_t xFileSize = static_cast<size_t>(n0) * n1 * mhc * h * sizeof(uint16_t);
    size_t mixFileSize = static_cast<size_t>(n0) * n1 * mhc * sizeof(float);
    size_t yFileSize = static_cast<size_t>(n0) * n1 * h * sizeof(uint16_t);

    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_x.bin", xFileSize},
        {"./input/input_mix.bin", mixFileSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", yFileSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(tiling.blockNum, stream, inputsInfo, outputsInfo,
        (uint8_t*)&tiling, n0, n1, mhc, h);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
