#include "kernel_operator.h"
#include "act_quant_kernel_tiling.h"

// ============================================================================
// FP32 → FP8_e4m3fn 标量转换 (DAV_2201 软件实现)
// ============================================================================

__aicore__ inline uint8_t fp32_to_fp8_e4m3fn(float val)
{
    // NaN -> canonical NaN (0x7F)
    if (val != val) return 0x7F;

    // Extract bit pattern via union
    union { float f; uint32_t u; } conv;
    conv.f = val;
    uint32_t bits = conv.u;

    uint8_t sign = (bits >> 31) & 1;
    int32_t exp  = static_cast<int32_t>((bits >> 23) & 0xFF) - 127;
    uint32_t mant = bits & 0x7FFFFF;

    // Zero
    if (exp == -127 && mant == 0) return sign << 7;

    // Overflow: clamp to max (448 = 0x7E)
    if (exp > 8) return (sign << 7) | 0x7E;

    // Compute fp8 biased exponent
    int32_t e8 = exp + 7;

    // Subnormal or very small
    if (e8 <= 0) {
        if (exp < -9) return sign << 7; // too small -> 0
        // Subnormal: shift mantissa right
        uint32_t mfull = mant | 0x800000; // implied 1
        int32_t shift = 20 + (-e8 + 1);
        if (shift >= 24) return sign << 7;
        uint32_t m8 = mfull >> shift;
        // Round: check bit just below LSB
        if (shift > 0) {
            uint32_t roundBit = (mfull >> (shift - 1)) & 1;
            if (roundBit) {
                uint32_t sticky = (shift >= 2) ? ((mfull & ((1u << (shift - 1)) - 1)) != 0) : 0;
                if (sticky || (m8 & 1)) m8++;
            }
        }
        if (m8 > 7) m8 = 7;
        return (sign << 7) | (m8 & 0x7);
    }

    // Normal value
    if (e8 > 15) e8 = 15;

    // Round mantissa from 23 bits to 3 bits (round to nearest even)
    uint32_t m8 = mant >> 20;
    uint32_t roundBit = (mant >> 19) & 1;
    uint32_t sticky = (mant & 0x7FFFF) != 0;

    if (roundBit && (sticky || (m8 & 1))) {
        m8++;
        if (m8 == 8) {
            m8 = 0;
            e8++;
            if (e8 > 15) e8 = 15;
        }
    }

    return (sign << 7) | ((e8 & 0xF) << 3) | (m8 & 0x7);
}

// ============================================================================
// Kernel 模板类
// ============================================================================

template<typename T>
class KernelActQuant {
public:
    __aicore__ inline KernelActQuant(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR xGmAddr, GM_ADDR qGmAddr, GM_ADDR sGmAddr,
                                 const __gm__ ActQuantTiling* tilingData)
    {
        this->tiling = tilingData;
        uint32_t blockIdx = AscendC::GetBlockIdx();

        uint32_t startGroup = blockIdx * tiling->coreGroups;
        uint32_t endGroup = startGroup + tiling->coreGroups;
        if (endGroup > tiling->numGroups) endGroup = tiling->numGroups;
        if (startGroup >= tiling->numGroups) startGroup = tiling->numGroups;

        coreStartGroup = startGroup;
        coreGroups = endGroup - startGroup;
        tileNum = (coreGroups + tiling->tileGroups - 1) / tiling->tileGroups;

        uint32_t coreElements = coreGroups * tiling->groupSize;
        uint32_t coreQBytes = coreGroups * tiling->groupSize;
        uint32_t coreSBytes = coreGroups * sizeof(float);

        uint64_t xOffset = (uint64_t)startGroup * tiling->groupSize;
        uint64_t qOffset = (uint64_t)startGroup * tiling->groupSize;
        uint64_t sOffset = (uint64_t)startGroup;

        xGm.SetGlobalBuffer((__gm__ T*)xGmAddr + xOffset, coreElements + tiling->groupSizeAlign);
        qGm.SetGlobalBuffer((__gm__ uint8_t*)qGmAddr + qOffset, coreQBytes + tiling->groupSize);
        sGm.SetGlobalBuffer((__gm__ float*)sGmAddr + sOffset, coreSBytes + 1);

        uint32_t tileElements = tiling->tileGroups * tiling->groupSizeAlign;
        uint32_t tileQBytes = tiling->tileGroups * tiling->groupSize;
        uint32_t tileSBytes = tiling->tileGroups * sizeof(float);

        pipe_->InitBuffer(inQueueX, DOUBLE_BUFFER, tileElements * sizeof(T));
        pipe_->InitBuffer(outQueueQ, DOUBLE_BUFFER, tileQBytes);
        pipe_->InitBuffer(outQueueS, 1, tileSBytes);
        pipe_->InitBuffer(scaleBuf, tileSBytes);
        pipe_->InitBuffer(reduceBuf, REDUCE_BUF_SIZE);
        pipe_->InitBuffer(castBuf, tiling->groupSize * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t ti = 0; ti < tileNum; ti++) {
            uint32_t thisTileGroups = tiling->tileGroups;
            if (ti == tileNum - 1) {
                thisTileGroups = coreGroups - ti * tiling->tileGroups;
            }
            if (thisTileGroups == 0) break;

            CopyIn(ti, thisTileGroups);
            Compute(thisTileGroups);
            CopyOut(ti, thisTileGroups);
        }
    }

    __aicore__ inline void CopyIn(uint32_t tileIdx, uint32_t tileGroups)
    {
        uint32_t elements = tileGroups * tiling->groupSizeAlign;
        uint32_t bytes = elements * sizeof(T);

        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        uint64_t elemOffset = (uint64_t)tileIdx * tiling->tileGroups * tiling->groupSizeAlign;

        AscendC::DataCopyPad(xLocal, xGm[elemOffset],
            {1, static_cast<uint16_t>(bytes), 0, 0},
            {false, 0, 0, 0});

        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint32_t tileGroups)
    {
        AscendC::LocalTensor<T> inData = inQueueX.DeQue<T>();
        AscendC::LocalTensor<uint8_t> qLocal = outQueueQ.AllocTensor<uint8_t>();
        AscendC::LocalTensor<float> sLocal = outQueueS.AllocTensor<float>();
        AscendC::LocalTensor<float> scales = scaleBuf.Get<float>();
        AscendC::LocalTensor<float> castWork = castBuf.Get<float>();

        uint32_t gsa = tiling->groupSizeAlign;
        uint32_t gs  = tiling->groupSize;
        float fp8Max = tiling->fp8Max;
        float fp8Min = tiling->fp8Min;
        float eps = tiling->eps;

        for (uint32_t g = 0; g < tileGroups; g++) {
            uint32_t rowOffset = g * gsa;

            // Step 1: Cast input group to fp32
            AscendC::Cast<float, T>(castWork, inData[rowOffset],
                AscendC::RoundMode::CAST_NONE, static_cast<int32_t>(gs));

            // Step 2: Abs in fp32
            AscendC::Abs(castWork, castWork, static_cast<int32_t>(gs));

            // Step 3: ReduceMax in fp32 -> scalar at scales[g]
            AscendC::LocalTensor<float> scalePtr = scales[g];
            AscendC::LocalTensor<float> reduceWork = reduceBuf.Get<float>();
            AscendC::ReduceMax<float>(scalePtr, castWork, reduceWork,
                static_cast<int32_t>(gs), false);

            // Step 3b: Clamp amax with eps
            float amax = scalePtr.GetValue(0);
            if (amax < eps) amax = eps;
            if (amax != amax) amax = eps;

            // Step 4: scale = amax / fp8_max
            float scale = amax / fp8Max;

            scalePtr.SetValue(0, scale);

            // Step 5: Quantize: castWork elements after abs → need original values
            // Re-cast input group to fp32 (without abs)
            AscendC::Cast<float, T>(castWork, inData[rowOffset],
                AscendC::RoundMode::CAST_NONE, static_cast<int32_t>(gs));

            // Step 6: x / scale
            float invScale = 1.0f / scale;
            AscendC::Muls(castWork, castWork, invScale, static_cast<int32_t>(gs));

            // Clamp to [fp8Min, fp8Max]
            AscendC::Mins(castWork, castWork, fp8Max, static_cast<int32_t>(gs));
            AscendC::Maxs(castWork, castWork, fp8Min, static_cast<int32_t>(gs));

            // Step 7: fp32 -> fp8_e4m3fn via scalar conversion
            for (uint32_t j = 0; j < gs; j++) {
                float fval = castWork.GetValue(j);
                uint8_t fp8val = fp32_to_fp8_e4m3fn(fval);
                qLocal.SetValue(g * gs + j, fp8val);
            }
        }

        // Copy computed scales to output buffer
        for (uint32_t g = 0; g < tileGroups; g++) {
            sLocal.SetValue(g, scales.GetValue(g));
        }

        outQueueQ.EnQue<uint8_t>(qLocal);
        outQueueS.EnQue<float>(sLocal);
        inQueueX.FreeTensor(inData);
    }

    __aicore__ inline void CopyOut(uint32_t tileIdx, uint32_t tileGroups)
    {
        AscendC::LocalTensor<uint8_t> qLocal = outQueueQ.DeQue<uint8_t>();
        uint32_t qBytes = tileGroups * tiling->groupSize;
        uint64_t qGmOff = (uint64_t)tileIdx * tiling->tileGroups * tiling->groupSize;

        AscendC::DataCopyPad(qGm[qGmOff], qLocal,
            {1, static_cast<uint16_t>(qBytes), 0, 0});
        outQueueQ.FreeTensor(qLocal);

        AscendC::LocalTensor<float> sLocal = outQueueS.DeQue<float>();
        uint32_t sBytes = tileGroups * sizeof(float);
        uint64_t sGmOff = (uint64_t)tileIdx * tiling->tileGroups;

        AscendC::DataCopyPad(sGm[sGmOff], sLocal,
            {1, static_cast<uint16_t>(sBytes), 0, 0});
        outQueueS.FreeTensor(sLocal);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ ActQuantTiling* tiling;

    AscendC::GlobalTensor<T>      xGm;
    AscendC::GlobalTensor<uint8_t> qGm;
    AscendC::GlobalTensor<float>  sGm;

    AscendC::TQue<AscendC::TPosition::VECIN, 1>  inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueQ;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueS;

    AscendC::TBuf<AscendC::TPosition::VECCALC> scaleBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> castBuf;

    uint32_t coreStartGroup;
    uint32_t coreGroups;
    uint32_t tileNum;
};

// ============================================================================
// Kernel entry points
// ============================================================================

extern "C" __global__ __vector__ void act_quant_kernel_kernel(
    GM_ADDR x, GM_ADDR q, GM_ADDR s, GM_ADDR tiling)
{
    auto* tilingData = (__gm__ ActQuantTiling*)tiling;
    AscendC::TPipe pipe;

    if (tilingData->inputDtype == InputDtype::BF16) {
        KernelActQuant<bfloat16_t> op(&pipe);
        op.Init(x, q, s, tilingData);
        op.Process();
    } else {
        KernelActQuant<half> op(&pipe);
        op.Init(x, q, s, tilingData);
        op.Process();
    }
}
