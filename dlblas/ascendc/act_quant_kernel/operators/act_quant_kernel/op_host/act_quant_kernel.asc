// ============================================================================
// Ascend C Kernel 直调 - act_quant_kernel (Host + Main)
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <cmath>
#include "acl/acl.h"
#include "../op_kernel/act_quant_kernel_tiling.h"
#include "data_utils.h"

// 引用 kernel 文件
#include "../op_kernel/act_quant_kernel_kernel.asc"

// ============================================================================
// Host 端代码
// ============================================================================

struct ArgInfo {
    std::string fileName;
    size_t length;
};

void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(ActQuantTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(ActQuantTiling), tilingData,
        sizeof(ActQuantTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // 1 input (x), 2 outputs (x_q, x_s), 1 tiling
    act_quant_kernel_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0],
        outputDevice[0], outputDevice[1],
        tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// ============================================================================
// Tiling 参数计算
// ============================================================================

void ComputeTiling(ActQuantTiling& tiling, uint32_t totalElements,
                   uint32_t groupSize, uint32_t dsize, bool useUe8m0,
                   uint32_t coreNum)
{
    tiling.numGroups = totalElements / groupSize;
    tiling.groupSize = groupSize;
    tiling.groupSizeAlign = calcGroupSizeAlign(groupSize, dsize);
    tiling.fp8Max = FP8_E4M3FN_MAX;
    tiling.fp8Min = FP8_E4M3FN_MIN;
    tiling.eps = 1e-10f;
    tiling.scaleUe8m0 = useUe8m0;
    tiling.inputDtype = (dsize == 2) ? InputDtype::BF16 : InputDtype::FP16;

    // Groups per core
    uint32_t numGroups = tiling.numGroups;
    tiling.coreGroups = (numGroups + coreNum - 1) / coreNum;
    if (tiling.coreGroups < 1) tiling.coreGroups = 1;

    // Tile groups: based on UB constraint
    // Conservative estimate: ~128 for groupSize=128, 256 for groupSize=64, etc.
    if (groupSize >= 128) {
        tiling.tileGroups = 128;
    } else if (groupSize >= 64) {
        tiling.tileGroups = 256;
    } else if (groupSize >= 32) {
        tiling.tileGroups = 512;
    } else {
        tiling.tileGroups = 1024;
    }
    if (tiling.tileGroups > tiling.coreGroups) {
        tiling.tileGroups = tiling.coreGroups;
    }
    if (tiling.tileGroups < 1) tiling.tileGroups = 1;
}

int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // Get core count
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }
    printf("Available VectorCore count: %ld\n", availableCoreNum);

    // ============== Test Configuration ==============
    // Default test: [16, 128] bf16, group_size=128
    uint32_t totalElements = 16 * 128;   // 2048 elements
    uint32_t groupSize = 128;
    uint32_t dsize = 2;                  // bf16 = 2 bytes
    bool useUe8m0 = false;

    // Override from command line (optional): argv[1]=totalElements argv[2]=groupSize
    if (argc >= 2) totalElements = (uint32_t)std::atoi(argv[1]);
    if (argc >= 3) groupSize = (uint32_t)std::atoi(argv[2]);
    if (argc >= 4) useUe8m0 = (std::atoi(argv[3]) != 0);

    printf("act_quant_kernel config:\n");
    printf("  totalElements = %u\n", totalElements);
    printf("  groupSize     = %u\n", groupSize);
    printf("  dataTypeSize  = %u (bf16)\n", dsize);
    printf("  scaleUe8m0    = %s\n", useUe8m0 ? "true" : "false");

    size_t inputByteSize = totalElements * dsize;
    size_t numGroups = totalElements / groupSize;

    // Compute tiling
    ActQuantTiling tiling;
    ComputeTiling(tiling, totalElements, groupSize, dsize, useUe8m0,
                  (uint32_t)availableCoreNum);

    uint32_t blockNum = (tiling.numGroups + tiling.coreGroups - 1) / tiling.coreGroups;
    if (blockNum < 1) blockNum = 1;
    if (blockNum > (uint32_t)availableCoreNum) blockNum = (uint32_t)availableCoreNum;

    printf("Tiling:\n");
    printf("  numGroups      = %u\n", tiling.numGroups);
    printf("  groupSize      = %u\n", tiling.groupSize);
    printf("  groupSizeAlign = %u\n", tiling.groupSizeAlign);
    printf("  coreGroups     = %u\n", tiling.coreGroups);
    printf("  tileGroups     = %u\n", tiling.tileGroups);
    printf("  blockNum       = %u\n", blockNum);

    size_t qOutputByteSize = totalElements;              // fp8 = 1 byte each
    size_t sOutputByteSize = numGroups * sizeof(float);   // fp32 scale per group

    // Input/Output files
    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_x.bin", inputByteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output_q.bin", qOutputByteSize},
        {"./output/output_s.bin", sOutputByteSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(blockNum, stream, inputsInfo, outputsInfo, (uint8_t *)&tiling);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("act_quant_kernel completed successfully.\n");
    return 0;
}
