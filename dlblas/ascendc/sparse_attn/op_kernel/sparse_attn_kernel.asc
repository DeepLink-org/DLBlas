/**
 * sparse_attn_kernel.asc - TEST: Q+1 → O
 */
#include "kernel_operator.h"
#include "sparse_attn_tiling.h"
using namespace AscendC;

class KernelSparseAttn {
public:
    __aicore__ inline KernelSparseAttn(TPipe* p) : pipe_(p) {}
    __aicore__ inline void Init(GM_ADDR q,GM_ADDR kv,GM_ADDR snk,GM_ADDR ix,GM_ADDR o,GM_ADDR tl) {
        tiling_=(const __gm__ SparseAttnTilingData*)tl;
        B_=tiling_->batchSize; M_=tiling_->seqLen; H_=tiling_->nHeads; D_=tiling_->headDim;
        T_=tiling_->topk; N_=tiling_->kvLen; HC_=tiling_->hChunk; TC_=tiling_->tChunk;
        tt_=tiling_->totalTasks; uc_=tiling_->usedCoreNum;
        qr_=(__gm__ bfloat16_t*)q; or_=(__gm__ bfloat16_t*)o;
        pipe_->InitBuffer(tQ_,HC_*D_*sizeof(bfloat16_t));
        pipe_->InitBuffer(tQF_,HC_*D_*sizeof(float));
    }
    __aicore__ inline void Process(){uint32_t bi=GetBlockIdx();for(uint32_t ti=bi;ti<tt_;ti+=uc_)Task(ti/M_,ti%M_);}
private:
    TPipe* pipe_; const __gm__ SparseAttnTilingData* tiling_;
    uint32_t B_,M_,H_,D_,T_,N_,HC_,TC_; float SC_; uint32_t tt_,uc_;
    __gm__ bfloat16_t *qr_,*or_;
    TBuf<TPosition::LCM> tQ_,tQF_;
    static constexpr uint16_t M16(uint32_t b){return (uint16_t)b;}
    __aicore__ inline void Task(uint32_t ba,uint32_t ma){
        for(uint32_t hc=0;hc<H_;hc+=HC_){
            uint32_t cH=(hc+HC_<=H_)?HC_:(H_-hc);
            LocalTensor<bfloat16_t> qb=tQ_.Get<bfloat16_t>();
            { GlobalTensor<bfloat16_t> g; g.SetGlobalBuffer(qr_+((ba*M_+ma)*H_+hc)*D_,cH*D_);
              DataCopyPad(qb,g,{1,M16(cH*D_*sizeof(bfloat16_t)),0,0},{false,0,0,0}); }
            PipeBarrier<PIPE_MTE2>();
            LocalTensor<float> qf=tQF_.Get<float>();
            Cast(qf,qb,RoundMode::CAST_NONE,cH*D_);
            tQ_.FreeTensor(qb);
            // Q+1.0 using Add with a buffer of ones
            { LocalTensor<float> ones=tQ_.Get<float>(); 
              for(uint32_t i=0;i<cH*D_;i++) ones.SetValue(i,1.f);
              Add(qf,qf,ones,cH*D_);
              tQ_.FreeTensor(ones); }
            // Cast back bf16 and write
            LocalTensor<bfloat16_t> ob=tQ_.Get<bfloat16_t>();
            Cast(ob,qf,RoundMode::CAST_ROUND,cH*D_);
            { GlobalTensor<bfloat16_t> g; g.SetGlobalBuffer(or_+((ba*M_+ma)*H_+hc)*D_,cH*D_);
              DataCopyPad(g,ob,{1,M16(cH*D_*sizeof(bfloat16_t)),0,0}); }
            tQ_.FreeTensor(ob);
            tQF_.FreeTensor(qf);
        }
    }
};
extern "C" __global__ __vector__ void sparse_attn_kernel(GM_ADDR q,GM_ADDR kv,GM_ADDR snk,GM_ADDR ix,GM_ADDR o,GM_ADDR tl){
    TPipe pipe; KernelSparseAttn op(&pipe); op.Init(q,kv,snk,ix,o,tl); op.Process();
}
