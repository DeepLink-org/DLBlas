/**
 * SparseAttn Kernel - Complete working implementation
 * All fp32 computation after initial Cast. No operator[].
 */
#include "kernel_operator.h"
#include "sparse_attn_tiling.h"
using namespace AscendC;

class KernelSparseAttn {
public:
    __aicore__ inline KernelSparseAttn(TPipe*p):pipe_(p){}
    __aicore__ inline void Init(GM_ADDR qg,GM_ADDR kg,GM_ADDR ig,GM_ADDR sg,GM_ADDR og,
                                 const __gm__ SparseAttnTiling*tl){
        if(GetBlockIdx()>=tl->usedCoreNum){ok_=false;return;}ok_=true;
        B_=tl->b;M_=tl->m;N_=tl->n;H_=tl->h;D_=tl->d;K_=tl->topk;
        HD_=H_*D_;ND_=N_*D_;KD_=K_*D_;sc_=tl->softmax_scale;
        Q_=(__gm__ bfloat16_t*)qg;Kv_=(__gm__ bfloat16_t*)kg;
        Id_=(__gm__ int32_t*)ig;Sk_=(__gm__ float*)sg;O_=(__gm__ bfloat16_t*)og;
        uint32_t s=GetBlockIdx()*tl->tasksPerCore,e=s+tl->tasksPerCore;
        if(e>tl->totalTasks)e=tl->totalTasks;t0_=s;tn_=e-s;
    }
    __aicore__ inline void Process(){
        if(!ok_)return;
        for(uint32_t t=t0_;t<t0_+tn_;){
            uint32_t sz=t0_+tn_-t;if(sz>TILE_M_MAX)sz=TILE_M_MAX;
            uint32_t bIdx=t/M_,qfn=sz*HD_,kfn=ND_,gfn=sz*KD_,sfn=sz*H_*K_,ofn=sz*HD_;
            // Load inputs
            uint32_t qb=sz*HD_*sizeof(bfloat16_t),kvb=ND_*sizeof(bfloat16_t);
            uint32_t ib=sz*K_*sizeof(int32_t),sb=H_*sizeof(float);
            pipe_->InitBuffer(i0_,1,qb);LocalTensor<bfloat16_t>ql=i0_.AllocTensor<bfloat16_t>();
            {GlobalTensor<bfloat16_t>g;g.SetGlobalBuffer(Q_+t*HD_,qfn);
             DataCopyPad(ql,g,{1,(uint16_t)qb,0,0},{0,0,0,0});}i0_.EnQue(ql);
            pipe_->InitBuffer(i1_,1,kvb);LocalTensor<bfloat16_t>kl=i1_.AllocTensor<bfloat16_t>();
            {GlobalTensor<bfloat16_t>g;g.SetGlobalBuffer(Kv_+bIdx*ND_,kfn);
             DataCopyPad(kl,g,{1,(uint16_t)kvb,0,0},{0,0,0,0});}i1_.EnQue(kl);
            pipe_->InitBuffer(i2_,1,ib);LocalTensor<int32_t>il=i2_.AllocTensor<int32_t>();
            {GlobalTensor<int32_t>g;g.SetGlobalBuffer(Id_+t*K_,sz*K_);
             DataCopyPad(il,g,{1,(uint16_t)ib,0,0},{0,0,0,0});}i2_.EnQue(il);
            pipe_->InitBuffer(i3_,1,sb);LocalTensor<float>sl=i3_.AllocTensor<float>();
            {GlobalTensor<float>g;g.SetGlobalBuffer(Sk_,H_);
             DataCopyPad(sl,g,{1,(uint16_t)sb,0,0},{0,0,0,0});}i3_.EnQue(sl);
            // DeQue
            LocalTensor<bfloat16_t>qi=i0_.DeQue<bfloat16_t>();
            LocalTensor<bfloat16_t>ki=i1_.DeQue<bfloat16_t>();
            LocalTensor<int32_t>iI=i2_.DeQue<int32_t>();
            LocalTensor<float>sK=i3_.DeQue<float>();
            // Cast to fp32
            pipe_->InitBuffer(f0_,1,qfn*sizeof(float));LocalTensor<float>qf=f0_.AllocTensor<float>();
            Cast(qf,qi,RoundMode::CAST_NONE,qfn);i0_.FreeTensor(qi);
            pipe_->InitBuffer(f1_,1,kfn*sizeof(float));LocalTensor<float>kf=f1_.AllocTensor<float>();
            Cast(kf,ki,RoundMode::CAST_NONE,kfn);i1_.FreeTensor(ki);
            pipe_->InitBuffer(f2_,1,gfn*sizeof(float));LocalTensor<float>gf=f2_.AllocTensor<float>();
            // Gather KV
            for(uint32_t i=0;i<sz;i++)for(uint32_t k=0;k<K_;k++){
                int32_t r=iI.GetValue(i*K_+k);uint32_t sidx=(r>=0)?(uint32_t)r:0;bool ok2=(r>=0);
                uint32_t so=sidx*D_,d_o=(i*K_+k)*D_;
                if(ok2)for(uint32_t dd=0;dd<D_;dd++)gf.SetValue(d_o+dd,kf.GetValue(so+dd));
                else for(uint32_t dd=0;dd<D_;dd++)gf.SetValue(d_o+dd,0.0f);
            }
            f1_.FreeTensor(kf);
            // Scores
            pipe_->InitBuffer(f3_,1,sfn*sizeof(float));LocalTensor<float>sf=f3_.AllocTensor<float>();
            for(uint32_t i=0;i<sz;i++)for(uint32_t hh=0;hh<H_;hh++){
                uint32_t qBase=i*HD_+hh*D_;
                for(uint32_t t2=0;t2<K_;t2++){uint32_t kvBase=i*KD_+t2*D_;float acc=0;
                    for(uint32_t dd=0;dd<D_;dd++)acc+=qf.GetValue(qBase+dd)*gf.GetValue(kvBase+dd);
                    sf.SetValue(i*H_*K_+hh*K_+t2,acc*sc_);
                }
            }
            // Mask invalid
            {constexpr float NI=-1e30f;
             for(uint32_t i=0;i<sz;i++)for(uint32_t k=0;k<K_;k++)
                 if(iI.GetValue(i*K_+k)<0)for(uint32_t hh=0;hh<H_;hh++)sf.SetValue(i*H_*K_+hh*K_+k,NI);}
            i2_.FreeTensor(iI);
            // Softmax with sink (all scalar, no operator[])
            pipe_->InitBuffer(f4_,1,K_*sizeof(float));
            {constexpr float EP=1e-10f;
             for(uint32_t i=0;i<sz;i++)for(uint32_t hh=0;hh<H_;hh++){
                 uint32_t bo=i*H_*K_+hh*K_;float mv=-1e30f;
                 for(uint32_t t2=0;t2<K_;t2++){float v=sf.GetValue(bo+t2);if(v>mv)mv=v;}
                 float sv=sK.GetValue(hh);float mx=(sv>mv)?sv:mv;
                 LocalTensor<float>et=f4_.AllocTensor<float>();
                 for(uint32_t t2=0;t2<K_;t2++)et.SetValue(t2,sf.GetValue(bo+t2)-mx);
                 AscendC::Exp(et,et,K_);float sm=0;
                 for(uint32_t t2=0;t2<K_;t2++){
                     if(sf.GetValue(bo+t2)<-1e20f)sf.SetValue(bo+t2,0);
                     else{float ev=et.GetValue(t2);sf.SetValue(bo+t2,ev);sm+=ev;}
                 }
                 f4_.FreeTensor(et);
                 {LocalTensor<float>se=f4_.AllocTensor<float>();se.SetValue(0,sv-mx);
                  AscendC::Exp(se,se,1);sm+=se.GetValue(0);f4_.FreeTensor(se);}
                 if(sm<EP)sm=EP;float inv=1.0f/sm;
                 for(uint32_t t2=0;t2<K_;t2++)sf.SetValue(bo+t2,sf.GetValue(bo+t2)*inv);
             }}
            i3_.FreeTensor(sK);
            // Weighted sum → qf (reuse)
            for(uint32_t i=0;i<sz;i++)for(uint32_t hh=0;hh<H_;hh++){
                uint32_t ab=i*H_*K_+hh*K_,ob=i*HD_+hh*D_;
                for(uint32_t dd=0;dd<D_;dd++){float acc=0;
                    for(uint32_t t2=0;t2<K_;t2++)acc+=sf.GetValue(ab+t2)*gf.GetValue(i*KD_+t2*D_+dd);
                    qf.SetValue(ob+dd,acc);
                }
            }
            f3_.FreeTensor(sf);f2_.FreeTensor(gf);
            // Cast fp32→bf16 output
            uint32_t ob2=ofn*sizeof(bfloat16_t);
            pipe_->InitBuffer(o0_,1,ob2);LocalTensor<bfloat16_t>ol=o0_.AllocTensor<bfloat16_t>();
            Cast(ol,qf,RoundMode::CAST_ROUND,ofn);f0_.FreeTensor(qf);
            o0_.EnQue(ol);
            // CopyOut
            {LocalTensor<bfloat16_t>oi=o0_.DeQue<bfloat16_t>();
             GlobalTensor<bfloat16_t>og;og.SetGlobalBuffer(O_+t*HD_,ofn);
             DataCopyPad(og,oi,{1,(uint16_t)ob2,0,0});o0_.FreeTensor(oi);}
            t+=sz;
        }
    }
    TPipe*pipe_;bool ok_;float sc_;
    uint32_t B_,M_,N_,H_,D_,K_,HD_,ND_,KD_,t0_,tn_;
    __gm__ bfloat16_t*Q_,*Kv_,*O_;__gm__ int32_t*Id_;__gm__ float*Sk_;
    TQue<TPosition::VECIN,1>i0_,i1_,i2_,i3_,f0_,f1_,f2_,f3_,f4_;
    TQue<TPosition::VECOUT,1>o0_;
};

extern "C" __global__ __vector__ void sparse_attn_kernel(
    GM_ADDR qg,GM_ADDR kg,GM_ADDR ig,GM_ADDR sg,GM_ADDR og,GM_ADDR tiling)
{ TPipe p;KernelSparseAttn o(&p);
  o.Init(qg,kg,ig,sg,og,(__gm__ SparseAttnTiling*)tiling);o.Process();}
