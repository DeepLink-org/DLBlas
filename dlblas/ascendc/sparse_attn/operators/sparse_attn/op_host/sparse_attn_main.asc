// ============================================================================
// Sparse Attention - Host + Main 入口
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <cmath>
#include "acl/acl.h"
#include "../op_kernel/sparse_attn_tiling.h"
#include "data_utils.h"

// 引用拆出的纯 kernel 文件
#include "../op_kernel/sparse_attn_kernel.asc"

// ============================================================================
// Compute TilingData from input shapes (thin wrapper around shared function)
// ============================================================================
static SparseAttnTilingData computeTilingData(
    uint32_t b, uint32_t m, uint32_t h, uint32_t d,
    uint32_t topk, uint32_t n, float scale, uint32_t aicCoreNum)
{
    // P2 fix: UB 容量作为参数传入 computeTiling()，替代硬编码常量。
    // DAV_2201 系列 UB = 192KB。若迁移到其他架构（如 DAV_3510），
    // 修改此常量即可。在 TilingContext 路径下可改用 GetUbSize(context)。
    constexpr uint32_t UB_BUDGET = 192 * 1024;
    return computeTiling(b, m, h, d, topk, n, scale, aicCoreNum, UB_BUDGET);
}

// ============================================================================
// ArgInfo and KernelCall
// ============================================================================
struct ArgInfo {
    std::string fileName;
    size_t length;
};

void kernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo>& inputsInfo, std::vector<ArgInfo>& outputsInfo,
    uint8_t* tilingData)
{
    std::vector<uint8_t*> inputHost(inputsInfo.size());
    std::vector<uint8_t*> inputDevice(inputsInfo.size());
    std::vector<uint8_t*> outputHost(outputsInfo.size());
    std::vector<uint8_t*> outputDevice(outputsInfo.size());
    uint8_t* tilingDevice = nullptr;

    aclrtMalloc((void**)&tilingDevice, sizeof(SparseAttnTilingData),
                ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(SparseAttnTilingData), tilingData,
                sizeof(SparseAttnTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void**)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void**)&inputDevice[i], inputsInfo[i].length,
                    ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i],
                 inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
                    inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void**)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void**)&outputDevice[i], outputsInfo[i].length,
                    ACL_MEM_MALLOC_HUGE_FIRST);
    }

    sparse_attn_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0],   // q
        inputDevice[1],   // kv
        inputDevice[2],   // attn_sink
        inputDevice[3],   // topk_idxs
        outputDevice[0],  // o
        tilingDevice);

    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
                    outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// ============================================================================
// Main entry
// ============================================================================
int32_t main(int32_t argc, char* argv[])
{
    setbuf(stdout, NULL);  // Disable stdout buffering for debug
    printf("DEBUG: main start, argc=%d\n", argc);
    aclInit(nullptr);
    printf("DEBUG: aclInit done\n");
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    printf("DEBUG: aclrtSetDevice ret=%d\n", ret);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // Get available core count
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM,
                             &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // Default shape: b=2, m=16, n=32, h=8, d=64, topk=16
    uint32_t b = 2, m = 16, n = 32, h = 8, d = 64, topk = 16;
    float softmaxScale = 1.0f / sqrtf((float)d);

    // Allow shape override via command line: b m n h d topk
    if (argc >= 7) {
        b = atoi(argv[1]);
        m = atoi(argv[2]);
        n = atoi(argv[3]);
        h = atoi(argv[4]);
        d = atoi(argv[5]);
        topk = atoi(argv[6]);
        softmaxScale = 1.0f / sqrtf((float)d);
    }

    SparseAttnTilingData tiling = computeTilingData(
        b, m, h, d, topk, n, softmaxScale, (uint32_t)availableCoreNum);

    printf("DEBUG: tiling done, before kernelCall\n");
    fflush(stdout);

    uint32_t blockNum = tiling.usedCoreNum;
    size_t qSize = (size_t)b * m * h * d * sizeof(uint16_t);
    size_t kvSize = (size_t)b * n * d * sizeof(uint16_t);
    size_t sinkSize = (size_t)h * sizeof(float);
    size_t topkSize = (size_t)b * m * topk * sizeof(int32_t);
    size_t oSize = qSize;

    printf("SparseAttn: b=%u m=%u n=%u h=%u d=%u topk=%u\n", b, m, n, h, d, topk);
    printf("  ubBudget=%u hChunk=%u tChunk=%u hLoop=%u tLoop=%u\n",
           tiling.ubSize, tiling.hChunk, tiling.tChunk,
           tiling.hLoopCount, tiling.tLoopCount);
    printf("  totalTasks=%u usedCoreNum=%u blockNum=%u\n",
           tiling.totalTasks, tiling.usedCoreNum, blockNum);
    printf("  softmaxScale=%.6f\n", tiling.softmaxScale);

    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_q.bin", qSize},
        {"./input/input_kv.bin", kvSize},
        {"./input/input_sink.bin", sinkSize},
        {"./input/input_idxs.bin", topkSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", oSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    kernelCall(blockNum, stream, inputsInfo, outputsInfo,
               (uint8_t*)&tiling);

    printf("DEBUG: kernelCall returned\n");
    fflush(stdout);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
