// ============================================================================
// SparseAttn Host 侧入口 - 数据加载、Tiling 计算、Kernel 启动
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <cmath>
#include "acl/acl.h"
#include "../op_kernel/sparse_attn_tiling.h"
#include "data_utils.h"

// 引用 kernel 文件（包含 kernel_operator.h）
#include "../op_kernel/sparse_attn_kernel.asc"
#include <chrono>

// ============================================================================
// Tiling 计算
// ============================================================================

inline SparseAttnTiling ComputeTiling(
    uint32_t b, uint32_t m, uint32_t n, uint32_t h, uint32_t d, uint32_t topk,
    float softmax_scale,
    uint32_t aivNum)
{
    SparseAttnTiling tiling;
    tiling.b   = b;
    tiling.m   = m;
    tiling.n   = n;
    tiling.h   = h;
    tiling.d   = d;
    tiling.topk = topk;

    tiling.totalTasks = b * m;
    tiling.usedCoreNum = (aivNum < tiling.totalTasks) ? aivNum : tiling.totalTasks;
    if (tiling.usedCoreNum < 1) tiling.usedCoreNum = 1;

    tiling.tasksPerCore = (tiling.totalTasks + tiling.usedCoreNum - 1) / tiling.usedCoreNum;

    // tile_m 计算：基于 UB 容量
    // Stage B 峰值 = tile_m × (4*h*d + 4*h*topk + 4*topk*d + 8*h) + 4096
    uint32_t per_task_ub = 4 * h * d + 4 * h * topk + 4 * topk * d + 8 * h;
    uint32_t ub_avail = UB_AVAIL;
    uint32_t computed_tile_m = (ub_avail > 4096) ? ((ub_avail - 4096) / per_task_ub) : 1;
    if (computed_tile_m < 1) computed_tile_m = 1;
    if (computed_tile_m > TILE_M_MAX) computed_tile_m = TILE_M_MAX;

    tiling.tile_m = computed_tile_m;

    tiling.coreTaskStart = 0;  // host 侧不设置，kernel 自己算
    tiling.coreTaskCount = 0;

    tiling.softmax_scale = softmax_scale;

    return tiling;
}

// ============================================================================
// Kernel 启动封装
// ============================================================================

struct ArgInfo {
    std::string fileName;
    size_t length;
};

aclrtSynchronizeStream(stream);
auto _t0 = std::chrono::high_resolution_clock::now();
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo>& inputsInfo, std::vector<ArgInfo>& outputsInfo,
    uint8_t* tilingData)
{
    std::vector<uint8_t*> inputHost(inputsInfo.size(), nullptr);
    std::vector<uint8_t*> inputDevice(inputsInfo.size(), nullptr);
    std::vector<uint8_t*> outputHost(outputsInfo.size(), nullptr);
    std::vector<uint8_t*> outputDevice(outputsInfo.size(), nullptr);
    uint8_t* tilingDevice = nullptr;

    // 分配并拷贝 Tiling 数据到 device
    aclrtMalloc((void**)&tilingDevice, sizeof(SparseAttnTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(SparseAttnTiling), tilingData,
        sizeof(SparseAttnTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    // 加载输入数据
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void**)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void**)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        bool ok = ReadFile(inputsInfo[i].fileName, inputsInfo[i].length,
                           inputHost[i], inputsInfo[i].length);
        if (!ok) {
            printf("ERROR: Failed to read %s\n", inputsInfo[i].fileName.c_str());
            return;
        }
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    // 分配输出 buffer
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void**)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void**)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // 启动 kernel
    // 参数顺序: q, kv, topk_idxs, attn_sink, output, tiling
    sparse_attn_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0],   // q
        inputDevice[1],   // kv
        inputDevice[2],   // topk_idxs
        inputDevice[3],   // attn_sink
        outputDevice[0],  // output
        tilingDevice
    );
    aclrtSynchronizeStream(stream);
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    // 释放 tiling device memory
    aclrtFree(tilingDevice);

    // 拷贝输出回 host
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    // 释放输入
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// ============================================================================
// Main 入口
// ============================================================================

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        aclFinalize();
        return ret;
    }

    // 获取 Vector 核数
    uint32_t aivNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, (int64_t*)&aivNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return ret;
    }
    printf("Vector core count: %u\n", aivNum);

    // 默认 shape 参数
    uint32_t b    = 2;
    uint32_t m    = 16;
    uint32_t n    = 32;
    uint32_t h    = 8;
    uint32_t d    = 64;
    uint32_t topk = 16;
    float softmax_scale = 1.0f / std::sqrt(static_cast<float>(d));

    // 支持命令行参数覆盖
    if (argc >= 7) {
        b    = std::atoi(argv[1]);
        m    = std::atoi(argv[2]);
        n    = std::atoi(argv[3]);
        h    = std::atoi(argv[4]);
        d    = std::atoi(argv[5]);
        topk = std::atoi(argv[6]);
        softmax_scale = 1.0f / std::sqrt(static_cast<float>(d));
    }
    if (argc >= 8) {
        softmax_scale = std::atof(argv[7]);
    }

    printf("Shape: b=%u m=%u n=%u h=%u d=%u topk=%u scale=%.6f\n",
           b, m, n, h, d, topk, softmax_scale);

    // 计算数据大小
    size_t qSize    = (size_t)b * m * h * d * sizeof(uint16_t);     // bf16
    size_t kvSize   = (size_t)b * n * d * sizeof(uint16_t);         // bf16
    size_t idxSize  = (size_t)b * m * topk * sizeof(int32_t);
    size_t sinkSize = (size_t)h * sizeof(float);
    size_t outSize  = (size_t)b * m * h * d * sizeof(uint16_t);     // bf16

    // 计算 Tiling
    SparseAttnTiling tiling = ComputeTiling(b, m, n, h, d, topk, softmax_scale, aivNum);
    uint32_t blockNum = tiling.usedCoreNum;

    printf("Tiling: totalTasks=%u usedCoreNum=%u tasksPerCore=%u tile_m=%u\n",
           tiling.totalTasks, tiling.usedCoreNum, tiling.tasksPerCore, tiling.tile_m);

    // 准备输入输出文件信息
    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_q.bin",     qSize},
        {"./input/input_kv.bin",    kvSize},
        {"./input/input_idx.bin",   idxSize},
        {"./input/input_sink.bin",  sinkSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", outSize}
    };

    // 创建 stream 并启动 kernel
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    KernelCall(blockNum, stream, inputsInfo, outputsInfo, (uint8_t*)&tiling);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("Kernel execution completed.\n");
    return 0;
}
