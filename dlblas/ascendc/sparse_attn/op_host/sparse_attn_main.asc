 *
 * ACL initialization, data loading, Tiling computation, kernel launch,
 * output readback.
 */

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <fstream>

#include "acl/acl.h"
#include "data_utils.h"
#include "../op_kernel/sparse_attn_tiling.h"

// Pull in the kernel definition (class + entry function)
#include "../op_kernel/sparse_attn_kernel.asc"

// ============================================================================
// Tiling metadata (input shape)
// ============================================================================
struct TilingMeta {
    uint32_t b, m, n, h, d, topk;
    float softmaxScale;
};

static bool ReadBin(const std::string& path, void* buf, size_t size) {
    std::ifstream f(path, std::ios::binary);
    if (!f.is_open()) { printf("ERROR: Cannot open %s\n", path.c_str()); return false; }
    f.read(reinterpret_cast<char*>(buf), size);
    if (!f) { printf("ERROR: Failed to read %zu bytes from %s\n", size, path.c_str()); return false; }
    return true;
}

static TilingMeta GetTestCase(int caseId) {
    TilingMeta m;
    switch (caseId) {
        case 1: m.b=2; m.m=16; m.n=32; m.h=8;  m.d=64; m.topk=16; break;
        case 2: m.b=2; m.m=16; m.n=32; m.h=8;  m.d=64; m.topk=16; break;
        case 3: m.b=2; m.m=16; m.n=32; m.h=8;  m.d=64; m.topk=16; break;
        case 5: m.b=1; m.m=1;  m.n=32; m.h=4;  m.d=32; m.topk=8;  break;
        default: m.b=2; m.m=16; m.n=32; m.h=8;  m.d=64; m.topk=16; break;
    }
    m.softmaxScale = 1.0f / sqrtf((float)m.d);
    return m;
}

// ============================================================================
// Main
// ============================================================================
int32_t main(int32_t argc, char* argv[])
{
    int caseId = (argc >= 2) ? atoi(argv[1]) : 1;
    printf("=== sparse_attn TC-%02d ===\n", caseId);

    // ACL init
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) { printf("aclrtSetDevice failed: %d\n", ret); aclFinalize(); return ret; }

    int64_t aicCoreNum = 0;
    aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &aicCoreNum);
    int64_t ubSize = 192 * 1024; // DAV_2201 UB size
    // UB size is fixed for DAV_2201; aclrtGetDeviceInfo may not support it
    printf("Cores=%ld UB=%ld\n", aicCoreNum, ubSize);

    TilingMeta meta = GetTestCase(caseId);
    printf("Shape: b=%u m=%u n=%u h=%u d=%u topk=%u\n",
           meta.b, meta.m, meta.n, meta.h, meta.d, meta.topk);

    // Compute tiling
    SparseAttnTilingData tiling = ComputeSparseAttnTiling(
        meta.b, meta.m, meta.h, meta.d, meta.topk, meta.n,
        meta.softmaxScale, (uint32_t)ubSize, (uint32_t)aicCoreNum);
    printf("Tiling: tasks=%u cores=%u hChunk=%u tChunk=%u\n",
           tiling.totalTasks, tiling.usedCoreNum, tiling.hChunk, tiling.tChunk);

    tiling.usedCoreNum = 1; uint32_t blockNum = 1; // DEBUG single core
    size_t qSize    = (size_t)meta.b * meta.m * meta.h * meta.d * sizeof(uint16_t);
    size_t kvSize   = (size_t)meta.b * meta.n * meta.d * sizeof(uint16_t);
    size_t sinkSize = (size_t)meta.h * sizeof(float);
    size_t idxsSize = (size_t)meta.b * meta.m * meta.topk * sizeof(int32_t);
    size_t oSize    = qSize;

    // Allocate device memory
    uint8_t *qDev=nullptr, *kvDev=nullptr, *sinkDev=nullptr;
    uint8_t *idxsDev=nullptr, *oDev=nullptr, *tilingDev=nullptr;
    aclrtMalloc((void**)&qDev, qSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&kvDev, kvSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&sinkDev, sinkSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&idxsDev, idxsSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&oDev, oSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&tilingDev, sizeof(SparseAttnTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDev, sizeof(SparseAttnTilingData), &tiling,
                sizeof(SparseAttnTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    // Load inputs
    uint8_t *hBuf = nullptr;
    aclrtMallocHost((void**)&hBuf, qSize);
    ReadBin("./input/input_q.bin", hBuf, qSize);
    aclrtMemcpy(qDev, qSize, hBuf, qSize, ACL_MEMCPY_HOST_TO_DEVICE);
    ReadBin("./input/input_kv.bin", hBuf, kvSize);
    aclrtMemcpy(kvDev, kvSize, hBuf, kvSize, ACL_MEMCPY_HOST_TO_DEVICE);
    ReadBin("./input/input_sink.bin", hBuf, sinkSize);
    aclrtMemcpy(sinkDev, sinkSize, hBuf, sinkSize, ACL_MEMCPY_HOST_TO_DEVICE);
    ReadBin("./input/input_idxs.bin", hBuf, idxsSize);
    aclrtMemcpy(idxsDev, idxsSize, hBuf, idxsSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtFreeHost(hBuf);

    // Launch kernel
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    sparse_attn_kernel<<<blockNum, nullptr, stream>>>(
        qDev, kvDev, sinkDev, idxsDev, oDev, tilingDev);
    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) {
        printf("Kernel failed: ret=%d\n", ret);
        // Cleanup and exit
        aclrtDestroyStream(stream);
        aclrtFree(qDev); aclrtFree(kvDev); aclrtFree(sinkDev);
        aclrtFree(idxsDev); aclrtFree(oDev); aclrtFree(tilingDev);
        aclrtResetDevice(deviceId); aclFinalize();
        return ret;
    }

    // Read output
    aclrtMallocHost((void**)&hBuf, oSize);
    aclrtMemcpy(hBuf, oSize, oDev, oSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", hBuf, oSize);
    aclrtFreeHost(hBuf);

    // Cleanup
    aclrtDestroyStream(stream);
    aclrtFree(qDev); aclrtFree(kvDev); aclrtFree(sinkDev);
    aclrtFree(idxsDev); aclrtFree(oDev); aclrtFree(tilingDev);
    aclrtResetDevice(deviceId);
    aclFinalize();
    printf("=== TC-%02d DONE ===\n", caseId);
    return 0;
}
