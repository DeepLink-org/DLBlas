/**
 * engram_gate_bwd kernel v17 -- Hang bug fix
 *
 * CRITICAL FIX: All per-T buffer allocations moved from C1() to Process()
 * before the T-loop. C1() was calling AllocTensor() on single-slot queues
 * inside a T-loop without FreeTensor(), causing the 2nd+ call to hang
 * indefinitely (DAV_2201 queue deadlock).
 *
 * Changes in v17:
 *   1. All AllocTensor() calls moved from C1() to Process(), before T-loop
 *   2. All buffers passed by reference to C1() - no alloc/free inside C1
 *   3. s_[] queues expanded from 14 to 18 (slot-reuse ex: sg/gs, ng/gg, cm/mk, ss/gd)
 *   4. th0 freed after T-loop so XR() can reuse t0_
 *   5. bf passed to XR() by reference (no re-allocation from bQ_)
 *   6. All per-T buffers allocated once and reused across T iterations
 *
 * Buffer ownership:
 *   - Init: Initialize all queues only
 *   - Process: Allocate ALL buffers (persistent + per-T) before T-loop
 *   - C1: Pure computation, no AllocTensor/FreeTensor (all buffers via refs)
 *   - XR: Accept bf by ref, allocate w from t0_ (freed after T-loop)
 */

#include "kernel_operator.h"
#include "engram_gate_bwd_tiling.h"
using namespace AscendC;

class KernelEngramGateBwd {
public:
    __aicore__ inline KernelEngramGateBwd(TPipe* pipe) : p_(pipe) {}

    __aicore__ inline void Init(
        GM_ADDR gm_go, GM_ADDR gm_x, GM_ADDR gm_k, GM_ADDR gm_v,
        GM_ADDR gm_wh, GM_ADDR gm_we,
        GM_ADDR gm_gx, GM_ADDR gm_gk, GM_ADDR gm_gv,
        GM_ADDR gm_gwh, GM_ADDR gm_gwe, GM_ADDR gm_ws,
        const __gm__ EngramGateBwdTiling* t)
    {
        t_ = t;
        uint32_t b = GetBlockIdx();
        TH_ = t_->totalH; TD_ = t_->totalD; HD_ = TH_ * TD_;
        tileT_ = t_->tileT; tpl_ = t_->tileTPerLoop; lc_ = t_->loopCount; cid_ = b;
        H_i = (int32_t)TH_; D_i = (int32_t)TD_; HD_i = (int32_t)HD_;
        hb_ = HD_ * sizeof(bfloat16_t); hf_ = HD_ * sizeof(float);
        df_ = TD_ * sizeof(float); db_ = TD_ * sizeof(bfloat16_t);
        sf_ = TH_ * sizeof(float);
        uint64_t to = b * tileT_; wsO_ = b * 2 * HD_;

        // Global tensor views (offset by this core's T slice)
        goG_.SetGlobalBuffer((__gm__ bfloat16_t*)gm_go + to * HD_, tileT_ * HD_);
        xG_ .SetGlobalBuffer((__gm__ bfloat16_t*)gm_x  + to * HD_, tileT_ * HD_);
        kG_ .SetGlobalBuffer((__gm__ bfloat16_t*)gm_k  + to * HD_, tileT_ * HD_);
        vG_ .SetGlobalBuffer((__gm__ bfloat16_t*)gm_v  + to * TD_, tileT_ * TD_);
        whG_.SetGlobalBuffer((__gm__ bfloat16_t*)gm_wh, HD_);
        weG_.SetGlobalBuffer((__gm__ bfloat16_t*)gm_we, HD_);
        gxG_.SetGlobalBuffer((__gm__ bfloat16_t*)gm_gx  + to * HD_, tileT_ * HD_);
        gkG_.SetGlobalBuffer((__gm__ bfloat16_t*)gm_gk  + to * HD_, tileT_ * HD_);
        gvG_.SetGlobalBuffer((__gm__ bfloat16_t*)gm_gv  + to * TD_, tileT_ * TD_);
        gwG_.SetGlobalBuffer((__gm__ bfloat16_t*)gm_gwh, HD_);
        geG_.SetGlobalBuffer((__gm__ bfloat16_t*)gm_gwe, HD_);
        ws_ = (__gm__ float*)gm_ws;

        // Initialize all queues (allocation happens in Process)
        p_->InitBuffer(bQ_,  1, hb_);
        p_->InitBuffer(goQ_, 1, hf_); p_->InitBuffer(xQ_, 1, hf_);
        p_->InitBuffer(kQ_,  1, hf_); p_->InitBuffer(gxQ_, 1, hf_);
        p_->InitBuffer(gkQ_, 1, hf_); p_->InitBuffer(gvQ_, 1, df_);
        p_->InitBuffer(whQ_, 1, hf_); p_->InitBuffer(weQ_, 1, hf_);
        p_->InitBuffer(awQ_, 1, hf_); p_->InitBuffer(aeQ_, 1, hf_);
        p_->InitBuffer(t0_,  1, hf_); p_->InitBuffer(t1_, 1, hf_);
        p_->InitBuffer(t2_,  1, hf_);
        p_->InitBuffer(d0_,  1, df_); p_->InitBuffer(d1_, 1, df_);
        // Scalar buffers: 18 slots (14 original + 4 for slot-reuse separation:
        //   gg(14), gs(15), mk(16), gd(17))
        for (int i = 0; i < 18; i++) p_->InitBuffer(s_[i], 1, sf_);
        p_->InitBuffer(rQ_, 1, 4096);
        p_->InitBuffer(cQ_, 1, HD_ * sizeof(uint8_t));
    }

    // ===================================================================
    // Main processing: allocate ALL buffers, loop T, cross-core reduce
    // ===================================================================
    __aicore__ inline void Process()
    {
        // ---- Load persistent WH/WE (allocated here, passed by ref) ----
        auto bf = bQ_.AllocTensor<bfloat16_t>();
        DataCopyPad(bf, whG_, {1, (uint16_t)hb_, 0, 0}, {false, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        auto wh = whQ_.AllocTensor<float>();
        Cast(wh, bf, RoundMode::CAST_NONE, HD_i);
        PipeBarrier<PIPE_ALL>();

        DataCopyPad(bf, weG_, {1, (uint16_t)hb_, 0, 0}, {false, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        auto we = weQ_.AllocTensor<float>();
        Cast(we, bf, RoundMode::CAST_NONE, HD_i);
        PipeBarrier<PIPE_ALL>();

        // ---- Accumulators (persistent across T loop) ----
        auto aw = awQ_.AllocTensor<float>(); Duplicate(aw, 0.0f, HD_i);
        auto ae = aeQ_.AllocTensor<float>(); Duplicate(ae, 0.0f, HD_i);

        // ---- Per-T buffers (allocated ONCE, reused across all T iterations) ----
        // Input/output tensors (HD = H*D sized)
        auto go  = goQ_.AllocTensor<float>();
        auto xf  = xQ_.AllocTensor<float>();
        auto kf  = kQ_.AllocTensor<float>();
        auto gx  = gxQ_.AllocTensor<float>();
        auto gk  = gkQ_.AllocTensor<float>();

        // D-sized tensors
        auto gv  = gvQ_.AllocTensor<float>();
        auto td0 = d0_.AllocTensor<float>();
        auto vf  = d1_.AllocTensor<float>();

        // HD-sized work tensors
        auto th0 = t0_.AllocTensor<float>();
        auto th1 = t1_.AllocTensor<float>();
        auto th2 = t2_.AllocTensor<float>();

        // H-sized scalar tensors (s_[0]..s_[13]: original 14 slots)
        auto rx  = s_[0].AllocTensor<float>();   // rstd_x
        auto rk  = s_[1].AllocTensor<float>();   // rstd_k
        auto rd  = s_[2].AllocTensor<float>();   // raw_dot
        auto dt  = s_[3].AllocTensor<float>();   // dot
        auto ad  = s_[4].AllocTensor<float>();   // abs_dot
        auto cm  = s_[5].AllocTensor<float>();   // clamp_max
        auto sg  = s_[6].AllocTensor<float>();   // sign
        auto ng  = s_[7].AllocTensor<float>();   // neg_one
        auto ss  = s_[8].AllocTensor<float>();   // s_sqrt
        auto gt  = s_[9].AllocTensor<float>();   // gate
        auto gr  = s_[10].AllocTensor<float>();  // grad_raw_dot
        auto gxs = s_[11].AllocTensor<float>();  // grad_rstd_x
        auto gks = s_[12].AllocTensor<float>();  // grad_rstd_k
        auto ex  = s_[13].AllocTensor<float>();  // expansion temp

        // H-sized scalar tensors (s_[14]..s_[17]: new slots for slot-reuse separation)
        auto gg  = s_[14].AllocTensor<float>();  // grad_gate
        auto gs  = s_[15].AllocTensor<float>();  // grad_s_sqrt
        auto mk  = s_[16].AllocTensor<float>();  // mask
        auto gd  = s_[17].AllocTensor<float>();  // grad_dot

        // Workspace tensors
        auto rt = rQ_.AllocTensor<uint8_t>();
        auto cb = cQ_.AllocTensor<uint8_t>();

        // ---- T loop: process each T element ----
        for (uint64_t lp = 0; lp < lc_; lp++) {
            uint64_t n = (lp == lc_ - 1 && t_->tailT > 0) ? t_->tailT : tpl_;
            for (uint64_t i = 0; i < n; i++) {
                C1(lp * tpl_ + i, aw, ae, wh, we,
                   bf, go, xf, kf, gx, gk, gv,
                   th0, th1, th2, td0, vf,
                   rx, rk, rd, dt, ad, cm, sg, ng, ss, gt,
                   gr, gxs, gks, ex, gg, gs, mk, gd,
                   rt, cb);
            }
        }

        // Cross-core reduce + output grad_wh/grad_we
        // th0 is passed by reference to XR (reused as workspace read buffer)
        XR(aw, ae, bf, th0);
    }

private:
    // ===================================================================
    // Compute for one T element (all buffers via reference, NO alloc/free)
    // ===================================================================
    __aicore__ inline void C1(
        uint64_t t,
        LocalTensor<float>& aw, LocalTensor<float>& ae,
        LocalTensor<float>& wh, LocalTensor<float>& we,
        LocalTensor<bfloat16_t>& bf,
        LocalTensor<float>& go, LocalTensor<float>& xf,
        LocalTensor<float>& kf, LocalTensor<float>& gx,
        LocalTensor<float>& gk, LocalTensor<float>& gv,
        LocalTensor<float>& th0, LocalTensor<float>& th1,
        LocalTensor<float>& th2, LocalTensor<float>& td0,
        LocalTensor<float>& vf,
        LocalTensor<float>& rx, LocalTensor<float>& rk,
        LocalTensor<float>& rd, LocalTensor<float>& dt,
        LocalTensor<float>& ad, LocalTensor<float>& cm,
        LocalTensor<float>& sg, LocalTensor<float>& ng,
        LocalTensor<float>& ss, LocalTensor<float>& gt,
        LocalTensor<float>& gr, LocalTensor<float>& gxs,
        LocalTensor<float>& gks, LocalTensor<float>& ex,
        LocalTensor<float>& gg, LocalTensor<float>& gs,
        LocalTensor<float>& mk, LocalTensor<float>& gd,
        LocalTensor<uint8_t>& rt, LocalTensor<uint8_t>& cb)
    {
        const float iv = t_->invD, ep = t_->eps, sc = t_->scalar, cv = t_->clampValue;

        // ---- Load inputs ----
        DataCopyPad(bf, goG_[t * HD_], {1, (uint16_t)hb_, 0, 0}, {false, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast(go, bf, RoundMode::CAST_NONE, HD_i); PipeBarrier<PIPE_ALL>();

        DataCopyPad(bf, xG_[t * HD_], {1, (uint16_t)hb_, 0, 0}, {false, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast(xf, bf, RoundMode::CAST_NONE, HD_i); PipeBarrier<PIPE_ALL>();

        DataCopyPad(bf, kG_[t * HD_], {1, (uint16_t)hb_, 0, 0}, {false, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast(kf, bf, RoundMode::CAST_NONE, HD_i); PipeBarrier<PIPE_ALL>();

        DataCopyPad(bf, vG_[t * TD_], {1, (uint16_t)db_, 0, 0}, {false, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast(vf, bf, RoundMode::CAST_NONE, D_i); PipeBarrier<PIPE_ALL>();

        // ======== PHASE A: Forward recompute ========

        // A1: rstd_x = rsqrt(mean(x^2, -1) + eps)
        Mul(th0, xf, xf, HD_i); PipeBarrier<PIPE_ALL>();
        {
            uint32_t sh[] = {(uint32_t)H_i, (uint32_t)D_i};
            ReduceSum<float, Pattern::Reduce::AR>(rx, th0, rt, sh, false);
        }
        PipeBarrier<PIPE_ALL>();
        Muls(rx, rx, iv, H_i); Adds(rx, rx, ep, H_i);
        Rsqrt(rx, rx, H_i); PipeBarrier<PIPE_ALL>();

        // A2: rstd_k
        Mul(th0, kf, kf, HD_i); PipeBarrier<PIPE_ALL>();
        {
            uint32_t sh[] = {(uint32_t)H_i, (uint32_t)D_i};
            ReduceSum<float, Pattern::Reduce::AR>(rk, th0, rt, sh, false);
        }
        PipeBarrier<PIPE_ALL>();
        Muls(rk, rk, iv, H_i); Adds(rk, rk, ep, H_i);
        Rsqrt(rk, rk, H_i); PipeBarrier<PIPE_ALL>();

        // A3: raw_dot = sum(x*wh * k*we, -1)
        // th0 = x*wh, th1 = k*we (saved for Phase B)
        Mul(th0, xf, wh, HD_i); PipeBarrier<PIPE_ALL>();
        Mul(th1, kf, we, HD_i); PipeBarrier<PIPE_ALL>();
        Mul(th0, th0, th1, HD_i); PipeBarrier<PIPE_ALL>();
        {
            uint32_t sh[] = {(uint32_t)H_i, (uint32_t)D_i};
            ReduceSum<float, Pattern::Reduce::AR>(rd, th0, rt, sh, false);
        }
        PipeBarrier<PIPE_ALL>();

        // A4: dot = raw_dot * rstd_x * rstd_k * scalar
        Mul(dt, rd, rx, H_i); PipeBarrier<PIPE_ALL>();
        Mul(dt, dt, rk, H_i); PipeBarrier<PIPE_ALL>();
        Muls(dt, dt, sc, H_i); PipeBarrier<PIPE_ALL>();

        // A5: abs_dot
        Abs(ad, dt, H_i); PipeBarrier<PIPE_ALL>();

        // A6: s_sqrt = sign(dot) * sqrt(max(|dot|, cv))
        Duplicate(td0, cv, H_i);
        Max(cm, ad, td0, H_i); PipeBarrier<PIPE_ALL>();
        Sqrt(cm, cm, H_i); PipeBarrier<PIPE_ALL>();

        // Compute s_sqrt = sign(dot) * sqrt(max(|dot|, cv))
        // Use arithmetic: sign = dot / max(|dot|, eps)
        Duplicate(td0, ep, H_i);
        Max(td0, ad, td0, H_i);   // td0 = max(|dot|, eps)
        Div(ss, dt, td0, H_i);   // ss = dot / max(|dot|, eps) = sign(dot)
        PipeBarrier<PIPE_ALL>();
        Mul(ss, ss, cm, H_i);    // ss = sign(dot) * sqrt(max(|dot|, cv))

        // A7: gate = sigmoid(s_sqrt)
        Sigmoid(gt, ss, H_i); PipeBarrier<PIPE_ALL>();

        // ======== grad_v (computed here while go and gate are fresh) ========
        Duplicate(gv, 0.0f, D_i); PipeBarrier<PIPE_ALL>();
        for (int32_t h = 0; h < H_i; h++) {
            int32_t base = h * D_i;
            for (int32_t d = 0; d < D_i; d++) td0.SetValue(d, go.GetValue(base + d));
            PipeBarrier<PIPE_ALL>();
            Muls(td0, td0, gt.GetValue(h), D_i); PipeBarrier<PIPE_ALL>();
            Add(gv, gv, td0, D_i); PipeBarrier<PIPE_ALL>();
        }

        // ======== PHASE B: Backward gradient ========

        // B1: grad_gate = sum(go * v_expanded, dim=-1)
        // Expand v (D,) --> th2 (H,D)
        for (int32_t h = 0; h < H_i; h++)
            for (int32_t d = 0; d < D_i; d++)
                th2.SetValue(h * D_i + d, vf.GetValue(d));
        PipeBarrier<PIPE_ALL>();

        Mul(th0, go, th2, HD_i); PipeBarrier<PIPE_ALL>();
        {
            uint32_t sh[] = {(uint32_t)H_i, (uint32_t)D_i};
            ReduceSum<float, Pattern::Reduce::AR>(gg, th0, rt, sh, false);
        }
        PipeBarrier<PIPE_ALL>();

        // B2: grad_s_sqrt = grad_gate * gate * (1 - gate)
        Duplicate(td0, 1.0f, H_i);
        Sub(gs, td0, gt, H_i); PipeBarrier<PIPE_ALL>();       // 1 - gate
        Mul(gs, gs, gt, H_i); PipeBarrier<PIPE_ALL>();        // gate * (1-gate)
        Mul(gs, gs, gg, H_i); PipeBarrier<PIPE_ALL>();        // grad_gate * gate * (1-gate)

        // B3: mask = (abs_dot >= cv) ? 1.0 : 0.0
        Compares(cb, ad, cv, CMPMODE::GE, (uint32_t)H_i); PipeBarrier<PIPE_ALL>();
        Duplicate(mk, 1.0f, H_i);
        Duplicate(td0, 0.0f, H_i);
        Select(mk, cb, mk, td0, SELMODE::VSEL_TENSOR_SCALAR_MODE, (uint32_t)H_i);
        PipeBarrier<PIPE_ALL>();

        // B4: grad_dot = grad_s_sqrt * mask * 0.5 / sqrt(max(|dot|, cv))
        Duplicate(td0, cv, H_i);
        Max(td0, ad, td0, H_i); PipeBarrier<PIPE_ALL>();
        Sqrt(td0, td0, H_i); PipeBarrier<PIPE_ALL>();
        Mul(gd, gs, mk, H_i); PipeBarrier<PIPE_ALL>();
        Muls(gd, gd, 0.5f, H_i); PipeBarrier<PIPE_ALL>();
        Div(gd, gd, td0, H_i); PipeBarrier<PIPE_ALL>();

        // B5: grad_raw_dot, grad_rstd_x, grad_rstd_k
        Mul(gr, gd, rx, H_i); PipeBarrier<PIPE_ALL>();
        Mul(gr, gr, rk, H_i); PipeBarrier<PIPE_ALL>();
        Muls(gr, gr, sc, H_i); PipeBarrier<PIPE_ALL>();

        Mul(gxs, gd, rd, H_i); PipeBarrier<PIPE_ALL>();
        Mul(gxs, gxs, rk, H_i); PipeBarrier<PIPE_ALL>();
        Muls(gxs, gxs, sc, H_i); PipeBarrier<PIPE_ALL>();

        Mul(gks, gd, rd, H_i); PipeBarrier<PIPE_ALL>();
        Mul(gks, gks, rx, H_i); PipeBarrier<PIPE_ALL>();
        Muls(gks, gks, sc, H_i); PipeBarrier<PIPE_ALL>();

        // ======== grad_x = go + gr*wh*(k*we) + gxs*(-x/D)*rx^3 ========
        // th1 = k*we (saved from Phase A)

        // Term 2: gr * wh * (k*we)
        for (int32_t h = 0; h < H_i; h++) {
            float v = gr.GetValue(h);
            for (int32_t d = 0; d < D_i; d++) th2.SetValue(h * D_i + d, v);
        }
        PipeBarrier<PIPE_ALL>();
        Mul(th0, wh, th1, HD_i); PipeBarrier<PIPE_ALL>();   // wh * (k*we)
        Mul(gx, th0, th2, HD_i); PipeBarrier<PIPE_ALL>();   // gr * wh * (k*we)

        // Term 3: gxs * (-x/D) * rx^3
        for (int32_t h = 0; h < H_i; h++) {
            float v = gxs.GetValue(h);
            for (int32_t d = 0; d < D_i; d++) th2.SetValue(h * D_i + d, v);
        }
        PipeBarrier<PIPE_ALL>();
        Muls(th0, xf, -iv, HD_i); PipeBarrier<PIPE_ALL>();  // -x/D
        Mul(th0, th0, th2, HD_i); PipeBarrier<PIPE_ALL>();   // gxs * (-x/D)

        Mul(ex, rx, rx, H_i); PipeBarrier<PIPE_ALL>();       // rx^2
        Mul(ex, ex, rx, H_i); PipeBarrier<PIPE_ALL>();       // rx^3
        for (int32_t h = 0; h < H_i; h++) {
            float v = ex.GetValue(h);
            for (int32_t d = 0; d < D_i; d++) th2.SetValue(h * D_i + d, v);
        }
        PipeBarrier<PIPE_ALL>();
        Mul(th0, th0, th2, HD_i); PipeBarrier<PIPE_ALL>();   // gxs*(-x/D)*rx^3

        // gx = go + term2 + term3
        Add(gx, go, gx, HD_i); PipeBarrier<PIPE_ALL>();
        Add(gx, gx, th0, HD_i); PipeBarrier<PIPE_ALL>();

        // ======== grad_k = gr*we*(x*wh) + gks*(-k/D)*rk^3 ========

        // Term 1: gr * we * (x*wh)
        for (int32_t h = 0; h < H_i; h++) {
            float v = gr.GetValue(h);
            for (int32_t d = 0; d < D_i; d++) th2.SetValue(h * D_i + d, v);
        }
        PipeBarrier<PIPE_ALL>();
        Mul(th0, xf, wh, HD_i); PipeBarrier<PIPE_ALL>();    // x*wh
        Mul(gk, we, th0, HD_i); PipeBarrier<PIPE_ALL>();    // we*(x*wh)
        Mul(gk, gk, th2, HD_i); PipeBarrier<PIPE_ALL>();    // gr*we*(x*wh)

        // Term 2: gks * (-k/D) * rk^3
        for (int32_t h = 0; h < H_i; h++) {
            float v = gks.GetValue(h);
            for (int32_t d = 0; d < D_i; d++) th2.SetValue(h * D_i + d, v);
        }
        PipeBarrier<PIPE_ALL>();
        Muls(th0, kf, -iv, HD_i); PipeBarrier<PIPE_ALL>();  // -k/D
        Mul(th0, th0, th2, HD_i); PipeBarrier<PIPE_ALL>();   // gks*(-k/D)

        Mul(ex, rk, rk, H_i); PipeBarrier<PIPE_ALL>();       // rk^2
        Mul(ex, ex, rk, H_i); PipeBarrier<PIPE_ALL>();       // rk^3
        for (int32_t h = 0; h < H_i; h++) {
            float v = ex.GetValue(h);
            for (int32_t d = 0; d < D_i; d++) th2.SetValue(h * D_i + d, v);
        }
        PipeBarrier<PIPE_ALL>();
        Mul(th0, th0, th2, HD_i); PipeBarrier<PIPE_ALL>();   // gks*(-k/D)*rk^3

        Add(gk, gk, th0, HD_i); PipeBarrier<PIPE_ALL>();

        // ======== accum_wh += gr * (k*we) * x ========
        // accum_we += gr * x * wh * k
        for (int32_t h = 0; h < H_i; h++) {
            float v = gr.GetValue(h);
            for (int32_t d = 0; d < D_i; d++) th2.SetValue(h * D_i + d, v);
        }
        PipeBarrier<PIPE_ALL>();

        // accum_wh
        Mul(th0, th1, xf, HD_i); PipeBarrier<PIPE_ALL>();   // (k*we) * x
        Mul(th0, th0, th2, HD_i); PipeBarrier<PIPE_ALL>();  // gr * (k*we) * x
        Add(aw, aw, th0, HD_i); PipeBarrier<PIPE_ALL>();

        // accum_we (re-expand gr into th2)
        for (int32_t h = 0; h < H_i; h++) {
            float v = gr.GetValue(h);
            for (int32_t d = 0; d < D_i; d++) th2.SetValue(h * D_i + d, v);
        }
        PipeBarrier<PIPE_ALL>();
        Mul(th0, xf, wh, HD_i); PipeBarrier<PIPE_ALL>();    // x*wh
        Mul(th0, th0, kf, HD_i); PipeBarrier<PIPE_ALL>();   // x*wh*k
        Mul(th0, th0, th2, HD_i); PipeBarrier<PIPE_ALL>();  // gr*x*wh*k
        Add(ae, ae, th0, HD_i); PipeBarrier<PIPE_ALL>();

        // ======== Store outputs (f32 -> bf16 -> GM) ========
        Cast(bf, gx, RoundMode::CAST_ROUND, HD_i); PipeBarrier<PIPE_ALL>();
        DataCopyPad(gxG_[t * HD_], bf, {1, (uint16_t)hb_, 0, 0}); PipeBarrier<PIPE_ALL>();

        Cast(bf, gk, RoundMode::CAST_ROUND, HD_i); PipeBarrier<PIPE_ALL>();
        DataCopyPad(gkG_[t * HD_], bf, {1, (uint16_t)hb_, 0, 0}); PipeBarrier<PIPE_ALL>();

        Cast(bf, gv, RoundMode::CAST_ROUND, D_i); PipeBarrier<PIPE_ALL>();
        DataCopyPad(gvG_[t * TD_], bf, {1, (uint16_t)db_, 0, 0}); PipeBarrier<PIPE_ALL>();
    }

    // ===================================================================
    // Cross-core reduction: write partials -> workspace -> merge on core 0
    // bf and th0 are passed by reference (allocated in Process, reused here)
    // ===================================================================
    __aicore__ inline void XR(LocalTensor<float>& aw, LocalTensor<float>& ae,
                              LocalTensor<bfloat16_t>& bf, LocalTensor<float>& w)
    {
        GlobalTensor<float> ws;
        ws.SetGlobalBuffer(ws_, t_->workspaceSize / sizeof(float));

        // Write partials to workspace
        DataCopyPad(ws[wsO_], aw, {1, (uint16_t)hf_, 0, 0}); PipeBarrier<PIPE_ALL>();
        DataCopyPad(ws[wsO_ + HD_], ae, {1, (uint16_t)hf_, 0, 0}); PipeBarrier<PIPE_ALL>();
        SyncAll();

        // Only core 0 merges
        if (cid_ != 0) return;

        Duplicate(aw, 0.0f, HD_i);
        Duplicate(ae, 0.0f, HD_i);

        for (uint64_t i = 0; i < t_->coreNum; i++) {
            DataCopyPad(w, ws[i * 2 * HD_],
                        {1, (uint16_t)hf_, 0, 0}, {false, 0, 0, 0});
            PipeBarrier<PIPE_ALL>(); Add(aw, aw, w, HD_i); PipeBarrier<PIPE_ALL>();

            DataCopyPad(w, ws[i * 2 * HD_ + HD_],
                        {1, (uint16_t)hf_, 0, 0}, {false, 0, 0, 0});
            PipeBarrier<PIPE_ALL>(); Add(ae, ae, w, HD_i); PipeBarrier<PIPE_ALL>();
        }

        // Write final grad_wh, grad_we (uses passed bf, no re-allocation)
        Cast(bf, aw, RoundMode::CAST_ROUND, HD_i); PipeBarrier<PIPE_ALL>();
        DataCopyPad(gwG_, bf, {1, (uint16_t)hb_, 0, 0}); PipeBarrier<PIPE_ALL>();

        Cast(bf, ae, RoundMode::CAST_ROUND, HD_i); PipeBarrier<PIPE_ALL>();
        DataCopyPad(geG_, bf, {1, (uint16_t)hb_, 0, 0}); PipeBarrier<PIPE_ALL>();
    }

    // ---- Member variables ----
    TPipe* p_;
    const __gm__ EngramGateBwdTiling* t_;

    uint64_t TH_, TD_, HD_, tileT_, tpl_, lc_, cid_, wsO_;
    int32_t H_i, D_i, HD_i;
    uint64_t hb_, hf_, df_, db_, sf_;

    GlobalTensor<bfloat16_t> goG_, xG_, kG_, vG_, whG_, weG_;
    GlobalTensor<bfloat16_t> gxG_, gkG_, gvG_, gwG_, geG_;
    __gm__ float* ws_;

    // Queues (single-slot: 1 buffer each)
    TQue<TPosition::VECCALC, 1> bQ_, goQ_, xQ_, kQ_, gxQ_, gkQ_, gvQ_;
    TQue<TPosition::VECCALC, 1> whQ_, weQ_, awQ_, aeQ_;
    TQue<TPosition::VECCALC, 1> t0_, t1_, t2_, d0_, d1_;
    TQue<TPosition::VECCALC, 1> s_[18];  // 18 scalar queues (14 + 4 for reuse separation)
    TQue<TPosition::VECCALC, 1> rQ_, cQ_;
};

extern "C" __global__ __vector__ void engram_gate_bwd_kernel(
    GM_ADDR gm_go, GM_ADDR gm_x, GM_ADDR gm_k, GM_ADDR gm_v,
    GM_ADDR gm_wh, GM_ADDR gm_we,
    GM_ADDR gm_gx, GM_ADDR gm_gk, GM_ADDR gm_gv,
    GM_ADDR gm_gwh, GM_ADDR gm_gwe,
    GM_ADDR gm_ws, GM_ADDR tiling)
{
    TPipe pipe;
    KernelEngramGateBwd op(&pipe);
    op.Init(gm_go, gm_x, gm_k, gm_v, gm_wh, gm_we,
            gm_gx, gm_gk, gm_gv, gm_gwh, gm_gwe, gm_ws,
            (__gm__ EngramGateBwdTiling*)tiling);
    op.Process();
}
