/**
 * Copyright (c) 2026 Huawei Technologies Co., Ltd.
 * EngramGateBwd ForwardKernel — 前向重计算，输出 6 个中间量到 GM (bf16)
 *
 * Inputs (bf16):  x (T,H,D), k (T,H,D), wh (H,D), we (H,D)
 * Outputs (bf16 to GM): rstd_x, rstd_k, raw_dot, dot, s_sqrt, gate (each (T,H))
 */
#include "kernel_operator.h"
#include "engram_gate_bwd_tiling.h"
using namespace AscendC;

class ForwardKernel {
    static constexpr uint32_t H_ = 4, D_ = 128, HD_ = 512, M_ = 64;
public:
    __aicore__ inline ForwardKernel(TPipe* p) : pipe_(p) {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR k, GM_ADDR wh, GM_ADDR we,
        GM_ADDR interm_rstd_x, GM_ADDR interm_rstd_k, GM_ADDR interm_raw_dot,
        GM_ADDR interm_dot, GM_ADDR interm_s_sqrt, GM_ADDR interm_gate,
        const __gm__ EngramGateBwdTilingData* tl)
    {
        tiling_ = tl;
        uint32_t bi = GetBlockIdx();
        T0_ = bi * tl->T_per_core;
        T1_ = (T0_ + tl->T_per_core) < tl->T_total ? (T0_ + tl->T_per_core) : tl->T_total;
        Tm_ = tl->T_TILE;
        uint32_t Tt = Tm_, totalTH = tl->T_total * H_;

        xGm_.SetGlobalBuffer((__gm__ bfloat16_t*)x, tl->T_total * HD_);
        kGm_.SetGlobalBuffer((__gm__ bfloat16_t*)k, tl->T_total * HD_);
        whGm_.SetGlobalBuffer((__gm__ bfloat16_t*)wh, HD_);
        weGm_.SetGlobalBuffer((__gm__ bfloat16_t*)we, HD_);
        iRxGm_.SetGlobalBuffer((__gm__ bfloat16_t*)interm_rstd_x, totalTH);
        iRkGm_.SetGlobalBuffer((__gm__ bfloat16_t*)interm_rstd_k, totalTH);
        iRdGm_.SetGlobalBuffer((__gm__ bfloat16_t*)interm_raw_dot, totalTH);
        iDtGm_.SetGlobalBuffer((__gm__ bfloat16_t*)interm_dot, totalTH);
        iSsGm_.SetGlobalBuffer((__gm__ bfloat16_t*)interm_s_sqrt, totalTH);
        iGtGm_.SetGlobalBuffer((__gm__ bfloat16_t*)interm_gate, totalTH);

        uint32_t s3 = Tt * HD_ * 4, sW = HD_ * 4, sS = Tt * H_ * 4, sB = Tt * HD_ * 2;
        pipe_->InitBuffer(bfB_, sB);
        pipe_->InitBuffer(xB_, s3);   pipe_->InitBuffer(kB_, s3);
        pipe_->InitBuffer(whB_, sW);  pipe_->InitBuffer(weB_, sW);
        pipe_->InitBuffer(tA_, s3);   pipe_->InitBuffer(tB_, s3);
        pipe_->InitBuffer(rtB_, 32768);
        pipe_->InitBuffer(rstdx_, sS);
        pipe_->InitBuffer(rstdk_, sS);
        pipe_->InitBuffer(rawdot_, sS);
        pipe_->InitBuffer(dot_, sS);
        pipe_->InitBuffer(ssqrt_, sS);
        pipe_->InitBuffer(gate_, sS);
    }

    __aicore__ inline void Process() {
        LdC(whGm_, whB_); LdC(weGm_, weB_);
        PipeBarrier<PIPE_ALL>();
        for (uint32_t t = T0_; t < T1_; t += Tm_) {
            uint32_t Tt = (t + Tm_ <= T1_) ? Tm_ : (T1_ - t);
            CI(t, Tt);
            PipeBarrier<PIPE_ALL>();
            Cpt(Tt);
            PipeBarrier<PIPE_ALL>();
            CO(t, Tt);
        }
        PipeBarrier<PIPE_ALL>();
    }

private:
    typedef GlobalTensor<bfloat16_t> GB;
    typedef TBuf<TPosition::VECCALC> TB;
    typedef TBuf<TPosition::VECIN> TV;

    __aicore__ inline void LdC(GB& g, TB& u) {
        auto b = bfB_.Get<bfloat16_t>();
        DataCopyPad(b, g, {1, (uint16_t)(HD_ * 2), 0, 0}, {false, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<float, bfloat16_t>(u.Get<float>(), b, RoundMode::CAST_NONE, HD_);
    }
    __aicore__ inline void L3(GB& g, TB& u, uint32_t ts, uint32_t Tt) {
        uint32_t n = Tt * HD_;
        auto b = bfB_.Get<bfloat16_t>();
        DataCopyPad(b, g[ts * HD_], {1, (uint16_t)(n * 2), 0, 0}, {false, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<float, bfloat16_t>(u.Get<float>(), b, RoundMode::CAST_NONE, n);
    }
    __aicore__ inline void CI(uint32_t ts, uint32_t Tt) {
        L3(xGm_, xB_, ts, Tt);
        L3(kGm_, kB_, ts, Tt);
    }
    __aicore__ inline void CO(uint32_t ts, uint32_t Tt) {
        uint32_t n = Tt * H_;
        uint16_t nB = (uint16_t)(n * 2);
        auto b = bfB_.Get<bfloat16_t>();
        Cast<bfloat16_t, float>(b, rstdx_.Get<float>(), RoundMode::CAST_ROUND, n);
        PipeBarrier<PIPE_ALL>();
        DataCopyPad(iRxGm_[ts * H_], b, {1, nB, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<bfloat16_t, float>(b, rstdk_.Get<float>(), RoundMode::CAST_ROUND, n);
        PipeBarrier<PIPE_ALL>();
        DataCopyPad(iRkGm_[ts * H_], b, {1, nB, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<bfloat16_t, float>(b, rawdot_.Get<float>(), RoundMode::CAST_ROUND, n);
        PipeBarrier<PIPE_ALL>();
        DataCopyPad(iRdGm_[ts * H_], b, {1, nB, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<bfloat16_t, float>(b, dot_.Get<float>(), RoundMode::CAST_ROUND, n);
        PipeBarrier<PIPE_ALL>();
        DataCopyPad(iDtGm_[ts * H_], b, {1, nB, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<bfloat16_t, float>(b, ssqrt_.Get<float>(), RoundMode::CAST_ROUND, n);
        PipeBarrier<PIPE_ALL>();
        DataCopyPad(iSsGm_[ts * H_], b, {1, nB, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<bfloat16_t, float>(b, gate_.Get<float>(), RoundMode::CAST_ROUND, n);
        PipeBarrier<PIPE_ALL>();
        DataCopyPad(iGtGm_[ts * H_], b, {1, nB, 0, 0});
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void VMul(LocalTensor<float>& d, LocalTensor<float>& a, LocalTensor<float>& b, uint32_t Tt) {
        uint32_t n = Tt * HD_;
        for (uint32_t o = 0; o < n; o += M_) {
            uint32_t c = (o + M_ <= n) ? M_ : (n - o);
            Mul<float>(d[o], a[o], b[o], c);
        }
    }
    __aicore__ inline void VBMulC(LocalTensor<float>& d, LocalTensor<float>& a, LocalTensor<float>& c, uint32_t Tt) {
        for (uint32_t t = 0; t < Tt; t++)
            for (uint32_t h = 0; h < H_; h++) {
                uint32_t ro = (t * H_ + h) * D_, co = h * D_;
                for (uint32_t dd = 0; dd < D_; dd += M_)
                    Mul<float>(d[ro + dd], a[ro + dd], c[co + dd], M_);
            }
    }
    __aicore__ inline void RSD(LocalTensor<float>& d, LocalTensor<float>& s, uint32_t Tt) {
        auto rt = rtB_.Get<float>();
        for (uint32_t t = 0; t < Tt; t++)
            for (uint32_t h = 0; h < H_; h++)
                ReduceSum<float, true>(d[t * H_ + h], s[(t * H_ + h) * D_], rt, (int32_t)D_);
    }

    __aicore__ inline void Cpt(uint32_t Tt) {
        float sc = tiling_->scalar, cv = ENG_CLAMP_VALUE, ep = ENG_EPS, iD = 1.0f / 128.0f;
        uint32_t TR = Tt * H_;
        auto X = xB_.Get<float>(), K = kB_.Get<float>();
        auto WH = whB_.Get<float>(), WE = weB_.Get<float>();
        auto TA = tA_.Get<float>(), TB = tB_.Get<float>();
        auto RX = rstdx_.Get<float>(), RK = rstdk_.Get<float>(), RD = rawdot_.Get<float>();
        auto DT = dot_.Get<float>(), SS = ssqrt_.Get<float>(), GT = gate_.Get<float>();

        VMul(TA, X, X, Tt); RSD(RX, TA, Tt);
        Muls<float>(RX, RX, iD, TR); Adds<float>(RX, RX, ep, TR);
        Rsqrt<float>(RX, RX, TR);

        VMul(TA, K, K, Tt); RSD(RK, TA, Tt);
        Muls<float>(RK, RK, iD, TR); Adds<float>(RK, RK, ep, TR);
        Rsqrt<float>(RK, RK, TR);

        VBMulC(TA, X, WH, Tt); VBMulC(TB, K, WE, Tt);
        VMul(TA, TA, TB, Tt); RSD(RD, TA, Tt);

        Mul<float>(DT, RD, RX, TR); Mul<float>(DT, DT, RK, TR);
        Muls<float>(DT, DT, sc, TR);
        Abs<float>(TA, DT, TR);
        Duplicate<float>(TB, cv, TR); Max<float>(TB, TA, TB, TR);
        Sqrt<float>(SS, TB, TR);
        Div<float>(TB, DT, TB, TR); Mul<float>(SS, SS, TB, TR);
        Muls<float>(GT, SS, -1.0f, TR); Exp<float>(GT, GT, TR);
        Adds<float>(GT, GT, 1.0f, TR);
        Duplicate<float>(TB, 1.0f, TR); Div<float>(GT, TB, GT, TR);
    }

    TPipe* pipe_;
    const __gm__ EngramGateBwdTilingData* tiling_;
    uint32_t T0_, T1_, Tm_;
    GB xGm_, kGm_, whGm_, weGm_;
    GB iRxGm_, iRkGm_, iRdGm_, iDtGm_, iSsGm_, iGtGm_;
    TB xB_, kB_, whB_, weB_, tA_, tB_, rtB_;
    TB rstdx_, rstdk_, rawdot_, dot_, ssqrt_, gate_;
    TV bfB_;
};

extern "C" __global__ __vector__ void engram_gate_bwd_fwd_kernel(
    GM_ADDR x, GM_ADDR k, GM_ADDR wh, GM_ADDR we,
    GM_ADDR interm_rstd_x, GM_ADDR interm_rstd_k, GM_ADDR interm_raw_dot,
    GM_ADDR interm_dot, GM_ADDR interm_s_sqrt, GM_ADDR interm_gate,
    GM_ADDR tl)
{
    TPipe p;
    ForwardKernel op(&p);
    op.Init(x, k, wh, we, interm_rstd_x, interm_rstd_k, interm_raw_dot,
            interm_dot, interm_s_sqrt, interm_gate,
            (__gm__ EngramGateBwdTilingData*)tl);
    op.Process();
}
