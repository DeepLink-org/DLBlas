/**
 * EngramGateBwd BackwardKernel - FULL computation (all 5 gradients)
 *
 * Fixes applied:
 * - Root Cause 2: Add<float>(d==a) → use tmpB_ scratch buffer as independent dst
 * - Root Cause 3: RST Tt=1 degradation → skip RST, accumulate directly at (H,D) level
 */
#include "kernel_operator.h"
#include "engram_gate_bwd_tiling.h"
using namespace AscendC;

class BackwardKernel {
    static constexpr uint32_t H_ = 4, D_ = 128, HD_ = 512, M_ = 64;
public:
    __aicore__ inline BackwardKernel(TPipe* p) : pipe_(p) {}

    __aicore__ inline void Init(
        GM_ADDR go, GM_ADDR x, GM_ADDR k, GM_ADDR v, GM_ADDR wh, GM_ADDR we,
        GM_ADDR interm_rstd_x, GM_ADDR interm_rstd_k, GM_ADDR interm_raw_dot,
        GM_ADDR interm_dot, GM_ADDR interm_s_sqrt, GM_ADDR interm_gate,
        GM_ADDR gx, GM_ADDR gk, GM_ADDR gv, GM_ADDR gwh, GM_ADDR gwe,
        const __gm__ EngramGateBwdTilingData* tl)
    {
        tiling_ = tl;
        uint32_t bi = GetBlockIdx();
        T0_ = bi * tl->T_per_core;
        T1_ = (T0_ + tl->T_per_core) < tl->T_total ? (T0_ + tl->T_per_core) : tl->T_total;
        Tm_ = tl->T_TILE;  uint32_t Tt = Tm_, totalTH = tl->T_total * H_;

        goGm_.SetGlobalBuffer((__gm__ bfloat16_t*)go, tl->T_total * HD_);
        xGm_.SetGlobalBuffer((__gm__ bfloat16_t*)x, tl->T_total * HD_);
        kGm_.SetGlobalBuffer((__gm__ bfloat16_t*)k, tl->T_total * HD_);
        vGm_.SetGlobalBuffer((__gm__ bfloat16_t*)v, tl->T_total * D_);
        whGm_.SetGlobalBuffer((__gm__ bfloat16_t*)wh, HD_);
        weGm_.SetGlobalBuffer((__gm__ bfloat16_t*)we, HD_);
        iRxGm_.SetGlobalBuffer((__gm__ bfloat16_t*)interm_rstd_x, totalTH);
        iRkGm_.SetGlobalBuffer((__gm__ bfloat16_t*)interm_rstd_k, totalTH);
        iRdGm_.SetGlobalBuffer((__gm__ bfloat16_t*)interm_raw_dot, totalTH);
        iDtGm_.SetGlobalBuffer((__gm__ bfloat16_t*)interm_dot, totalTH);
        iSsGm_.SetGlobalBuffer((__gm__ bfloat16_t*)interm_s_sqrt, totalTH);
        iGtGm_.SetGlobalBuffer((__gm__ bfloat16_t*)interm_gate, totalTH);
        gxGm_.SetGlobalBuffer((__gm__ bfloat16_t*)gx, tl->T_total * HD_);
        gkGm_.SetGlobalBuffer((__gm__ bfloat16_t*)gk, tl->T_total * HD_);
        gvGm_.SetGlobalBuffer((__gm__ bfloat16_t*)gv, tl->T_total * D_);
        gwhGm_.SetGlobalBuffer((__gm__ bfloat16_t*)gwh, HD_);
        gweGm_.SetGlobalBuffer((__gm__ bfloat16_t*)gwe, HD_);

        uint32_t s3 = Tt * HD_ * 4, sW = HD_ * 4, s2D = Tt * D_ * 4;
        uint32_t sS = Tt * H_ * 4, sM = Tt * H_ * 2, sB = Tt * HD_ * 2;
        uint32_t sTmp = Tt * HD_ * 4;  // tmpB_ for independent Add dst (Root Cause 2)

        pipe_->InitBuffer(bfB_, sB);
        pipe_->InitBuffer(goB_, s3); pipe_->InitBuffer(xB_, s3);
        pipe_->InitBuffer(kB_, s3);  pipe_->InitBuffer(vB_, s2D);
        pipe_->InitBuffer(whB_, sW); pipe_->InitBuffer(weB_, sW);
        pipe_->InitBuffer(tA_, s3);  pipe_->InitBuffer(tB_, s3);
        pipe_->InitBuffer(gvB_, s2D);
        pipe_->InitBuffer(rtB_, 32768);
        pipe_->InitBuffer(tmpB_, sTmp);
        pipe_->InitBuffer(f0_, sS);  pipe_->InitBuffer(f1_, sS);
        pipe_->InitBuffer(f2_, sS);  pipe_->InitBuffer(f3_, sS);
        pipe_->InitBuffer(f4_, sS);  pipe_->InitBuffer(f5_, sS);
        pipe_->InitBuffer(mkB_, sM);
        pipe_->InitBuffer(gwA_, sW); pipe_->InitBuffer(geA_, sW);
        { auto a = gwA_.Get<float>(), b = geA_.Get<float>();
          Duplicate<float>(a, 0.0f, HD_); Duplicate<float>(b, 0.0f, HD_); }
    }

    __aicore__ inline void Process() {
        LdC(whGm_, whB_); LdC(weGm_, weB_);
        PipeBarrier<PIPE_ALL>();
        for (uint32_t t = T0_; t < T1_; t += Tm_) {
            uint32_t Tt = (t + Tm_ <= T1_) ? Tm_ : (T1_ - t);
            CI(t, Tt); LdI(t, Tt);
            PipeBarrier<PIPE_ALL>();
            Cpt(Tt);
            PipeBarrier<PIPE_ALL>();
            CO(t, Tt);
        }
        PipeBarrier<PIPE_ALL>();
        AWr();
    }

private:
    typedef GlobalTensor<bfloat16_t> GB;
    typedef TBuf<TPosition::VECCALC> TB;
    typedef TBuf<TPosition::VECIN> TV;

    __aicore__ inline void LdC(GB& g, TB& u) {
        auto b = bfB_.Get<bfloat16_t>();
        DataCopyPad(b, g, {1, (uint16_t)(HD_ * 2), 0, 0}, {false, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<float, bfloat16_t>(u.Get<float>(), b, RoundMode::CAST_NONE, HD_);
    }
    __aicore__ inline void L3(GB& g, TB& u, uint32_t ts, uint32_t Tt) {
        uint32_t n = Tt * HD_;
        auto b = bfB_.Get<bfloat16_t>();
        DataCopyPad(b, g[ts * HD_], {1, (uint16_t)(n * 2), 0, 0}, {false, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<float, bfloat16_t>(u.Get<float>(), b, RoundMode::CAST_NONE, n);
    }
    __aicore__ inline void L2(GB& g, TB& u, uint32_t ts, uint32_t Tt) {
        uint32_t n = Tt * D_;
        auto b = bfB_.Get<bfloat16_t>();
        DataCopyPad(b, g[ts * D_], {1, (uint16_t)(n * 2), 0, 0}, {false, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<float, bfloat16_t>(u.Get<float>(), b, RoundMode::CAST_NONE, n);
    }
    __aicore__ inline void LdI1(GB& g, TB& u, uint32_t ts, uint32_t n) {
        auto b = bfB_.Get<bfloat16_t>();
        DataCopyPad(b, g[ts * H_], {1, (uint16_t)(n * 2), 0, 0}, {false, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<float, bfloat16_t>(u.Get<float>(), b, RoundMode::CAST_NONE, n);
    }
    __aicore__ inline void CI(uint32_t ts, uint32_t Tt) {
        L3(goGm_, goB_, ts, Tt); PipeBarrier<PIPE_V>();
        L3(xGm_, xB_, ts, Tt);   PipeBarrier<PIPE_V>();
        L3(kGm_, kB_, ts, Tt);   PipeBarrier<PIPE_V>();
        L2(vGm_, vB_, ts, Tt);   PipeBarrier<PIPE_V>();
    }
    __aicore__ inline void LdI(uint32_t ts, uint32_t Tt) {
        uint32_t n = Tt * H_;
        LdI1(iRxGm_, f0_, ts, n); PipeBarrier<PIPE_V>();
        LdI1(iRkGm_, f1_, ts, n); PipeBarrier<PIPE_V>();
        LdI1(iRdGm_, f2_, ts, n); PipeBarrier<PIPE_V>();
        LdI1(iDtGm_, f3_, ts, n); PipeBarrier<PIPE_V>();
        LdI1(iSsGm_, f4_, ts, n); PipeBarrier<PIPE_V>();
        LdI1(iGtGm_, f5_, ts, n); PipeBarrier<PIPE_V>();
    }
    __aicore__ inline void CO(uint32_t ts, uint32_t Tt) {
        uint32_t n3 = Tt * HD_, n2 = Tt * D_;
        auto ba = tA_.Get<bfloat16_t>(), bb = tB_.Get<bfloat16_t>();
        Cast<bfloat16_t, float>(ba, goB_.Get<float>(), RoundMode::CAST_ROUND, n3);
        PipeBarrier<PIPE_ALL>();
        DataCopyPad(gxGm_[ts * HD_], ba, {1, (uint16_t)(n3 * 2), 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<bfloat16_t, float>(bb, kB_.Get<float>(), RoundMode::CAST_ROUND, n3);
        PipeBarrier<PIPE_ALL>();
        DataCopyPad(gkGm_[ts * HD_], bb, {1, (uint16_t)(n3 * 2), 0, 0});
        PipeBarrier<PIPE_ALL>();
        Cast<bfloat16_t, float>(ba, gvB_.Get<float>(), RoundMode::CAST_ROUND, n2);
        PipeBarrier<PIPE_ALL>();
        DataCopyPad(gvGm_[ts * D_], ba, {1, (uint16_t)(n2 * 2), 0, 0});
    }
    __aicore__ inline void AWr() {
        auto ba = tA_.Get<bfloat16_t>(), bb = tB_.Get<bfloat16_t>();
        Cast<bfloat16_t, float>(ba, gwA_.Get<float>(), RoundMode::CAST_ROUND, HD_);
        PipeBarrier<PIPE_ALL>();
        SetAtomicAdd<bfloat16_t>();
        DataCopyPad(gwhGm_, ba, {1, (uint16_t)(HD_ * 2), 0, 0});
        SetAtomicNone();
        Cast<bfloat16_t, float>(bb, geA_.Get<float>(), RoundMode::CAST_ROUND, HD_);
        PipeBarrier<PIPE_ALL>();
        SetAtomicAdd<bfloat16_t>();
        DataCopyPad(gweGm_, bb, {1, (uint16_t)(HD_ * 2), 0, 0});
        SetAtomicNone();
    }

    __aicore__ inline void VBMulC(LocalTensor<float>& d, LocalTensor<float>& a,
                                   LocalTensor<float>& c, uint32_t Tt) {
        for (uint32_t t = 0; t < Tt; t++)
            for (uint32_t h = 0; h < H_; h++) {
                uint32_t ro = (t * H_ + h) * D_, co = h * D_;
                for (uint32_t dd = 0; dd < D_; dd += M_)
                    Mul<float>(d[ro + dd], a[ro + dd], c[co + dd], M_);
            }
    }
    __aicore__ inline void VBMulS(LocalTensor<float>& d, LocalTensor<float>& a,
                                   LocalTensor<float>& s, uint32_t Tt) {
        float sv[32]; uint32_t TR = Tt * H_;
        for (uint32_t i = 0; i < TR; i++) sv[i] = s.GetValue(i);
        for (uint32_t t = 0; t < Tt; t++)
            for (uint32_t h = 0; h < H_; h++) {
                uint32_t ro = (t * H_ + h) * D_;
                float v = sv[t * H_ + h];
                for (uint32_t dd = 0; dd < D_; dd += M_)
                    Muls<float>(d[ro + dd], a[ro + dd], v, M_);
            }
    }
    __aicore__ inline void VBMulV(LocalTensor<float>& d, LocalTensor<float>& a,
                                   LocalTensor<float>& v, uint32_t Tt) {
        for (uint32_t t = 0; t < Tt; t++)
            for (uint32_t h = 0; h < H_; h++) {
                uint32_t ro = (t * H_ + h) * D_, vo = t * D_;
                for (uint32_t dd = 0; dd < D_; dd += M_)
                    Mul<float>(d[ro + dd], a[ro + dd], v[vo + dd], M_);
            }
    }
    __aicore__ inline void VMul(LocalTensor<float>& d, LocalTensor<float>& a,
                                 LocalTensor<float>& b, uint32_t Tt) {
        uint32_t n = Tt * HD_;
        for (uint32_t o = 0; o < n; o += M_) {
            uint32_t c = (o + M_ <= n) ? M_ : (n - o);
            Mul<float>(d[o], a[o], b[o], c);
        }
    }
    __aicore__ inline void M2F(LocalTensor<float>& d, LocalTensor<uint16_t>& m, uint32_t n) {
        for (uint32_t i = 0; i < n; i++)
            d.SetValue(i, (m.GetValue(i) & 1) ? 1.0f : 0.0f);
    }
    __aicore__ inline void RSD(LocalTensor<float>& d, LocalTensor<float>& s, uint32_t Tt) {
        auto rt = rtB_.Get<float>();
        for (uint32_t t = 0; t < Tt; t++)
            for (uint32_t h = 0; h < H_; h++)
                ReduceSum<float, true>(d[t * H_ + h], s[(t * H_ + h) * D_], rt, (int32_t)D_);
    }
    __aicore__ inline void RSH(LocalTensor<float>& d, LocalTensor<float>& s, uint32_t Tt) {
        auto rt = rtB_.Get<uint8_t>();
        uint32_t sh[] = {H_, D_};
        for (uint32_t t = 0; t < Tt; t++)
            ReduceSum<float, Pattern::Reduce::RA, true>(d[t * D_], s[t * HD_], rt, sh, true);
    }
    __aicore__ inline void RST(LocalTensor<float>& d, LocalTensor<float>& s, uint32_t Tt) {
        auto rt = rtB_.Get<uint8_t>();
        uint32_t sh[] = {Tt, HD_};
        ReduceSum<float, Pattern::Reduce::RA, true>(d, s, rt, sh, true);
    }

    __aicore__ inline void Cpt(uint32_t Tt) {
        float sc = tiling_->scalar, cv = ENG_CLAMP_VALUE, iD = 1.0f / 128.0f;
        uint32_t TR = Tt * H_, n3d = Tt * HD_;

        auto GO = goB_.Get<float>(),  X = xB_.Get<float>();
        auto K  = kB_.Get<float>(),   V = vB_.Get<float>();
        auto WH = whB_.Get<float>(),  WE = weB_.Get<float>();
        auto TA = tA_.Get<float>(),   TB = tB_.Get<float>();
        auto GV = gvB_.Get<float>();
        auto MK = mkB_.Get<uint16_t>();
        auto GWA = gwA_.Get<float>(), GWE = geA_.Get<float>();
        auto F0 = f0_.Get<float>(), F1 = f1_.Get<float>(), F2 = f2_.Get<float>();
        auto F3 = f3_.Get<float>(), F4 = f4_.Get<float>(), F5 = f5_.Get<float>();
        auto TMP = tmpB_.Get<float>();  // scratch for independent Add dst (RC2 fix)

        // P1: grad_v
        VBMulS(TA, GO, F5, Tt); RSH(GV, TA, Tt);

        // P2-P5: grad_dot chain
        Abs<float>(F3, F3, TR);
        VBMulV(TA, GO, V, Tt); RSD(F4, TA, Tt);
        Duplicate<float>(TB, 1.0f, TR);
        Sub<float>(TB, TB, F5, TR);
        Mul<float>(F4, F4, F5, TR);
        Mul<float>(F4, F4, TB, TR);

        Compares<float, uint16_t>(MK, F3, cv, CMPMODE::GE, TR);
        M2F(TB, MK, TR);
        Duplicate<float>(TA, cv, TR);
        Max<float>(TA, F3, TA, TR);
        Sqrt<float>(TA, TA, TR);
        Mul<float>(F4, F4, TB, TR);
        Muls<float>(F4, F4, 0.5f, TR);
        Div<float>(F4, F4, TA, TR);

        // P6: grad_raw_dot(F5), grad_rstd_x(TA), grad_rstd_k(TB)
        Mul<float>(F5, F4, F0, TR);
        Mul<float>(F5, F5, F1, TR);
        Muls<float>(F5, F5, sc, TR);

        Mul<float>(TA, F4, F2, TR);
        Mul<float>(TA, TA, F1, TR);
        Muls<float>(TA, TA, sc, TR);

        Mul<float>(TB, F4, F2, TR);
        Mul<float>(TB, TB, F0, TR);
        Muls<float>(TB, TB, sc, TR);

        // P7: rstd_x^3(F2), rstd_k^3(F3), save to F4/F0
        Mul<float>(F2, F0, F0, TR);
        Mul<float>(F2, F2, F0, TR);
        Mul<float>(F3, F1, F1, TR);
        Mul<float>(F3, F3, F1, TR);
        for (uint32_t i = 0; i < TR; i++) {
            F4.SetValue(i, TA.GetValue(i));
            F0.SetValue(i, TB.GetValue(i));
        }

        // P8: grad_wh/grad_we partial
        VBMulC(TA, K, WE, Tt); VMul(TA, TA, X, Tt);
        VBMulS(TA, TA, F5, Tt);
        if (Tt == 1) {
            // RC3 fix: skip unreliable RST identity for Tt==1
            for (uint32_t o = 0; o < HD_; o += M_) {
                uint32_t c = (o + M_ <= HD_) ? M_ : (HD_ - o);
                // RC2 fix: TMP as independent Add dst (d!=a)
                Add<float>(TMP[o], GWA[o], TA[o], c);
                for (uint32_t i = 0; i < c; i++) GWA.SetValue(o + i, TMP.GetValue(o + i));
            }
        } else {
            RST(TB, TA, Tt);
            for (uint32_t o = 0; o < HD_; o += M_) {
                uint32_t c = (o + M_ <= HD_) ? M_ : (HD_ - o);
                Add<float>(TMP[o], GWA[o], TB[o], c);
                for (uint32_t i = 0; i < c; i++) GWA.SetValue(o + i, TMP.GetValue(o + i));
            }
        }

        VBMulC(TA, X, WH, Tt); VMul(TA, TA, K, Tt);
        VBMulS(TA, TA, F5, Tt);
        if (Tt == 1) {
            for (uint32_t o = 0; o < HD_; o += M_) {
                uint32_t c = (o + M_ <= HD_) ? M_ : (HD_ - o);
                Add<float>(TMP[o], GWE[o], TA[o], c);
                for (uint32_t i = 0; i < c; i++) GWE.SetValue(o + i, TMP.GetValue(o + i));
            }
        } else {
            RST(TB, TA, Tt);
            for (uint32_t o = 0; o < HD_; o += M_) {
                uint32_t c = (o + M_ <= HD_) ? M_ : (HD_ - o);
                Add<float>(TMP[o], GWE[o], TB[o], c);
                for (uint32_t i = 0; i < c; i++) GWE.SetValue(o + i, TMP.GetValue(o + i));
            }
        }

        // P9: grad_x = GO (base) + term1 + term2
        VBMulC(TB, K, WE, Tt); VBMulC(TB, TB, WH, Tt);
        VBMulS(TB, TB, F5, Tt);
        for (uint32_t o = 0; o < n3d; o += M_) {
            uint32_t c = (o + M_ <= n3d) ? M_ : (n3d - o);
            Add<float>(TMP[o], GO[o], TB[o], c);
            for (uint32_t i = 0; i < c; i++) GO.SetValue(o + i, TMP.GetValue(o + i));
        }
        for (uint32_t i = 0; i < TR; i++)
            TA.SetValue(i, F4.GetValue(i) * F2.GetValue(i) * (-iD));
        VBMulS(TA, X, TA, Tt);
        for (uint32_t o = 0; o < n3d; o += M_) {
            uint32_t c = (o + M_ <= n3d) ? M_ : (n3d - o);
            Add<float>(TMP[o], GO[o], TA[o], c);
            for (uint32_t i = 0; i < c; i++) GO.SetValue(o + i, TMP.GetValue(o + i));
        }

        // P10: grad_k = term1 + term2
        VBMulC(TA, X, WH, Tt); VBMulC(TA, TA, WE, Tt);
        VBMulS(TA, TA, F5, Tt);
        for (uint32_t i = 0; i < TR; i++)
            TB.SetValue(i, F0.GetValue(i) * F3.GetValue(i) * (-iD));
        VBMulS(TB, K, TB, Tt);
        for (uint32_t o = 0; o < n3d; o++)
            K.SetValue(o, TA.GetValue(o) + TB.GetValue(o));
    }

    TPipe* pipe_;
    const __gm__ EngramGateBwdTilingData* tiling_;
    uint32_t T0_, T1_, Tm_;
    GB goGm_, xGm_, kGm_, vGm_, whGm_, weGm_;
    GB iRxGm_, iRkGm_, iRdGm_, iDtGm_, iSsGm_, iGtGm_;
    GB gxGm_, gkGm_, gvGm_, gwhGm_, gweGm_;
    TB goB_, xB_, kB_, vB_, whB_, weB_, tA_, tB_, gvB_, rtB_, tmpB_;
    TB f0_, f1_, f2_, f3_, f4_, f5_, mkB_, gwA_, geA_;
    TV bfB_;
};

extern "C" __global__ __vector__ void engram_gate_bwd_bwd_kernel(
    GM_ADDR go, GM_ADDR x, GM_ADDR k, GM_ADDR v, GM_ADDR wh, GM_ADDR we,
    GM_ADDR interm_rstd_x, GM_ADDR interm_rstd_k, GM_ADDR interm_raw_dot,
    GM_ADDR interm_dot, GM_ADDR interm_s_sqrt, GM_ADDR interm_gate,
    GM_ADDR gx, GM_ADDR gk, GM_ADDR gv, GM_ADDR gwh, GM_ADDR gwe,
    GM_ADDR tl)
{
    TPipe p;
    BackwardKernel op(&p);
    op.Init(go, x, k, v, wh, we, interm_rstd_x, interm_rstd_k, interm_raw_dot,
            interm_dot, interm_s_sqrt, interm_gate, gx, gk, gv, gwh, gwe,
            (__gm__ EngramGateBwdTilingData*)tl);
    op.Process();
}
