/**
 * DIAGNOSTIC: ForwardKernel standalone test.
 * Runs ForwardKernel only, dumps 6 intermediates to files.
 */
#include <cmath>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/engram_gate_bwd_tiling.h"
#include "data_utils.h"
#include "../op_kernel/engram_gate_bwd_fwd_kernel.asc"

struct ArgInfo {
    std::string fileName;
    size_t length;
};

int32_t main(int32_t argc, char* argv[])
{
    uint32_t T = 14;
    if (argc >= 2) T = static_cast<uint32_t>(std::atoi(argv[1]));
    int32_t deviceId = 0;
    if (argc >= 3) deviceId = std::atoi(argv[2]);

    aclInit(nullptr);
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) { printf("aclrtSetDevice failed, ret=%d\n", ret); return ret; }

    int64_t availableCoreNum = 0;
    aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);

    uint32_t H = ENG_H, D = ENG_D, HxD = H * D;
    uint32_t blockNum = static_cast<uint32_t>(availableCoreNum);
    if (blockNum > T) blockNum = T;
    if (blockNum < 1) blockNum = 1;
    uint32_t T_per_core = (T + blockNum - 1) / blockNum;
    uint32_t T_TILE = ENG_MAX_T_TILE;
    if (T_TILE > T_per_core) T_TILE = T_per_core;

    EngramGateBwdTilingData tiling;
    tiling.T_total = T; tiling.T_TILE = T_TILE;
    tiling.T_per_core = T_per_core;
    tiling.scalar = std::pow(static_cast<float>(D), -0.5f);

    size_t sz3D = T * HxD * sizeof(bfloat16_t);
    size_t sz2D = T * D * sizeof(bfloat16_t);
    size_t szHD = HxD * sizeof(bfloat16_t);
    size_t szInter = T * H * sizeof(uint16_t);

    // Input file info
    std::vector<ArgInfo> inputsInfo = {
        {"NOT_USED", sz3D},  // go (not used by FwdKernel)
        {"./input/x.bin",  sz3D},
        {"./input/k.bin",  sz3D},
        {"NOT_USED", sz2D},  // v
        {"./input/wh.bin", szHD},
        {"./input/we.bin", szHD}
    };

    // Allocate and load inputs to device
    std::vector<uint8_t*> iD(6);
    for (size_t i = 0; i < 6; i++) {
        size_t sz = (i == 3) ? sz2D : ((i >= 4) ? szHD : sz3D);
        void* hBuf = nullptr;
        aclrtMallocHost(&hBuf, sz);
        if (i != 0 && i != 3) {
            ReadFile(inputsInfo[i].fileName, sz, hBuf, sz);
        } else {
            memset(hBuf, 0, sz);
        }
        aclrtMalloc((void**)&iD[i], sz, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(iD[i], sz, hBuf, sz, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtFreeHost(hBuf);
    }

    // Allocate 6 intermediate buffers
    uint8_t *d_rstd_x = nullptr, *d_rstd_k = nullptr;
    uint8_t *d_raw_dot = nullptr, *d_dot = nullptr;
    uint8_t *d_s_sqrt = nullptr, *d_gate = nullptr;
    aclrtMalloc((void**)&d_rstd_x,  szInter, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&d_rstd_k,  szInter, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&d_raw_dot, szInter, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&d_dot,     szInter, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&d_s_sqrt,  szInter, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&d_gate,    szInter, ACL_MEM_MALLOC_HUGE_FIRST);

    // Copy tiling to device
    uint8_t* tD = nullptr;
    aclrtMalloc((void**)&tD, sizeof(EngramGateBwdTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tD, sizeof(EngramGateBwdTilingData), &tiling,
        sizeof(EngramGateBwdTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    printf("DIAG ForwardKernel: T=%u H=%u D=%u blockNum=%u T_per_core=%u T_TILE=%u scalar=%.6f\n",
        T, H, D, blockNum, T_per_core, T_TILE, tiling.scalar);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // Launch ForwardKernel only
    engram_gate_bwd_fwd_kernel<<<blockNum, nullptr, stream>>>(
        iD[1], iD[2], iD[4], iD[5],        // x, k, wh, we
        d_rstd_x, d_rstd_k, d_raw_dot, d_dot, d_s_sqrt, d_gate,
        tD);

    aclrtSynchronizeStream(stream);
    aclrtDestroyStream(stream);

    // Dump intermediates to host
    auto dump_interm = [&](const char* name, uint8_t* d_buf) {
        void* hBuf = nullptr;
        aclrtMallocHost(&hBuf, szInter);
        aclrtMemcpy(hBuf, szInter, d_buf, szInter, ACL_MEMCPY_DEVICE_TO_HOST);
        // Read as uint16 (bf16) and print as fp32
        uint16_t* bf = (uint16_t*)hBuf;
        printf("  %s (first 8 of %zu):", name, szInter/2);
        for (size_t i = 0; i < 8 && i < szInter/2; i++) {
            uint32_t u32 = ((uint32_t)bf[i]) << 16;
            float v = *(float*)&u32;
            printf(" %.6f", v);
        }
        printf("\n");
        aclrtFreeHost(hBuf);
    };

    printf("ForwardKernel intermediates:\n");
    dump_interm("rstd_x",  d_rstd_x);
    dump_interm("rstd_k",  d_rstd_k);
    dump_interm("raw_dot", d_raw_dot);
    dump_interm("dot",     d_dot);
    dump_interm("s_sqrt",  d_s_sqrt);
    dump_interm("gate",    d_gate);

    // Cleanup
    aclrtFree(tD);
    aclrtFree(d_gate); aclrtFree(d_s_sqrt); aclrtFree(d_dot);
    aclrtFree(d_raw_dot); aclrtFree(d_rstd_k); aclrtFree(d_rstd_x);
    for (size_t i = 0; i < 6; i++) aclrtFree(iD[i]);

    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
