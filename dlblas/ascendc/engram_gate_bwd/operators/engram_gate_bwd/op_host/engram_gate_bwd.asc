// ============================================================================
// Host + Main - Engram Gate Bwd
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <chrono>
#include "acl/acl.h"
#include "../op_kernel/engram_gate_bwd_tiling.h"
#include "data_utils.h"
#include "../op_kernel/engram_gate_bwd_kernel.asc"

struct ArgInfo {
    std::string fileName;
    size_t length;
};

// ============================================================================
// Tiling computation
// ============================================================================
static void ComputeTiling(EngramGateBwdTiling& tiling,
    uint64_t totalT, uint64_t totalH, uint64_t totalD,
    int64_t availableCoreNum,
    float clampValue, float eps)
{
    tiling.totalT = totalT;
    tiling.totalH = totalH;
    tiling.totalD = totalD;
    tiling.D_align = ((totalD * sizeof(float) + 31) / 32) * 32 / sizeof(float);

    // Multi-core
    tiling.coreNum = std::min(totalT, (uint64_t)availableCoreNum);
    if (tiling.coreNum == 0) tiling.coreNum = 1;
    tiling.tileT = (totalT + tiling.coreNum - 1) / tiling.coreNum;

    // UB tiling: tileTPerLoop = 1 for simplicity (fits in 192KB UB)
    tiling.tileTPerLoop = 1;
    tiling.loopCount = (tiling.tileT + tiling.tileTPerLoop - 1) / tiling.tileTPerLoop;
    tiling.tailT = tiling.tileT - tiling.tileTPerLoop * (tiling.loopCount - 1);
    if (tiling.tailT == 0) tiling.tailT = tiling.tileTPerLoop;

    // Constants
    tiling.clampValue = clampValue;
    tiling.eps = eps;
    tiling.scalar = std::pow((float)totalD, -0.5f);
    tiling.invD = 1.0f / (float)totalD;
    tiling.half = 0.5f;
    tiling.one = 1.0f;

    // Workspace: coreNum * 2 * H * D * sizeof(float)
    tiling.workspaceSize = tiling.coreNum * 2 * totalH * totalD * sizeof(float);
    tiling.workspaceOffset = 0; // per-core offset computed by kernel
}

// ============================================================================
// Kernel launch
// ============================================================================
static void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo>& inInfo, std::vector<ArgInfo>& outInfo,
    uint8_t* tilingData, size_t tilingSize,
    uint64_t workspaceSize)
{
    std::vector<uint8_t*> inHost(inInfo.size()), inDev(inInfo.size());
    std::vector<uint8_t*> outHost(outInfo.size()), outDev(outInfo.size());
    uint8_t* tilingDev = nullptr;
    uint8_t* wsDev = nullptr;

    // Allocate and copy tiling
    aclrtMalloc((void**)&tilingDev, tilingSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDev, tilingSize, tilingData, tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate workspace
    if (workspaceSize > 0) {
        aclrtMalloc((void**)&wsDev, workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // Load inputs
    for (size_t i = 0; i < inInfo.size(); i++) {
        aclrtMallocHost((void**)&inHost[i], inInfo[i].length);
        aclrtMalloc((void**)&inDev[i], inInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inInfo[i].fileName, inInfo[i].length, inHost[i], inInfo[i].length);
        aclrtMemcpy(inDev[i], inInfo[i].length, inHost[i],
            inInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    // Allocate outputs
    for (size_t i = 0; i < outInfo.size(); i++) {
        aclrtMallocHost((void**)&outHost[i], outInfo[i].length);
        aclrtMalloc((void**)&outDev[i], outInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // Warmup: 3 kernel launches
    for (int w = 0; w < 3; w++) {
        engram_gate_bwd_kernel<<<blockNum, nullptr, stream>>>(
            inDev[0], inDev[1], inDev[2], inDev[3],
            inDev[4], inDev[5],
            outDev[0], outDev[1], outDev[2],
            outDev[3], outDev[4],
            wsDev, tilingDev);
    }
    aclrtSynchronizeStream(stream);

    // Timed: 50 kernel launches
    auto t0 = std::chrono::high_resolution_clock::now();
    for (int i = 0; i < 50; i++) {
        engram_gate_bwd_kernel<<<blockNum, nullptr, stream>>>(
            inDev[0], inDev[1], inDev[2], inDev[3],
            inDev[4], inDev[5],
            outDev[0], outDev[1], outDev[2],
            outDev[3], outDev[4],
            wsDev, tilingDev);
    }
    aclrtSynchronizeStream(stream);
    auto t1 = std::chrono::high_resolution_clock::now();
    double kernel_us = std::chrono::duration<double, std::micro>(t1 - t0).count() / 50.0;
    printf("[PERF] kernel_time_us=%.2f\n", kernel_us);

    // Free tiling and workspace
    aclrtFree(tilingDev);
    if (wsDev) aclrtFree(wsDev);

    // Read back outputs
    for (size_t i = 0; i < outInfo.size(); i++) {
        aclrtMemcpy(outHost[i], outInfo[i].length, outDev[i],
            outInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outInfo[i].fileName, outHost[i], outInfo[i].length);
        aclrtFree(outDev[i]);
        aclrtFreeHost(outHost[i]);
    }

    // Free inputs
    for (size_t i = 0; i < inInfo.size(); i++) {
        aclrtFree(inDev[i]);
        aclrtFreeHost(inHost[i]);
    }
}

// ============================================================================
// Main
// ============================================================================
int32_t main(int32_t argc, char* argv[])
{
    // Default dimensions from PLAN.md: T=14, H=4, D=128
    uint64_t T = 14, H = 4, D = 128;
    float clampValue = 1e-6f, eps = 1e-20f;

    if (argc >= 4) { T = std::stoull(argv[1]); H = std::stoull(argv[2]); D = std::stoull(argv[3]); }
    if (argc >= 5) clampValue = std::stof(argv[4]);
    if (argc >= 6) eps = std::stof(argv[5]);

    printf("engram_gate_bwd: T=%lu H=%lu D=%lu cv=%.1e eps=%.1e\n", T, H, D, clampValue, eps);

    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // Get core count
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }
    printf("Available cores: %ld\n", availableCoreNum);

    // Compute tiling
    EngramGateBwdTiling tiling = {};
    ComputeTiling(tiling, T, H, D, availableCoreNum, clampValue, eps);

    tiling.coreIdx = 0;
    for (uint64_t i = 0; i < tiling.coreNum; i++) {
        tiling.coreIdx = i;
    }

    printf("coreNum=%lu tileT=%lu loopCount=%lu\n",
        tiling.coreNum, tiling.tileT, tiling.loopCount);

    // Input/output sizes (bf16)
    size_t sz_THD = T * H * D * sizeof(bfloat16_t);
    size_t sz_TD  = T * D * sizeof(bfloat16_t);
    size_t sz_HD  = H * D * sizeof(bfloat16_t);

    // Set up file lists
    std::vector<ArgInfo> inInfo = {
        {"./input/input_go.bin", sz_THD},   // 0: grad_out
        {"./input/input_x.bin",  sz_THD},   // 1: x
        {"./input/input_k.bin",  sz_THD},   // 2: k
        {"./input/input_v.bin",  sz_TD},    // 3: v
        {"./input/input_wh.bin", sz_HD},    // 4: wh
        {"./input/input_we.bin", sz_HD},    // 5: we
    };

    std::vector<ArgInfo> outInfo = {
        {"./output/output_grad_x.bin",  sz_THD}, // 0
        {"./output/output_grad_k.bin",  sz_THD}, // 1
        {"./output/output_grad_v.bin",  sz_TD},  // 2
        {"./output/output_grad_wh.bin", sz_HD},  // 3
        {"./output/output_grad_we.bin", sz_HD},  // 4
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(tiling.coreNum, stream, inInfo, outInfo,
        (uint8_t*)&tiling, sizeof(tiling), tiling.workspaceSize);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("engram_gate_bwd completed successfully\n");
    return 0;
}
