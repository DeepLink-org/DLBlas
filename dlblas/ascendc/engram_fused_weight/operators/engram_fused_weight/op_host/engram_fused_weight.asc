// ============================================================================
// Ascend C Kernel Direct Invoke - engram_fused_weight (Host + Main)
//
// File structure:
//   op_kernel/engram_fused_weight_tiling.h   - Tiling struct + ComputeTiling()
//   op_kernel/engram_fused_weight_kernel.asc - Kernel implementation
//   op_host/engram_fused_weight.asc          - This file: Host code + main
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/engram_fused_weight_tiling.h"
#include "data_utils.h"

// Include the pure kernel file (brings in kernel_operator.h + kernel class)
#include "../op_kernel/engram_fused_weight_kernel.asc"
#include <chrono>

// ============================================================================
// Host-side code - runs on CPU
// ============================================================================

struct ArgInfo {
    std::string fileName;
    size_t length;
};

// KernelCall: handles the full kernel invocation flow
aclrtSynchronizeStream(stream);
auto _t0 = std::chrono::high_resolution_clock::now();
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData, size_t tilingSize)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    // Copy tiling data to device
    aclrtMalloc((void **)&tilingDevice, tilingSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, tilingSize, tilingData,
        tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate and copy inputs
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    // Allocate output buffers
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // Launch kernel
    engram_fused_weight_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], inputDevice[1],
        outputDevice[0], tilingDevice);
    aclrtSynchronizeStream(stream);
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    // Free tiling device buffer
    aclrtFree(tilingDevice);

    // Copy outputs back to host and write to files
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    // Free input buffers
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// Standard ACL initialization flow
int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // Get available AI core count
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // Operator parameters from source code
    // Default: hc_mult=4, hidden_size=128 -> dim0=512
    int64_t hc_mult = 4;
    int64_t hidden_size = 128;

    // Allow overriding from command line
    if (argc >= 3) {
        hc_mult = std::atoll(argv[1]);
        hidden_size = std::atoll(argv[2]);
    }

    int64_t dim0 = hc_mult * hidden_size;
    // Per DESIGN.md §1.2: input is BF16 (2 bytes), output is FP32 (4 bytes)
    size_t inputByteSize = dim0 * sizeof(bfloat16_t);
    size_t outputByteSize = dim0 * sizeof(float);

    // Compute tiling parameters per DESIGN.md §9.4
    auto tiling = ComputeTiling(hc_mult, hidden_size, static_cast<int32_t>(availableCoreNum));

    printf("=== engram_fused_weight ===\n");
    printf("  hc_mult=%lld, hidden_size=%lld, dim0=%lld\n",
        (long long)hc_mult, (long long)hidden_size, (long long)dim0);
    printf("  coreNum=%d, blockNum=%lld, blockFormer=%lld\n",
        tiling.coreNum, (long long)tiling.blockNum, (long long)tiling.blockFormer);
    printf("  ubFormer=%lld, ubLoop=%lld, ubTail=%lld\n",
        (long long)tiling.ubFormer, (long long)tiling.ubLoop, (long long)tiling.ubTail);

    uint32_t blockNum = static_cast<uint32_t>(tiling.blockNum);

    // Input/output file configuration
    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_wh.bin", inputByteSize},
        {"./input/input_we.bin", inputByteSize}
    };
    // Output: FP32 binary (per DESIGN.md §1.2)
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", outputByteSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    KernelCall(blockNum, stream, inputsInfo, outputsInfo,
        (uint8_t *)&tiling, sizeof(EngramFusedWeightTilingData));

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("  Done.\n");
    return 0;
}
