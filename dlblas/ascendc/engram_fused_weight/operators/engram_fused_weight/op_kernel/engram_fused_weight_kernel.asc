// Ascend C Kernel - engram_fused_weight
// Math: output_fp32[i] = float(wh_bf16[i]) * float(we_bf16[i])
// BF16 inputs, Cast to FP32, FP32 Multiply, FP32 output.

#include "kernel_operator.h"
#include "engram_fused_weight_tiling.h"

class KernelEngramFusedWeight {
public:
    __aicore__ inline KernelEngramFusedWeight(AscendC::TPipe* p) : pipe_(p) {}

    __aicore__ inline void Init(
        GM_ADDR whGM, GM_ADDR weGM, GM_ADDR outGM,
        const __gm__ EngramFusedWeightTilingData* tiling)
    {
        this->tiling_ = tiling;

        // Store raw GM addresses for per-tile offset computation
        whGM_ = reinterpret_cast<__gm__ bfloat16_t*>(whGM);
        weGM_ = reinterpret_cast<__gm__ bfloat16_t*>(weGM);
        outGM_ = reinterpret_cast<__gm__ float*>(outGM);

        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx < static_cast<uint32_t>(tiling_->blockNum - 1)) {
            total_ = tiling_->blockFormer;
        } else {
            total_ = tiling_->blockFormer;
            if (tiling_->dim0 > tiling_->blockFormer * (tiling_->blockNum - 1)) {
                total_ = tiling_->dim0 - tiling_->blockFormer * (tiling_->blockNum - 1);
            }
        }

        tileNum_ = static_cast<uint32_t>(
            (total_ + tiling_->ubFormer - 1) / tiling_->ubFormer);

        // Base offset for this block
        baseOff_ = static_cast<int64_t>(blockIdx) * tiling_->blockFormer;

        pipe_->InitBuffer(whQ_, QUE_DEPTH, tiling_->ubFormer * sizeof(bfloat16_t));
        pipe_->InitBuffer(weQ_, QUE_DEPTH, tiling_->ubFormer * sizeof(bfloat16_t));
        pipe_->InitBuffer(tmpWH_, tiling_->ubFormer * sizeof(float));
        pipe_->InitBuffer(tmpWE_, tiling_->ubFormer * sizeof(float));
        pipe_->InitBuffer(outQ_, QUE_DEPTH, tiling_->ubFormer * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum_; i++) {
            uint32_t count = (i == tileNum_ - 1)
                ? static_cast<uint32_t>(total_ - static_cast<int64_t>(i) * tiling_->ubFormer)
                : static_cast<uint32_t>(tiling_->ubFormer);
            CopyIn(count);
            Compute(count);
            CopyOut(count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t count)
    {
        AscendC::LocalTensor<bfloat16_t> whBuf = whQ_.AllocTensor<bfloat16_t>();
        AscendC::LocalTensor<bfloat16_t> weBuf = weQ_.AllocTensor<bfloat16_t>();

        // Use raw pointer + offset to avoid GlobalTensor slicing issues for large offsets
        int64_t off = baseOff_ + curOff_;
        AscendC::GlobalTensor<bfloat16_t> whSlice;
        AscendC::GlobalTensor<bfloat16_t> weSlice;
        whSlice.SetGlobalBuffer(whGM_ + off, count);
        weSlice.SetGlobalBuffer(weGM_ + off, count);

        AscendC::DataCopy(whBuf, whSlice,
            {1, static_cast<uint16_t>(count), 0, 0});
        AscendC::DataCopy(weBuf, weSlice,
            {1, static_cast<uint16_t>(count), 0, 0});

        whQ_.EnQue(whBuf);
        weQ_.EnQue(weBuf);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<bfloat16_t> whBF16 = whQ_.DeQue<bfloat16_t>();
        AscendC::LocalTensor<bfloat16_t> weBF16 = weQ_.DeQue<bfloat16_t>();

        AscendC::Cast<float>(tmpWH_.Get<float>(), whBF16,
            AscendC::RoundMode::CAST_NONE, static_cast<int32_t>(count));
        AscendC::Cast<float>(tmpWE_.Get<float>(), weBF16,
            AscendC::RoundMode::CAST_NONE, static_cast<int32_t>(count));

        AscendC::LocalTensor<float> outBuf = outQ_.AllocTensor<float>();
        AscendC::Mul<float>(outBuf, tmpWH_.Get<float>(), tmpWE_.Get<float>(),
            static_cast<int32_t>(count));

        outQ_.EnQue<float>(outBuf);
        whQ_.FreeTensor(whBF16);
        weQ_.FreeTensor(weBF16);
    }

    __aicore__ inline void CopyOut(uint32_t count)
    {
        AscendC::LocalTensor<float> outFP32 = outQ_.DeQue<float>();

        int64_t off = baseOff_ + curOff_;
        AscendC::GlobalTensor<float> outSlice;
        outSlice.SetGlobalBuffer(outGM_ + off, count);

        AscendC::DataCopy(outSlice, outFP32,
            {1, static_cast<uint16_t>(count), 0, 0});

        outQ_.FreeTensor(outFP32);

        // Advance offset for next tile
        curOff_ += count;
    }

    AscendC::TPipe* pipe_;
    const __gm__ EngramFusedWeightTilingData* tiling_;

    __gm__ bfloat16_t* whGM_ = nullptr;
    __gm__ bfloat16_t* weGM_ = nullptr;
    __gm__ float* outGM_ = nullptr;

    AscendC::TQue<AscendC::TPosition::VECIN, QUE_DEPTH> whQ_;
    AscendC::TQue<AscendC::TPosition::VECIN, QUE_DEPTH> weQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, QUE_DEPTH> outQ_;

    AscendC::TBuf<> tmpWH_;
    AscendC::TBuf<> tmpWE_;

    int64_t total_ = 0;
    int64_t baseOff_ = 0;
    uint32_t tileNum_ = 0;
    uint32_t curOff_ = 0;
};

extern "C" __global__ __vector__ void engram_fused_weight_kernel(
    GM_ADDR whGM, GM_ADDR weGM, GM_ADDR outGM, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelEngramFusedWeight op(&pipe);
    op.Init(whGM, weGM, outGM, (__gm__ EngramFusedWeightTilingData*)tiling);
    op.Process();
}
