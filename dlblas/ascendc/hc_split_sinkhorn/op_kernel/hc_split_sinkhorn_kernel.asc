// ============================================================================
// hc_split_sinkhorn Kernel 实现
// ============================================================================

#include "kernel_operator.h"
#include "hc_split_sinkhorn_tiling.h"

class KernelHcSplitSinkhorn {
public:
    __aicore__ inline KernelHcSplitSinkhorn(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR mixesGM, GM_ADDR preGM, GM_ADDR postGM, GM_ADDR combGM,
                                const __gm__ HcSplitSinkhornTiling* tiling)
    {
        this->tiling = tiling;

        hc_ = static_cast<uint32_t>(tiling->hc);
        hcAlign_ = static_cast<uint32_t>(tiling->hcAlign);
        mixHc_ = static_cast<uint32_t>(tiling->mixHc);
        mixHcAlign_ = static_cast<uint32_t>(tiling->mixHcAlign);
        sinkhornIters_ = tiling->sinkhornIters;
        eps_ = tiling->eps;
        T_ = tiling->tileRows;

        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint64_t rowOffset = static_cast<uint64_t>(blockIdx) * tiling->rowsPerCore;
        if (blockIdx < tiling->usedCoreNum - 1) {
            totalRows_ = static_cast<uint32_t>(tiling->rowsPerCore);
        } else {
            totalRows_ = tiling->tailCoreRows;
        }

        tileNum_ = (totalRows_ + T_ - 1) / T_;

        uint64_t postBaseOff = ((BASE_START + hc_ + 7) / 8) * 8;
        uint64_t combBaseOff = ((postBaseOff + hc_ + 7) / 8) * 8;
        preBaseOff_ = static_cast<uint32_t>(BASE_START);
        postBaseOff_ = static_cast<uint32_t>(postBaseOff);
        combBaseOff_ = static_cast<uint32_t>(combBaseOff);

        // 计算 paramBuf 的 32B 对齐尺寸
        uint64_t paramRawBytes = (combBaseOff_ + static_cast<uint64_t>(hc_) * hc_) * sizeof(float);
        uint64_t paramBufAligned = ((paramRawBytes + 31) / 32) * 32;

        mixesGm_.SetGlobalBuffer((__gm__ float*)mixesGM + rowOffset * mixHc_, totalRows_ * mixHc_);
        preGm_.SetGlobalBuffer((__gm__ float*)preGM + rowOffset * hc_, totalRows_ * hc_);
        postGm_.SetGlobalBuffer((__gm__ float*)postGM + rowOffset * hc_, totalRows_ * hc_);
        combGm_.SetGlobalBuffer((__gm__ float*)combGM + rowOffset * hc_ * hc_, totalRows_ * hc_ * hc_);

        // UB Buffer 分配 (单缓冲)
        pipe_->InitBuffer(inQueueMixes_, 1, T_ * mixHcAlign_ * sizeof(float));
        pipe_->InitBuffer(outQueuePre_, 1, T_ * hcAlign_ * sizeof(float));
        pipe_->InitBuffer(outQueuePost_, 1, T_ * hcAlign_ * sizeof(float));

        pipe_->InitBuffer(workBufComb_, T_ * hc_ * hcAlign_ * sizeof(float));
        pipe_->InitBuffer(workBufFlatPre_, T_ * hc_ * sizeof(float));
        pipe_->InitBuffer(workBufFlatPost_, T_ * hc_ * sizeof(float));
        pipe_->InitBuffer(workBufFlatComb_, T_ * hc_ * hc_ * sizeof(float));

        pipe_->InitBuffer(tmpBufRowCol_, T_ * hcAlign_ * sizeof(float));
        pipe_->InitBuffer(tmpBufCompute_, COMPUTE_BUF_SIZE);
        pipe_->InitBuffer(tmpBufParams_, paramBufAligned);
        pipe_->InitBuffer(tmpBufReduce_, REDUCE_TMP_BUF_SIZE);
    }

    __aicore__ inline void Process()
    {
        if (totalRows_ == 0) return;

        LoadParams();

        uint32_t rowsDone = 0;
        for (uint32_t tileIdx = 0; tileIdx < tileNum_; tileIdx++) {
            uint32_t rowsThisTile = (tileIdx == tileNum_ - 1)
                ? (totalRows_ - rowsDone) : T_;
            CopyIn(rowsThisTile, rowsDone);
            Compute(rowsThisTile);
            CopyOut(rowsThisTile, rowsDone);
            rowsDone += rowsThisTile;
        }
    }

    __aicore__ inline void CopyIn(uint32_t rowsThisTile, uint32_t rowsDone)
    {
        AscendC::LocalTensor<float> mixesLocal = inQueueMixes_.AllocTensor<float>();
        uint64_t gmOffset = static_cast<uint64_t>(rowsDone) * mixHc_;
        uint32_t copyElements = rowsThisTile * mixHcAlign_;

        if (mixHcAlign_ == mixHc_) {
            AscendC::DataCopyPad(mixesLocal,
                mixesGm_[gmOffset],
                {1, static_cast<uint16_t>(copyElements * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
        } else {
            for (uint32_t r = 0; r < rowsThisTile; r++) {
                uint64_t rowGmOff = gmOffset + static_cast<uint64_t>(r) * mixHc_;
                AscendC::DataCopyPad(
                    mixesLocal[r * mixHcAlign_],
                    mixesGm_[rowGmOff],
                    {1, static_cast<uint16_t>(mixHc_ * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
            }
        }
        inQueueMixes_.EnQue(mixesLocal);
    }

    __aicore__ inline void Compute(uint32_t T)
    {
        AscendC::LocalTensor<float> mixesLocal = inQueueMixes_.DeQue<float>();

        AscendC::LocalTensor<float> flatPre = workBufFlatPre_.Get<float>();
        AscendC::LocalTensor<float> flatPost = workBufFlatPost_.Get<float>();
        AscendC::LocalTensor<float> flatComb = workBufFlatComb_.Get<float>();
        AscendC::LocalTensor<float> combBuf = workBufComb_.Get<float>();
        AscendC::LocalTensor<float> rowColTmp = tmpBufRowCol_.Get<float>();
        AscendC::LocalTensor<float> params = tmpBufParams_.Get<float>();
        AscendC::LocalTensor<float> computeBuf = tmpBufCompute_.Get<float>();

        float s0 = tiling->hcScale[0];
        float s1 = tiling->hcScale[1];
        float s2 = tiling->hcScale[2];
        float eps = eps_;

        for (uint32_t t = 0; t < T; t++) {
            // ---------- Pre Sigmoid ----------
            {
                AscendC::LocalTensor<float> preWork = rowColTmp[t * hcAlign_];
                for (uint32_t j = 0; j < hcAlign_; j++) {
                    if (j < hc_) {
                        preWork.SetValue(j, mixesLocal.GetValue(t * mixHcAlign_ + j));
                    } else {
                        preWork.SetValue(j, 0.0f);
                    }
                }
                AscendC::Muls(preWork, preWork, s0, hc_);
                AscendC::Add(preWork, preWork, params[preBaseOff_], hc_);
                AscendC::Muls(preWork, preWork, -1.0f, hc_);
                AscendC::Exp(preWork, preWork, hc_);
                AscendC::Adds(preWork, preWork, 1.0f, hc_);
                AscendC::Div(preWork, computeBuf, preWork, hc_);
                AscendC::Adds(preWork, preWork, eps, hc_);
                for (uint32_t j = 0; j < hc_; j++) {
                    flatPre.SetValue(t * hc_ + j, preWork.GetValue(j));
                }
            }

            // ---------- Post Sigmoid ----------
            {
                AscendC::LocalTensor<float> postWork = rowColTmp[t * hcAlign_];
                for (uint32_t j = 0; j < hcAlign_; j++) {
                    if (j < hc_) {
                        postWork.SetValue(j, mixesLocal.GetValue(t * mixHcAlign_ + hc_ + j));
                    } else {
                        postWork.SetValue(j, 0.0f);
                    }
                }
                AscendC::Muls(postWork, postWork, s1, hc_);
                AscendC::Add(postWork, postWork, params[postBaseOff_], hc_);
                AscendC::Muls(postWork, postWork, -1.0f, hc_);
                AscendC::Exp(postWork, postWork, hc_);
                AscendC::Adds(postWork, postWork, 1.0f, hc_);
                AscendC::Div(postWork, computeBuf, postWork, hc_);
                AscendC::Muls(postWork, postWork, 2.0f, hc_);
                for (uint32_t j = 0; j < hc_; j++) {
                    flatPost.SetValue(t * hc_ + j, postWork.GetValue(j));
                }
            }

            // ---------- Comb: scale + bias ----------
            {
                for (uint32_t r = 0; r < hc_; r++) {
                    for (uint32_t c = 0; c < hcAlign_; c++) {
                        if (c < hc_) {
                            uint32_t rawIdx = 2 * hc_ + r * hc_ + c;
                            float rawVal = mixesLocal.GetValue(t * mixHcAlign_ + rawIdx);
                            float baseVal = params.GetValue(combBaseOff_ + r * hc_ + c);
                            combBuf.SetValue(t * hc_ * hcAlign_ + r * hcAlign_ + c,
                                rawVal * s2 + baseVal);
                        } else {
                            combBuf.SetValue(t * hc_ * hcAlign_ + r * hcAlign_ + c, 0.0f);
                        }
                    }
                }
            }
        }

        // ---------- Sinkhorn 迭代 ----------
        for (uint32_t t = 0; t < T; t++) {
            uint32_t baseOff = t * hc_ * hcAlign_;
            AscendC::LocalTensor<float> reduceTmp = tmpBufReduce_.Get<float>();

            // 第 0 次迭代: Exp 稳定化
            for (uint32_t r = 0; r < hc_; r++) {
                AscendC::LocalTensor<float> rowData = combBuf[baseOff + r * hcAlign_];
                AscendC::LocalTensor<float> tmpDst = rowColTmp[t * hcAlign_ + r];
                AscendC::ReduceMax<float>(tmpDst, rowData, reduceTmp, hc_);
                float rowMax = tmpDst.GetValue(0);
                AscendC::Adds(rowData, rowData, -rowMax, hc_);
                AscendC::Exp(rowData, rowData, hc_);
            }
            for (uint32_t r = 0; r < hc_; r++) {
                AscendC::LocalTensor<float> rowData = combBuf[baseOff + r * hcAlign_];
                AscendC::LocalTensor<float> tmpDst = rowColTmp[t * hcAlign_ + r];
                AscendC::ReduceSum<float, true>(tmpDst, rowData, reduceTmp, hc_);
                float rowSum = tmpDst.GetValue(0);
                AscendC::Muls(rowData, rowData, 1.0f / rowSum, hc_);
                AscendC::Adds(rowData, rowData, eps, hc_);
            }
            colNormalize(baseOff, eps);

            for (uint32_t iter = 1; iter < sinkhornIters_; iter++) {
                for (uint32_t r = 0; r < hc_; r++) {
                    AscendC::LocalTensor<float> rowData = combBuf[baseOff + r * hcAlign_];
                    AscendC::LocalTensor<float> tmpDst = rowColTmp[t * hcAlign_ + r];
                    AscendC::ReduceSum<float, true>(tmpDst, rowData, reduceTmp, hc_);
                    float rowSum = tmpDst.GetValue(0);
                    AscendC::Muls(rowData, rowData, 1.0f / (rowSum + eps), hc_);
                }
                colNormalize(baseOff, eps);
            }

            // 紧凑写出
            for (uint32_t r = 0; r < hc_; r++) {
                for (uint32_t c = 0; c < hc_; c++) {
                    float val = combBuf.GetValue(baseOff + r * hcAlign_ + c);
                    flatComb.SetValue(t * hc_ * hc_ + r * hc_ + c, val);
                }
            }
        }

        inQueueMixes_.FreeTensor(mixesLocal);
    }

    __aicore__ inline void CopyOut(uint32_t T, uint32_t rowsDone)
    {
        AscendC::LocalTensor<float> flatPre = workBufFlatPre_.Get<float>();
        AscendC::LocalTensor<float> flatPost = workBufFlatPost_.Get<float>();
        AscendC::LocalTensor<float> flatComb = workBufFlatComb_.Get<float>();

        uint64_t preGmOff = static_cast<uint64_t>(rowsDone) * hc_;
        uint64_t postGmOff = static_cast<uint64_t>(rowsDone) * hc_;
        uint64_t combGmOff = static_cast<uint64_t>(rowsDone) * hc_ * hc_;
        uint64_t hcHc = static_cast<uint64_t>(hc_) * hc_;

        AscendC::DataCopyPad(preGm_[preGmOff], flatPre,
            {1, static_cast<uint16_t>(T * hc_ * sizeof(float)), 0, 0});
        AscendC::DataCopyPad(postGm_[postGmOff], flatPost,
            {1, static_cast<uint16_t>(T * hc_ * sizeof(float)), 0, 0});
        AscendC::DataCopyPad(combGm_[combGmOff], flatComb,
            {1, static_cast<uint16_t>(T * hcHc * sizeof(float)), 0, 0});
    }

private:
    __aicore__ inline void LoadParams()
    {
        AscendC::LocalTensor<float> params = tmpBufParams_.Get<float>();
        uint32_t paramTotal = combBaseOff_ + hc_ * hc_;
        for (uint32_t i = 0; i < paramTotal; i++) {
            params.SetValue(i, 0.0f);
        }
        for (uint32_t j = 0; j < hc_; j++) {
            params.SetValue(preBaseOff_ + j, tiling->hcBase[j]);
        }
        for (uint32_t j = 0; j < hc_; j++) {
            params.SetValue(postBaseOff_ + j, tiling->hcBase[hc_ + j]);
        }
        for (uint32_t j = 0; j < hc_ * hc_; j++) {
            params.SetValue(combBaseOff_ + j, tiling->hcBase[2 * hc_ + j]);
        }

        AscendC::LocalTensor<float> comp = tmpBufCompute_.Get<float>();
        for (uint32_t j = 0; j < 32; j++) {
            comp.SetValue(j, 1.0f);
        }
    }

    __aicore__ inline void colNormalize(uint32_t baseOff, float eps)
    {
        for (uint32_t c = 0; c < hc_; c++) {
            float colSum = 0.0f;
            for (uint32_t r = 0; r < hc_; r++) {
                colSum += workBufComb_.Get<float>().GetValue(baseOff + r * hcAlign_ + c);
            }
            float invSum = 1.0f / (colSum + eps);
            for (uint32_t r = 0; r < hc_; r++) {
                AscendC::LocalTensor<float> buf = workBufComb_.Get<float>();
                float val = buf.GetValue(baseOff + r * hcAlign_ + c);
                buf.SetValue(baseOff + r * hcAlign_ + c, val * invSum);
            }
        }
    }

    AscendC::TPipe* pipe_;
    const __gm__ HcSplitSinkhornTiling* tiling;

    uint32_t hc_;
    uint32_t hcAlign_;
    uint32_t mixHc_;
    uint32_t mixHcAlign_;
    uint32_t sinkhornIters_;
    float    eps_;
    uint32_t T_;
    uint32_t totalRows_;
    uint32_t tileNum_;

    uint32_t preBaseOff_;
    uint32_t postBaseOff_;
    uint32_t combBaseOff_;

    AscendC::GlobalTensor<float> mixesGm_;
    AscendC::GlobalTensor<float> preGm_;
    AscendC::GlobalTensor<float> postGm_;
    AscendC::GlobalTensor<float> combGm_;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueMixes_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueuePre_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueuePost_;

    AscendC::TBuf<> workBufComb_;
    AscendC::TBuf<> workBufFlatPre_;
    AscendC::TBuf<> workBufFlatPost_;
    AscendC::TBuf<> workBufFlatComb_;
    AscendC::TBuf<> tmpBufRowCol_;
    AscendC::TBuf<> tmpBufCompute_;
    AscendC::TBuf<> tmpBufParams_;
    AscendC::TBuf<> tmpBufReduce_;
};

extern "C" __global__ __vector__ void hc_split_sinkhorn_kernel(
    GM_ADDR mixes, GM_ADDR pre, GM_ADDR post, GM_ADDR comb, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelHcSplitSinkhorn op(&pipe);
    op.Init(mixes, pre, post, comb, (__gm__ HcSplitSinkhornTiling*)tiling);
    op.Process();
}
