// ============================================================================
// hc_split_sinkhorn Host + Main 入口
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/hc_split_sinkhorn_tiling.h"
#include "data_utils.h"

#include "../op_kernel/hc_split_sinkhorn_kernel.asc"
#include <chrono>

struct ArgInfo {
    std::string fileName;
    size_t length;
};

aclrtSynchronizeStream(stream);
auto _t0 = std::chrono::high_resolution_clock::now();
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(HcSplitSinkhornTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(HcSplitSinkhornTiling), tilingData,
        sizeof(HcSplitSinkhornTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    hc_split_sinkhorn_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0],                              // mixes
        outputDevice[0], outputDevice[1], outputDevice[2],  // pre, post, comb
        tilingDevice);
    aclrtSynchronizeStream(stream);
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // 读取 meta 信息
    // meta.bin: [b(uint64), s(uint64), hc(uint64), iters(uint32), eps(float)]
    //            + hcScale[3](float) + hcBase[mixHc](float)
    size_t metaSize = 5 * sizeof(uint64_t) + sizeof(uint32_t) + sizeof(float)
                    + 3 * sizeof(float) + HC_SPLIT_SINKHORN_MAX_MIX_HC * sizeof(float);
    std::vector<uint8_t> metaBuf(metaSize);
    ReadFile("./input/meta.bin", metaSize, metaBuf.data(), metaSize);

    uint64_t b, s, hc;
    uint32_t iters;
    float eps;
    {
        const uint8_t* p = metaBuf.data();
        b = *reinterpret_cast<const uint64_t*>(p); p += 8;
        s = *reinterpret_cast<const uint64_t*>(p); p += 8;
        hc = *reinterpret_cast<const uint64_t*>(p); p += 8;
        // skip 2 reserved uint64
        p += 16;
        iters = *reinterpret_cast<const uint32_t*>(p); p += 4;
        eps = *reinterpret_cast<const float*>(p); p += 4;
        // hcScale
        float hcScale[3];
        for (int i = 0; i < 3; i++) {
            hcScale[i] = *reinterpret_cast<const float*>(p); p += 4;
        }
        // hcBase
        float hcBase[HC_SPLIT_SINKHORN_MAX_MIX_HC];
        for (uint64_t i = 0; i < HC_SPLIT_SINKHORN_MAX_MIX_HC; i++) {
            hcBase[i] = *reinterpret_cast<const float*>(p); p += 4;
        }

        uint64_t totalBatch = b * s;
        uint64_t mixHc = (2 + hc) * hc;

        printf("Config: b=%lu s=%lu hc=%lu iters=%u eps=%e totalBatch=%lu mixHc=%lu\n",
            b, s, hc, iters, eps, totalBatch, mixHc);

        // 获取核数
        int64_t availableCoreNum = 0;
        ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
        if (ret != ACL_SUCCESS) {
            printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
            aclrtResetDevice(deviceId);
            return ret;
        }

        // Tiling 计算
        HcSplitSinkhornTiling tiling;
        ComputeTiling(tiling, totalBatch, hc, iters, eps, availableCoreNum, hcScale, hcBase);

        uint32_t blockNum = (availableCoreNum < static_cast<int64_t>(tiling.usedCoreNum))
            ? static_cast<uint32_t>(availableCoreNum) : tiling.usedCoreNum;

        printf("Tiling: rowsPerCore=%lu tileRows=%u tilesPerCore=%u usedCoreNum=%u blockNum=%u\n",
            tiling.rowsPerCore, tiling.tileRows, tiling.tilesPerCore, tiling.usedCoreNum, blockNum);

        // 输入输出大小
        size_t mixesByteSize = totalBatch * mixHc * sizeof(float);
        size_t preByteSize = totalBatch * hc * sizeof(float);
        size_t postByteSize = totalBatch * hc * sizeof(float);
        size_t combByteSize = totalBatch * hc * hc * sizeof(float);

        std::vector<ArgInfo> inputsInfo = {
            {"./input/input_mixes.bin", mixesByteSize}
        };
        std::vector<ArgInfo> outputsInfo = {
            {"./output/output_pre.bin", preByteSize},
            {"./output/output_post.bin", postByteSize},
            {"./output/output_comb.bin", combByteSize}
        };

        aclrtStream stream = nullptr;
        aclrtCreateStream(&stream);

        aclrtSynchronizeStream(stream);
        auto _t0 = std::chrono::high_resolution_clock::now();
        KernelCall(blockNum, stream, inputsInfo, outputsInfo, (uint8_t *)&tiling);

        aclrtDestroyStream(stream);
    }

    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
