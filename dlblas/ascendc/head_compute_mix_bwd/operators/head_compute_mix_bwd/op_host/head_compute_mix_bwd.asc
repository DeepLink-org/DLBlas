// ============================================================================
// Ascend C Kernel Direct Invoke - head_compute_mix_bwd (Host + Main)
// ============================================================================

#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "tiling/sigmoid/sigmoid_tiling.h"
#include "../op_kernel/head_compute_mix_bwd_tiling.h"
#include "data_utils.h"

// Include kernel code
#include "../op_kernel/head_compute_mix_bwd_kernel.asc"
#include <chrono>

// ============================================================================
// Tiling computation
// ============================================================================
HeadComputeMixBwdTiling ComputeTiling(
    uint32_t total_rows, uint32_t inner_dim,
    int64_t avail_cores)
{
    HeadComputeMixBwdTiling tiling;
    tiling.total_rows = total_rows;
    tiling.inner_dim = inner_dim;

    // 1. Multi-core split
    uint32_t total_elems = total_rows * inner_dim;
    uint32_t min_bytes_per_core = 4096;  // 4KB minimum per core
    uint32_t core_num = (total_elems * sizeof(float) + min_bytes_per_core - 1) / min_bytes_per_core;
    if (core_num > static_cast<uint32_t>(avail_cores)) {
        core_num = static_cast<uint32_t>(avail_cores);
    }
    if (core_num < 1) core_num = 1;
    tiling.core_num = core_num;

    tiling.rows_per_core = (total_rows + core_num - 1) / core_num;
    tiling.block_num = core_num;
    tiling.tail_rows = total_rows - (core_num - 1) * tiling.rows_per_core;

    // 2. Sigmoid tmpBuf size
    ge::Shape sigmoidShape({static_cast<int64_t>(total_elems)});
    uint32_t sigmoid_tmp_max = 0, sigmoid_tmp_min = 0;
    AscendC::GetSigmoidMaxMinTmpSize(sigmoidShape, sizeof(float), false,
                                     sigmoid_tmp_max, sigmoid_tmp_min);
    tiling.sigmoid_tmp_size = sigmoid_tmp_max;

    // 3. UB split (4 buffers)
    // Each buffer: tile_rows * inner_dim * sizeof(float)
    // Plus: sigmoid_tmp, accBase(16), accScale(4), scale(4), base(32), reduce_tmp(1KB)
    const uint32_t ub_size = 196608;  // DAV_2201 UB: 192 KB
    uint32_t per_row_bytes = inner_dim * sizeof(float);  // 16
    uint32_t overhead = 64 + sigmoid_tmp_max + 256 * sizeof(float) + 4 * sizeof(float)
                        + 8 * sizeof(float) + 1 * sizeof(float) + 5 * sizeof(float);
    // 4 * DOUBLE_BUFFER * tile_rows * per_row_bytes + overhead <= ub_size
    uint32_t available = ub_size - overhead;
    uint32_t tile_rows = available / (4 * DOUBLE_BUFFER * per_row_bytes);

    // Cap at rows_per_core
    if (tile_rows > tiling.rows_per_core) {
        tile_rows = tiling.rows_per_core;
    }
    if (tile_rows < 1) {
        tile_rows = 1;
    }
    tiling.tile_rows = tile_rows;
    tiling.ub_loops = (tiling.rows_per_core + tile_rows - 1) / tile_rows;

    // 4. Workspace (group reduce): 5 float32 per core, aligned to 256 bytes
    tiling.ws_offset_stride = ((5 * sizeof(float) + 255) / 256) * 256;
    tiling.workspace_size = core_num * tiling.ws_offset_stride;

    return tiling;
}

// ============================================================================
// KernelCall wrapper
// ============================================================================
struct ArgInfo {
    std::string fileName;
    size_t length;
};

aclrtSynchronizeStream(stream);
auto _t0 = std::chrono::high_resolution_clock::now();
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo>& inputsInfo, std::vector<ArgInfo>& outputsInfo,
    uint8_t* tilingData, uint32_t tilingSize,
    uint8_t* workspaceData, uint32_t workspaceSize)
{
    std::vector<uint8_t*> inputHost(inputsInfo.size());
    std::vector<uint8_t*> inputDevice(inputsInfo.size());
    std::vector<uint8_t*> outputHost(outputsInfo.size());
    std::vector<uint8_t*> outputDevice(outputsInfo.size());
    uint8_t* tilingDevice = nullptr;
    uint8_t* workspaceDevice = nullptr;

    // Allocate tiling on device
    aclrtMalloc((void**)&tilingDevice, tilingSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, tilingSize, tilingData, tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate workspace on device
    aclrtMalloc((void**)&workspaceDevice, workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // Load inputs
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void**)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void**)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    // Allocate outputs
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void**)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void**)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // Launch kernel
    head_compute_mix_bwd_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0],   // input_mix
        inputDevice[1],   // mhc_scale
        inputDevice[2],   // mhc_base (8 elements)
        inputDevice[3],   // grad_out
        outputDevice[0],  // grad_input_mix
        outputDevice[1],  // grad_mhc_scale
        outputDevice[2],  // grad_mhc_base
        workspaceDevice,
        tilingDevice);
    aclrtSynchronizeStream(stream);
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    // Copy outputs back
    aclrtFree(tilingDevice);
    aclrtFree(workspaceDevice);

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// ============================================================================
// Main
// Usage: ./head_compute_mix_bwd [n0] [n1] [mhc_mult]
// ============================================================================
int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // Get available cores
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // Accept shape parameters from command line (default: 2 1024 4)
    uint32_t batch0 = (argc > 1) ? static_cast<uint32_t>(std::atoi(argv[1])) : 2;
    uint32_t batch1 = (argc > 2) ? static_cast<uint32_t>(std::atoi(argv[2])) : 1024;
    uint32_t inner_dim = (argc > 3) ? static_cast<uint32_t>(std::atoi(argv[3])) : 4;
    uint32_t total_rows = batch0 * batch1;

    // Compute tiling
    HeadComputeMixBwdTiling tiling = ComputeTiling(total_rows, inner_dim, availableCoreNum);

    printf("=== Tiling Info ===\n");
    printf("  total_rows=%u, inner_dim=%u\n", tiling.total_rows, tiling.inner_dim);
    printf("  core_num=%u, rows_per_core=%u, tail_rows=%u\n",
           tiling.core_num, tiling.rows_per_core, tiling.tail_rows);
    printf("  tile_rows=%u, ub_loops=%u\n", tiling.tile_rows, tiling.ub_loops);
    printf("  sigmoid_tmp_size=%u, workspace_size=%u\n",
           tiling.sigmoid_tmp_size, tiling.workspace_size);

    // Input/output file sizes
    size_t inputMixSize = total_rows * inner_dim * sizeof(float);
    size_t scaleSize = 1 * sizeof(float);
    size_t baseSize = 8 * sizeof(float);       // 8 elements (4+4 for broadcast alignment)
    size_t gradOutSize = total_rows * inner_dim * sizeof(float);
    size_t gradInputMixSize = total_rows * inner_dim * sizeof(float);
    size_t gradScaleSize = 1 * sizeof(float);
    size_t gradBaseSize = 4 * sizeof(float);

    // Input files
    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_input_mix.bin", inputMixSize},
        {"./input/input_mhc_scale.bin", scaleSize},
        {"./input/input_mhc_base.bin", baseSize},
        {"./input/input_grad_out.bin", gradOutSize},
    };

    // Output files
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output_grad_input_mix.bin", gradInputMixSize},
        {"./output/output_grad_mhc_scale.bin", gradScaleSize},
        {"./output/output_grad_mhc_base.bin", gradBaseSize},
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    KernelCall(tiling.block_num, stream, inputsInfo, outputsInfo,
               (uint8_t*)&tiling, sizeof(HeadComputeMixBwdTiling),
               nullptr, tiling.workspace_size);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
