// ============================================================================
// Ascend C Kernel - head_compute_mix_bwd
// Broadcast + Elementwise + Reduction fusion for mix head backward pass
// ============================================================================

#include "kernel_operator.h"
#include "head_compute_mix_bwd_tiling.h"

class KernelHeadComputeMixBwd {
public:
    __aicore__ inline KernelHeadComputeMixBwd(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(
        GM_ADDR gm_input_mix,
        GM_ADDR gm_mhc_scale,
        GM_ADDR gm_mhc_base,
        GM_ADDR gm_grad_out,
        GM_ADDR gm_grad_input_mix,
        GM_ADDR gm_grad_mhc_scale,
        GM_ADDR gm_grad_mhc_base,
        GM_ADDR gm_workspace,
        const __gm__ HeadComputeMixBwdTiling* tiling)
    {
        this->tiling = tiling;

        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t innerDim = tiling->inner_dim;
        uint32_t tileRows = tiling->tile_rows;
        uint32_t totalElemPerTile = tileRows * innerDim;

        if (blockIdx < tiling->block_num - 1) {
            rowsThisCore = tiling->rows_per_core;
        } else {
            rowsThisCore = tiling->tail_rows;
        }

        uint32_t gmOffset = blockIdx * tiling->rows_per_core * innerDim;

        // Global tensor setup
        gmInputMix.SetGlobalBuffer(
            (__gm__ float*)gm_input_mix + gmOffset, rowsThisCore * innerDim);
        gmGradOut.SetGlobalBuffer(
            (__gm__ float*)gm_grad_out + gmOffset, rowsThisCore * innerDim);

        // mhc_scale: 1 element, mhc_base: 8 elements (4+4 for broadcast alignment)
        gmMhcScale.SetGlobalBuffer((__gm__ float*)gm_mhc_scale, 1);
        gmMhcBase.SetGlobalBuffer((__gm__ float*)gm_mhc_base, 8);

        // Output: grad_input_mix
        gmGradInputMix.SetGlobalBuffer(
            (__gm__ float*)gm_grad_input_mix + gmOffset, rowsThisCore * innerDim);

        // Final scalar outputs
        gmGradMhcScale.SetGlobalBuffer((__gm__ float*)gm_grad_mhc_scale, 1);
        gmGradMhcBase.SetGlobalBuffer((__gm__ float*)gm_grad_mhc_base, 4);

        // Workspace base pointer
        wsGmBase = (__gm__ float*)gm_workspace;

        // UB buffer initialization - 4 main data buffers
        pipe_->InitBuffer(inQIm, DOUBLE_BUFFER, tileRows * innerDim * sizeof(float));
        pipe_->InitBuffer(inQGo, DOUBLE_BUFFER, tileRows * innerDim * sizeof(float));
        pipe_->InitBuffer(bufZTbuf, tileRows * innerDim * sizeof(float));
        pipe_->InitBuffer(outQOut, DOUBLE_BUFFER, tileRows * innerDim * sizeof(float));

        // Small scalar buffers
        pipe_->InitBuffer(scaleBuf, 1 * sizeof(float));
        pipe_->InitBuffer(baseBuf8, 8 * sizeof(float));

        // Sigmoid tmp buffer
        pipe_->InitBuffer(sigmoidTmpBuf, tiling->sigmoid_tmp_size);

        // Reduction tmp buffer (for ReduceSum API)
        pipe_->InitBuffer(reduceTmpBuf, 256 * sizeof(float));

        // Partial accumulation buffers (persistent across tiles)
        pipe_->InitBuffer(accBaseBuf, 4 * sizeof(float));
        pipe_->InitBuffer(accScaleBuf, 1 * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        uint32_t innerDim = tiling->inner_dim;
        uint32_t tileRows = tiling->tile_rows;
        uint32_t tileElemTotal = tileRows * innerDim;
        uint32_t ubLoops = tiling->ub_loops;

        // Initialize partial accumulators to zero
        {
            AscendC::LocalTensor<float> accBase = accBaseBuf.Get<float>();
            AscendC::LocalTensor<float> accScale = accScaleBuf.Get<float>();
            accBase.SetValue(0, 0.0f);
            accBase.SetValue(1, 0.0f);
            accBase.SetValue(2, 0.0f);
            accBase.SetValue(3, 0.0f);
            accScale.SetValue(0, 0.0f);
        }

        // Load mhc_scale and mhc_base once
        LoadScalars();

        // Main loop over UB tiles
        for (uint32_t loop = 0; loop < ubLoops; loop++) {
            uint32_t rowsThisTile = tileRows;
            if (loop == ubLoops - 1) {
                uint32_t processedRows = loop * tileRows;
                rowsThisTile = rowsThisCore - processedRows;
            }
            uint32_t elemThisTile = rowsThisTile * innerDim;
            ProcessTile(loop, elemThisTile, rowsThisTile);
        }

        // Write partial results to workspace
        WritePartialsToWorkspace();

        // Sync all cores
        AscendC::SyncAll();

        // Core 0 merges partials
        if (AscendC::GetBlockIdx() == 0) {
            MergePartials();
        }
    }

private:
    // ====================================================================
    // Scalar loading
    // ====================================================================
    __aicore__ inline void LoadScalars()
    {
        AscendC::LocalTensor<float> scl = scaleBuf.Get<float>();
        AscendC::DataCopyPad(scl, gmMhcScale,
            {1, static_cast<uint16_t>(1 * sizeof(float)), 0, 0},
            {false, 0, 0, 0});
        scaleVal = scl.GetValue(0);

        AscendC::LocalTensor<float> base = baseBuf8.Get<float>();
        AscendC::DataCopyPad(base, gmMhcBase,
            {1, static_cast<uint16_t>(8 * sizeof(float)), 0, 0},
            {false, 0, 0, 0});
        baseVal0 = base.GetValue(0);
        baseVal1 = base.GetValue(1);
        baseVal2 = base.GetValue(2);
        baseVal3 = base.GetValue(3);
    }

    // ====================================================================
    // Single tile processing
    // ====================================================================
    __aicore__ inline void ProcessTile(uint32_t loop, uint32_t count, uint32_t rowsThisTile)
    {
        uint32_t innerDim = tiling->inner_dim;
        uint32_t tileRows = tiling->tile_rows;
        uint32_t tileElem = tileRows * innerDim;
        uint32_t gmOffset = loop * tileElem;

        // ---- CopyIn: GM → UB ----
        AscendC::LocalTensor<float> bufIm = inQIm.AllocTensor<float>();
        AscendC::LocalTensor<float> bufGo = inQGo.AllocTensor<float>();

        AscendC::DataCopyPad(bufIm, gmInputMix[gmOffset],
            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
            {false, 0, 0, 0});
        AscendC::DataCopyPad(bufGo, gmGradOut[gmOffset],
            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
            {false, 0, 0, 0});

        inQIm.EnQue(bufIm);
        inQGo.EnQue(bufGo);

        // ---- DeQue for compute ----
        bufIm = inQIm.DeQue<float>();
        bufGo = inQGo.DeQue<float>();

        AscendC::LocalTensor<float> bufZ = bufZTbuf.Get<float>();
        AscendC::LocalTensor<float> bufOut = outQOut.AllocTensor<float>();

        // ---- Compute chain ----

        // Step 1: bufZ = bufIm * mhc_scale
        AscendC::Muls(bufZ, bufIm, static_cast<float>(scaleVal), count);

        // Step 2: bufZ += mhc_base (broadcast per-row)
        AddMhcBaseBroadcast(bufZ, bufOut, rowsThisTile);

        // Step 3: bufZ = Sigmoid(bufZ)
        {
            AscendC::LocalTensor<uint8_t> sigTmp = sigmoidTmpBuf.Get<uint8_t>();
            AscendC::Sigmoid(bufZ, bufZ, sigTmp, count);
        }

        // Step 4: bufOut = 1.0 - sigmoid  (reuse bufOut)
        // bufOut = -sig_z; bufOut += 1.0
        AscendC::Muls(bufOut, bufZ, -1.0f, count);
        AscendC::Adds(bufOut, bufOut, 1.0f, count);

        // Step 5: bufZ = sigmoid * (1-sigmoid) = sigmoid_grad
        AscendC::Mul(bufZ, bufZ, bufOut, count);

        // Step 6: bufZ = grad_out * sigmoid_grad = grad_z
        AscendC::Mul(bufZ, bufGo, bufZ, count);

        // Step 7: bufOut = grad_z * mhc_scale = grad_input_mix
        AscendC::Muls(bufOut, bufZ, static_cast<float>(scaleVal), count);
        outQOut.EnQue<float>(bufOut);

        // Step 8: bufIm = grad_z * input_mix = temp (bufIm still has input_mix)
        AscendC::Mul(bufIm, bufZ, bufIm, count);

        // Step 9: Partial reduction
        AccumulatePartials(bufZ, bufIm, count);

        // ---- CopyOut: UB → GM ----
        bufOut = outQOut.DeQue<float>();
        AscendC::DataCopyPad(gmGradInputMix[gmOffset], bufOut,
            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0});
        outQOut.FreeTensor(bufOut);

        inQIm.FreeTensor(bufIm);
        inQGo.FreeTensor(bufGo);
        // bufZ goes out of scope - TBuf manages its lifetime
    }

    // ====================================================================
    // mhc_base broadcast addition
    // ====================================================================
    __aicore__ inline void AddMhcBaseBroadcast(
        AscendC::LocalTensor<float>& bufZ,
        AscendC::LocalTensor<float>& bufOut,
        uint32_t rowsThisTile)
    {
        uint32_t innerDim = tiling->inner_dim;

        // Prepare 8-element base pattern in bufOut:
        // [b0,b1,b2,b3,b0,b1,b2,b3]
        bufOut.SetValue(0, baseVal0);
        bufOut.SetValue(1, baseVal1);
        bufOut.SetValue(2, baseVal2);
        bufOut.SetValue(3, baseVal3);
        bufOut.SetValue(4, baseVal0);
        bufOut.SetValue(5, baseVal1);
        bufOut.SetValue(6, baseVal2);
        bufOut.SetValue(7, baseVal3);

        // Use BinaryRepeatParams: each iteration processes 8 elements (2 rows)
        // src1RepStride=0 keeps bufOut at the same position across iterations
        uint32_t evenRows = rowsThisTile & ~1u;
        if (evenRows > 0) {
            uint32_t iterations = evenRows / 2;
            uint64_t mask = 0xFF;
            uint8_t blkStride = 1;
            uint8_t repStride = 1;

            // Batch into max 255 iterations per call (repeatTime limit)
            uint32_t doneIter = 0;
            while (doneIter < iterations) {
                uint32_t batchIter = (iterations - doneIter > 255) ? 255 : (iterations - doneIter);
                uint8_t repeatTime = static_cast<uint8_t>(batchIter);
                AscendC::Add(bufZ[doneIter * 8], bufZ[doneIter * 8], bufOut,
                    mask, repeatTime,
                    {blkStride, blkStride, blkStride, repStride, repStride, 0});
                doneIter += batchIter;
            }
        }

        // Handle odd last row
        if (rowsThisTile & 1u) {
            uint32_t lastRowOff = evenRows * 4;
            AscendC::Add(bufZ[lastRowOff], bufZ[lastRowOff], bufOut, 4);
        }
    }

    // ====================================================================
    // Accumulate partial reduction results
    // ====================================================================
    __aicore__ inline void AccumulatePartials(
        AscendC::LocalTensor<float>& bufZ,
        AscendC::LocalTensor<float>& bufIm,
        uint32_t count)
    {
        AscendC::LocalTensor<float> accBase = accBaseBuf.Get<float>();
        AscendC::LocalTensor<float> accScale = accScaleBuf.Get<float>();
        AscendC::LocalTensor<float> reduceTmp = reduceTmpBuf.Get<float>();

        // Column-wise accumulation of bufZ (grad_z)
        // inner_dim=4 is tiny, use manual loop
        float pb0 = accBase.GetValue(0);
        float pb1 = accBase.GetValue(1);
        float pb2 = accBase.GetValue(2);
        float pb3 = accBase.GetValue(3);
        for (uint32_t i = 0; i < count; i += 4) {
            pb0 += bufZ.GetValue(i);
            pb1 += bufZ.GetValue(i + 1);
            pb2 += bufZ.GetValue(i + 2);
            pb3 += bufZ.GetValue(i + 3);
        }
        accBase.SetValue(0, pb0);
        accBase.SetValue(1, pb1);
        accBase.SetValue(2, pb2);
        accBase.SetValue(3, pb3);

        // Total sum of bufIm (temp)
        // Use a temp buffer since ReduceSum overwrites dst[0]
        AscendC::LocalTensor<float> oneVal = scaleBuf.Get<float>();  // reuse scaleBuf
        AscendC::ReduceSum(oneVal, bufIm, reduceTmp, count);
        float tempSum = oneVal.GetValue(0);
        float prevSum = accScale.GetValue(0);
        accScale.SetValue(0, prevSum + tempSum);
    }

    // ====================================================================
    // Write partial results to GM workspace
    // ====================================================================
    __aicore__ inline void WritePartialsToWorkspace()
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t wsStride = tiling->ws_offset_stride;

        AscendC::LocalTensor<float> accBase = accBaseBuf.Get<float>();
        AscendC::LocalTensor<float> accScale = accScaleBuf.Get<float>();

        // Pack 5 float32 values into a temporary buffer
        AscendC::LocalTensor<float> tmpOut = outQOut.AllocTensor<float>();
        tmpOut.SetValue(0, accBase.GetValue(0));
        tmpOut.SetValue(1, accBase.GetValue(1));
        tmpOut.SetValue(2, accBase.GetValue(2));
        tmpOut.SetValue(3, accBase.GetValue(3));
        tmpOut.SetValue(4, accScale.GetValue(0));

        // Write to workspace slot
        AscendC::GlobalTensor<float> wsSlot;
        wsSlot.SetGlobalBuffer(wsGmBase + blockIdx * wsStride / sizeof(float), 5);
        AscendC::DataCopyPad(wsSlot, tmpOut,
            {1, static_cast<uint16_t>(5 * sizeof(float)), 0, 0});

        outQOut.FreeTensor(tmpOut);
    }

    // ====================================================================
    // Core 0 merges all partials to produce final outputs
    // ====================================================================
    __aicore__ inline void MergePartials()
    {
        uint32_t blockNum = tiling->block_num;
        uint32_t wsStride = tiling->ws_offset_stride;

        float finalBase[4] = {0, 0, 0, 0};
        float finalScale = 0;

        // Read each core's partial from workspace
        for (uint32_t b = 0; b < blockNum; b++) {
            AscendC::LocalTensor<float> tmpIn = inQIm.AllocTensor<float>();

            AscendC::GlobalTensor<float> wsSlot;
            wsSlot.SetGlobalBuffer(wsGmBase + b * wsStride / sizeof(float), 5);

            AscendC::DataCopyPad(tmpIn, wsSlot,
                {1, static_cast<uint16_t>(5 * sizeof(float)), 0, 0},
                {false, 0, 0, 0});

            finalBase[0] += tmpIn.GetValue(0);
            finalBase[1] += tmpIn.GetValue(1);
            finalBase[2] += tmpIn.GetValue(2);
            finalBase[3] += tmpIn.GetValue(3);
            finalScale += tmpIn.GetValue(4);

            inQIm.FreeTensor(tmpIn);
        }

        // Write final results to GM
        AscendC::LocalTensor<float> tmpBase = outQOut.AllocTensor<float>();
        tmpBase.SetValue(0, finalBase[0]);
        tmpBase.SetValue(1, finalBase[1]);
        tmpBase.SetValue(2, finalBase[2]);
        tmpBase.SetValue(3, finalBase[3]);
        AscendC::DataCopyPad(gmGradMhcBase, tmpBase,
            {1, static_cast<uint16_t>(4 * sizeof(float)), 0, 0});
        outQOut.FreeTensor(tmpBase);

        AscendC::LocalTensor<float> tmpScale = outQOut.AllocTensor<float>();
        tmpScale.SetValue(0, finalScale);
        AscendC::DataCopyPad(gmGradMhcScale, tmpScale,
            {1, static_cast<uint16_t>(1 * sizeof(float)), 0, 0});
        outQOut.FreeTensor(tmpScale);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ HeadComputeMixBwdTiling* tiling;

    // Global tensors
    AscendC::GlobalTensor<float> gmInputMix;
    AscendC::GlobalTensor<float> gmMhcScale;
    AscendC::GlobalTensor<float> gmMhcBase;
    AscendC::GlobalTensor<float> gmGradOut;
    AscendC::GlobalTensor<float> gmGradInputMix;
    AscendC::GlobalTensor<float> gmGradMhcScale;
    AscendC::GlobalTensor<float> gmGradMhcBase;
    __gm__ float* wsGmBase;

    // UB Queues
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQIm, inQGo;
    AscendC::TBuf<> bufZTbuf;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQOut;

    // Scalar/aux buffers
    AscendC::TBuf<> scaleBuf;
    AscendC::TBuf<> baseBuf8;
    AscendC::TBuf<> sigmoidTmpBuf;
    AscendC::TBuf<> reduceTmpBuf;
    AscendC::TBuf<> accBaseBuf;
    AscendC::TBuf<> accScaleBuf;

    // Cached scalar values
    float scaleVal;
    float baseVal0, baseVal1, baseVal2, baseVal3;

    static constexpr uint32_t DOUBLE_BUFFER = 2;
    uint32_t rowsThisCore;
};

extern "C" __global__ __vector__ void head_compute_mix_bwd_kernel(
    GM_ADDR gm_input_mix,
    GM_ADDR gm_mhc_scale,
    GM_ADDR gm_mhc_base,
    GM_ADDR gm_grad_out,
    GM_ADDR gm_grad_input_mix,
    GM_ADDR gm_grad_mhc_scale,
    GM_ADDR gm_grad_mhc_base,
    GM_ADDR gm_workspace,
    GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelHeadComputeMixBwd op(&pipe);
    op.Init(gm_input_mix, gm_mhc_scale, gm_mhc_base, gm_grad_out,
            gm_grad_input_mix, gm_grad_mhc_scale, gm_grad_mhc_base,
            gm_workspace,
            (__gm__ HeadComputeMixBwdTiling*)tiling);
    op.Process();
}
