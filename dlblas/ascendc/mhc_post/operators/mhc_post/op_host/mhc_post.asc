// ============================================================================
// Ascend C Kernel 直调 - MHC Post 算子（Host + Main 入口）
//
// 多核切分: 沿 n1 维度均匀切分，最多 20 核
// dtype: bfloat16_t I/O, fp32 compute
// 支持命令行参数: ./mhc_post [n0] [n1] [h]
//   默认: n0=2, n1=4096, h=1280
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include "acl/acl.h"
#include "../op_kernel/mhc_post_tiling.h"
#include "data_utils.h"

// 引用 kernel 文件
#include "../op_kernel/mhc_post_kernel_decl.h"
#include <chrono>

struct ArgInfo {
    std::string fileName;
    size_t length;
};

// ============================================================================
// Host 侧 Tiling 计算
// ============================================================================
void ComputeTiling(uint32_t n0, uint32_t n1, uint32_t h, uint32_t blockNum, MhcPostTiling& tiling)
{
    tiling.n0 = n0;
    tiling.n1 = n1;
    tiling.blockNum = blockNum;
    tiling.bTile = B_TILE;
    tiling.cTile = C_TILE;
    tiling.h = h;
}

// ============================================================================
// KernelCall 封装
// ============================================================================
aclrtSynchronizeStream(stream);
auto _t0 = std::chrono::high_resolution_clock::now();
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo>& inputsInfo, std::vector<ArgInfo>& outputsInfo,
    uint32_t n0, uint32_t n1, uint32_t h)
{
    printf("KernelCall: start\n"); fflush(stdout);
    std::vector<uint8_t*> inputHost(inputsInfo.size());
    std::vector<uint8_t*> inputDevice(inputsInfo.size());
    std::vector<uint8_t*> outputHost(outputsInfo.size());
    std::vector<uint8_t*> outputDevice(outputsInfo.size());

    // Allocate and copy inputs
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        printf("KernelCall: alloc input %zu, size=%zu\n", i, inputsInfo[i].length); fflush(stdout);
        aclrtMallocHost(reinterpret_cast<void**>(&inputHost[i]), inputsInfo[i].length);
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice[i]),
            inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length,
            inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    // Allocate outputs
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        printf("KernelCall: alloc output %zu, size=%zu\n", i, outputsInfo[i].length); fflush(stdout);
        aclrtMallocHost(reinterpret_cast<void**>(&outputHost[i]), outputsInfo[i].length);
        aclrtMalloc(reinterpret_cast<void**>(&outputDevice[i]),
            outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // Allocate and copy tiling data
    printf("KernelCall: compute tiling\n"); fflush(stdout);
    MhcPostTiling tilingHost;
    uint8_t* tilingDevice = nullptr;

    ComputeTiling(n0, n1, h, blockNum, tilingHost);
    aclrtMalloc(reinterpret_cast<void**>(&tilingDevice),
        sizeof(MhcPostTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(MhcPostTiling),
        &tilingHost, sizeof(MhcPostTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    // Launch kernel
    printf("KernelCall: launching kernel with %u blocks\n", blockNum); fflush(stdout);
    mhc_post_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0],   // x
        inputDevice[1],   // residual
        inputDevice[2],   // post_layer_mix
        inputDevice[3],   // comb_res_mix
        outputDevice[0],  // output
        tilingDevice);

    printf("KernelCall: waiting for sync\n"); fflush(stdout);
    aclrtSynchronizeStream(stream);
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);
    printf("KernelCall: sync done\n"); fflush(stdout);

    // Copy output back
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    aclrtFree(tilingDevice);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// ============================================================================
// Main entry
// Usage: ./mhc_post [n0] [n1] [h]
// ============================================================================
int32_t main(int32_t argc, char* argv[])
{
    // Parse arguments
    uint32_t n0 = N0_DEFAULT;
    uint32_t n1 = N1_DEFAULT;
    uint32_t h  = H_DEFAULT;

    if (argc >= 4) {
        n0 = static_cast<uint32_t>(std::stoul(argv[1]));
        n1 = static_cast<uint32_t>(std::stoul(argv[2]));
        h  = static_cast<uint32_t>(std::stoul(argv[3]));
    }

    printf("Step 1: aclInit\n"); fflush(stdout);
    aclInit(nullptr);
    printf("Step 2: aclrtSetDevice\n"); fflush(stdout);
    // Get available device count and try to set the first available device
    uint32_t devCount = 0;
    aclrtGetDeviceCount(&devCount);
    printf("Available device count: %u\n", devCount); fflush(stdout);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }
    printf("Step 3: aclrtGetDeviceInfo\n"); fflush(stdout);

    // Get available cores
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // Limit to MAX_CORE_NUM or n1 (whichever is smaller)
    uint32_t blockNum = static_cast<uint32_t>(
        std::min({availableCoreNum, static_cast<int64_t>(MAX_CORE_NUM), static_cast<int64_t>(n1)}));
    printf("Shape: n0=%u, n1=%u, h=%u. Using %u cores (available: %ld)\n",
        n0, n1, h, blockNum, availableCoreNum);

    // Input/Output sizes based on actual shape
    size_t xSize      = static_cast<size_t>(n0) * n1 * h * sizeof(uint16_t);
    size_t resSize    = static_cast<size_t>(n0) * n1 * MHC_MULT * h * sizeof(uint16_t);
    size_t pmSize     = static_cast<size_t>(n0) * n1 * MHC_MULT * sizeof(float);
    size_t cmbSize    = static_cast<size_t>(n0) * n1 * MHC_MULT * MHC_MULT * sizeof(float);
    size_t outputSize = static_cast<size_t>(n0) * n1 * MHC_MULT * h * sizeof(uint16_t);

    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_x.bin",              xSize},
        {"./input/input_residual.bin",       resSize},
        {"./input/input_post_layer_mix.bin", pmSize},
        {"./input/input_comb_res_mix.bin",   cmbSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", outputSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    KernelCall(blockNum, stream, inputsInfo, outputsInfo, n0, n1, h);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("MHC Post kernel completed successfully.\n");
    return 0;
}
