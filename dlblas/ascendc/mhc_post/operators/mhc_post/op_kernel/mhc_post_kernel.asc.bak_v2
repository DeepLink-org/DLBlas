// ============================================================================
// MHC Post Kernel - SIMD/MemBase Vector Implementation
//
// Algorithm (per batch a,b):
//   1. Load coefficients (comb_res_mix + post_layer_mix) per batch
//   2. For each column tile ci along h-dimension:
//      a. Cast residual[m] bf16→fp32, x bf16→fp32
//      b. K=4 vector dot product: term2[m] = sum_k cmb[m,k] * resFp32[k]
//      c. Broadcast MulAdd: outFp32[m] = xFp32 * pm[m] + term2[m]
//      d. Cast outFp32[m] fp32→bf16
//
// dtype: bfloat16_t I/O, fp32 compute
// NpuArch: DAV_2201 (SIMD/MemBase, TPipe + TQue + Vector API)
//
// v2: Serial pipeline (BUFFER_NUM=1), simplified for initial correctness.
//     Double-buffered pipeline deferred to v3 after correctness verified.
// ============================================================================

#include "kernel_operator.h"
#include "mhc_post_tiling.h"
#include "mhc_post_kernel_decl.h"

using namespace AscendC;

class KernelMhcPost {
public:
    __aicore__ inline KernelMhcPost(TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(
        GM_ADDR x_gm, GM_ADDR residual_gm, GM_ADDR post_layer_mix_gm,
        GM_ADDR comb_res_mix_gm, GM_ADDR output_gm,
        const __gm__ MhcPostTiling* tiling)
    {
        this->tiling_ = tiling;
        uint32_t blockIdx = GetBlockIdx();
        uint32_t blockNum = tiling->blockNum;
        n0_    = tiling->n0;
        n1_    = tiling->n1;
        cTile_ = tiling->cTile;
        h_     = tiling->h;
        uint32_t n1PerCore = (n1_ + blockNum - 1) / blockNum;
        n1Start_ = blockIdx * n1PerCore;
        if (n1Start_ >= n1_) { n1Start_ = n1_; n1End_ = n1_; }
        else { n1End_ = n1Start_ + n1PerCore; if (n1End_ > n1_) n1End_ = n1_; }
        cTiles_ = (h_ + cTile_ - 1) / cTile_;

        // Global tensor setup
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x_gm), n0_ * n1_ * h_);
        residualGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(residual_gm),
            n0_ * n1_ * MHC_MULT * h_);
        postLayerMixGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post_layer_mix_gm),
            n0_ * n1_ * MHC_MULT);
        combResMixGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb_res_mix_gm),
            n0_ * n1_ * MHC_MULT * MHC_MULT);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(output_gm),
            n0_ * n1_ * MHC_MULT * h_);

        // I/O queues: single-buffered (BUFFER_NUM=1) for initial correctness
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            pipe_->InitBuffer(inQueRes_[m], 1, cTile_ * sizeof(bfloat16_t));
        }
        pipe_->InitBuffer(inQueX_, 1, cTile_ * sizeof(bfloat16_t));

        // Coefficient queues: small single-buffer queues
        pipe_->InitBuffer(inQueCmb_, 1, MHC_MULT * MHC_MULT * sizeof(float));
        pipe_->InitBuffer(inQuePm_,  1, MHC_MULT * sizeof(float));

        for (uint32_t m = 0; m < MHC_MULT; m++) {
            pipe_->InitBuffer(outQue_[m], 1, cTile_ * sizeof(bfloat16_t));
        }

        // Scratch buffers for fp32 intermediate computation
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            pipe_->InitBuffer(resFp32_[m], cTile_ * sizeof(float));
            pipe_->InitBuffer(term2_[m],  cTile_ * sizeof(float));
        }
        pipe_->InitBuffer(xFp32_,   cTile_ * sizeof(float));
        pipe_->InitBuffer(tmpFp32_, cTile_ * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        uint32_t totalN1 = n1End_ - n1Start_;
        if (totalN1 == 0 || cTiles_ == 0) return;

        for (uint32_t a = 0; a < n0_; a++) {
            for (uint32_t bi = n1Start_; bi < n1End_; bi++) {
                ProcessBatch(a, bi);
            }
        }
    }

private:
    __aicore__ inline uint32_t TileSize(uint32_t ci) const {
        uint32_t remaining = h_ - ci * cTile_;
        return (remaining >= cTile_) ? cTile_ : remaining;
    }

    // ========================================================================
    // ProcessBatch: serial pipeline (CopyIn → Compute → CopyOut per tile)
    // Coefficients loaded once per batch
    // ========================================================================
    __aicore__ inline void ProcessBatch(uint32_t a, uint32_t b) {
        uint64_t elemBase = static_cast<uint64_t>(a) * n1_ + b;

        // Load coefficients once per batch
        {
            // Load comb_res_mix (16 fp32 values, 64 bytes)
            LocalTensor<float> cmbLocal = inQueCmb_.AllocTensor<float>();
            GlobalTensor<float> cmbSrc = combResMixGm_[elemBase * MHC_MULT * MHC_MULT];
            DataCopyPad(cmbLocal, cmbSrc,
                {1, static_cast<uint16_t>(MHC_MULT * MHC_MULT * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
            inQueCmb_.EnQue(cmbLocal);

            // Load post_layer_mix (4 fp32 values, 16 bytes)
            LocalTensor<float> pmLocal = inQuePm_.AllocTensor<float>();
            GlobalTensor<float> pmSrc = postLayerMixGm_[elemBase * MHC_MULT];
            DataCopyPad(pmLocal, pmSrc,
                {1, static_cast<uint16_t>(MHC_MULT * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
            inQuePm_.EnQue(pmLocal);
        }

        // Process tiles serially
        for (uint32_t ci = 0; ci < cTiles_; ci++) {
            uint32_t cStart = ci * cTile_;
            uint32_t count = TileSize(ci);

            // CopyIn
            {
                uint16_t bytes = static_cast<uint16_t>(count * sizeof(bfloat16_t));

                // Load residual 4 rows
                for (uint32_t m = 0; m < MHC_MULT; m++) {
                    LocalTensor<bfloat16_t> resLocal = inQueRes_[m].AllocTensor<bfloat16_t>();
                    GlobalTensor<bfloat16_t> srcGm = residualGm_[elemBase * MHC_MULT * h_ + m * h_ + cStart];
                    DataCopyPad(resLocal, srcGm, {1, bytes, 0, 0}, {false, 0, 0, 0});
                    inQueRes_[m].EnQue(resLocal);
                }

                // Load x
                {
                    LocalTensor<bfloat16_t> xLocal = inQueX_.AllocTensor<bfloat16_t>();
                    GlobalTensor<bfloat16_t> xSrc = xGm_[elemBase * h_ + cStart];
                    DataCopyPad(xLocal, xSrc, {1, bytes, 0, 0}, {false, 0, 0, 0});
                    inQueX_.EnQue(xLocal);
                }
            }

            // Compute
            {
                // DeQue inputs
                LocalTensor<bfloat16_t> resBf16[MHC_MULT];
                for (uint32_t m = 0; m < MHC_MULT; m++) {
                    resBf16[m] = inQueRes_[m].DeQue<bfloat16_t>();
                }
                LocalTensor<bfloat16_t> xBf16 = inQueX_.DeQue<bfloat16_t>();

                // DeQue coefficients (first tile only, for subsequent tiles reuse from member variables)
                LocalTensor<float> cmbFp32, pmFp32;
                if (ci == 0) {
                    cmbFp32 = inQueCmb_.DeQue<float>();
                    pmFp32  = inQuePm_.DeQue<float>();
                    // Cache scalar values for subsequent tiles
                    for (uint32_t m = 0; m < MHC_MULT; m++) {
                        pmCached_[m] = pmFp32.GetValue(m);
                        for (uint32_t k = 0; k < MHC_MULT; k++) {
                            cmbCached_[m][k] = cmbFp32.GetValue(m * MHC_MULT + k);
                        }
                    }
                }

                // Get scratch buffers
                LocalTensor<float> resFp32[MHC_MULT], term2[MHC_MULT];
                for (uint32_t m = 0; m < MHC_MULT; m++) {
                    resFp32[m] = resFp32_[m].Get<float>();
                    term2[m] = term2_[m].Get<float>();
                }
                LocalTensor<float> xFp32 = xFp32_.Get<float>();
                LocalTensor<float> tmp   = tmpFp32_.Get<float>();

                // Allocate output buffers
                LocalTensor<bfloat16_t> outBf16[MHC_MULT];
                for (uint32_t m = 0; m < MHC_MULT; m++) {
                    outBf16[m] = outQue_[m].AllocTensor<bfloat16_t>();
                }

                // Step 1: Cast bf16 → fp32 (CAST_NONE: zero-extend)
                for (uint32_t m = 0; m < MHC_MULT; m++) {
                    Cast(resFp32[m], resBf16[m], RoundMode::CAST_NONE, count);
                }
                Cast(xFp32, xBf16, RoundMode::CAST_NONE, count);

                // Step 2: K=4 vector dot product (Muls + Add)
                for (uint32_t m = 0; m < MHC_MULT; m++) {
                    Muls(term2[m], resFp32[0], cmbCached_[m][0], count);
                    for (uint32_t k = 1; k < MHC_MULT; k++) {
                        Muls(tmp, resFp32[k], cmbCached_[m][k], count);
                        Add(term2[m], term2[m], tmp, count);
                    }
                }

                // Step 3: Broadcast MulAdd
                for (uint32_t m = 0; m < MHC_MULT; m++) {
                    Muls(tmp, xFp32, pmCached_[m], count);
                    Add(term2[m], tmp, term2[m], count);
                }

                // Step 4: Cast fp32 → bf16 output (CAST_ROUND: RNE)
                for (uint32_t m = 0; m < MHC_MULT; m++) {
                    Cast(outBf16[m], term2[m], RoundMode::CAST_ROUND, count);
                    outQue_[m].EnQue(outBf16[m]);
                }

                // Free input tensors
                for (uint32_t m = 0; m < MHC_MULT; m++) {
                    inQueRes_[m].FreeTensor(resBf16[m]);
                }
                inQueX_.FreeTensor(xBf16);

                // Free coefficient tensors (last tile)
                if (ci == cTiles_ - 1) {
                    inQueCmb_.FreeTensor(cmbFp32);
                    inQuePm_.FreeTensor(pmFp32);
                }
            }

            // CopyOut
            {
                uint16_t bytes = static_cast<uint16_t>(count * sizeof(bfloat16_t));

                for (uint32_t m = 0; m < MHC_MULT; m++) {
                    LocalTensor<bfloat16_t> outLocal = outQue_[m].DeQue<bfloat16_t>();
                    GlobalTensor<bfloat16_t> dstGm = outGm_[elemBase * MHC_MULT * h_ + m * h_ + cStart];
                    DataCopyPad(dstGm, outLocal, {1, bytes, 0, 0});
                    outQue_[m].FreeTensor(outLocal);
                }
            }
        }
    }

    // ========================================================================
    // Member variables
    // ========================================================================
    TPipe* pipe_;
    const __gm__ MhcPostTiling* tiling_;
    uint32_t n0_, n1_, n1Start_, n1End_, cTile_, h_, cTiles_;

    // Global tensors (GM addresses)
    GlobalTensor<bfloat16_t> xGm_, residualGm_, outGm_;
    GlobalTensor<float> postLayerMixGm_, combResMixGm_;

    // I/O queues: single-buffered for initial correctness
    TQue<TPosition::VECIN, 1>  inQueRes_[MHC_MULT];
    TQue<TPosition::VECIN, 1>  inQueX_;
    TQue<TPosition::VECIN, 1>  inQueCmb_, inQuePm_;
    TQue<TPosition::VECOUT, 1> outQue_[MHC_MULT];

    // Cached coefficient scalars (loaded once per batch, reused across tiles)
    float cmbCached_[MHC_MULT][MHC_MULT];
    float pmCached_[MHC_MULT];

    // Scratch buffers for fp32 intermediate computation
    TBuf<TPosition::VECCALC> resFp32_[MHC_MULT];
    TBuf<TPosition::VECCALC> term2_[MHC_MULT];
    TBuf<TPosition::VECCALC> xFp32_;
    TBuf<TPosition::VECCALC> tmpFp32_;
};

// ============================================================================
// Kernel entry point
// ============================================================================
extern "C" __global__ __vector__ void mhc_post_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR post_layer_mix,
    GM_ADDR comb_res_mix, GM_ADDR output, GM_ADDR tiling)
{
    TPipe pipe;
    KernelMhcPost op(&pipe);
    op.Init(x, residual, post_layer_mix, comb_res_mix, output,
        reinterpret_cast<__gm__ MhcPostTiling*>(tiling));
    op.Process();
}
