// ============================================================================
// MHC Post Kernel - SIMD/MemBase Vector Implementation v2 (Double Buffer)
//
// Algorithm (per batch a,b):
//   1. Load coefficients (comb_res_mix 64B + post_layer_mix 16B) to TBuf
//      (once per batch, shared across all column tiles)
//   2. Double-buffered pipeline over column tiles ci along h-dimension:
//      Pre-CopyIn(tile 0)
//      for ci in 0..cTiles-1:
//        CopyIn(tile ci+1)   [async, overlaps with Compute]
//        Compute(tile ci)    [DeQue + Cast + dot product + MulAdd + Cast + EnQue]
//        CopyOut(tile ci-1)  [DeQue + DataCopyPad to GM]
//      CopyOut(tile cTiles-1)
//
// dtype: bfloat16_t I/O, fp32 compute
// NpuArch: DAV_2201 (SIMD/MemBase, TPipe + TQue<...,2> + TBuf + Vector API)
// ============================================================================

#include "kernel_operator.h"
#include "mhc_post_tiling.h"
#include "mhc_post_kernel_decl.h"

using namespace AscendC;

// Number of buffer slots for double-buffering I/O queues
constexpr uint32_t BUFFER_NUM = 2;

class KernelMhcPost {
public:
    __aicore__ inline KernelMhcPost(TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(
        GM_ADDR x_gm, GM_ADDR residual_gm, GM_ADDR post_layer_mix_gm,
        GM_ADDR comb_res_mix_gm, GM_ADDR output_gm,
        const __gm__ MhcPostTiling* tiling)
    {
        uint32_t blockIdx = GetBlockIdx();
        uint32_t blockNum = tiling->blockNum;
        n0_    = tiling->n0;
        n1_    = tiling->n1;
        cTile_ = tiling->cTile;
        h_     = tiling->h;

        uint32_t n1PerCore = (n1_ + blockNum - 1) / blockNum;
        n1Start_ = blockIdx * n1PerCore;
        if (n1Start_ >= n1_) {
            n1Start_ = n1_;
            n1End_   = n1_;
        } else {
            n1End_ = n1Start_ + n1PerCore;
            if (n1End_ > n1_) n1End_ = n1_;
        }
        cTiles_ = (h_ + cTile_ - 1) / cTile_;

        // Global tensor setup
        xGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ bfloat16_t*>(x_gm),
            static_cast<uint64_t>(n0_) * n1_ * h_);
        residualGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ bfloat16_t*>(residual_gm),
            static_cast<uint64_t>(n0_) * n1_ * MHC_MULT * h_);
        postLayerMixGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ float*>(post_layer_mix_gm),
            static_cast<uint64_t>(n0_) * n1_ * MHC_MULT);
        combResMixGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ float*>(comb_res_mix_gm),
            static_cast<uint64_t>(n0_) * n1_ * MHC_MULT * MHC_MULT);
        outGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ bfloat16_t*>(output_gm),
            static_cast<uint64_t>(n0_) * n1_ * MHC_MULT * h_);

        // I/O queues: double-buffered (BUFFER_NUM=2) for pipeline overlap
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            pipe_->InitBuffer(inQueRes_[m], BUFFER_NUM,
                cTile_ * sizeof(bfloat16_t));
        }
        pipe_->InitBuffer(inQueX_, BUFFER_NUM, cTile_ * sizeof(bfloat16_t));

        for (uint32_t m = 0; m < MHC_MULT; m++) {
            pipe_->InitBuffer(outQue_[m], BUFFER_NUM,
                cTile_ * sizeof(bfloat16_t));
        }

        // Coefficient TBuf: once per batch, shared across all column tiles
        // Layout: comb_res_mix[0..3][0..3] (64B) + post_layer_mix[0..3] (16B) = 80B
        // Align to 32 bytes: need MHC_MULT*MHC_MULT + MHC_MULT = 20 fp32 values = 80B
        // Use separate TBufs for alignment and clarity
        pipe_->InitBuffer(cmbBuf_,  MHC_MULT * MHC_MULT * sizeof(float));
        pipe_->InitBuffer(pmBuf_,   MHC_MULT * sizeof(float));

        // Scratch buffers for fp32 intermediate computation (single-buffered)
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            pipe_->InitBuffer(resFp32_[m], cTile_ * sizeof(float));
            pipe_->InitBuffer(term2_[m],   cTile_ * sizeof(float));
        }
        pipe_->InitBuffer(xFp32_,   cTile_ * sizeof(float));
        pipe_->InitBuffer(tmpFp32_, cTile_ * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        if ((n1End_ <= n1Start_) || (cTiles_ == 0)) return;

        for (uint32_t a = 0; a < n0_; a++) {
            for (uint32_t b = n1Start_; b < n1End_; b++) {
                PipelineBatch(a, b);
            }
        }
    }

private:
    __aicore__ inline uint32_t TileSize(uint32_t ci) const {
        uint32_t remaining = h_ - ci * cTile_;
        return (remaining >= cTile_) ? cTile_ : remaining;
    }

    // ========================================================================
    // LoadCoefficients: load comb_res_mix and post_layer_mix into TBuf
    // Called once per batch (a, b). Uses DataCopyPad to TBuf.
    // ========================================================================
    __aicore__ inline void LoadCoefficients(uint64_t elemBase)
    {
        // Load comb_res_mix[a,b,:,:] (4x4 fp32 = 64 bytes)
        {
            LocalTensor<float> cmb = cmbBuf_.Get<float>();
            GlobalTensor<float> cmbSrc = combResMixGm_[elemBase * MHC_MULT * MHC_MULT];
            DataCopyPad(cmb, cmbSrc,
                {1, static_cast<uint16_t>(MHC_MULT * MHC_MULT * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
        }
        // Load post_layer_mix[a,b,:] (4 fp32 = 16 bytes)
        {
            LocalTensor<float> pm = pmBuf_.Get<float>();
            GlobalTensor<float> pmSrc = postLayerMixGm_[elemBase * MHC_MULT];
            DataCopyPad(pm, pmSrc,
                {1, static_cast<uint16_t>(MHC_MULT * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
        }
        // Pipeline barrier: ensure coefficient loads complete before use
        PipeBarrier<PIPE_MTE2>();
    }

    // ========================================================================
    // CopyInData: start async DMA load for one column tile
    // ========================================================================
    __aicore__ inline void CopyInData(uint64_t elemBase, uint32_t cStart, uint32_t count)
    {
        uint16_t bytes = static_cast<uint16_t>(count * sizeof(bfloat16_t));

        // Load residual 4 rows
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            LocalTensor<bfloat16_t> resLocal = inQueRes_[m].AllocTensor<bfloat16_t>();
            GlobalTensor<bfloat16_t> srcGm =
                residualGm_[elemBase * MHC_MULT * h_ + m * h_ + cStart];
            DataCopyPad(resLocal, srcGm, {1, bytes, 0, 0}, {false, 0, 0, 0});
            inQueRes_[m].EnQue(resLocal);
        }

        // Load x
        {
            LocalTensor<bfloat16_t> xLocal = inQueX_.AllocTensor<bfloat16_t>();
            GlobalTensor<bfloat16_t> xSrc = xGm_[elemBase * h_ + cStart];
            DataCopyPad(xLocal, xSrc, {1, bytes, 0, 0}, {false, 0, 0, 0});
            inQueX_.EnQue(xLocal);
        }
    }

    // ========================================================================
    // ComputeTile: DeQue + fp32 computation + Cast to bf16 + EnQue output
    // Reads coefficients from TBuf via GetValue (scalar reads)
    // ========================================================================
    __aicore__ inline void ComputeTile(uint32_t count)
    {
        // DeQue inputs (wait for DMA to complete)
        LocalTensor<bfloat16_t> resBf16[MHC_MULT];
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            resBf16[m] = inQueRes_[m].DeQue<bfloat16_t>();
        }
        LocalTensor<bfloat16_t> xBf16 = inQueX_.DeQue<bfloat16_t>();

        // Read scalar coefficients from TBuf
        LocalTensor<float> cmbLocal = cmbBuf_.Get<float>();
        LocalTensor<float> pmLocal  = pmBuf_.Get<float>();

        // Get scratch buffers
        LocalTensor<float> resFp32[MHC_MULT], term2[MHC_MULT];
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            resFp32[m] = resFp32_[m].Get<float>();
            term2[m]   = term2_[m].Get<float>();
        }
        LocalTensor<float> xFp32 = xFp32_.Get<float>();
        LocalTensor<float> tmp   = tmpFp32_.Get<float>();

        // Allocate output tensors
        LocalTensor<bfloat16_t> outBf16[MHC_MULT];
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            outBf16[m] = outQue_[m].AllocTensor<bfloat16_t>();
        }

        // Step 1: Cast bf16 → fp32 (CAST_NONE: zero-extend, no rounding)
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            Cast(resFp32[m], resBf16[m], RoundMode::CAST_NONE, count);
        }
        Cast(xFp32, xBf16, RoundMode::CAST_NONE, count);

        // Step 2: K=4 vector dot product
        // term2[m] = sum_{k=0}^{3} cmb[m,k] * resFp32[k]
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            float cmb_m0 = cmbLocal.GetValue(m * MHC_MULT + 0);
            Muls(term2[m], resFp32[0], cmb_m0, count);
            for (uint32_t k = 1; k < MHC_MULT; k++) {
                float cmb_mk = cmbLocal.GetValue(m * MHC_MULT + k);
                Muls(tmp, resFp32[k], cmb_mk, count);
                Add(term2[m], term2[m], tmp, count);
            }
        }

        // Step 3: Broadcast MulAdd
        // outFp32[m] = xFp32 * pm[m] + term2[m]
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            float pm_m = pmLocal.GetValue(m);
            Muls(tmp, xFp32, pm_m, count);
            Add(term2[m], tmp, term2[m], count);
        }

        // Step 4: Cast fp32 → bf16 (CAST_ROUND: round-to-nearest-even)
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            Cast(outBf16[m], term2[m], RoundMode::CAST_ROUND, count);
            outQue_[m].EnQue(outBf16[m]);
        }

        // Free input tensors
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            inQueRes_[m].FreeTensor(resBf16[m]);
        }
        inQueX_.FreeTensor(xBf16);
    }

    // ========================================================================
    // CopyOutTile: DeQue output from queue and DMA write to GM
    // ========================================================================
    __aicore__ inline void CopyOutTile(uint64_t elemBase, uint32_t cStart, uint32_t count)
    {
        uint16_t bytes = static_cast<uint16_t>(count * sizeof(bfloat16_t));

        for (uint32_t m = 0; m < MHC_MULT; m++) {
            LocalTensor<bfloat16_t> outLocal = outQue_[m].DeQue<bfloat16_t>();
            GlobalTensor<bfloat16_t> dstGm =
                outGm_[elemBase * MHC_MULT * h_ + m * h_ + cStart];
            DataCopyPad(dstGm, outLocal, {1, bytes, 0, 0});
            outQue_[m].FreeTensor(outLocal);
        }
    }

    // ========================================================================
    // PipelineBatch: double-buffered pipeline over column tiles
    //
    // Timeline (cTiles >= 2):
    //   PreLoad:   CopyIn(tile 0)
    //   ci=0:      CopyIn(tile 1) | Compute(tile 0)
    //   ci=1:      CopyIn(tile 2) | Compute(tile 1) | CopyOut(tile 0)
    //   ci=2:      CopyIn(tile 3) | Compute(tile 2) | CopyOut(tile 1)
    //   ...
    //   ci=N-1:    (no more CopyIn) | Compute(tile N-1) | CopyOut(tile N-2)
    //   Drain:     CopyOut(tile N-1)
    // ========================================================================
    __aicore__ inline void PipelineBatch(uint32_t a, uint32_t b)
    {
        uint64_t elemBase = static_cast<uint64_t>(a) * n1_ + b;

        // Step 1: Load coefficients into TBuf (once per batch)
        LoadCoefficients(elemBase);

        if (cTiles_ == 0) return;

        // Step 2: Pre-load first tile
        CopyInData(elemBase, 0, TileSize(0));

        // Step 3: Main double-buffer pipeline loop
        for (uint32_t ci = 0; ci < cTiles_; ci++) {
            uint32_t cStart = ci * cTile_;

            // Start loading next tile (overlaps with Compute of current tile)
            if (ci + 1 < cTiles_) {
                uint32_t nextStart = (ci + 1) * cTile_;
                CopyInData(elemBase, nextStart, TileSize(ci + 1));
            }

            // Compute current tile (DeQue waits for current tile's DMA)
            ComputeTile(TileSize(ci));

            // Write out previous tile (ci > 0 because tile ci-1 compute is done)
            if (ci > 0) {
                uint32_t prevStart = (ci - 1) * cTile_;
                CopyOutTile(elemBase, prevStart, TileSize(ci - 1));
            }
        }

        // Step 4: Write out last tile
        CopyOutTile(elemBase, (cTiles_ - 1) * cTile_, TileSize(cTiles_ - 1));
    }

    // ========================================================================
    // Member variables
    // ========================================================================
    TPipe* pipe_;
    uint32_t n0_, n1_, n1Start_, n1End_, cTile_, h_, cTiles_;

    // Global tensors
    GlobalTensor<bfloat16_t> xGm_, residualGm_, outGm_;
    GlobalTensor<float>      postLayerMixGm_, combResMixGm_;

    // I/O queues: double-buffered (BUFFER_NUM=2) for pipeline overlap
    TQue<TPosition::VECIN, BUFFER_NUM>  inQueRes_[MHC_MULT];
    TQue<TPosition::VECIN, BUFFER_NUM>  inQueX_;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQue_[MHC_MULT];

    // Coefficient TBufs (single-buffered, shared across all column tiles)
    TBuf<TPosition::VECCALC> cmbBuf_;   // comb_res_mix[a,b,:,:] (4x4 fp32 = 64B)
    TBuf<TPosition::VECCALC> pmBuf_;    // post_layer_mix[a,b,:] (4 fp32 = 16B)

    // Scratch buffers for fp32 intermediate computation
    TBuf<TPosition::VECCALC> resFp32_[MHC_MULT];  // residual after Cast
    TBuf<TPosition::VECCALC> term2_[MHC_MULT];    // dot product accumulator
    TBuf<TPosition::VECCALC> xFp32_;              // x after Cast
    TBuf<TPosition::VECCALC> tmpFp32_;            // temporary for Muls result
};

// ============================================================================
// Kernel entry point
// ============================================================================
extern "C" __global__ __vector__ void mhc_post_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR post_layer_mix,
    GM_ADDR comb_res_mix, GM_ADDR output, GM_ADDR tiling)
{
    TPipe pipe;
    KernelMhcPost op(&pipe);
    op.Init(x, residual, post_layer_mix, comb_res_mix, output,
        reinterpret_cast<__gm__ MhcPostTiling*>(tiling));
    op.Process();
}
