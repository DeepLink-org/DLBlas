// MHC Post Kernel - Double Buffer Pipeline across column tiles
// DESIGN v2: B_TILE=1 (per-batch), bfloat16_t I/O with fp32 compute
// TQue<VECIN/VECOUT, 2> for residual/x/out enables Load-Compute-Store pipeline overlap
// Handles partial tiles when h is not a multiple of C_TILE (ceiling division)
#include "kernel_operator.h"
#include "mhc_post_tiling.h"
#include "mhc_post_kernel_decl.h"

using namespace AscendC;

class KernelMhcPost {
public:
    __aicore__ inline KernelMhcPost(TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(
        GM_ADDR x_gm, GM_ADDR residual_gm, GM_ADDR post_layer_mix_gm,
        GM_ADDR comb_res_mix_gm, GM_ADDR output_gm,
        const __gm__ MhcPostTiling* tiling)
    {
        this->tiling_ = tiling;
        uint32_t blockIdx = GetBlockIdx();
        uint32_t blockNum = tiling->blockNum;
        n0_    = tiling->n0;
        n1_    = tiling->n1;
        cTile_ = tiling->cTile;
        h_     = tiling->h;

        // Per-core n1 range
        uint32_t n1PerCore = (n1_ + blockNum - 1) / blockNum;
        n1Start_ = blockIdx * n1PerCore;
        if (n1Start_ >= n1_) { n1Start_ = n1_; n1End_ = n1_; }
        else { n1End_ = n1Start_ + n1PerCore; if (n1End_ > n1_) n1End_ = n1_; }

        // Number of column tiles (ceiling division for partial last tile)
        cTiles_ = (h_ + cTile_ - 1) / cTile_;

        // GlobalTensor views (bfloat16_t for bf16 data, float for fp32 coefficients)
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x_gm), n0_ * n1_ * h_);
        residualGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(residual_gm), n0_ * n1_ * MHC_MULT * h_);
        postLayerMixGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post_layer_mix_gm), n0_ * n1_ * MHC_MULT);
        combResMixGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb_res_mix_gm), n0_ * n1_ * MHC_MULT * MHC_MULT);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(output_gm), n0_ * n1_ * MHC_MULT * h_);

        // Per-row input queues with DOUBLE buffering (BUFFER_NUM=2) for pipeline overlap
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            pipe_->InitBuffer(inQueRes_[m], 2, cTile_ * sizeof(bfloat16_t));
        }
        pipe_->InitBuffer(inQueX_, 2, cTile_ * sizeof(bfloat16_t));

        // Coefficient queues: single buffer per batch (small: 64+16=80 bytes per load)
        pipe_->InitBuffer(inQueCmb_, 1, MHC_MULT * MHC_MULT * sizeof(float));
        pipe_->InitBuffer(inQuePm_,  1, MHC_MULT * sizeof(float));

        // Per-row output queues with DOUBLE buffering (BUFFER_NUM=2)
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            pipe_->InitBuffer(outQue_[m], 2, cTile_ * sizeof(bfloat16_t));
        }

        // Scratch buffers (single buffer, per-row for operator[] safety)
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            pipe_->InitBuffer(resFp32_[m], cTile_ * sizeof(float));
            pipe_->InitBuffer(term2_[m],  cTile_ * sizeof(float));
        }
        pipe_->InitBuffer(xFp32_,   cTile_ * sizeof(float));
        pipe_->InitBuffer(tmpFp32_, cTile_ * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        uint32_t totalN1 = n1End_ - n1Start_;
        if (totalN1 == 0 || cTiles_ == 0) return;

        for (uint32_t a = 0; a < n0_; a++) {
            for (uint32_t bi = n1Start_; bi < n1End_; bi++) {
                // Double-buffered pipeline across column tiles for this batch item
                PipelineBatch(a, bi);
            }
        }
    }

private:
    // ========================================================================
    // Get the actual element count for a given tile index
    // Last tile may be partial: min(cTile_, h_ - ci * cTile_)
    // ========================================================================
    __aicore__ inline uint32_t TileSize(uint32_t ci) const
    {
        uint32_t remaining = h_ - ci * cTile_;
        return (remaining >= cTile_) ? cTile_ : remaining;
    }

    // ========================================================================
    // Double-buffered pipeline across column tiles for a single batch item
    // Overlaps CopyIn(tile N+1) with Compute(tile N) and CopyOut(tile N-1)
    // Uses TQue<..., 2> for automatic ping-pong buffer management
    // ========================================================================
    __aicore__ inline void PipelineBatch(uint32_t a, uint32_t b)
    {
        // Preload tile 0 (incl. coefficients)
        CopyIn(a, b, 0, TileSize(0));

        for (uint32_t ci = 0; ci < cTiles_; ci++) {
            // Start loading next tile (overlaps with compute)
            if (ci + 1 < cTiles_) {
                CopyIn(a, b, (ci + 1) * cTile_, TileSize(ci + 1));
            }

            // Compute current tile
            Compute(TileSize(ci));

            // Store previous tile
            if (ci > 0) {
                CopyOut(a, b, (ci - 1) * cTile_, TileSize(ci - 1));
            }
        }

        // Store last tile
        CopyOut(a, b, (cTiles_ - 1) * cTile_, TileSize(cTiles_ - 1));
    }

    // ========================================================================
    // CopyIn: load all inputs for one (batch, column) tile
    // count = number of elements to load (cTile_ for full tiles, smaller for last)
    // ========================================================================
    __aicore__ inline void CopyIn(uint32_t a, uint32_t b, uint32_t cStart, uint32_t count)
    {
        uint64_t elemBase = static_cast<uint64_t>(a) * n1_ + b;
        uint16_t bytesToCopy = static_cast<uint16_t>(count * sizeof(bfloat16_t));

        // 1. Residual: per-row loading (4 separate DataCopyPad calls)
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            LocalTensor<bfloat16_t> resLocal = inQueRes_[m].AllocTensor<bfloat16_t>();
            GlobalTensor<bfloat16_t> srcGm = residualGm_[elemBase * MHC_MULT * h_ + m * h_ + cStart];
            DataCopyPad(resLocal, srcGm,
                {1, bytesToCopy, 0, 0},
                {false, 0, 0, 0});
            inQueRes_[m].EnQue(resLocal);
        }

        // 2. x
        {
            LocalTensor<bfloat16_t> xLocal = inQueX_.AllocTensor<bfloat16_t>();
            GlobalTensor<bfloat16_t> srcGm = xGm_[elemBase * h_ + cStart];
            DataCopyPad(xLocal, srcGm,
                {1, bytesToCopy, 0, 0},
                {false, 0, 0, 0});
            inQueX_.EnQue(xLocal);
        }

        // 3. comb_res_mix [4,4] (contiguous 16 floats = 64 bytes)
        {
            LocalTensor<float> cmbLocal = inQueCmb_.AllocTensor<float>();
            GlobalTensor<float> srcGm = combResMixGm_[elemBase * MHC_MULT * MHC_MULT];
            DataCopyPad(cmbLocal, srcGm,
                {1, static_cast<uint16_t>(MHC_MULT * MHC_MULT * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
            inQueCmb_.EnQue(cmbLocal);
        }

        // 4. post_layer_mix [4] (contiguous 4 floats = 16 bytes)
        {
            LocalTensor<float> pmLocal = inQuePm_.AllocTensor<float>();
            GlobalTensor<float> srcGm = postLayerMixGm_[elemBase * MHC_MULT];
            DataCopyPad(pmLocal, srcGm,
                {1, static_cast<uint16_t>(MHC_MULT * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
            inQuePm_.EnQue(pmLocal);
        }
    }

    // ========================================================================
    // Compute: MatMul (K=4 vector dot) + Broadcast MulAdd + fp32→bf16 Cast
    // ========================================================================
    __aicore__ inline void Compute(uint32_t count)
    {
        // Dequeue inputs
        LocalTensor<bfloat16_t> resBf16[MHC_MULT];
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            resBf16[m] = inQueRes_[m].DeQue<bfloat16_t>();
        }
        LocalTensor<bfloat16_t>  xBf16   = inQueX_.DeQue<bfloat16_t>();
        LocalTensor<float> cmbFp32 = inQueCmb_.DeQue<float>();
        LocalTensor<float> pmFp32  = inQuePm_.DeQue<float>();

        // Get scratch buffers
        LocalTensor<float> resFp32[MHC_MULT], term2[MHC_MULT];
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            resFp32[m] = resFp32_[m].Get<float>();
            term2[m]   = term2_[m].Get<float>();
        }
        LocalTensor<float> xFp32 = xFp32_.Get<float>();
        LocalTensor<float> tmp   = tmpFp32_.Get<float>();

        // Alloc per-row outputs
        LocalTensor<bfloat16_t> outBf16[MHC_MULT];
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            outBf16[m] = outQue_[m].AllocTensor<bfloat16_t>();
        }

        // Cast bf16→fp32 for each residual row (CAST_NONE: no rounding, just extend precision)
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            Cast(resFp32[m], resBf16[m], RoundMode::CAST_NONE, count);
        }
        Cast(xFp32, xBf16, RoundMode::CAST_NONE, count);

        // K=4 MatMul (Vector dot): term2[m] = sum_k cmb[m,k] * resFp32[k]
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            float cmb0 = cmbFp32.GetValue(m * MHC_MULT);  // cmb[m, 0]
            Muls(term2[m], resFp32[0], cmb0, count);
            for (uint32_t k = 1; k < MHC_MULT; k++) {
                float cmbVal = cmbFp32.GetValue(m * MHC_MULT + k);
                Muls(tmp, resFp32[k], cmbVal, count);
                Add(term2[m], term2[m], tmp, count);
            }
        }

        // Broadcast MulAdd: output = xFp32 * pm[m] + term2[m]
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            float pmVal = pmFp32.GetValue(m);
            Muls(tmp, xFp32, pmVal, count);
            Add(term2[m], tmp, term2[m], count);
        }

        // Cast fp32→bf16 and enqueue output (CAST_ROUND: round-to-nearest-even)
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            Cast(outBf16[m], term2[m], RoundMode::CAST_ROUND, count);
            outQue_[m].EnQue<bfloat16_t>(outBf16[m]);
        }

        // Free input buffers
        for (uint32_t m = 0; m < MHC_MULT; m++) {
            inQueRes_[m].FreeTensor(resBf16[m]);
        }
        inQueX_.FreeTensor(xBf16);
        inQueCmb_.FreeTensor(cmbFp32);
        inQuePm_.FreeTensor(pmFp32);
    }

    // ========================================================================
    // CopyOut: store output rows to GM
    // ========================================================================
    __aicore__ inline void CopyOut(uint32_t a, uint32_t b, uint32_t cStart, uint32_t count)
    {
        uint64_t elemBase = static_cast<uint64_t>(a) * n1_ + b;
        uint16_t bytesToCopy = static_cast<uint16_t>(count * sizeof(bfloat16_t));

        for (uint32_t m = 0; m < MHC_MULT; m++) {
            LocalTensor<bfloat16_t> outLocal = outQue_[m].DeQue<bfloat16_t>();
            GlobalTensor<bfloat16_t> dstGm = outGm_[elemBase * MHC_MULT * h_ + m * h_ + cStart];
            DataCopyPad(dstGm, outLocal,
                {1, bytesToCopy, 0, 0});
            outQue_[m].FreeTensor(outLocal);
        }
    }

    // ========================================================================
    // Member variables
    // ========================================================================
    TPipe* pipe_;
    const __gm__ MhcPostTiling* tiling_;
    uint32_t n0_, n1_, n1Start_, n1End_, cTile_, h_, cTiles_;

    GlobalTensor<bfloat16_t>  xGm_, residualGm_, outGm_;
    GlobalTensor<float> postLayerMixGm_, combResMixGm_;

    // Double-buffered I/O queues: BUFFER_NUM=2 enables Load-Compute-Store pipeline overlap
    TQue<TPosition::VECIN,  2> inQueRes_[MHC_MULT], inQueX_;
    TQue<TPosition::VECIN,  1> inQueCmb_, inQuePm_;
    TQue<TPosition::VECOUT, 2> outQue_[MHC_MULT];

    // Scratch buffers (single buffer, no double needed within a compute tile)
    TBuf<TPosition::VECCALC> resFp32_[MHC_MULT], term2_[MHC_MULT], xFp32_, tmpFp32_;
};

extern "C" __global__ __vector__ void mhc_post_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR post_layer_mix,
    GM_ADDR comb_res_mix, GM_ADDR output, GM_ADDR tiling)
{
    TPipe pipe;
    KernelMhcPost op(&pipe);
    op.Init(x, residual, post_layer_mix, comb_res_mix, output,
        reinterpret_cast<__gm__ MhcPostTiling*>(tiling));
    op.Process();
}
