/**
 * @file head_compute_mix_fwd.asc
 * @brief Host-side entry for head_compute_mix_fwd operator (direct invoke mode).
 *
 * Computes: output = sigmoid(input_mix * mhc_scale + mhc_base) + mhc_pre_eps
 *
 * Inputs (binary files):
 *   input/input_mix.bin   - FP16, shape [batch, n1, mhc_mult], flattened
 *   input/mhc_scale.bin   - FP16, scalar
 *   input/mhc_base.bin    - FP16, 4 elements
 *   input/mhc_pre_eps.bin - FP32, scalar
 * Output:
 *   output/output.bin     - FP16, same shape as input
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/head_compute_mix_fwd_tiling.h"
#include "data_utils.h"

// Include kernel implementation (ASC code)
#include "../op_kernel/head_compute_mix_fwd_kernel.asc"

// ============================================================================
// Host-side structures and helpers
// ============================================================================

struct ArgInfo {
    std::string fileName;
    size_t length;
};

/**
 * @brief Compute tiling parameters for the head_compute_mix_fwd operator.
 *
 * Follows the Elementwise standard tiling formula from DESIGN.md §4:
 *   dim0 = batch * n1 * mhc_mult
 *   coreNum = min(ceil(dim0*minDtypeBits/MIN_TILING_BITS), availableCoreNum)
 *   blockFormer = ceil(ceil(dim0/coreNum) / ELEM_ALIGN_FACTOR) * ELEM_ALIGN_FACTOR
 *   blockNum = ceil(dim0 / blockFormer)
 *   blockTail = dim0 - (blockNum-1) * blockFormer
 */
void ComputeTiling(HeadComputeMixFwdTilingData* tiling,
                   int64_t dim0, int64_t availableCoreNum)
{
    tiling->dim0 = dim0;

    // Compute coreNum
    int64_t coreNum = (dim0 * 16 + MIN_TILING_BITS - 1) / MIN_TILING_BITS;
    if (coreNum > availableCoreNum) coreNum = availableCoreNum;
    if (coreNum < 1) coreNum = 1;
    tiling->coreNum = static_cast<int32_t>(coreNum);

    // Compute blockFormer (512-aligned)
    int64_t blockFormer = ((dim0 + coreNum - 1) / coreNum + ELEM_ALIGN_FACTOR - 1)
                          / ELEM_ALIGN_FACTOR * ELEM_ALIGN_FACTOR;
    tiling->blockFormer = blockFormer;

    // Compute blockNum and blockTail
    int64_t blockNum = (dim0 + blockFormer - 1) / blockFormer;
    tiling->blockNum = blockNum;
    tiling->blockTail = dim0 - (blockNum - 1) * blockFormer;

    // UB tile size (use pre-computed constant)
    tiling->ubFormer = UB_FORMER_HALF;

    // Former block UB loops
    int64_t ubLoopF = (blockFormer + tiling->ubFormer - 1) / tiling->ubFormer;
    tiling->ubLoopOfFormerBlock = ubLoopF;
    tiling->ubTailOfFormerBlock = blockFormer - (ubLoopF - 1) * tiling->ubFormer;

    // Tail block UB loops
    if (tiling->blockTail > 0) {
        int64_t ubLoopT = (tiling->blockTail + tiling->ubFormer - 1) / tiling->ubFormer;
        tiling->ubLoopOfTailBlock = ubLoopT;
        tiling->ubTailOfTailBlock = tiling->blockTail - (ubLoopT - 1) * tiling->ubFormer;
    } else {
        // Tail block same as former
        tiling->ubLoopOfTailBlock = tiling->ubLoopOfFormerBlock;
        tiling->ubTailOfTailBlock = tiling->ubTailOfFormerBlock;
    }
}

// ============================================================================
// Kernel launch wrapper
// ============================================================================

void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo>& inputsInfo, std::vector<ArgInfo>& outputsInfo,
    uint8_t* tilingData, size_t tilingSize)
{
    std::vector<uint8_t*> inputHost(inputsInfo.size());
    std::vector<uint8_t*> inputDevice(inputsInfo.size());
    std::vector<uint8_t*> outputHost(outputsInfo.size());
    std::vector<uint8_t*> outputDevice(outputsInfo.size());
    uint8_t* tilingDevice = nullptr;

    // Allocate and copy tiling data to device
    aclrtMalloc(reinterpret_cast<void**>(&tilingDevice), tilingSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, tilingSize, tilingData, tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate and copy input data to device
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost(reinterpret_cast<void**>(&inputHost[i]), inputsInfo[i].length);
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice[i]), inputsInfo[i].length,
                    ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
                    inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    // Allocate output buffers on device
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost(reinterpret_cast<void**>(&outputHost[i]), outputsInfo[i].length);
        aclrtMalloc(reinterpret_cast<void**>(&outputDevice[i]), outputsInfo[i].length,
                    ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // Launch kernel (one input, one output)
    head_compute_mix_fwd_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], outputDevice[0], tilingDevice);
    aclrtSynchronizeStream(stream);

    // Free tiling device memory
    aclrtFree(tilingDevice);

    // Copy output back to host and write to files
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
                    outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    // Free input buffers
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// ============================================================================
// Main entry point
// ============================================================================

int32_t main(int32_t argc, char* argv[])
{
    // Parse or use default shape parameters
    // Default: batch=16, n1=16384, mhc_mult=4
    int64_t batch = 16;
    int64_t n1 = 16384;
    int64_t mhcMult = 4;

    if (argc >= 4) {
        batch = std::atoll(argv[1]);
        n1 = std::atoll(argv[2]);
        mhcMult = std::atoll(argv[3]);
    }
    int64_t dim0 = batch * n1 * mhcMult;

    // Read scalar parameters from files
    // mhc_scale: FP16 scalar
    half mhcScaleHalf;
    {
        std::ifstream scaleFile("input/mhc_scale.bin", std::ios::binary);
        if (!scaleFile.is_open()) {
            printf("ERROR: Cannot open input/mhc_scale.bin\n");
            return -1;
        }
        scaleFile.read(reinterpret_cast<char*>(&mhcScaleHalf), sizeof(half));
        scaleFile.close();
    }

    // mhc_base: FP16 [4]
    half mhcBaseHalf[4];
    {
        std::ifstream baseFile("input/mhc_base.bin", std::ios::binary);
        if (!baseFile.is_open()) {
            printf("ERROR: Cannot open input/mhc_base.bin\n");
            return -1;
        }
        baseFile.read(reinterpret_cast<char*>(mhcBaseHalf), sizeof(half) * 4);
        baseFile.close();
    }

    // mhc_pre_eps: FP32 scalar
    float mhcPreEps;
    {
        std::ifstream epsFile("input/mhc_pre_eps.bin", std::ios::binary);
        if (!epsFile.is_open()) {
            printf("ERROR: Cannot open input/mhc_pre_eps.bin\n");
            return -1;
        }
        epsFile.read(reinterpret_cast<char*>(&mhcPreEps), sizeof(float));
        epsFile.close();
    }

    printf("Operator: head_compute_mix_fwd\n");
    printf("Shape: [%ld, %ld, %ld], dim0=%ld\n", batch, n1, mhcMult, dim0);
    printf("mhc_scale=%.6f, mhc_pre_eps=%.6f\n",
           static_cast<float>(mhcScaleHalf), mhcPreEps);

    // ACL initialization
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        aclFinalize();
        return ret;
    }

    // Get available core count
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return ret;
    }
    printf("Available cores: %ld\n", availableCoreNum);

    // Compute tiling parameters
    HeadComputeMixFwdTilingData tiling;
    ComputeTiling(&tiling, dim0, availableCoreNum);

    // Fill scalar parameters (FP32)
    tiling.mhc_scale_f32 = static_cast<float>(mhcScaleHalf);
    tiling.mhc_pre_eps_f32 = mhcPreEps;
    for (int i = 0; i < 4; i++) {
        tiling.mhc_base_f32[i] = static_cast<float>(mhcBaseHalf[i]);
    }

    // Print tiling summary
    printf("Tiling: coreNum=%d, blockFormer=%ld, blockNum=%ld, blockTail=%ld\n",
           tiling.coreNum, tiling.blockFormer, tiling.blockNum, tiling.blockTail);
    printf("Tiling: ubFormer=%ld, ubLoopF=%ld, ubTailF=%ld, ubLoopT=%ld, ubTailT=%ld\n",
           tiling.ubFormer, tiling.ubLoopOfFormerBlock, tiling.ubTailOfFormerBlock,
           tiling.ubLoopOfTailBlock, tiling.ubTailOfTailBlock);

    // Setup file paths
    size_t inputByteSize = static_cast<size_t>(dim0) * sizeof(half);
    size_t outputByteSize = inputByteSize;

    std::vector<ArgInfo> inputsInfo = {
        {"input/input_mix.bin", inputByteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"output/output.bin", outputByteSize}
    };

    // Create stream and launch kernel
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint32_t blockNum = static_cast<uint32_t>(tiling.blockNum);
    KernelCall(blockNum, stream, inputsInfo, outputsInfo,
               reinterpret_cast<uint8_t*>(&tiling), sizeof(HeadComputeMixFwdTilingData));

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("Kernel execution completed successfully.\n");
    return 0;
}
