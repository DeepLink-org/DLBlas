/**
 * @file head_compute_mix_fwd_kernel.asc
 * @brief Ascend C Kernel implementation for head_compute_mix_fwd operator.
 *
 * Computes: output = sigmoid(input_mix * mhc_scale + mhc_base) + mhc_pre_eps
 *
 * Strategy (DAV_2201):
 *   - 3D tensor flattened to 1D for elementwise processing
 *   - FP16 input/output with FP32 intermediate computation (for sigmoid precision)
 *   - Double-buffered pipeline: inQueue | f32WorkBuf | outQueue
 *   - mhc_base[4] pre-expanded via manual SetValue loop (once per core)
 *   - Sigmoid via: Muls(-1) → Exp → Adds(1) → Reciprocal → Adds(eps)
 */

#include "kernel_operator.h"
#include "head_compute_mix_fwd_tiling.h"

using namespace AscendC;

class KernelHeadComputeMixFwd {
public:
    __aicore__ inline KernelHeadComputeMixFwd(TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(
        GM_ADDR inputGmAddr,
        GM_ADDR outputGmAddr,
        const __gm__ HeadComputeMixFwdTilingData* tiling)
    {
        this->tiling_ = tiling;
        uint32_t blockIdx = GetBlockIdx();

        // Determine this core's work range
        if (blockIdx < static_cast<uint32_t>(tiling_->blockNum - 1)) {
            blockSize_ = tiling_->blockFormer;
            ubLoop_ = static_cast<uint32_t>(tiling_->ubLoopOfFormerBlock);
            ubTail_ = static_cast<uint32_t>(tiling_->ubTailOfFormerBlock);
        } else {
            blockSize_ = tiling_->blockTail;
            ubLoop_ = static_cast<uint32_t>(tiling_->ubLoopOfTailBlock);
            ubTail_ = static_cast<uint32_t>(tiling_->ubTailOfTailBlock);
        }

        // GM offsets
        int64_t coreOffset = blockIdx * tiling_->blockFormer;
        inputGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ half*>(inputGmAddr) + coreOffset,
            static_cast<uint32_t>(blockSize_));
        outputGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ half*>(outputGmAddr) + coreOffset,
            static_cast<uint32_t>(blockSize_));

        // UB Buffer initialization
        // inQueue: Double-buffered FP16 input (TQue)
        pipe_->InitBuffer(inQueue_, DOUBLE_BUFFER,
            static_cast<uint32_t>(tiling_->ubFormer) * sizeof(half));
        // f32WorkBuf: Two single FP32 work buffers (manually ping-ponged)
        pipe_->InitBuffer(f32WorkBuf0_,
            static_cast<uint32_t>(tiling_->ubFormer) * sizeof(float));
        pipe_->InitBuffer(f32WorkBuf1_,
            static_cast<uint32_t>(tiling_->ubFormer) * sizeof(float));
        // baseF32Expanded: mhc_base expanded to tile size (written once)
        pipe_->InitBuffer(baseF32Expanded_,
            static_cast<uint32_t>(tiling_->ubFormer) * sizeof(float));
        // outQueue: Double-buffered FP16 output (TQue)
        pipe_->InitBuffer(outQueue_, DOUBLE_BUFFER,
            static_cast<uint32_t>(tiling_->ubFormer) * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        // ---- Stage 0: Expand mhc_base[4] to ubFormer elements ----
        PrepareBaseExpanded();

        uint32_t ubFormer = static_cast<uint32_t>(tiling_->ubFormer);

        // ---- Stage 1: Process first tile (CopyIn only, nothing to compute yet) ----
        uint32_t totalTiles = ubLoop_;

        uint32_t firstSize;
        if (totalTiles > 1) {
            // Multi-tile scenario: first tile is always ubFormer
            firstSize = ubFormer;
        } else {
            // Single tile: it is the last tile, use ubTail_ (may equal ubFormer)
            firstSize = (ubTail_ > 0) ? ubTail_ : ubFormer;
        }
        int64_t gmOffset = 0;
        CopyInTile(firstSize, gmOffset);

        // ---- Stage 2: Main pipeline loop ----
        uint32_t prevSize = firstSize;
        uint32_t prevPrevSize = 0;
        int64_t prevGmOffset = 0;
        int64_t prevPrevGmOffset = 0;
        int32_t ping = 0;
        gmOffset += firstSize;

        for (uint32_t i = 1; i < totalTiles; i++) {
            // Determine current tile size: last tile uses ubTail_, others use ubFormer
            uint32_t curSize;
            if (static_cast<uint32_t>(i + 1) < totalTiles) {
                curSize = ubFormer;  // Not the last tile
            } else {
                curSize = (ubTail_ > 0) ? ubTail_ : ubFormer;  // Last tile
            }

            // CopyIn: tile i
            CopyInTile(curSize, gmOffset);

            // Compute: tile i-1
            ComputeTile(prevSize, ping);

            // CopyOut: tile i-2 (skip for first iter)
            if (i >= 2) {
                CopyOutTile(prevPrevSize, prevPrevGmOffset);
            }

            // Advance state
            prevPrevSize = prevSize;
            prevPrevGmOffset = prevGmOffset;
            prevSize = curSize;
            prevGmOffset = gmOffset;
            gmOffset += curSize;
            ping ^= 1;
        }

        // ---- Stage 3: Tail flush ----
        ComputeTile(prevSize, ping);
        if (totalTiles >= 2) {
            CopyOutTile(prevPrevSize, prevPrevGmOffset);
        }
        CopyOutTile(prevSize, prevGmOffset);
    }

private:
    // ========================================================================
    // Stage 0: Expand mhc_base[4] to ubFormer elements
    // On DAV_2201, Duplicate(tensor→tensor) is not available, so we use
    // a manual SetValue loop. This runs once per core (not per tile) and
    // processes ubFormer=9728 elements.
    // ========================================================================
    __aicore__ inline void PrepareBaseExpanded()
    {
        uint32_t ubFormer = static_cast<uint32_t>(tiling_->ubFormer);
        LocalTensor<float> baseF32 = baseF32Expanded_.Get<float>();

        // Repeat mhc_base[4] pattern across ubFormer elements
        // ubFormer is always divisible by 4 (verified at tiling time)
        for (uint32_t i = 0; i < ubFormer; i += 4) {
            baseF32.SetValue(i,     tiling_->mhc_base_f32[0]);
            baseF32.SetValue(i + 1, tiling_->mhc_base_f32[1]);
            baseF32.SetValue(i + 2, tiling_->mhc_base_f32[2]);
            baseF32.SetValue(i + 3, tiling_->mhc_base_f32[3]);
        }
    }

    // ========================================================================
    // CopyIn: Load one tile from GM to UB (FP16)
    // ========================================================================
    __aicore__ inline void CopyInTile(uint32_t count, int64_t gmOffset)
    {
        if (count == 0) return;
        LocalTensor<half> inLocal = inQueue_.AllocTensor<half>();
        DataCopyPad(inLocal, inputGm_[gmOffset],
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0},
            {false, 0, 0, 0});
        inQueue_.EnQue(inLocal);
    }

    // ========================================================================
    // Compute: Core sigmoid computation on one tile (FP32 internally)
    // ========================================================================
    __aicore__ inline void ComputeTile(uint32_t count, int32_t ping)
    {
        if (count == 0) return;

        // Dequeue input (FP16)
        LocalTensor<half> inLocal = inQueue_.DeQue<half>();

        // Select work buffer based on ping-pong
        LocalTensor<float> work = (ping == 0)
            ? f32WorkBuf0_.Get<float>()
            : f32WorkBuf1_.Get<float>();

        // Step 0: Cast half → float (CAST_NONE: no rounding needed)
        Cast<float, half>(work, inLocal, RoundMode::CAST_NONE, count);

        // Step 1: x = input * mhc_scale (scalar multiply)
        float scale = tiling_->mhc_scale_f32;
        Muls(work, work, scale, count);

        // Step 2: x = x + mhc_base (broadcast add with pre-expanded base)
        LocalTensor<float> baseF32 = baseF32Expanded_.Get<float>();
        Add(work, work, baseF32, static_cast<int32_t>(count));

        // ---- Sigmoid chain (all FP32) ----
        // Step 3: neg = -x
        Muls(work, work, -1.0f, count);
        // Step 4: exp_val = exp(-x)
        Exp(work, work, count);
        // Step 5: denom = 1.0 + exp(-x)
        Adds(work, work, 1.0f, count);
        // Step 6: sigmoid = 1.0 / denom
        Reciprocal(work, work, static_cast<int32_t>(count));
        // Step 7: result = sigmoid + mhc_pre_eps
        float eps = tiling_->mhc_pre_eps_f32;
        Adds(work, work, eps, count);

        // Step 8: Cast float → half (CAST_ROUND: proper rounding)
        LocalTensor<half> outLocal = outQueue_.AllocTensor<half>();
        Cast<half, float>(outLocal, work, RoundMode::CAST_ROUND, count);
        outQueue_.EnQue(outLocal);

        inQueue_.FreeTensor(inLocal);
    }

    // ========================================================================
    // CopyOut: Write one tile from UB to GM (FP16)
    // ========================================================================
    __aicore__ inline void CopyOutTile(uint32_t count, int64_t gmOffset)
    {
        if (count == 0) return;
        LocalTensor<half> outLocal = outQueue_.DeQue<half>();
        DataCopyPad(outputGm_[gmOffset], outLocal,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0});
        outQueue_.FreeTensor(outLocal);
    }

    // ========================================================================
    // Member variables
    // ========================================================================
    TPipe* pipe_;
    const __gm__ HeadComputeMixFwdTilingData* tiling_;

    GlobalTensor<half> inputGm_;
    GlobalTensor<half> outputGm_;

    TQue<TPosition::VECIN, 2>  inQueue_;
    TBuf<TPosition::VECCALC>   f32WorkBuf0_;
    TBuf<TPosition::VECCALC>   f32WorkBuf1_;
    TBuf<TPosition::VECCALC>   baseF32Expanded_;
    TQue<TPosition::VECOUT, 2> outQueue_;

    int64_t  blockSize_;
    uint32_t ubLoop_;
    uint32_t ubTail_;
};

// ===================================================================
// Kernel entry point
// ===================================================================
extern "C" __global__ __vector__ void head_compute_mix_fwd_kernel(
    GM_ADDR inputGm, GM_ADDR outputGm, GM_ADDR tiling)
{
    TPipe pipe;
    KernelHeadComputeMixFwd op(&pipe);
    op.Init(inputGm, outputGm,
        reinterpret_cast<__gm__ HeadComputeMixFwdTilingData*>(tiling));
    op.Process();
}
