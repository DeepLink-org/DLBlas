/**
 * MTPBlock K6: mtp_head Kernel
 *
 * Math:
 *   1. Flatten x [b,s,hc,d] → [b*s, hc*d]
 *   2. RMSNorm: rsqrt = 1/sqrt(mean(x_flat²)+eps)
 *   3. mixes = x_flat @ hc_head_fn^T * rsqrt [b*s, hc]
 *   4. pre = sigmoid(mixes * scale + base) + eps
 *   5. y = sum(pre * x, dim=2) [b,s,d]
 *   6. x_last = RMSNorm(y[:,-1]) [b,d] (only for LAST tile)
 *   7. logits = x_last @ head_weight^T [b, vocab]
 *
 * NpuArch: DAV_2201, __aicore__ (Cube+Vector)
 *
 * L2 FIX (Round 2): Step 6-7 (RMSNorm + lm_head) now guarded by
 *   `if (tile_idx == n_tiles - 1)` to ensure only the last tile
 *   processes the last token. Previously every tile computed logits
 *   for its own last row, producing incorrect results in multi-tile
 *   scenarios.
 *
 * MatmulImpl integration status:
 *   This kernel has two matrix multiplications:
 *   a) hc_head: M=8, K=2048, N=4 — N=4 is very tiny.
 *      MatmulImpl NOT used: Cube utilization would be near-zero.
 *      Manual SIMD with UB-preloaded weight rows is more efficient.
 *   b) lm_head: M=1, K=512, N=vocab(129280) — This is the LARGEST matmul
 *      in MTPBlock and would benefit most from MatmulImpl.
 *      MatmulImpl NOT yet integrated because:
 *        - M=1 is below typical Cube tile size (baseM>=8)
 *        - N=129280 needs ~2000+ tiles with M=1 (many small tiles)
 *        - Current approach (stream each weight row from GM) is simple
 *          but slow; MatmulImpl would be 10-100x faster for large vocab
 *      Recommended priority: HIGHEST for MatmulImpl integration.
 *      Requires: TCubeTiling via matmul_tiling_helper.cpp on C++ host.
 */

#include "kernel_operator.h"
#include "mtpblock_tiling.h"

using namespace AscendC;

constexpr uint32_t K6_MAX_TILE_S = 8;
constexpr uint32_t K6_HC    = DEMO_HC;
constexpr uint32_t K6_D     = DEMO_D;
constexpr uint32_t K6_HCD   = DEMO_HC * DEMO_D;

class KernelMtpHead {
public:
    __aicore__ inline KernelMtpHead(TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(
        GM_ADDR x_gm, GM_ADDR hc_fn_gm, GM_ADDR hc_scale_gm, GM_ADDR hc_base_gm,
        GM_ADDR norm_w_gm, GM_ADDR head_w_gm, GM_ADDR logits_gm,
        const __gm__ K6MtpHeadTiling* tiling)
    {
        this->tiling = tiling;
        dim_bs  = tiling->base.b * tiling->base.s;
        dim_hc  = tiling->base.hc;
        dim_d   = tiling->base.d;
        dim_hcd = dim_hc * dim_d;
        vocab   = tiling->base.vocab_size;

        xGm.SetGlobalBuffer((__gm__ half*)x_gm, dim_bs * dim_hcd);
        hcFnGm.SetGlobalBuffer((__gm__ float*)hc_fn_gm, dim_hc * dim_hcd);
        scaleGm.SetGlobalBuffer((__gm__ float*)hc_scale_gm, 1);
        baseGm.SetGlobalBuffer((__gm__ float*)hc_base_gm, dim_hc);
        normWGm.SetGlobalBuffer((__gm__ float*)norm_w_gm, dim_d);
        headWGm.SetGlobalBuffer((__gm__ float*)head_w_gm, vocab * dim_d);
        logitsGm.SetGlobalBuffer((__gm__ float*)logits_gm, vocab);

        tile_s = tiling->base.tile_s;
        if (tile_s == 0 || tile_s > K6_MAX_TILE_S) tile_s = K6_MAX_TILE_S;
        n_tiles = (dim_bs + tile_s - 1) / tile_s;

        pipe_->InitBuffer(xInBuf,       1, K6_MAX_TILE_S * dim_hcd * sizeof(half));
        pipe_->InitBuffer(fnRowBuf,     1, dim_hcd * sizeof(float));
        pipe_->InitBuffer(xRowFp32Buf,  1, dim_d * sizeof(float));
        pipe_->InitBuffer(wtRowBuf,     1, dim_d * sizeof(float));
        pipe_->InitBuffer(scaleBuf,     1, sizeof(float));
        pipe_->InitBuffer(baseBuf,      1, dim_hc * sizeof(float));
        pipe_->InitBuffer(mixesBuf,     1, K6_MAX_TILE_S * dim_hc * sizeof(float));
        pipe_->InitBuffer(preBuf,       1, K6_MAX_TILE_S * dim_hc * sizeof(float));
        pipe_->InitBuffer(rsqrtBuf,     1, K6_MAX_TILE_S * sizeof(float));
        pipe_->InitBuffer(sigmoidBuf,   1, K6_MAX_TILE_S * dim_hc * sizeof(float));
        pipe_->InitBuffer(yOutBuf,      1, K6_MAX_TILE_S * dim_d * sizeof(float));
        pipe_->InitBuffer(logitsBuf,    1, sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t tile_idx = 0; tile_idx < n_tiles; tile_idx++) {
            uint32_t cur_s = (tile_idx == n_tiles - 1) ?
                (dim_bs - tile_idx * tile_s) : tile_s;
            uint32_t s_offset = tile_idx * tile_s;
            Compute(cur_s, s_offset, tile_idx);
        }
    }

private:
    __aicore__ inline void Compute(uint32_t cur_s, uint32_t s_offset, uint32_t tile_idx)
    {
        LocalTensor<half>  xIn   = xInBuf.AllocTensor<half>();
        LocalTensor<float> fnRow = fnRowBuf.AllocTensor<float>();
        LocalTensor<float> xRowF = xRowFp32Buf.AllocTensor<float>();
        LocalTensor<float> wtRow = wtRowBuf.AllocTensor<float>();
        LocalTensor<float> sBuf  = scaleBuf.AllocTensor<float>();
        LocalTensor<float> bBuf  = baseBuf.AllocTensor<float>();
        LocalTensor<float> mixes = mixesBuf.AllocTensor<float>();
        LocalTensor<float> pre   = preBuf.AllocTensor<float>();
        LocalTensor<float> rvec  = rsqrtBuf.AllocTensor<float>();
        LocalTensor<float> sigT  = sigmoidBuf.AllocTensor<float>();
        LocalTensor<float> yOut  = yOutBuf.AllocTensor<float>();
        LocalTensor<float> logit = logitsBuf.AllocTensor<float>();

        float eps = tiling->base.hc_eps;

        DataCopyPad(xIn, xGm[s_offset * dim_hcd],
            {1, static_cast<uint16_t>(cur_s * dim_hcd * sizeof(half)), 0, 0},
            {false, 0, 0, 0});
        DataCopyPad(sBuf, scaleGm,
            {1, static_cast<uint16_t>(sizeof(float)), 0, 0}, {false, 0, 0, 0});
        DataCopyPad(bBuf, baseGm,
            {1, static_cast<uint16_t>(dim_hc * sizeof(float)), 0, 0}, {false, 0, 0, 0});

        float hc_scale = sBuf.GetValue(0);
        float norm_eps = tiling->base.norm_eps;

        // ============================================================
        // Step 1-2: RMSNorm per row (flattened)
        // ============================================================
        for (uint32_t m = 0; m < cur_s; m++) {
            float sum_sq = 0.0f;
            for (uint32_t k = 0; k < dim_hcd; k++) {
                float xv = static_cast<float>(xIn.GetValue(m * dim_hcd + k));
                sum_sq += xv * xv;
            }
            int hcd_i = (int)dim_hcd;
            rvec.SetValue(m, sum_sq / (float)hcd_i + norm_eps);
        }
        AscendC::Rsqrt(rvec, rvec, cur_s);

        // ============================================================
        // Step 3: mixes = x_flat * hc_fn^T * rsqrt
        //
        // NOTE: MatmulImpl NOT used. hc_fn is [hc=4, hcd=2048] float.
        // N=4 is too small for Cube utilization. Manual SIMD with
        // UB-preloaded fn rows is more efficient at this scale.
        // hc_fn size: 4*2048*4 = 32KB, fits in UB.
        // ============================================================
        for (uint32_t n = 0; n < dim_hc; n++) {
            DataCopyPad(fnRow, hcFnGm[n * dim_hcd],
                {1, static_cast<uint16_t>(dim_hcd * sizeof(float)), 0, 0},
                {false, 0, 0, 0});

            for (uint32_t m = 0; m < cur_s; m++) {
                float dot = 0.0f;
                for (uint32_t k = 0; k < dim_hcd; k++) {
                    float xv = static_cast<float>(xIn.GetValue(m * dim_hcd + k));
                    float wv = fnRow.GetValue(k);
                    dot += xv * wv;
                }
                mixes.SetValue(m * dim_hc + n, dot * rvec.GetValue(m));
            }
        }

        // ============================================================
        // Step 4: pre = sigmoid(mixes * scale + base) + eps
        // ============================================================
        for (uint32_t m = 0; m < cur_s; m++) {
            for (uint32_t i = 0; i < dim_hc; i++) {
                float v = mixes.GetValue(m * dim_hc + i) * hc_scale + bBuf.GetValue(i);
                sigT.SetValue(i, v);
            }
            ComputeSigmoid(sigT, dim_hc);
            for (uint32_t i = 0; i < dim_hc; i++) {
                pre.SetValue(m * dim_hc + i, sigT.GetValue(i) + eps);
            }
        }

        // ============================================================
        // Step 5: y[m, di] = sum_i pre[m,i] * x[m, i*d+di]
        // ============================================================
        for (uint32_t m = 0; m < cur_s; m++) {
            for (uint32_t di = 0; di < dim_d; di++) {
                float acc = 0.0f;
                for (uint32_t i = 0; i < dim_hc; i++) {
                    float pv = pre.GetValue(m * dim_hc + i);
                    float xv = static_cast<float>(xIn.GetValue(m * dim_hcd + i * dim_d + di));
                    acc += pv * xv;
                }
                yOut.SetValue(m * dim_d + di, acc);
            }
        }

        // ============================================================
        // Step 6-7: RMSNorm on last token + lm_head
        //
        // L2 FIX (Round 2): Only execute on LAST tile.
        // Previously every tile wrote logits for its own last row,
        // producing incorrect outputs in multi-tile scenarios.
        // Now guarded by tile_idx check.
        // ============================================================
        if (tile_idx == n_tiles - 1) {
            uint32_t last_m = cur_s - 1;

            // RMSNorm on y[last_m, :]
            {
                float sum_sq = 0.0f;
                for (uint32_t di = 0; di < dim_d; di++) {
                    float val = yOut.GetValue(last_m * dim_d + di);
                    xRowF.SetValue(di, val);
                    sum_sq += val * val;
                }
                int d_i = (int)dim_d;
                rvec.SetValue(0, sum_sq / (float)d_i + norm_eps);
                AscendC::Rsqrt(rvec, rvec, 1);
                float rv = rvec.GetValue(0);

                DataCopyPad(wtRow, normWGm,
                    {1, static_cast<uint16_t>(dim_d * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});

                for (uint32_t di = 0; di < dim_d; di++) {
                    float val = xRowF.GetValue(di) * rv * wtRow.GetValue(di);
                    xRowF.SetValue(di, val);
                }
            }

            // ============================================================
            // Step 7: logits = x_last @ head_weight^T [1, vocab]
            //
            // NOTE: MatmulImpl NOT yet integrated. This is the highest-priority
            // matmul for future MatmulImpl integration (M=1, K=512, N=vocab).
            // head_weight [vocab, d] = [129280, 512] float = 258MB in GM.
            // Current approach: stream each row from GM, compute dot product.
            // With MatmulImpl: L1/L0C tiled loading, Cube dot product.
            // Expected speedup: >10x for large vocab (129280).
            // Requires: TCubeTiling from matmul_tiling_helper.cpp on C++ host.
            // ============================================================
            for (uint32_t n = 0; n < vocab; n++) {
                DataCopyPad(wtRow, headWGm[n * dim_d],
                    {1, static_cast<uint16_t>(dim_d * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});

                float dot = 0.0f;
                for (uint32_t k = 0; k < dim_d; k++) {
                    dot += xRowF.GetValue(k) * wtRow.GetValue(k);
                }
                logit.SetValue(0, dot);

                DataCopyPad(logitsGm[n], logit,
                    {1, static_cast<uint16_t>(sizeof(float)), 0, 0});
            }
        }

        xInBuf.FreeTensor(xIn);
        fnRowBuf.FreeTensor(fnRow);
        xRowFp32Buf.FreeTensor(xRowF);
        wtRowBuf.FreeTensor(wtRow);
        scaleBuf.FreeTensor(sBuf);
        baseBuf.FreeTensor(bBuf);
        mixesBuf.FreeTensor(mixes);
        preBuf.FreeTensor(pre);
        rsqrtBuf.FreeTensor(rvec);
        sigmoidBuf.FreeTensor(sigT);
        yOutBuf.FreeTensor(yOut);
        logitsBuf.FreeTensor(logit);
    }

    // Sigmoid via AscendC::Exp
    __aicore__ inline void ComputeSigmoid(LocalTensor<float>& t, uint32_t n)
    {
        AscendC::Muls(t, t, -1.0f, n);
        AscendC::Exp(t, t, n);
        for (uint32_t i = 0; i < n; i++) {
            float ev = t.GetValue(i);
            t.SetValue(i, 1.0f / (1.0f + ev));
        }
    }

private:
    TPipe* pipe_;
    const __gm__ K6MtpHeadTiling* tiling;

    GlobalTensor<half> xGm;
    GlobalTensor<float> hcFnGm, scaleGm, baseGm, normWGm, headWGm, logitsGm;

    TQue<TPosition::VECIN, 1> xInBuf, fnRowBuf, xRowFp32Buf, wtRowBuf;
    TQue<TPosition::VECIN, 1> scaleBuf, baseBuf, mixesBuf, preBuf;
    TQue<TPosition::VECIN, 1> rsqrtBuf, sigmoidBuf, yOutBuf, logitsBuf;

    uint32_t dim_bs, dim_hc, dim_d, dim_hcd, vocab;
    uint32_t tile_s, n_tiles;
};

extern "C" __global__ __aicore__ void k6_mtp_head_kernel(
    GM_ADDR x, GM_ADDR hc_fn, GM_ADDR hc_scale, GM_ADDR hc_base,
    GM_ADDR norm_w, GM_ADDR head_w, GM_ADDR logits, GM_ADDR tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    TPipe pipe; KernelMtpHead op(&pipe);
    op.Init(x, hc_fn, hc_scale, hc_base, norm_w, head_w, logits,
            (__gm__ K6MtpHeadTiling*)tiling);
    op.Process();
}
