/**
 * MTPBlock K2: hc_pre Kernel
 *
 * 数学: HC 预处理 + Sinkhorn 归一化
 *
 * NpuArch: DAV_2201, UB=192KB, __vector__ (Vector-only)
 *
 * MatmulImpl integration status:
 *   K2 has one matrix multiply: mixes = x_flat [M=8, K=2048] × hc_fn^T [N=24, K=2048]
 *   This is an extreme case: M=8, N=24, K=2048.
 *   MatmulImpl NOT used because:
 *   a) N=24 is tiny — Cube unit utilization would be very poor (<5% for typical baseN=64)
 *   b) MatmulImpl overhead (TCubeTiling setup, L0C/L1 data movement) would far exceed
 *      the scalar computation cost for such small output dimensions
 *   c) M=8 is below the recommended minimum M=16 for good Cube efficiency
 *   d) The existing approach (load fn row into UB, dot product with all M rows) is
 *      efficient for this shape because each fn row (8KB) fits in UB and is reused
 *      across all M rows
 *
 *   For shapes with M>=32, N>=64: MatmulImpl would be beneficial. For the current
 *   demo shape, manual SIMD is the optimal choice.
 *
 * Demo shape: b=1, s=8, hc=4, d=512 → dim_bs=8, hc*d=2048, mix_hc=24
 */

#include "kernel_operator.h"
#include "mtpblock_tiling.h"

using namespace AscendC;

// Max tile size for UB buffer allocation (compile-time constant required)
constexpr uint32_t K2_MAX_TILE_S = 8;
constexpr uint32_t K2_HC    = DEMO_HC;
constexpr uint32_t K2_D     = DEMO_D;
constexpr uint32_t K2_HCD   = DEMO_HC * DEMO_D;        // 2048
constexpr uint32_t K2_MIX   = DEMO_MIX_HC;              // 24
constexpr uint32_t K2_MAX_SIGMOID = (K2_MAX_TILE_S > K2_HC) ? K2_MAX_TILE_S : K2_HC;

class KernelHcPre {
public:
    __aicore__ inline KernelHcPre(TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(
        GM_ADDR x_gm, GM_ADDR hc_fn_gm, GM_ADDR hc_scale_gm,
        GM_ADDR hc_base_gm, GM_ADDR y_gm, GM_ADDR pre_gm,
        GM_ADDR post_gm, GM_ADDR comb_gm,
        const __gm__ K2HcPreTiling* tiling)
    {
        this->tiling = tiling;
        dim_bs = tiling->base.b * tiling->base.s;
        dim_hc = tiling->base.hc;
        dim_d  = tiling->base.d;
        dim_hcd = dim_hc * dim_d;
        dim_mix = tiling->base.mix_hc;

        // Global buffer setup
        xGm.SetGlobalBuffer((__gm__ half*)x_gm, dim_bs * dim_hcd);
        hcFnGm.SetGlobalBuffer((__gm__ float*)hc_fn_gm, dim_mix * dim_hcd);
        scaleGm.SetGlobalBuffer((__gm__ float*)hc_scale_gm, 3);
        baseGm.SetGlobalBuffer((__gm__ float*)hc_base_gm, dim_mix);
        yGm.SetGlobalBuffer((__gm__ half*)y_gm, dim_bs * dim_d);
        preGm.SetGlobalBuffer((__gm__ float*)pre_gm, dim_bs * dim_hc);
        postGm.SetGlobalBuffer((__gm__ float*)post_gm, dim_bs * dim_hc);
        combGm.SetGlobalBuffer((__gm__ float*)comb_gm, dim_bs * dim_hc * dim_hc);

        // UB buffer init
        tile_s = tiling->base.tile_s;
        if (tile_s == 0 || tile_s > K2_MAX_TILE_S) tile_s = K2_MAX_TILE_S;
        n_tiles = (dim_bs + tile_s - 1) / tile_s;

        pipe_->InitBuffer(inQueueX, DOUBLE_BUFFER, K2_MAX_TILE_S * dim_hcd * sizeof(half));
        pipe_->InitBuffer(inQueueScale, 1, 3 * sizeof(float));
        pipe_->InitBuffer(inQueueBase, 1, dim_mix * sizeof(float));
        pipe_->InitBuffer(xFp32RowBuf, 1, dim_hcd * sizeof(float));
        pipe_->InitBuffer(fnRowBuf, 1, dim_hcd * sizeof(float));
        pipe_->InitBuffer(mixesBuf, 1, K2_MAX_TILE_S * dim_mix * sizeof(float));
        pipe_->InitBuffer(rsqrtBuf, 1, K2_MAX_TILE_S * sizeof(float));
        pipe_->InitBuffer(sigmoidTmp, 1, K2_MAX_SIGMOID * sizeof(float));
        pipe_->InitBuffer(combRowBuf, 1, dim_hc * dim_hc * sizeof(float));
        pipe_->InitBuffer(preBuf, 1, K2_MAX_TILE_S * dim_hc * sizeof(float));
        pipe_->InitBuffer(postBuf, 1, K2_MAX_TILE_S * dim_hc * sizeof(float));
        pipe_->InitBuffer(combBuf, 1, K2_MAX_TILE_S * dim_hc * dim_hc * sizeof(float));
        pipe_->InitBuffer(outQueueY, DOUBLE_BUFFER, K2_MAX_TILE_S * dim_d * sizeof(half));
        pipe_->InitBuffer(outQueuePre, 1, K2_MAX_TILE_S * dim_hc * sizeof(float));
        pipe_->InitBuffer(outQueuePost, 1, K2_MAX_TILE_S * dim_hc * sizeof(float));
        pipe_->InitBuffer(outQueueComb, 1, K2_MAX_TILE_S * dim_hc * dim_hc * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t tile_idx = 0; tile_idx < n_tiles; tile_idx++) {
            uint32_t cur_tile_s = (tile_idx == n_tiles - 1) ?
                (dim_bs - tile_idx * tile_s) : tile_s;
            uint32_t s_offset = tile_idx * tile_s;

            CopyIn(s_offset, cur_tile_s);
            Compute(cur_tile_s);
            CopyOut(s_offset, cur_tile_s);
        }
    }

private:
    // ----------------------------------------------------------------
    // CopyIn: Load x_flat, scale, base from GM
    // ----------------------------------------------------------------
    __aicore__ inline void CopyIn(uint32_t s_offset, uint32_t cur_s)
    {
        // x_flat: [cur_s, hc*d] bf16
        {
            LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
            DataCopyPad(xLocal,
                xGm[s_offset * dim_hcd],
                {1, static_cast<uint16_t>(cur_s * dim_hcd * sizeof(half)), 0, 0},
                {false, 0, 0, 0});
            inQueueX.EnQue(xLocal);
        }

        // scale: [3] fp32
        {
            LocalTensor<float> scaleLocal = inQueueScale.AllocTensor<float>();
            DataCopyPad(scaleLocal, scaleGm,
                {1, static_cast<uint16_t>(3 * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
            inQueueScale.EnQue(scaleLocal);
        }

        // base: [mix_hc] fp32
        {
            LocalTensor<float> baseLocal = inQueueBase.AllocTensor<float>();
            DataCopyPad(baseLocal, baseGm,
                {1, static_cast<uint16_t>(dim_mix * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
            inQueueBase.EnQue(baseLocal);
        }
    }

    // ----------------------------------------------------------------
    // Compute: Full hc_pre pipeline
    // ----------------------------------------------------------------
    __aicore__ inline void Compute(uint32_t cur_s)
    {
        LocalTensor<half> xLocal = inQueueX.DeQue<half>();
        LocalTensor<float> scaleLocal = inQueueScale.DeQue<float>();
        LocalTensor<float> baseLocal = inQueueBase.DeQue<float>();

        LocalTensor<float> xRow = xFp32RowBuf.AllocTensor<float>();
        LocalTensor<float> fnRow = fnRowBuf.AllocTensor<float>();
        LocalTensor<float> mixes = mixesBuf.AllocTensor<float>();
        LocalTensor<float> rsqrtVec = rsqrtBuf.AllocTensor<float>();
        LocalTensor<float> sigTmp = sigmoidTmp.AllocTensor<float>();
        LocalTensor<float> combRow = combRowBuf.AllocTensor<float>();
        LocalTensor<float> preOut = preBuf.AllocTensor<float>();
        LocalTensor<float> postOut = postBuf.AllocTensor<float>();
        LocalTensor<float> combOut = combBuf.AllocTensor<float>();

        float s0 = scaleLocal.GetValue(0);
        float s1 = scaleLocal.GetValue(1);
        float s2 = scaleLocal.GetValue(2);
        float eps = tiling->base.hc_eps;

        // Process each row
        for (uint32_t m = 0; m < cur_s; m++) {
            // -------------------------------------------
            // Step 1: Cast x_flat row to fp32 + compute sum_sq for RMSNorm
            // -------------------------------------------
            float sum_sq = 0.0f;
            for (uint32_t k = 0; k < dim_hcd; k++) {
                float xv = static_cast<float>(xLocal.GetValue(m * dim_hcd + k));
                xRow.SetValue(k, xv);
                sum_sq += xv * xv;
            }
            int hcd_int = (int)dim_hcd;
            float mean_sq = sum_sq / (float)hcd_int;
            rsqrtVec.SetValue(m, mean_sq + eps);

            // -------------------------------------------
            // Step 2: Linear projection mixes[m, n] = dot(x, fn[n]) * rsqrt
            // Load hc_fn row-by-row from GM to stay within UB budget
            // -------------------------------------------
            for (uint32_t n = 0; n < dim_mix; n++) {
                // Load one row of hc_fn from GM
                DataCopyPad(fnRow, hcFnGm[n * dim_hcd],
                    {1, static_cast<uint16_t>(dim_hcd * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                // Compute dot product
                float dot = 0.0f;
                for (uint32_t k = 0; k < dim_hcd; k++) {
                    float xv = xRow.GetValue(k);
                    float wv = fnRow.GetValue(k);
                    dot += xv * wv;
                }
                mixes.SetValue(m * dim_mix + n, dot);
            }
        }

        // -------------------------------------------
        // Step 2b: Apply rsqrt (vector operation)
        // -------------------------------------------
        AscendC::Rsqrt(rsqrtVec, rsqrtVec, cur_s);

        // Multiply mixes by rsqrt
        for (uint32_t m = 0; m < cur_s; m++) {
            float rv = rsqrtVec.GetValue(m);
            for (uint32_t n = 0; n < dim_mix; n++) {
                float old_val = mixes.GetValue(m * dim_mix + n);
                mixes.SetValue(m * dim_mix + n, old_val * rv);
            }
        }

        // -------------------------------------------
        // Step 3: Scale + Bias → pre, post, comb
        // -------------------------------------------
        for (uint32_t m = 0; m < cur_s; m++) {
            // pre: mixes[:, :hc] * s0 + base[:hc]
            for (uint32_t i = 0; i < dim_hc; i++) {
                float v = mixes.GetValue(m * dim_mix + i) * s0 + baseLocal.GetValue(i);
                sigTmp.SetValue(i, v);  // store for sigmoid
            }
            ComputeSigmoid(sigTmp, dim_hc);
            for (uint32_t i = 0; i < dim_hc; i++) {
                preOut.SetValue(m * dim_hc + i, sigTmp.GetValue(i) + eps);
            }

            // post: mixes[:, hc:2*hc] * s1 + base[hc:2*hc]
            for (uint32_t i = 0; i < dim_hc; i++) {
                float v = mixes.GetValue(m * dim_mix + dim_hc + i) * s1
                        + baseLocal.GetValue(dim_hc + i);
                sigTmp.SetValue(i, v);
            }
            ComputeSigmoid(sigTmp, dim_hc);
            for (uint32_t i = 0; i < dim_hc; i++) {
                postOut.SetValue(m * dim_hc + i, 2.0f * sigTmp.GetValue(i));
            }

            // comb: mixes[:, 2*hc:] * s2 + base[2*hc:] → reshape [hc, hc]
            for (uint32_t i = 0; i < dim_hc; i++) {
                for (uint32_t j = 0; j < dim_hc; j++) {
                    float v = mixes.GetValue(m * dim_mix + 2*dim_hc + i*dim_hc + j) * s2
                            + baseLocal.GetValue(2*dim_hc + i*dim_hc + j);
                    combRow.SetValue(i * dim_hc + j, v);
                }
            }

            // -------------------------------------------
            // Step 4: Sinkhorn Normalization on comb (uses sigTmp for Exp)
            // -------------------------------------------
            ComputeSinkhorn(combRow, sigTmp, dim_hc, tiling->base.hc_sinkhorn_iters, eps);

            // Store comb result
            for (uint32_t i = 0; i < dim_hc; i++) {
                for (uint32_t j = 0; j < dim_hc; j++) {
                    combOut.SetValue(m * dim_hc * dim_hc + i * dim_hc + j,
                                     combRow.GetValue(i * dim_hc + j));
                }
            }
        }

        // -------------------------------------------
        // Step 5: Weighted sum y[m, di] = sum_i pre[m,i] * x[m, i*d + di]
        // -------------------------------------------
        LocalTensor<half> yOutLocal = outQueueY.AllocTensor<half>();
        for (uint32_t m = 0; m < cur_s; m++) {
            for (uint32_t di = 0; di < dim_d; di++) {
                float acc = 0.0f;
                for (uint32_t i = 0; i < dim_hc; i++) {
                    float pv = preOut.GetValue(m * dim_hc + i);
                    float xv = static_cast<float>(xLocal.GetValue(m * dim_hcd + i * dim_d + di));
                    acc += pv * xv;
                }
                yOutLocal.SetValue(m * dim_d + di, static_cast<half>(acc));
            }
        }

        // Enqueue outputs
        outQueueY.EnQue<half>(yOutLocal);

        // Copy pre/post/comb to output buffers
        LocalTensor<float> preDst = outQueuePre.AllocTensor<float>();
        LocalTensor<float> postDst = outQueuePost.AllocTensor<float>();
        LocalTensor<float> combDst = outQueueComb.AllocTensor<float>();

        for (uint32_t m = 0; m < cur_s; m++) {
            for (uint32_t i = 0; i < dim_hc; i++) {
                preDst.SetValue(m * dim_hc + i, preOut.GetValue(m * dim_hc + i));
                postDst.SetValue(m * dim_hc + i, postOut.GetValue(m * dim_hc + i));
            }
            for (uint32_t i = 0; i < dim_hc; i++) {
                for (uint32_t j = 0; j < dim_hc; j++) {
                    combDst.SetValue(m * dim_hc * dim_hc + i * dim_hc + j,
                                     combOut.GetValue(m * dim_hc * dim_hc + i * dim_hc + j));
                }
            }
        }

        outQueuePre.EnQue<float>(preDst);
        outQueuePost.EnQue<float>(postDst);
        outQueueComb.EnQue<float>(combDst);

        // Free input tensors
        inQueueX.FreeTensor(xLocal);
        inQueueScale.FreeTensor(scaleLocal);
        inQueueBase.FreeTensor(baseLocal);
        xFp32RowBuf.FreeTensor(xRow);
        fnRowBuf.FreeTensor(fnRow);
        mixesBuf.FreeTensor(mixes);
        rsqrtBuf.FreeTensor(rsqrtVec);
        sigmoidTmp.FreeTensor(sigTmp);
        combRowBuf.FreeTensor(combRow);
        preBuf.FreeTensor(preOut);
        postBuf.FreeTensor(postOut);
        combBuf.FreeTensor(combOut);
    }

    // ----------------------------------------------------------------
    // CopyOut: Write y, pre, post, comb to GM
    // ----------------------------------------------------------------
    __aicore__ inline void CopyOut(uint32_t s_offset, uint32_t cur_s)
    {
        // y output [cur_s, d] bf16
        {
            LocalTensor<half> yLocal = outQueueY.DeQue<half>();
            DataCopyPad(yGm[s_offset * dim_d], yLocal,
                {1, static_cast<uint16_t>(cur_s * dim_d * sizeof(half)), 0, 0});
            outQueueY.FreeTensor(yLocal);
        }

        // pre output [cur_s, hc] fp32
        {
            LocalTensor<float> preLocal = outQueuePre.DeQue<float>();
            DataCopyPad(preGm[s_offset * dim_hc], preLocal,
                {1, static_cast<uint16_t>(cur_s * dim_hc * sizeof(float)), 0, 0});
            outQueuePre.FreeTensor(preLocal);
        }

        // post output [cur_s, hc] fp32
        {
            LocalTensor<float> postLocal = outQueuePost.DeQue<float>();
            DataCopyPad(postGm[s_offset * dim_hc], postLocal,
                {1, static_cast<uint16_t>(cur_s * dim_hc * sizeof(float)), 0, 0});
            outQueuePost.FreeTensor(postLocal);
        }

        // comb output [cur_s, hc, hc] fp32
        {
            LocalTensor<float> combLocal = outQueueComb.DeQue<float>();
            DataCopyPad(combGm[s_offset * dim_hc * dim_hc], combLocal,
                {1, static_cast<uint16_t>(cur_s * dim_hc * dim_hc * sizeof(float)), 0, 0});
            outQueueComb.FreeTensor(combLocal);
        }
    }

    // ----------------------------------------------------------------
    // Helper: Sigmoid using AscendC vector ops
    // sigmoid(x) = 1 / (1 + exp(-x))
    // Steps: negate → Exp → add 1 → reciprocal (computed scalar)
    // Input/Output in sigTmp[0..n-1]
    // ----------------------------------------------------------------
    __aicore__ inline void ComputeSigmoid(LocalTensor<float>& sigTmp, uint32_t n)
    {
        // sigTmp = -sigTmp
        AscendC::Muls(sigTmp, sigTmp, -1.0f, n);
        // sigTmp = exp(sigTmp)
        AscendC::Exp(sigTmp, sigTmp, n);
        // sigTmp = 1 / (1 + sigTmp)  (scalar reciprocal avoids missing AscendC::Recip)
        for (uint32_t i = 0; i < n; i++) {
            float ev = sigTmp.GetValue(i);
            sigTmp.SetValue(i, 1.0f / (1.0f + ev));
        }
    }

    // ----------------------------------------------------------------
    // Helper: Sinkhorn Normalization on comb matrix [hc, hc]
    // Steps:
    //   1. softmax along dim=-1 (row-wise) using AscendC::Exp
    //   2. Normalize along dim=-2 (col-wise)
    //   3. Repeat: row-norm → col-norm for (iters-1) times
    // Uses expTmp [H] as temporary for AscendC::Exp vector operation
    // ----------------------------------------------------------------
    __aicore__ inline void ComputeSinkhorn(
        LocalTensor<float>& comb, LocalTensor<float>& expTmp,
        uint32_t hc, uint32_t iters, float eps)
    {
        const uint32_t H = hc;

        // Step A: softmax along dim=-1 (row-wise) using AscendC::Exp
        for (uint32_t i = 0; i < H; i++) {
            float row_max = comb.GetValue(i * H);
            for (uint32_t j = 1; j < H; j++) {
                float v = comb.GetValue(i * H + j);
                if (v > row_max) row_max = v;
            }
            // Copy row to expTmp, subtract max, apply AscendC::Exp
            for (uint32_t j = 0; j < H; j++) {
                expTmp.SetValue(j, comb.GetValue(i * H + j) - row_max);
            }
            AscendC::Exp(expTmp, expTmp, H);
            float row_sum = 0.0f;
            for (uint32_t j = 0; j < H; j++) {
                float ev = expTmp.GetValue(j);
                comb.SetValue(i * H + j, ev);
                row_sum += ev;
            }
            float inv_sum = 1.0f / (row_sum + eps);
            for (uint32_t j = 0; j < H; j++) {
                comb.SetValue(i * H + j, comb.GetValue(i * H + j) * inv_sum + eps);
            }
        }

        // Step B: col-normalize (dim=-2)
        for (uint32_t j = 0; j < H; j++) {
            float col_sum = 0.0f;
            for (uint32_t i = 0; i < H; i++) {
                col_sum += comb.GetValue(i * H + j);
            }
            float inv_sum = 1.0f / (col_sum + eps);
            for (uint32_t i = 0; i < H; i++) {
                comb.SetValue(i * H + j, comb.GetValue(i * H + j) * inv_sum);
            }
        }

        // Step C: (row-norm → col-norm) × (iters-1)
        for (uint32_t iter = 1; iter < iters; iter++) {
            for (uint32_t i = 0; i < H; i++) {
                float row_sum = 0.0f;
                for (uint32_t j = 0; j < H; j++) {
                    row_sum += comb.GetValue(i * H + j);
                }
                float inv_sum = 1.0f / (row_sum + eps);
                for (uint32_t j = 0; j < H; j++) {
                    comb.SetValue(i * H + j, comb.GetValue(i * H + j) * inv_sum);
                }
            }
            for (uint32_t j = 0; j < H; j++) {
                float col_sum = 0.0f;
                for (uint32_t i = 0; i < H; i++) {
                    col_sum += comb.GetValue(i * H + j);
                }
                float inv_sum = 1.0f / (col_sum + eps);
                for (uint32_t i = 0; i < H; i++) {
                    comb.SetValue(i * H + j, comb.GetValue(i * H + j) * inv_sum);
                }
            }
        }
    }

private:
    TPipe* pipe_;
    const __gm__ K2HcPreTiling* tiling;

    GlobalTensor<half> xGm, yGm;
    GlobalTensor<float> hcFnGm, scaleGm, baseGm, preGm, postGm, combGm;

    TQue<TPosition::VECIN, 1> inQueueX;
    TQue<TPosition::VECIN, 1> inQueueScale;
    TQue<TPosition::VECIN, 1> inQueueBase;
    TQue<TPosition::VECIN, 1> xFp32RowBuf;
    TQue<TPosition::VECIN, 1> fnRowBuf;
    TQue<TPosition::VECIN, 1> mixesBuf;
    TQue<TPosition::VECIN, 1> rsqrtBuf;
    TQue<TPosition::VECIN, 1> sigmoidTmp;
    TQue<TPosition::VECIN, 1> combRowBuf;
    TQue<TPosition::VECIN, 1> preBuf;
    TQue<TPosition::VECIN, 1> postBuf;
    TQue<TPosition::VECIN, 1> combBuf;
    TQue<TPosition::VECOUT, 1> outQueueY;
    TQue<TPosition::VECOUT, 1> outQueuePre;
    TQue<TPosition::VECOUT, 1> outQueuePost;
    TQue<TPosition::VECOUT, 1> outQueueComb;

    uint32_t dim_bs, dim_hc, dim_d, dim_hcd, dim_mix;
    uint32_t tile_s, n_tiles;
};

extern "C" __global__ __vector__ void k2_hc_pre_kernel(
    GM_ADDR x, GM_ADDR hc_fn, GM_ADDR hc_scale, GM_ADDR hc_base,
    GM_ADDR y, GM_ADDR pre, GM_ADDR post, GM_ADDR comb, GM_ADDR tiling)
{
    TPipe pipe; KernelHcPre op(&pipe);
    op.Init(x, hc_fn, hc_scale, hc_base, y, pre, post, comb,
            (__gm__ K2HcPreTiling*)tiling);
    op.Process();
}
