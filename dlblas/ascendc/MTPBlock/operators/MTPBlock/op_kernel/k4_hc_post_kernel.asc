/**
 * MTPBlock K4: hc_post Kernel
 *
 * 数学: out = post * x (broadcast) + sum(comb * residual, hc_dim)
 *
 * 输入:
 *   x:        [b, s, d]       bf16
 *   residual: [b, s, hc, d]   bf16
 *   post:     [b, s, hc]      fp32
 *   comb:     [b, s, hc, hc]  fp32
 * 输出:
 *   out:      [b, s, hc, d]   bf16
 *
 * 策略:
 *   - s 维度分 tile (tile_s=8)
 *   - tile 内逐行计算 hc_post
 *   - fp32 中间精度, bf16 输出
 *   - 单核处理 (小 shape)
 */

#include "kernel_operator.h"
#include "mtpblock_tiling.h"

using namespace AscendC;

// ============================================================================
// UB Buffer 常量 (基于 UB=192KB 安全边界的最大 tile_s)
// ============================================================================
constexpr uint32_t K4_MAX_TILE_S = 8;    // s 维度 max tile 大小
constexpr uint32_t K4_HC = DEMO_HC;      // hc = 4
constexpr uint32_t K4_D = DEMO_D;        // d = 512
constexpr uint32_t K4_FP32_BYTES = 4;
constexpr uint32_t K4_FP16_BYTES = 2;

constexpr uint32_t K4_X_ELEMS      = K4_MAX_TILE_S * K4_D;           // 4096
constexpr uint32_t K4_RES_ELEMS    = K4_MAX_TILE_S * K4_HC * K4_D;   // 16384
constexpr uint32_t K4_OUT_ELEMS    = K4_MAX_TILE_S * K4_HC * K4_D;   // 16384
constexpr uint32_t K4_POST_ELEMS   = K4_MAX_TILE_S * K4_HC;          // 32
constexpr uint32_t K4_COMB_ELEMS   = K4_MAX_TILE_S * K4_HC * K4_HC;  // 128
constexpr uint32_t K4_TMP_FP32     = K4_HC * K4_D;                   // 2048 (per-row workspace)

// ============================================================================
// K4 hc_post Kernel 类
// ============================================================================
class KernelHcPost {
public:
    __aicore__ inline KernelHcPost(TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(
        GM_ADDR x_gm, GM_ADDR residual_gm, GM_ADDR post_gm,
        GM_ADDR comb_gm, GM_ADDR out_gm,
        const __gm__ K4HcPostTiling* tiling)
    {
        this->tiling = tiling;
        uint32_t s = tiling->base.s;
        uint32_t d = tiling->base.d;
        uint32_t hc = tiling->base.hc;

        total_s = s;
        dim_d = d;
        dim_hc = hc;

        // 初始化 GlobalTensor
        xGm.SetGlobalBuffer((__gm__ half*)x_gm, s * d);
        residualGm.SetGlobalBuffer((__gm__ half*)residual_gm, s * hc * d);
        postGm.SetGlobalBuffer((__gm__ float*)post_gm, s * hc);
        combGm.SetGlobalBuffer((__gm__ float*)comb_gm, s * hc * hc);
        outGm.SetGlobalBuffer((__gm__ half*)out_gm, s * hc * d);

        // 计算 tile 迭代次数 (运行时读取 tile_s，clamp 到编译期最大)
        tile_s = tiling->base.tile_s;
        if (tile_s == 0 || tile_s > K4_MAX_TILE_S) tile_s = K4_MAX_TILE_S;
        n_tiles = (s + tile_s - 1) / tile_s;

        // 初始化 UB Buffer
        pipe_->InitBuffer(inQueueX, DOUBLE_BUFFER, K4_X_ELEMS * sizeof(half));
        pipe_->InitBuffer(inQueueRes, DOUBLE_BUFFER, K4_RES_ELEMS * sizeof(half));
        pipe_->InitBuffer(inQueuePost, 1, K4_POST_ELEMS * sizeof(float));
        pipe_->InitBuffer(inQueueComb, 1, K4_COMB_ELEMS * sizeof(float));
        pipe_->InitBuffer(tmpQueueFP32, 1, K4_TMP_FP32 * sizeof(float));
        pipe_->InitBuffer(outQueue, DOUBLE_BUFFER, K4_OUT_ELEMS * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t tile_idx = 0; tile_idx < n_tiles; tile_idx++) {
            uint32_t cur_tile_s = (tile_idx == n_tiles - 1) ?
                (total_s - tile_idx * tile_s) : tile_s;
            uint32_t s_offset = tile_idx * tile_s;

            CopyIn(s_offset, cur_tile_s);
            Compute(cur_tile_s);
            CopyOut(s_offset, cur_tile_s);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t s_offset, uint32_t cur_s)
    {
        // x: [cur_s, d]
        {
            LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
            uint64_t x_gm_offset = s_offset * dim_d;
            DataCopyPad(xLocal,
                xGm[x_gm_offset],
                {1, static_cast<uint16_t>(cur_s * dim_d * sizeof(half)), 0, 0},
                {false, 0, 0, 0});
            inQueueX.EnQue(xLocal);
        }

        // residual: [cur_s, hc, d]
        {
            LocalTensor<half> resLocal = inQueueRes.AllocTensor<half>();
            uint64_t res_gm_offset = s_offset * dim_hc * dim_d;
            DataCopyPad(resLocal,
                residualGm[res_gm_offset],
                {1, static_cast<uint16_t>(cur_s * dim_hc * dim_d * sizeof(half)), 0, 0},
                {false, 0, 0, 0});
            inQueueRes.EnQue(resLocal);
        }

        // post: [cur_s, hc] fp32
        {
            LocalTensor<float> postLocal = inQueuePost.AllocTensor<float>();
            uint64_t post_gm_offset = s_offset * dim_hc;
            DataCopyPad(postLocal,
                postGm[post_gm_offset],
                {1, static_cast<uint16_t>(cur_s * dim_hc * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
            inQueuePost.EnQue(postLocal);
        }

        // comb: [cur_s, hc, hc] fp32
        {
            LocalTensor<float> combLocal = inQueueComb.AllocTensor<float>();
            uint64_t comb_gm_offset = s_offset * dim_hc * dim_hc;
            DataCopyPad(combLocal,
                combGm[comb_gm_offset],
                {1, static_cast<uint16_t>(cur_s * dim_hc * dim_hc * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
            inQueueComb.EnQue(combLocal);
        }
    }

    __aicore__ inline void Compute(uint32_t cur_s)
    {
        LocalTensor<half> xLocal = inQueueX.DeQue<half>();
        LocalTensor<half> resLocal = inQueueRes.DeQue<half>();
        LocalTensor<float> postLocal = inQueuePost.DeQue<float>();
        LocalTensor<float> combLocal = inQueueComb.DeQue<float>();
        LocalTensor<float> tmpFP32 = tmpQueueFP32.AllocTensor<float>();
        LocalTensor<half> outLocal = outQueue.AllocTensor<half>();

        // 逐 s 位置计算
        for (uint32_t si = 0; si < cur_s; si++) {
            uint32_t x_base    = si * dim_d;
            uint32_t res_base  = si * dim_hc * dim_d;
            uint32_t post_base = si * dim_hc;
            uint32_t comb_base = si * dim_hc * dim_hc;
            uint32_t out_base  = si * dim_hc * dim_d;

            // Step 1: post_term[hc, d] = post[hc] * x[d] (broadcast)
            // Cast x to fp32, then multiply by post
            // post * x broadcast: for each hc_i, multiply post[hc_i] with x[:]
            // We do this in a loop over hc_i
            for (uint32_t hc_i = 0; hc_i < dim_hc; hc_i++) {
                float post_val = postLocal.GetValue(post_base + hc_i);
                uint32_t out_row = out_base + hc_i * dim_d;
                uint32_t tmp_row = hc_i * dim_d;

                // post_term = post_val * x (elementwise)
                for (uint32_t di = 0; di < dim_d; di++) {
                    float x_val = static_cast<float>(xLocal.GetValue(x_base + di));
                    tmpFP32.SetValue(tmp_row + di, post_val * x_val);
                }
            }

            // Step 2: comb_term[hc, d] = sum_j comb[hc_i, hc_j] * residual[hc_j, d]
            for (uint32_t hc_i = 0; hc_i < dim_hc; hc_i++) {
                uint32_t out_row = out_base + hc_i * dim_d;
                uint32_t tmp_row = hc_i * dim_d;

                for (uint32_t hc_j = 0; hc_j < dim_hc; hc_j++) {
                    // comb[j, i] for comb[j,i] * residual[i,:]:
                    //   out[i,:] = post[i]*x + sum_j comb[j,i] * residual[i,:]
                    float comb_val = combLocal.GetValue(comb_base + hc_j * dim_hc + hc_i);

                    for (uint32_t di = 0; di < dim_d; di++) {
                        // residual at output index hc_i, feature di
                        float res_val = static_cast<float>(resLocal.GetValue(res_base + hc_i * dim_d + di));
                        float cur = tmpFP32.GetValue(tmp_row + di);
                        tmpFP32.SetValue(tmp_row + di, cur + comb_val * res_val);
                    }
                }

                // Step 3: out[hc_i, :] = fp32 → bf16 (post_term already accumulated)
                for (uint32_t di = 0; di < dim_d; di++) {
                    float val = tmpFP32.GetValue(tmp_row + di);
                    outLocal.SetValue(out_row + di, static_cast<half>(val));
                }
            }
        }

        outQueue.EnQue<half>(outLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueRes.FreeTensor(resLocal);
        inQueuePost.FreeTensor(postLocal);
        inQueueComb.FreeTensor(combLocal);
        tmpQueueFP32.FreeTensor(tmpFP32);
    }

    __aicore__ inline void CopyOut(uint32_t s_offset, uint32_t cur_s)
    {
        LocalTensor<half> outLocal = outQueue.DeQue<half>();
        uint64_t out_gm_offset = s_offset * dim_hc * dim_d;
        DataCopyPad(
            outGm[out_gm_offset], outLocal,
            {1, static_cast<uint16_t>(cur_s * dim_hc * dim_d * sizeof(half)), 0, 0});
        outQueue.FreeTensor(outLocal);
    }

private:
    TPipe* pipe_;
    const __gm__ K4HcPostTiling* tiling;

    GlobalTensor<half> xGm;
    GlobalTensor<half> residualGm;
    GlobalTensor<float> postGm;
    GlobalTensor<float> combGm;
    GlobalTensor<half> outGm;

    TQue<TPosition::VECIN, 1> inQueueX;
    TQue<TPosition::VECIN, 1> inQueueRes;
    TQue<TPosition::VECIN, 1> inQueuePost;
    TQue<TPosition::VECIN, 1> inQueueComb;
    TQue<TPosition::VECOUT, 1> outQueue;
    TQue<TPosition::VECIN, 1> tmpQueueFP32;

    uint32_t total_s;
    uint32_t dim_d;
    uint32_t dim_hc;
    uint32_t tile_s;
    uint32_t n_tiles;
};

// ============================================================================
// 核函数入口
// ============================================================================
extern "C" __global__ __vector__ void k4_hc_post_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR post, GM_ADDR comb, GM_ADDR out, GM_ADDR tiling)
{
    TPipe pipe;
    KernelHcPost op(&pipe);
    op.Init(x, residual, post, comb, out, (__gm__ K4HcPostTiling*)tiling);
    op.Process();
}
