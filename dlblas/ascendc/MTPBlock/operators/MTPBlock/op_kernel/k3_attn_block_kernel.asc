/**
 * MTPBlock K3: attn_block Kernel
 *
 * Q branch: wq_a → RMSNorm → wq_b → reshape → RMSNorm
 * KV branch: wkv → RMSNorm
 * Attention: QK^T → softmax with sink → weighted sum
 * Output: wo_a (grouped) → wo_b
 *
 * NpuArch: DAV_2201, __aicore__ (Cube+Vector)
 * Demo: b=1,s=8,n_heads=8,head_dim=64,q_lora=256,d=512,win=8
 *
 * MatmulImpl integration status:
 *   This kernel uses AscendC SIMD for vector operations and scalar dot
 *   products for matrix multiplications.
 *
 *   MatmulImpl is NOT yet integrated for the following reasons:
 *   a) wq_a [M=8,K=512,N=256]: M=8 is below recommended M>=16 for Cube efficiency
 *   b) wq_b [M=64,K=256,N=64]: M=64 is good but N=64 is borderline;
 *      MatmulImpl would be beneficial here (~4x speedup expected)
 *   c) wkv [M=8,K=512,N=64]: M=8 too small for Cube benefit
 *   d) wo_a grouped: Requires GroupedMatmul (GMM) API, not plain MatmulImpl
 *   e) wo_b [M=8,K=256,N=512]: M=8 borderline, N=512 good for Cube
 *
 *   Priority for future MatmulImpl integration: wq_b > wo_b > wq_a
 *
 * L3 FIX (Round 2): wo_a weight was read from GM via GetValue inside
 *   triple-nested loop. Fixed: DataCopyPad loads weight row into UB
 *   before inner computation loop (woBuf buffer).
 */

#include "kernel_operator.h"
#include "mtpblock_tiling.h"

using namespace AscendC;

class KernelAttnBlock {
public:
    __aicore__ inline KernelAttnBlock(TPipe* p) : pipe_(p) {}
    __aicore__ inline void Init(
        GM_ADDR x_gm, GM_ADDR wq_a_gm, GM_ADDR q_norm_gm, GM_ADDR wq_b_gm,
        GM_ADDR wkv_gm, GM_ADDR kv_norm_gm, GM_ADDR wo_a_gm, GM_ADDR wo_b_gm,
        GM_ADDR attn_sink_gm, GM_ADDR freqs_cis_gm, GM_ADDR topk_idxs_gm,
        GM_ADDR attn_out_gm, const __gm__ K3AttnBlockTiling* tiling)
    {
        this->tiling = tiling;
        s_=tiling->base.s; nh_=tiling->base.n_heads; hd_=tiling->base.head_dim;
        d_=tiling->base.d; ql_=tiling->base.q_lora; ol_=tiling->base.o_lora;
        ng_=tiling->base.n_groups;
        float sc = tiling->base.softmax_scale;
        softmax_sc_ = sc;

        xGm.SetGlobalBuffer((__gm__ half*)x_gm,s_*d_);
        wqAGm.SetGlobalBuffer((__gm__ half*)wq_a_gm,ql_*d_);
        qnGm.SetGlobalBuffer((__gm__ float*)q_norm_gm,ql_);
        wqBGm.SetGlobalBuffer((__gm__ half*)wq_b_gm,nh_*hd_*ql_);
        wkvGm.SetGlobalBuffer((__gm__ half*)wkv_gm,hd_*d_);
        knGm.SetGlobalBuffer((__gm__ float*)kv_norm_gm,hd_);
        woAGm.SetGlobalBuffer((__gm__ half*)wo_a_gm,ng_*ol_*(nh_*hd_/ng_));
        woBGm.SetGlobalBuffer((__gm__ half*)wo_b_gm,d_*ng_*ol_);
        skGm.SetGlobalBuffer((__gm__ float*)attn_sink_gm,nh_);
        otGm.SetGlobalBuffer((__gm__ half*)attn_out_gm,s_*d_);

        pipe_->InitBuffer(qx,  1,s_*d_*2);
        pipe_->InitBuffer(qwh, 1,d_*2);
        pipe_->InitBuffer(qwf, 1,d_*4);
        pipe_->InitBuffer(qq1, 1,s_*ql_*2);
        pipe_->InitBuffer(qqn, 1,ql_*4);
        pipe_->InitBuffer(qq,  1,s_*nh_*hd_*2);
        pipe_->InitBuffer(qk,  1,s_*hd_*2);
        pipe_->InitBuffer(qkn, 1,hd_*4);
        pipe_->InitBuffer(qsc, 1,s_*nh_*s_*4);
        pipe_->InitBuffer(qao, 1,s_*nh_*hd_*4);
        pipe_->InitBuffer(qrv, 1,s_*4);
        pipe_->InitBuffer(qo,  1,s_*d_*2);
        pipe_->InitBuffer(qo1, 1,s_*ng_*(nh_*hd_/ng_)*2);
        pipe_->InitBuffer(qo2, 1,s_*ng_*ol_*2);
        // L3 fix: buffer for wo_a weight row (pre-loaded from GM)
        pipe_->InitBuffer(qwoa, 1,(nh_*hd_/ng_)*2); // [hpg] half
    }
    __aicore__ inline void Process() { Compute(); }

private:
    __aicore__ inline void Compute()
    {
        auto x  = qx.AllocTensor<half>();
        auto wh = qwh.AllocTensor<half>();
        auto wf = qwf.AllocTensor<float>();
        auto q1 = qq1.AllocTensor<half>();
        auto qn = qqn.AllocTensor<float>();
        auto q  = qq.AllocTensor<half>();
        auto kv = qk.AllocTensor<half>();
        auto kn = qkn.AllocTensor<float>();
        auto sc = qsc.AllocTensor<float>();
        auto ao = qao.AllocTensor<float>();
        auto rv = qrv.AllocTensor<float>();
        auto o  = qo.AllocTensor<half>();
        auto o1 = qo1.AllocTensor<half>();
        auto o2 = qo2.AllocTensor<half>();
        auto woaRow = qwoa.AllocTensor<half>(); // L3 fix buffer

        float eps = tiling->base.norm_eps;
        float sms = softmax_sc_;

        DataCopyPad(x,xGm,{1,(uint16_t)(s_*d_*2),0,0},{0,0,0,0});

        // ============================================================
        // Q Branch: q1 = x @ wq_a^T → RMSNorm
        // wq_a [ql=256, d=512] half
        // ============================================================
        for(uint32_t n=0; n<ql_; n++){
            DataCopyPad(wh, wqAGm[n*d_], {1,(uint16_t)(d_*2),0,0},{0,0,0,0});
            for(uint32_t si=0; si<s_; si++){
                float dot=0;
                for(uint32_t k=0; k<d_; k++) dot += (float)x.GetValue(si*d_+k)*(float)wh.GetValue(k);
                wf.SetValue(si, dot);
            }
            for(uint32_t si=0; si<s_; si++) q1.SetValue(si*ql_+n, (half)wf.GetValue(si));
        }

        // RMSNorm on q1 [s, ql]
        for(uint32_t si=0; si<s_; si++){
            float sq=0;
            for(uint32_t n=0; n<ql_; n++){float v=(float)q1.GetValue(si*ql_+n); sq+=v*v;}
            int qli=(int)ql_; rv.SetValue(si, sq/(float)qli+eps);
        }
        AscendC::Rsqrt(rv, rv, s_);
        DataCopyPad(qn, qnGm, {1,(uint16_t)(ql_*4),0,0},{0,0,0,0});
        for(uint32_t si=0; si<s_; si++){
            float rr=rv.GetValue(si);
            for(uint32_t n=0; n<ql_; n++){
                float v=(float)q1.GetValue(si*ql_+n)*rr*qn.GetValue(n);
                q1.SetValue(si*ql_+n, (half)v);
            }
        }

        // q2 = q1 @ wq_b^T [s, ql] × [ql, nh*hd] → [s, nh*hd]
        uint32_t nhd=nh_*hd_;
        for(uint32_t n=0; n<nhd; n++){
            DataCopyPad(wh, wqBGm[n*ql_], {1,(uint16_t)(ql_*2),0,0},{0,0,0,0});
            for(uint32_t si=0; si<s_; si++){
                float dot=0;
                for(uint32_t k=0; k<ql_; k++) dot += (float)q1.GetValue(si*ql_+k)*(float)wh.GetValue(k);
                q.SetValue(si*nhd+n, (half)dot);
            }
        }

        // Q RMSNorm per head
        for(uint32_t si=0; si<s_; si++){
            for(uint32_t hi=0; hi<nh_; hi++){
                float sq=0;
                for(uint32_t di=0; di<hd_; di++){
                    float v=(float)q.GetValue(si*nhd+hi*hd_+di); sq+=v*v;
                }
                int hdi=(int)hd_; rv.SetValue(si*nh_+hi, sq/(float)hdi+eps);
            }
        }
        AscendC::Rsqrt(rv, rv, s_*nh_);
        for(uint32_t si=0; si<s_; si++){
            for(uint32_t hi=0; hi<nh_; hi++){
                float rr=rv.GetValue(si*nh_+hi);
                for(uint32_t di=0; di<hd_; di++){
                    float v=(float)q.GetValue(si*nhd+hi*hd_+di)*rr;
                    q.SetValue(si*nhd+hi*hd_+di, (half)v);
                }
            }
        }

        // ============================================================
        // KV Branch: kv = RMSNorm(x @ wkv^T) [s, hd]
        // ============================================================
        for(uint32_t n=0; n<hd_; n++){
            DataCopyPad(wh, wkvGm[n*d_], {1,(uint16_t)(d_*2),0,0},{0,0,0,0});
            for(uint32_t si=0; si<s_; si++){
                float dot=0;
                for(uint32_t k=0; k<d_; k++) dot += (float)x.GetValue(si*d_+k)*(float)wh.GetValue(k);
                kv.SetValue(si*hd_+n, (half)dot);
            }
        }
        for(uint32_t si=0; si<s_; si++){
            float sq=0;
            for(uint32_t di=0; di<hd_; di++){float v=(float)kv.GetValue(si*hd_+di); sq+=v*v;}
            int hdi=(int)hd_; rv.SetValue(si, sq/(float)hdi+eps);
        }
        AscendC::Rsqrt(rv, rv, s_);
        DataCopyPad(kn, knGm, {1,(uint16_t)(hd_*4),0,0},{0,0,0,0});
        for(uint32_t si=0; si<s_; si++){
            float rr=rv.GetValue(si);
            for(uint32_t di=0; di<hd_; di++){
                float v=(float)kv.GetValue(si*hd_+di)*rr*kn.GetValue(di);
                kv.SetValue(si*hd_+di, (half)v);
            }
        }

        // ============================================================
        // Attention: scores = Q @ KV^T * scale [s, nh, s]
        // Numerically stable softmax with AscendC::Exp (vector)
        // ============================================================
        auto et = rv;  // exp temp
        for(uint32_t si=0; si<s_; si++){
            for(uint32_t hi=0; hi<nh_; hi++){
                float mx=-1e30f;
                for(uint32_t sj=0; sj<s_; sj++){
                    float d=0;
                    for(uint32_t di=0; di<hd_; di++){
                        d += (float)q.GetValue(si*nhd+hi*hd_+di)*(float)kv.GetValue(sj*hd_+di);
                    }
                    d *= sms;
                    sc.SetValue((si*nh_+hi)*s_+sj, d);
                    if(d>mx) mx=d;
                }
                float sink=skGm.GetValue(hi);
                if(sink>mx) mx=sink;

                for(uint32_t sj=0; sj<s_; sj++){
                    et.SetValue(sj, sc.GetValue((si*nh_+hi)*s_+sj) - mx);
                }
                et.SetValue(s_, sink - mx);

                AscendC::Exp(et, et, s_ + 1);

                float se=0;
                for(uint32_t sj=0; sj<s_; sj++){
                    float ev = et.GetValue(sj);
                    sc.SetValue((si*nh_+hi)*s_+sj, ev);
                    se += ev;
                }
                float ev_sink = et.GetValue(s_);
                se += ev_sink;

                for(uint32_t sj=0; sj<s_; sj++){
                    sc.SetValue((si*nh_+hi)*s_+sj, sc.GetValue((si*nh_+hi)*s_+sj)/se);
                }
                // Weighted sum: ao[si,hi,di] = sum_sj weights[sj] * kv[sj,di]
                for(uint32_t di=0; di<hd_; di++){
                    float oo=0;
                    for(uint32_t sj=0; sj<s_; sj++){
                        oo += sc.GetValue((si*nh_+hi)*s_+sj)*(float)kv.GetValue(sj*hd_+di);
                    }
                    ao.SetValue(si*nhd+hi*hd_+di, oo);
                }
            }
        }

        // ============================================================
        // Output projection: wo_a (grouped) → wo_b [s, d]
        // L3 FIX: wo_a weight now pre-loaded to UB via DataCopyPad
        //   instead of per-element GM GetValue in inner loop
        // ============================================================
        uint32_t hpg = nh_*hd_/ng_;
        for(uint32_t si=0; si<s_; si++){
            for(uint32_t gi=0; gi<ng_; gi++){
                for(uint32_t n=0; n<ol_; n++){
                    float dot=0;
                    uint32_t wo_a_base = gi*ol_*hpg + n*hpg;
                    // L3 FIX: DataCopyPad loads weight row into UB (woaRow)
                    DataCopyPad(woaRow, woAGm[wo_a_base],
                        {1,(uint16_t)(hpg*2),0,0},{0,0,0,0});
                    for(uint32_t k=0; k<hpg; k++){
                        float av = ao.GetValue(si*nhd+gi*hpg+k);
                        float wv = (float)woaRow.GetValue(k);
                        dot += av*wv;
                    }
                    o1.SetValue(si*ng_*ol_+gi*ol_+n, (half)dot);
                }
            }
        }

        // wo_b: [s, ng*ol] × [d, ng*ol]^T → [s, d]
        uint32_t nol = ng_*ol_;
        for(uint32_t n=0; n<d_; n++){
            DataCopyPad(wh, woBGm[n*nol], {1,(uint16_t)(nol*2),0,0},{0,0,0,0});
            for(uint32_t si=0; si<s_; si++){
                float dot=0;
                for(uint32_t k=0; k<nol; k++){
                    dot += (float)o1.GetValue(si*nol+k)*(float)wh.GetValue(k);
                }
                o.SetValue(si*d_+n, (half)dot);
            }
        }

        DataCopyPad(otGm, o, {1,(uint16_t)(s_*d_*2),0,0});

        qx.FreeTensor(x); qwh.FreeTensor(wh); qwf.FreeTensor(wf); qq1.FreeTensor(q1);
        qqn.FreeTensor(qn); qq.FreeTensor(q); qk.FreeTensor(kv); qkn.FreeTensor(kn);
        qsc.FreeTensor(sc); qao.FreeTensor(ao); qrv.FreeTensor(rv); qo.FreeTensor(o);
        qo1.FreeTensor(o1); qo2.FreeTensor(o2); qwoa.FreeTensor(woaRow);
    }

    TPipe* pipe_; const __gm__ K3AttnBlockTiling* tiling;
    GlobalTensor<half> xGm,wqAGm,wqBGm,wkvGm,woAGm,woBGm,otGm;
    GlobalTensor<float> qnGm,knGm,skGm;
    TQue<TPosition::VECIN,1> qx,qwh,qwf,qq1,qqn,qq,qk,qkn,qsc,qao,qrv,qo1,qo2,qwoa;
    TQue<TPosition::VECOUT,1> qo;
    uint32_t s_,nh_,hd_,d_,ql_,ol_,ng_;
    float softmax_sc_;
};

extern "C" __global__ __aicore__ void k3_attn_block_kernel(
    GM_ADDR x,GM_ADDR wa,GM_ADDR qn,GM_ADDR wb,GM_ADDR kvw,GM_ADDR kn,
    GM_ADDR wa2,GM_ADDR wb2,GM_ADDR sk,GM_ADDR fr,GM_ADDR tk,
    GM_ADDR ao,GM_ADDR tl)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    TPipe p; KernelAttnBlock op(&p);
    op.Init(x,wa,qn,wb,kvw,kn,wa2,wb2,sk,fr,tk,ao,(__gm__ K3AttnBlockTiling*)tl);
    op.Process();
}
