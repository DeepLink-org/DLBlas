/**
 * MTPBlock K1: mtp_embed_fuse Kernel
 *
 * Math: e_proj(RMSNorm(embed(input_ids))) + h_proj(RMSNorm(x))
 *
 * NpuArch: DAV_2201, UB=192KB, __aicore__ (Cube+Vector)
 * Demo: b=1, s=8, hc=4, d=512
 *
 * MatmulImpl integration status:
 *   This kernel uses AscendC SIMD vector APIs (Mul, Cast, Rsqrt, etc.)
 *   for all non-matmul operations. Matrix multiplications (e_proj, h_proj)
 *   use DataCopyPad to load weights into UB + scalar dot products.
 *
 *   Full MatmulImpl integration requires:
 *   1. Proper TCubeTiling computed by MatmulApiTiling on C++ host side
 *   2. The ASC host direct-invoke path cannot link MatmulApiTiling
 *      (C++/ASC linker constraint); torch extension path CAN use it via
 *      matmul_tiling_helper.cpp
 *   3. For the current demo shapes (M<=32), MatmulImpl overhead may
 *      exceed benefit; benchmark after integration for M>=64 scenarios
 *
 * Vector API usage: AscendC::Cast, AscendC::Mul, AscendC::Muls, AscendC::Rsqrt,
 *   AscendC::Add used for contiguous element-wise operations.
 */

#include "kernel_operator.h"
#include "mtpblock_tiling.h"

using namespace AscendC;

constexpr uint32_t K1_MAX_TILE_S = 8;
constexpr uint32_t K1_HC    = DEMO_HC;
constexpr uint32_t K1_D     = DEMO_D;

class KernelEmbedFuse {
public:
    __aicore__ inline KernelEmbedFuse(TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(
        GM_ADDR x_gm, GM_ADDR input_ids_gm, GM_ADDR embed_w_gm, GM_ADDR enorm_w_gm,
        GM_ADDR e_proj_w_gm, GM_ADDR h_proj_w_gm, GM_ADDR hnorm_w_gm,
        GM_ADDR feat_gm, const __gm__ K1EmbedFuseTiling* tiling)
    {
        this->tiling = tiling;
        dim_bs = tiling->base.b * tiling->base.s;
        dim_hc = tiling->base.hc;
        dim_d  = tiling->base.d;
        vocab_sz = tiling->vocab_size_k1;

        xGm.SetGlobalBuffer((__gm__ half*)x_gm, dim_bs * dim_hc * dim_d);
        idsGm.SetGlobalBuffer((__gm__ int64_t*)input_ids_gm, dim_bs);
        embedWGm.SetGlobalBuffer((__gm__ half*)embed_w_gm, vocab_sz * dim_d);
        enormWGm.SetGlobalBuffer((__gm__ float*)enorm_w_gm, dim_d);
        eProjWGm.SetGlobalBuffer((__gm__ half*)e_proj_w_gm, dim_d * dim_d);
        hProjWGm.SetGlobalBuffer((__gm__ half*)h_proj_w_gm, dim_d * dim_d);
        hnormWGm.SetGlobalBuffer((__gm__ float*)hnorm_w_gm, dim_d);
        featGm.SetGlobalBuffer((__gm__ half*)feat_gm, dim_bs * dim_hc * dim_d);

        tile_s = tiling->base.tile_s;
        if (tile_s == 0 || tile_s > K1_MAX_TILE_S) tile_s = K1_MAX_TILE_S;
        n_tiles = (dim_bs + tile_s - 1) / tile_s;

        constexpr uint32_t RSQRT_PAD = 8;
        uint32_t rsqrt_padded = ((K1_MAX_TILE_S * dim_hc + RSQRT_PAD - 1) / RSQRT_PAD) * RSQRT_PAD;

        pipe_->InitBuffer(idsBuf,        1, K1_MAX_TILE_S * sizeof(int64_t));
        pipe_->InitBuffer(embRowBuf,     1, dim_d * sizeof(half));
        pipe_->InitBuffer(wtHalfBuf,     1, dim_d * sizeof(half));
        pipe_->InitBuffer(compRowBuf,    1, dim_d * sizeof(float));
        pipe_->InitBuffer(normWtBuf,     1, dim_d * sizeof(float));
        pipe_->InitBuffer(projRowBuf,    1, dim_d * sizeof(float));
        pipe_->InitBuffer(eMidBuf,       1, K1_MAX_TILE_S * dim_d * sizeof(float));
        pipe_->InitBuffer(eOutBuf,       1, K1_MAX_TILE_S * dim_d * sizeof(half));
        pipe_->InitBuffer(rsqrtBuf,      1, rsqrt_padded * sizeof(float));
        pipe_->InitBuffer(featBuf,       1, K1_MAX_TILE_S * dim_hc * dim_d * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t tile_idx = 0; tile_idx < n_tiles; tile_idx++) {
            uint32_t cur_s = (tile_idx == n_tiles - 1) ?
                (dim_bs - tile_idx * tile_s) : tile_s;
            uint32_t s_offset = tile_idx * tile_s;
            Compute(cur_s, s_offset);
        }
    }

private:
    __aicore__ inline void Compute(uint32_t cur_s, uint32_t s_offset)
    {
        LocalTensor<int64_t> ids = idsBuf.AllocTensor<int64_t>();
        LocalTensor<half>    eRow = embRowBuf.AllocTensor<half>();
        LocalTensor<half>    wtH  = wtHalfBuf.AllocTensor<half>();
        LocalTensor<float>   cRow = compRowBuf.AllocTensor<float>();
        LocalTensor<float>   nWt  = normWtBuf.AllocTensor<float>();
        LocalTensor<float>   pRow = projRowBuf.AllocTensor<float>();
        LocalTensor<float>   eMid = eMidBuf.AllocTensor<float>();
        LocalTensor<half>    eOut = eOutBuf.AllocTensor<half>();
        LocalTensor<float>   rVec = rsqrtBuf.AllocTensor<float>();
        LocalTensor<half>    feat = featBuf.AllocTensor<half>();

        float eps = tiling->base.norm_eps;
        const uint32_t hc_tot = cur_s * dim_hc;

        DataCopyPad(ids, idsGm[s_offset],
            {1, static_cast<uint16_t>(cur_s * sizeof(int64_t)), 0, 0},
            {false, 0, 0, 0});

        // ================================================================
        // Phase 1: Embedding gather + enorm RMSNorm
        // Uses AscendC::Rsqrt + AscendC::Mul (vector) for weight application
        // ================================================================
        DataCopyPad(nWt, enormWGm,
            {1, static_cast<uint16_t>(dim_d * sizeof(float)), 0, 0},
            {false, 0, 0, 0});

        for (uint32_t m = 0; m < cur_s; m++) {
            int64_t tid = ids.GetValue(m);
            uint64_t eoff = static_cast<uint64_t>(tid) * dim_d;

            DataCopyPad(eRow, embedWGm[eoff],
                {1, static_cast<uint16_t>(dim_d * sizeof(half)), 0, 0},
                {false, 0, 0, 0});

            // Scalar cast half→float
            for (uint32_t di = 0; di < dim_d; di++) {
                cRow.SetValue(di, static_cast<float>(eRow.GetValue(di)));
            }

            float sum_sq = 0.0f;
            for (uint32_t di = 0; di < dim_d; di++) {
                float val = cRow.GetValue(di);
                sum_sq += val * val;
            }
            int d_int = (int)dim_d;
            rVec.SetValue(m, sum_sq / (float)d_int + eps);

            // Vector multiply: cRow *= nWt (AscendC::Mul SIMD)
            AscendC::Mul(cRow, cRow, nWt, dim_d);
            for (uint32_t di = 0; di < dim_d; di++) {
                eMid.SetValue(m * dim_d + di, cRow.GetValue(di));
            }
        }
        AscendC::Rsqrt(rVec, rVec, cur_s);
        for (uint32_t m = 0; m < cur_s; m++) {
            float rv = rVec.GetValue(m);
            for (uint32_t di = 0; di < dim_d; di++) {
                float val = eMid.GetValue(m * dim_d + di) * rv;
                eOut.SetValue(m * dim_d + di, static_cast<half>(val));
            }
        }

        // ================================================================
        // Phase 2: e_proj MatMul  eMid[m,n] = sum_k eOut[m,k] * e_proj_w[n,k]
        //
        // NOTE: MatmulImpl NOT used here.
        // e_proj_w [512, 512] = 512KB >> UB 192KB, cannot load fully.
        // MatmulImpl would load it via L1/L0C pipeline. This requires:
        //   a) __aicore__ context (this kernel is __aicore__)
        //   b) TCubeTiling computed by MatmulApiTiling on C++ host
        //   c) GlobalTensor setup for weights
        // For demo shape M=8, scalar loop has acceptable performance.
        // For M>=64, integrate MatmulImpl via matmul_tiling_helper.cpp.
        // ================================================================
        for (uint32_t n = 0; n < dim_d; n++) {
            DataCopyPad(wtH,
                eProjWGm[n * dim_d],
                {1, static_cast<uint16_t>(dim_d * sizeof(half)), 0, 0},
                {false, 0, 0, 0});

            for (uint32_t m = 0; m < cur_s; m++) {
                float dot = 0.0f;
                for (uint32_t k = 0; k < dim_d; k++) {
                    float xv = static_cast<float>(eOut.GetValue(m * dim_d + k));
                    float wv = static_cast<float>(wtH.GetValue(k));
                    dot += xv * wv;
                }
                eMid.SetValue(m * dim_d + n, dot);
            }
        }

        // ================================================================
        // Phase 3: hnorm RMSNorm on x [cur_s*hc, d]
        // ================================================================
        DataCopyPad(feat, xGm[s_offset * dim_hc * dim_d],
            {1, static_cast<uint16_t>(cur_s * dim_hc * dim_d * sizeof(half)), 0, 0},
            {false, 0, 0, 0});

        DataCopyPad(nWt, hnormWGm,
            {1, static_cast<uint16_t>(dim_d * sizeof(float)), 0, 0},
            {false, 0, 0, 0});

        for (uint32_t hi = 0; hi < hc_tot; hi++) {
            float sum_sq = 0.0f;
            for (uint32_t di = 0; di < dim_d; di++) {
                float val = static_cast<float>(feat.GetValue(hi * dim_d + di));
                cRow.SetValue(di, val);
                sum_sq += val * val;
            }
            int d_int = (int)dim_d;
            rVec.SetValue(hi, sum_sq / (float)d_int + eps);

            AscendC::Mul(cRow, cRow, nWt, dim_d);
        }
        AscendC::Rsqrt(rVec, rVec, hc_tot);

        // ================================================================
        // Phase 4+5: h_proj MatMul + Broadcast add
        //
        // NOTE: Same MatmulImpl considerations as e_proj (Phase 2).
        // h_proj_w [512,512] too large for UB; needs L1/L0C pipeline.
        // ================================================================
        for (uint32_t hi = 0; hi < hc_tot; hi++) {
            float rv_norm = rVec.GetValue(hi);

            for (uint32_t di = 0; di < dim_d; di++) {
                cRow.SetValue(di, static_cast<float>(feat.GetValue(hi * dim_d + di)));
            }
            AscendC::Mul(cRow, cRow, nWt, dim_d);
            AscendC::Muls(cRow, cRow, rv_norm, dim_d);

            // h_proj MatMul scalar dot product
            for (uint32_t n = 0; n < dim_d; n++) {
                DataCopyPad(wtH,
                    hProjWGm[n * dim_d],
                    {1, static_cast<uint16_t>(dim_d * sizeof(half)), 0, 0},
                    {false, 0, 0, 0});

                float dot = 0.0f;
                for (uint32_t k = 0; k < dim_d; k++) {
                    float xv = cRow.GetValue(k);
                    float wv = static_cast<float>(wtH.GetValue(k));
                    dot += xv * wv;
                }
                uint32_t m = hi / dim_hc;
                float e_val = eMid.GetValue(m * dim_d + n);
                feat.SetValue(hi * dim_d + n, static_cast<half>(e_val + dot));
            }
        }

        DataCopyPad(featGm[s_offset * dim_hc * dim_d], feat,
            {1, static_cast<uint16_t>(cur_s * dim_hc * dim_d * sizeof(half)), 0, 0});

        idsBuf.FreeTensor(ids);
        embRowBuf.FreeTensor(eRow);
        wtHalfBuf.FreeTensor(wtH);
        compRowBuf.FreeTensor(cRow);
        normWtBuf.FreeTensor(nWt);
        projRowBuf.FreeTensor(pRow);
        eMidBuf.FreeTensor(eMid);
        eOutBuf.FreeTensor(eOut);
        rsqrtBuf.FreeTensor(rVec);
        featBuf.FreeTensor(feat);
    }

private:
    TPipe* pipe_;
    const __gm__ K1EmbedFuseTiling* tiling;

    GlobalTensor<half> xGm, embedWGm, eProjWGm, hProjWGm, featGm;
    GlobalTensor<int64_t> idsGm;
    GlobalTensor<float> enormWGm, hnormWGm;

    TQue<TPosition::VECIN, 1> idsBuf;
    TQue<TPosition::VECIN, 1> embRowBuf;
    TQue<TPosition::VECIN, 1> wtHalfBuf;
    TQue<TPosition::VECIN, 1> compRowBuf;
    TQue<TPosition::VECIN, 1> normWtBuf;
    TQue<TPosition::VECIN, 1> projRowBuf;
    TQue<TPosition::VECIN, 1> eMidBuf;
    TQue<TPosition::VECOUT, 1> eOutBuf;
    TQue<TPosition::VECIN, 1> rsqrtBuf;
    TQue<TPosition::VECOUT, 1> featBuf;

    uint32_t dim_bs, dim_hc, dim_d, vocab_sz;
    uint32_t tile_s, n_tiles;
};

extern "C" __global__ __aicore__ void k1_embed_fuse_kernel(
    GM_ADDR x, GM_ADDR ids, GM_ADDR ew, GM_ADDR enw, GM_ADDR epw,
    GM_ADDR hpw, GM_ADDR hnw, GM_ADDR feat, GM_ADDR tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    TPipe pipe;
    KernelEmbedFuse op(&pipe);
    op.Init(x, ids, ew, enw, epw, hpw, hnw, feat, (__gm__ K1EmbedFuseTiling*)tiling);
    op.Process();
}
