/**
 * MTPBlock AscendC 算子 - Host 侧入口
 *
 * 支持所有 6 个 kernel 的直调验证。
 * 通过 tilingData.kernelType 选择运行哪个 kernel。
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/mtpblock_tiling.h"
#include "data_utils.h"

// 引用所有 kernel
#include "../op_kernel/k1_embed_fuse_kernel.asc"
#include "../op_kernel/k2_hc_pre_kernel.asc"
#include "../op_kernel/k3_attn_block_kernel.asc"
#include "../op_kernel/k4_hc_post_kernel.asc"
#include "../op_kernel/k5_moe_block_kernel.asc"
#include "../op_kernel/k6_mtp_head_kernel.asc"
#include <chrono>

// ============================================================================
// 工具函数
// ============================================================================

static void CheckAclRet(const char* op, int32_t ret)
{
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] %s failed, ret=%d\n", op, ret);
        exit(-1);
    }
}

// ============================================================================
// Kernel Launcher 基类
// ============================================================================

struct HostBuffer {
    uint8_t* hostPtr;
    uint8_t* devicePtr;
    size_t byteSize;
};

class KernelLauncher {
public:
    KernelLauncher(int32_t deviceId, aclrtStream stream)
        : deviceId_(deviceId), stream_(stream) {}

    ~KernelLauncher()
    {
        for (auto& buf : hostBuffers_) {
            if (buf.hostPtr) aclrtFreeHost(buf.hostPtr);
            if (buf.devicePtr) aclrtFree(buf.devicePtr);
        }
        if (tilingDevice_) aclrtFree(tilingDevice_);
    }

    // 分配 GM buffer 并从文件读取输入
    uint8_t* AllocInput(const std::string& filePath, size_t byteSize)
    {
        HostBuffer buf;
        buf.byteSize = byteSize;
        CheckAclRet("aclrtMallocHost", aclrtMallocHost((void**)&buf.hostPtr, byteSize));
        CheckAclRet("aclrtMalloc", aclrtMalloc((void**)&buf.devicePtr, byteSize, ACL_MEM_MALLOC_HUGE_FIRST));
        ReadFile(filePath, byteSize, buf.hostPtr, byteSize);
        CheckAclRet("aclrtMemcpy H2D",
            aclrtMemcpy(buf.devicePtr, byteSize, buf.hostPtr, byteSize, ACL_MEMCPY_HOST_TO_DEVICE));
        hostBuffers_.push_back(buf);
        return buf.devicePtr;
    }

    // 分配 GM buffer 用于输出
    uint8_t* AllocOutput(size_t byteSize)
    {
        HostBuffer buf;
        buf.byteSize = byteSize;
        CheckAclRet("aclrtMallocHost", aclrtMallocHost((void**)&buf.hostPtr, byteSize));
        CheckAclRet("aclrtMalloc", aclrtMalloc((void**)&buf.devicePtr, byteSize, ACL_MEM_MALLOC_HUGE_FIRST));
        hostBuffers_.push_back(buf);
        return buf.devicePtr;
    }

    // 拷贝 Tiling 数据到 Device
    void SetTiling(const void* tilingData, size_t tilingSize)
    {
        CheckAclRet("aclrtMalloc tiling",
            aclrtMalloc((void**)&tilingDevice_, tilingSize, ACL_MEM_MALLOC_HUGE_FIRST));
        CheckAclRet("aclrtMemcpy tiling",
            aclrtMemcpy(tilingDevice_, tilingSize, tilingData, tilingSize, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    // 读回输出到文件
    void ReadBackOutput(size_t idx, const std::string& filePath)
    {
        if (idx >= hostBuffers_.size()) return;
        auto& buf = hostBuffers_[idx];
        CheckAclRet("aclrtMemcpy D2H",
            aclrtMemcpy(buf.hostPtr, buf.byteSize, buf.devicePtr, buf.byteSize, ACL_MEMCPY_DEVICE_TO_HOST));
        WriteFile(filePath, buf.hostPtr, buf.byteSize);
    }

    uint8_t* GetTilingDevice() { return tilingDevice_; }
    aclrtStream GetStream() { return stream_; }

private:
    int32_t deviceId_;
    aclrtStream stream_;
    std::vector<HostBuffer> hostBuffers_;
    uint8_t* tilingDevice_ = nullptr;
};

// ============================================================================
// K1 embed_fuse 测试
// ============================================================================

void RunK1EmbedFuse()
{
    printf("=== Running K1: embed_fuse ===\n");

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CheckAclRet("aclrtCreateStream", aclrtCreateStream(&stream));

    KernelLauncher launcher(deviceId, stream);

    uint32_t b = DEMO_B, s = DEMO_S, hc = DEMO_HC, d = DEMO_D;
    uint32_t test_vocab = 1000;

    size_t x_bytes        = b * s * hc * d * sizeof(half);
    size_t ids_bytes      = b * s * sizeof(int64_t);
    size_t embed_bytes    = test_vocab * d * sizeof(half);
    size_t enorm_bytes    = d * sizeof(float);
    size_t eproj_bytes    = d * d * sizeof(half);
    size_t hproj_bytes    = d * d * sizeof(half);
    size_t hnorm_bytes    = d * sizeof(float);
    size_t feat_bytes     = b * s * hc * d * sizeof(half);

    uint8_t* x_gm     = launcher.AllocInput("./input/k1_x.bin", x_bytes);
    uint8_t* ids_gm   = launcher.AllocInput("./input/k1_ids.bin", ids_bytes);
    uint8_t* ew_gm    = launcher.AllocInput("./input/k1_embed_w.bin", embed_bytes);
    uint8_t* enw_gm   = launcher.AllocInput("./input/k1_enorm_w.bin", enorm_bytes);
    uint8_t* epw_gm   = launcher.AllocInput("./input/k1_eproj_w.bin", eproj_bytes);
    uint8_t* hpw_gm   = launcher.AllocInput("./input/k1_hproj_w.bin", hproj_bytes);
    uint8_t* hnw_gm   = launcher.AllocInput("./input/k1_hnorm_w.bin", hnorm_bytes);
    uint8_t* feat_gm  = launcher.AllocOutput(feat_bytes);

    K1EmbedFuseTiling tiling = {};
    tiling.base.kernelType = MTP_K1_EMBED_FUSE;
    tiling.base.b = b; tiling.base.s = s; tiling.base.hc = hc; tiling.base.d = d;
    tiling.base.norm_eps = DEMO_EPS;
    tiling.base.tile_s = 8;
    tiling.base.usedCoreNum = 1;
    tiling.base.blockNum = 1;
    tiling.vocab_size_k1 = test_vocab;

    launcher.SetTiling(&tiling, sizeof(K1EmbedFuseTiling));

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    k1_embed_fuse_kernel<<<tiling.base.blockNum, nullptr, stream>>>(
        x_gm, ids_gm, ew_gm, enw_gm, epw_gm, hpw_gm, hnw_gm, feat_gm,
        launcher.GetTilingDevice());
    CheckAclRet("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    launcher.ReadBackOutput(7, "./output/k1_feat.bin");  // feat is 8th buffer

    printf("K1 embed_fuse completed successfully.\n");
    aclrtDestroyStream(stream);
}

// ============================================================================
// K2 hc_pre 测试
// ============================================================================

void RunK2HcPre()
{
    printf("=== Running K2: hc_pre ===\n");

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CheckAclRet("aclrtCreateStream", aclrtCreateStream(&stream));

    KernelLauncher launcher(deviceId, stream);

    uint32_t b = DEMO_B, s = DEMO_S, hc = DEMO_HC, d = DEMO_D;
    uint32_t mix_hc = DEMO_MIX_HC;
    uint32_t hcd = hc * d;

    size_t x_bytes     = b * s * hc * d * sizeof(half);
    size_t fn_bytes    = mix_hc * hcd * sizeof(float);
    size_t scale_bytes = 3 * sizeof(float);
    size_t base_bytes  = mix_hc * sizeof(float);
    size_t y_bytes     = b * s * d * sizeof(half);
    size_t pre_bytes   = b * s * hc * sizeof(float);
    size_t post_bytes  = b * s * hc * sizeof(float);
    size_t comb_bytes  = b * s * hc * hc * sizeof(float);

    uint8_t* x_gm     = launcher.AllocInput("./input/k2_x.bin", x_bytes);
    uint8_t* fn_gm    = launcher.AllocInput("./input/k2_hc_fn.bin", fn_bytes);
    uint8_t* scale_gm = launcher.AllocInput("./input/k2_hc_scale.bin", scale_bytes);
    uint8_t* base_gm  = launcher.AllocInput("./input/k2_hc_base.bin", base_bytes);
    uint8_t* y_gm     = launcher.AllocOutput(y_bytes);
    uint8_t* pre_gm   = launcher.AllocOutput(pre_bytes);
    uint8_t* post_gm  = launcher.AllocOutput(post_bytes);
    uint8_t* comb_gm  = launcher.AllocOutput(comb_bytes);

    K2HcPreTiling tiling = {};
    tiling.base.kernelType = MTP_K2_HC_PRE;
    tiling.base.b = b; tiling.base.s = s; tiling.base.hc = hc; tiling.base.d = d;
    tiling.base.mix_hc = mix_hc;
    tiling.base.hc_sinkhorn_iters = DEMO_SINKHORN_ITERS;
    tiling.base.hc_eps = DEMO_EPS;
    tiling.base.tile_s = 8;
    tiling.base.usedCoreNum = 1;
    tiling.base.blockNum = 1;

    launcher.SetTiling(&tiling, sizeof(K2HcPreTiling));

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    k2_hc_pre_kernel<<<1, nullptr, stream>>>(
        x_gm, fn_gm, scale_gm, base_gm, y_gm, pre_gm, post_gm, comb_gm,
        launcher.GetTilingDevice());
    CheckAclRet("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    // Read back outputs (indices: x(0), fn(1), scale(2), base(3), y(4), pre(5), post(6), comb(7))
    launcher.ReadBackOutput(4, "./output/k2_y.bin");
    launcher.ReadBackOutput(5, "./output/k2_pre.bin");
    launcher.ReadBackOutput(6, "./output/k2_post.bin");
    launcher.ReadBackOutput(7, "./output/k2_comb.bin");

    printf("K2 hc_pre completed successfully.\n");
    aclrtDestroyStream(stream);
}

// ============================================================================
// K4 hc_post 测试
// ============================================================================

void RunK4HcPost()
{
    printf("=== Running K4: hc_post ===\n");

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CheckAclRet("aclrtCreateStream", aclrtCreateStream(&stream));

    KernelLauncher launcher(deviceId, stream);

    // Demo shape
    uint32_t b = DEMO_B, s = DEMO_S, hc = DEMO_HC, d = DEMO_D;

    size_t x_bytes        = b * s * d * sizeof(half);
    size_t residual_bytes = b * s * hc * d * sizeof(half);
    size_t post_bytes     = b * s * hc * sizeof(float);
    size_t comb_bytes     = b * s * hc * hc * sizeof(float);
    size_t out_bytes      = b * s * hc * d * sizeof(half);

    uint8_t* x_gm        = launcher.AllocInput("./input/k4_x.bin", x_bytes);
    uint8_t* residual_gm = launcher.AllocInput("./input/k4_residual.bin", residual_bytes);
    uint8_t* post_gm     = launcher.AllocInput("./input/k4_post.bin", post_bytes);
    uint8_t* comb_gm     = launcher.AllocInput("./input/k4_comb.bin", comb_bytes);
    uint8_t* out_gm      = launcher.AllocOutput(out_bytes);

    // 设置 Tiling
    K4HcPostTiling tiling = {};
    tiling.base.kernelType = MTP_K4_HC_POST;
    tiling.base.b = b; tiling.base.s = s; tiling.base.hc = hc; tiling.base.d = d;
    tiling.base.tile_s = 8;
    tiling.base.usedCoreNum = 1;
    tiling.base.blockNum = 1;

    launcher.SetTiling(&tiling, sizeof(K4HcPostTiling));

    // Launch kernel
    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    k4_hc_post_kernel<<<1, nullptr, stream>>>(
        x_gm, residual_gm, post_gm, comb_gm, out_gm, launcher.GetTilingDevice());
    CheckAclRet("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    // 读回输出 (out is at index 4: x(0), residual(1), post(2), comb(3), out(4))
    launcher.ReadBackOutput(4, "./output/k4_out.bin");

    printf("K4 hc_post completed successfully.\n");
    aclrtDestroyStream(stream);
}

// ============================================================================
// K3 attn_block 测试
// ============================================================================

void RunK3AttnBlock()
{
    printf("=== Running K3: attn_block ===\n");

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CheckAclRet("aclrtCreateStream", aclrtCreateStream(&stream));

    KernelLauncher launcher(deviceId, stream);

    uint32_t s = DEMO_S, d = DEMO_D;
    uint32_t nh = DEMO_N_HEADS, hd = DEMO_HEAD_DIM;
    uint32_t ql = DEMO_Q_LORA, ol = DEMO_O_LORA, ng = DEMO_O_GROUPS;
    uint32_t nhd = nh * hd;
    uint32_t hpg = nhd / ng;

    size_t x_bytes       = s * d * sizeof(half);
    size_t wq_a_bytes    = ql * d * sizeof(half);
    size_t q_norm_bytes  = ql * sizeof(float);
    size_t wq_b_bytes    = nhd * ql * sizeof(half);
    size_t wkv_bytes     = hd * d * sizeof(half);
    size_t kv_norm_bytes = hd * sizeof(float);
    size_t wo_a_bytes    = ng * ol * hpg * sizeof(half);
    size_t wo_b_bytes    = d * ng * ol * sizeof(half);
    size_t sink_bytes    = nh * sizeof(float);
    size_t out_bytes     = s * d * sizeof(half);

    uint8_t* x_gm      = launcher.AllocInput("./input/k3_x.bin", x_bytes);
    uint8_t* wqa_gm    = launcher.AllocInput("./input/k3_wq_a.bin", wq_a_bytes);
    uint8_t* qn_gm     = launcher.AllocInput("./input/k3_q_norm.bin", q_norm_bytes);
    uint8_t* wqb_gm    = launcher.AllocInput("./input/k3_wq_b.bin", wq_b_bytes);
    uint8_t* wkv_gm    = launcher.AllocInput("./input/k3_wkv.bin", wkv_bytes);
    uint8_t* kn_gm     = launcher.AllocInput("./input/k3_kv_norm.bin", kv_norm_bytes);
    uint8_t* woa_gm    = launcher.AllocInput("./input/k3_wo_a.bin", wo_a_bytes);
    uint8_t* wob_gm    = launcher.AllocInput("./input/k3_wo_b.bin", wo_b_bytes);
    uint8_t* sink_gm   = launcher.AllocInput("./input/k3_attn_sink.bin", sink_bytes);
    uint8_t* out_gm    = launcher.AllocOutput(out_bytes);

    K3AttnBlockTiling tiling = {};
    tiling.base.kernelType = MTP_K3_ATTN_BLOCK;
    tiling.base.b = 1; tiling.base.s = s; tiling.base.d = d;
    tiling.base.n_heads = nh; tiling.base.head_dim = hd;
    tiling.base.q_lora = ql; tiling.base.o_lora = ol;
    tiling.base.n_groups = ng;
    tiling.base.norm_eps = DEMO_EPS;
    tiling.base.softmax_scale = DEMO_SOFTMAX_SCALE;
    tiling.base.tile_s = s;
    tiling.base.usedCoreNum = 1;
    tiling.base.blockNum = 1;

    launcher.SetTiling(&tiling, sizeof(K3AttnBlockTiling));

    // Create dummy freqs_cis and topk_idxs buffers (all zeros, not used for start_pos=0)
    size_t fc_bytes = s * (DEMO_ROPE_HEAD_DIM / 2) * sizeof(float) * 2;  // complex64 = 2*float
    size_t tk_bytes = s * DEMO_WIN * sizeof(int32_t);
    uint8_t* fc_gm = launcher.AllocOutput(fc_bytes);
    uint8_t* tk_gm = launcher.AllocOutput(tk_bytes);

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    k3_attn_block_kernel<<<tiling.base.blockNum, nullptr, stream>>>(
        x_gm, wqa_gm, qn_gm, wqb_gm, wkv_gm, kn_gm, woa_gm, wob_gm,
        sink_gm, fc_gm, tk_gm, out_gm, launcher.GetTilingDevice());
    CheckAclRet("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    // out is at index 9 (x(0),wqa(1),qn(2),wqb(3),wkv(4),kn(5),woa(6),wob(7),sink(8),out(9))
    launcher.ReadBackOutput(9, "./output/k3_out.bin");

    printf("K3 attn_block completed successfully.\n");
    aclrtDestroyStream(stream);
}

// ============================================================================
// K5 moe_block 测试
// ============================================================================

void RunK5MoeBlock()
{
    printf("=== Running K5: moe_block ===\n");

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CheckAclRet("aclrtCreateStream", aclrtCreateStream(&stream));

    KernelLauncher launcher(deviceId, stream);

    uint32_t bs = DEMO_B * DEMO_S, d = DEMO_D;
    uint32_t ne = DEMO_N_EXPERTS;
    uint32_t id = DEMO_D;  // inter_dim = d for demo

    size_t x_bytes    = bs * d * sizeof(half);
    size_t gw_bytes   = ne * d * sizeof(half);
    size_t gb_bytes   = ne * sizeof(float);
    size_t sw1_bytes  = id * d * sizeof(half);
    size_t sw2_bytes  = d * id * sizeof(half);
    size_t sw3_bytes  = id * d * sizeof(half);
    size_t out_bytes  = bs * d * sizeof(half);
    size_t ws_bytes   = 0;  // minimal workspace for demo

    uint8_t* x_gm    = launcher.AllocInput("./input/k5_x.bin", x_bytes);
    uint8_t* gw_gm   = launcher.AllocInput("./input/k5_gate_w.bin", gw_bytes);
    uint8_t* gb_gm   = launcher.AllocInput("./input/k5_gate_b.bin", gb_bytes);
    // Expert weights (unused in demo, pass same dummy buffers)
    uint8_t* ew1_gm  = launcher.AllocOutput(id * d * sizeof(half));
    uint8_t* ew2_gm  = launcher.AllocOutput(d * id * sizeof(half));
    uint8_t* ew3_gm  = launcher.AllocOutput(id * d * sizeof(half));
    uint8_t* sw1_gm  = launcher.AllocInput("./input/k5_sw1.bin", sw1_bytes);
    uint8_t* sw2_gm  = launcher.AllocInput("./input/k5_sw2.bin", sw2_bytes);
    uint8_t* sw3_gm  = launcher.AllocInput("./input/k5_sw3.bin", sw3_bytes);
    uint8_t* out_gm  = launcher.AllocOutput(out_bytes);
    uint8_t* ws_gm   = launcher.AllocOutput(ws_bytes > 0 ? ws_bytes : 4);

    K5MoeBlockTiling tiling = {};
    tiling.base.kernelType = MTP_K5_MOE_BLOCK;
    tiling.base.b = DEMO_B; tiling.base.s = DEMO_S; tiling.base.d = d;
    tiling.base.n_experts = ne; tiling.base.topk = DEMO_TOPK;
    tiling.base.norm_eps = DEMO_EPS;
    tiling.base.tile_s = bs;
    tiling.base.usedCoreNum = 1;
    tiling.base.blockNum = 1;
    tiling.inter_dim = id;

    launcher.SetTiling(&tiling, sizeof(K5MoeBlockTiling));

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    k5_moe_block_kernel<<<1, nullptr, stream>>>(
        x_gm, gw_gm, gb_gm, ew1_gm, ew2_gm, ew3_gm,
        sw1_gm, sw2_gm, sw3_gm, out_gm, ws_gm, launcher.GetTilingDevice());
    CheckAclRet("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    // out is at index 10 (0:x,1:gw,2:gb,3:ew1,4:ew2,5:ew3,6:sw1,7:sw2,8:sw3,9:out,10:ws)
    launcher.ReadBackOutput(9, "./output/k5_out.bin");

    printf("K5 moe_block completed successfully.\n");
    aclrtDestroyStream(stream);
}

// ============================================================================
// K6 mtp_head 测试
// ============================================================================

void RunK6MtpHead()
{
    printf("=== Running K6: mtp_head ===\n");

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CheckAclRet("aclrtCreateStream", aclrtCreateStream(&stream));

    KernelLauncher launcher(deviceId, stream);

    uint32_t b = DEMO_B, s = DEMO_S, hc = DEMO_HC, d = DEMO_D;
    uint32_t hcd = hc * d;
    uint32_t test_vocab = 1000;

    size_t x_bytes      = b * s * hc * d * sizeof(half);
    size_t fn_bytes     = hc * hcd * sizeof(float);
    size_t scale_bytes  = 1 * sizeof(float);
    size_t base_bytes   = hc * sizeof(float);
    size_t norm_bytes   = d * sizeof(float);
    size_t head_bytes   = test_vocab * d * sizeof(float);
    size_t logits_bytes = b * test_vocab * sizeof(float);

    uint8_t* x_gm      = launcher.AllocInput("./input/k6_x.bin", x_bytes);
    uint8_t* fn_gm     = launcher.AllocInput("./input/k6_hc_fn.bin", fn_bytes);
    uint8_t* scale_gm  = launcher.AllocInput("./input/k6_hc_scale.bin", scale_bytes);
    uint8_t* base_gm   = launcher.AllocInput("./input/k6_hc_base.bin", base_bytes);
    uint8_t* norm_gm   = launcher.AllocInput("./input/k6_norm_w.bin", norm_bytes);
    uint8_t* head_gm   = launcher.AllocInput("./input/k6_head_w.bin", head_bytes);
    uint8_t* logits_gm = launcher.AllocOutput(logits_bytes);

    K6MtpHeadTiling tiling = {};
    tiling.base.kernelType = MTP_K6_MTP_HEAD;
    tiling.base.b = b; tiling.base.s = s; tiling.base.hc = hc; tiling.base.d = d;
    tiling.base.vocab_size = test_vocab;
    tiling.base.hc_eps = DEMO_EPS;
    tiling.base.norm_eps = DEMO_EPS;
    tiling.base.tile_s = 8;
    tiling.base.usedCoreNum = 1;
    tiling.base.blockNum = 1;

    launcher.SetTiling(&tiling, sizeof(K6MtpHeadTiling));

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    k6_mtp_head_kernel<<<1, nullptr, stream>>>(
        x_gm, fn_gm, scale_gm, base_gm, norm_gm, head_gm, logits_gm,
        launcher.GetTilingDevice());
    CheckAclRet("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    // logits is at index 6 (0:x,1:fn,2:scale,3:base,4:norm,5:head,6:logits)
    launcher.ReadBackOutput(6, "./output/k6_logits.bin");

    printf("K6 mtp_head completed successfully.\n");
    aclrtDestroyStream(stream);
}

// ============================================================================
// Main
// ============================================================================

int32_t main(int32_t argc, char* argv[])
{
    CheckAclRet("aclInit", aclInit(nullptr));

    int32_t deviceId = 0;
    CheckAclRet("aclrtSetDevice", aclrtSetDevice(deviceId));

    // 默认运行 K4
    MTPKernelType kernelToRun = MTP_K4_HC_POST;
    if (argc > 1) {
        uint32_t ktype = (uint32_t)atoi(argv[1]);
        kernelToRun = static_cast<MTPKernelType>(ktype);
    }

    switch (kernelToRun) {
        case MTP_K1_EMBED_FUSE:
            RunK1EmbedFuse();
            break;
        case MTP_K2_HC_PRE:
            RunK2HcPre();
            break;
        case MTP_K3_ATTN_BLOCK:
            RunK3AttnBlock();
            break;
        case MTP_K4_HC_POST:
            RunK4HcPost();
            break;
        case MTP_K5_MOE_BLOCK:
            RunK5MoeBlock();
            break;
        case MTP_K6_MTP_HEAD:
            RunK6MtpHead();
            break;
        default:
            printf("[ERROR] Unknown kernel type: %d\n", (int)kernelToRun);
            break;
    }

    CheckAclRet("aclrtResetDevice", aclrtResetDevice(deviceId));
    CheckAclRet("aclFinalize", aclFinalize());

    printf("=== MTPBlock Host completed ===\n");
    return 0;
}
