/**
 * engram_gate_w_reduce Host + Main 入口
 *
 * 输入:
 *   input/input_grad_w_partial.bin    [108, 4, hidden_size] float32
 *   input/input_weight_hidden.bin     [4, hidden_size] bfloat16
 *   input/input_weight_embed.bin      [4, hidden_size] bfloat16
 *   input/input_grad_weight_hidden.bin [4, hidden_size] float32
 *   input/input_grad_weight_embed.bin [4, hidden_size] float32
 *
 * 输出:
 *   output/output_grad_weight_hidden.bin [4, hidden_size] float32
 *   output/output_grad_weight_embed.bin [4, hidden_size] float32
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/engram_gate_w_reduce_tiling.h"
#include "data_utils.h"

// 引用拆出的纯 kernel 文件
#include "../op_kernel/engram_gate_w_reduce_kernel.asc"
#include <chrono>

struct ArgInfo {
    std::string fileName;
    size_t length;
};

aclrtSynchronizeStream(stream);
auto _t0 = std::chrono::high_resolution_clock::now();
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(EngramGateWReduceTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(EngramGateWReduceTiling), tilingData,
        sizeof(EngramGateWReduceTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    engram_gate_w_reduce_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], inputDevice[1], inputDevice[2],
        inputDevice[3], inputDevice[4],
        tilingDevice);
    aclrtSynchronizeStream(stream);
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    aclrtFree(tilingDevice);
    // In-place 语义: kernel 直接修改 inputDevice[3] 和 inputDevice[4]
    // 因此输出需从修改后的输入 device 缓冲区读取
    aclrtMemcpy(outputHost[0], outputsInfo[0].length, inputDevice[3],
        outputsInfo[0].length, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile(outputsInfo[0].fileName, outputHost[0], outputsInfo[0].length);

    aclrtMemcpy(outputHost[1], outputsInfo[1].length, inputDevice[4],
        outputsInfo[1].length, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile(outputsInfo[1].fileName, outputHost[1], outputsInfo[1].length);

    // 释放 output 资源（outputDevice 未被 kernel 写入，直接释放）
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // 从环境变量或默认值获取 hidden_size
    uint32_t hiddenSize = 4096;
    const char* envHidden = getenv("HIDDEN_SIZE");
    if (envHidden) {
        hiddenSize = static_cast<uint32_t>(atoi(envHidden));
    }

    // 获取设备最大核数
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // Tiling 计算
    uint32_t R = 108;  // 归约维度固定

    // 先计算每 core 至少处理的 hidden 段长度，再反推所需核数
    uint32_t tileHiddenLen = (hiddenSize + availableCoreNum - 1) / availableCoreNum;
    if (tileHiddenLen < 1) tileHiddenLen = 1;
    uint32_t blockNum = (hiddenSize + tileHiddenLen - 1) / tileHiddenLen;
    uint32_t tileA0Len = tileHiddenLen * N_CHANNELS;
    uint32_t tailHiddenLen = hiddenSize - (blockNum - 1) * tileHiddenLen;
    uint32_t tailA0Len = tailHiddenLen * N_CHANNELS;

    // UB 容量检查
    uint32_t ubRequired = 32 * tileA0Len;  // 保守估计 (含 TQue + TBufs)
    if (ubRequired > 192 * 1024) {
        printf("ERROR: UB overflow: %u bytes required > 192 KB, tileA0Len=%u\n", ubRequired, tileA0Len);
        aclrtResetDevice(deviceId);
        return -1;
    }

    EngramGateWReduceTiling tiling;
    tiling.blockDim = blockNum;
    tiling.hiddenSize = hiddenSize;
    tiling.tileHiddenLen = tileHiddenLen;
    tiling.tileA0Len = tileA0Len;
    tiling.tailHiddenLen = tailHiddenLen;
    tiling.tailA0Len = tailA0Len;
    tiling.R = R;

    // 计算各缓冲区的字节大小
    uint64_t totalElements108 = static_cast<uint64_t>(R) * N_CHANNELS * hiddenSize;
    uint64_t totalElements4H = static_cast<uint64_t>(N_CHANNELS) * hiddenSize;

    size_t gradWPartialBytes = totalElements108 * sizeof(float);
    size_t weightHidBytes = totalElements4H * sizeof(uint16_t);  // bfloat16_t = uint16_t
    size_t weightEmbBytes = totalElements4H * sizeof(uint16_t);
    size_t gradBytes = totalElements4H * sizeof(float);

    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_grad_w_partial.bin", gradWPartialBytes},
        {"./input/input_weight_hidden.bin", weightHidBytes},
        {"./input/input_weight_embed.bin", weightEmbBytes},
        {"./input/input_grad_weight_hidden.bin", gradBytes},
        {"./input/input_grad_weight_embed.bin", gradBytes},
    };

    // 两个输出 (in-place 语义: 输出覆盖输入4和5)
    // 由于 in-place，kernel 会修改 device 上的数据，然后读回
    // 输入 4/5 在 CopyIn 时已拷贝原始值到 device，kernel 修改后 CopyOut
    // 注意：这里输出文件名与输入 4/5 不同，以避免混淆
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output_grad_weight_hidden.bin", gradBytes},
        {"./output/output_grad_weight_embed.bin", gradBytes},
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    printf("=== engram_gate_w_reduce Kernel Call ===\n");
    printf("  hiddenSize=%u, blockNum=%u, tileHiddenLen=%u, tailHiddenLen=%u\n",
           hiddenSize, blockNum, tileHiddenLen, tailHiddenLen);
    printf("  tileA0Len=%u, tailA0Len=%u, R=%u\n", tileA0Len, tailA0Len, R);
    printf("  UB required: %u bytes / 192 KB\n", ubRequired);

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    KernelCall(blockNum, stream, inputsInfo, outputsInfo, (uint8_t *)&tiling);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("=== Kernel execution completed ===\n");
    return 0;
}
