/**
 * STEP 4: Complete Phase 1 + Phase 2 (full operator)
 */
#include "kernel_operator.h"
#include "engram_gate_w_reduce_tiling.h"

class KernelEngramGateWReduce {
public:
    __aicore__ inline KernelEngramGateWReduce(AscendC::TPipe* pipe) { pipe_ = pipe; }
    __aicore__ inline void Init(
        GM_ADDR gm1, GM_ADDR gm2, GM_ADDR gm3, GM_ADDR gm4, GM_ADDR gm5,
        const __gm__ EngramGateWReduceTiling* tiling)
    {
        this->tiling = tiling;
        uint32_t bi = AscendC::GetBlockIdx();
        myTL = (bi < tiling->blockDim - 1) ? tiling->tileHiddenLen : tiling->tailHiddenLen;
        startH = bi * tiling->tileHiddenLen;
        myR = tiling->R;
        r1 = (__gm__ float*)gm1;
        r2 = (__gm__ bfloat16_t*)gm2;
        r3 = (__gm__ bfloat16_t*)gm3;
        r4 = (__gm__ float*)gm4;
        r5 = (__gm__ float*)gm5;
        uint32_t cbF = myTL * sizeof(float);
        uint32_t cbB = myTL * sizeof(bfloat16_t);
        pipe_->InitBuffer(acc0, cbF); pipe_->InitBuffer(acc1, cbF);
        pipe_->InitBuffer(acc2, cbF); pipe_->InitBuffer(acc3, cbF);
        pipe_->InitBuffer(loadFp32, cbF);
        pipe_->InitBuffer(loadBf16, cbB);
        pipe_->InitBuffer(whCh, cbF); pipe_->InitBuffer(weCh, cbF);
        pipe_->InitBuffer(ghCh, cbF); pipe_->InitBuffer(geCh, cbF);
    }
    __aicore__ inline void Process() {
        uint32_t H = tiling->hiddenSize;
        uint16_t blkF = static_cast<uint16_t>(myTL * sizeof(float));
        uint16_t blkB = static_cast<uint16_t>(myTL * sizeof(bfloat16_t));
        auto a0 = acc0.Get<float>(); auto a1 = acc1.Get<float>();
        auto a2 = acc2.Get<float>(); auto a3 = acc3.Get<float>();
        auto ld = loadFp32.Get<float>();
        auto lb = loadBf16.Get<bfloat16_t>();
        auto wh = whCh.Get<float>();
        auto we = weCh.Get<float>();
        auto gh = ghCh.Get<float>();
        auto ge = geCh.Get<float>();

        // === Phase 1: reduction ===
        AscendC::Duplicate<float>(a0, 0.0f, myTL);
        AscendC::Duplicate<float>(a1, 0.0f, myTL);
        AscendC::Duplicate<float>(a2, 0.0f, myTL);
        AscendC::Duplicate<float>(a3, 0.0f, myTL);
        for (uint32_t c = 0; c < 4; c++) {
            auto* acc = (c==0)?&a0:(c==1)?&a1:(c==2)?&a2:&a3;
            for (uint32_t r = 0; r < myR; r++) {
                uint64_t go = static_cast<uint64_t>(r)*4ULL*H + c*H + startH;
                AscendC::GlobalTensor<float> gS;
                gS.SetGlobalBuffer(r1 + go, myTL);
                AscendC::DataCopyPad(ld, gS, {1, blkF, 0, 0}, {false, 0, 0, 0});
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Add<float>(*acc, *acc, ld, myTL);
                AscendC::PipeBarrier<PIPE_ALL>();
            }
        }

        // === Phase 2: per-channel MulAddDst ===
        AscendC::GlobalTensor<float> gD;
        AscendC::GlobalTensor<bfloat16_t> gB;

        for (uint32_t c = 0; c < 4; c++) {
            uint64_t off = c * H + startH;
            auto* acc = (c==0)?&a0:(c==1)?&a1:(c==2)?&a2:&a3;

            // Load weight_hidden[c] BF16 → FP32
            gB.SetGlobalBuffer(r2 + off, myTL);
            AscendC::DataCopyPad(lb, gB, {1, blkB, 0, 0}, {false, 0, 0, 0});
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Cast<float, bfloat16_t>(wh, lb, AscendC::RoundMode::CAST_NONE, myTL);
            AscendC::PipeBarrier<PIPE_ALL>();

            // Load weight_embed[c] BF16 → FP32
            gB.SetGlobalBuffer(r3 + off, myTL);
            AscendC::DataCopyPad(lb, gB, {1, blkB, 0, 0}, {false, 0, 0, 0});
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Cast<float, bfloat16_t>(we, lb, AscendC::RoundMode::CAST_NONE, myTL);
            AscendC::PipeBarrier<PIPE_ALL>();

            // Load grad_weight_hidden[c] FP32 → gh directly
            gD.SetGlobalBuffer(r4 + off, myTL);
            AscendC::DataCopyPad(gh, gD, {1, blkF, 0, 0}, {false, 0, 0, 0});
            AscendC::PipeBarrier<PIPE_ALL>();

            // Load grad_weight_embed[c] FP32 → ge directly
            gD.SetGlobalBuffer(r5 + off, myTL);
            AscendC::DataCopyPad(ge, gD, {1, blkF, 0, 0}, {false, 0, 0, 0});
            AscendC::PipeBarrier<PIPE_ALL>();

            // Compute: gh += acc * we; ge += acc * wh
            AscendC::MulAddDst<float, float>(gh, *acc, we, myTL);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::MulAddDst<float, float>(ge, *acc, wh, myTL);
            AscendC::PipeBarrier<PIPE_ALL>();

            // Store gh → grad_weight_hidden[c]
            gD.SetGlobalBuffer(r4 + off, myTL);
            AscendC::DataCopyPad(gD, gh, {1, blkF, 0, 0});

            // Store ge → grad_weight_embed[c]
            gD.SetGlobalBuffer(r5 + off, myTL);
            AscendC::DataCopyPad(gD, ge, {1, blkF, 0, 0});

            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }
private:
    AscendC::TPipe* pipe_;
    const __gm__ EngramGateWReduceTiling* tiling;
    __gm__ float *r1, *r4, *r5;
    __gm__ bfloat16_t *r2, *r3;
    AscendC::TBuf<AscendC::TPosition::VECIN> acc0,acc1,acc2,acc3,loadFp32,loadBf16,whCh,weCh,ghCh,geCh;
    uint32_t myTL, startH, myR;
};

extern "C" __global__ __vector__ void engram_gate_w_reduce_kernel(
    GM_ADDR gm1, GM_ADDR gm2, GM_ADDR gm3, GM_ADDR gm4, GM_ADDR gm5, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelEngramGateWReduce op(&pipe);
    op.Init(gm1, gm2, gm3, gm4, gm5, (__gm__ EngramGateWReduceTiling*)tiling);
    op.Process();
}
