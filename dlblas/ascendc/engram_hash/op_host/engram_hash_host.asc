/**
 * engram_hash_host.asc — direct kernel invoke main for standalone testing.
 *
 * Reads inputs produced by scripts/gen_data.py (binary dumps under input/),
 * runs the kernel on the NPU, and writes the raw output to output/out.bin for
 * bit-exact comparison by scripts/verify_result.py.
 *
 * Usage: engram_hash_custom NT N L T [devId] [coreNum]
 *   The input/output directory is taken from EH_IO_DIR env var, else "input"
 *   / "output" relative to CWD. Shapes are passed on the command line and must
 *   match the generated data.
 */
#include "data_utils.h"
#include "engram_hash_tiling.h"
#include "engram_hash_compute_tiling.h"
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>

// Kernel host-side launch alias (C-compatible signature).
extern "C" void engram_hash_kernel(
    uint32_t blockDim, void* l2ctrl, aclrtStream stream,
    void* ngram, void* mult, void* vocab, void* offsets,
    void* output, void* tiling);

int main(int argc, char* argv[]) {
    uint32_t NT = 4096, N = 3, L = 2, T = 8;
    int32_t devId = 0;             // logical device inside process (mapped by RT_VISIBLE_DEVICES)
    uint32_t coreNum = 48;         // DAV_2201 Vector core count

    if (argc > 1) NT = (uint32_t)atoi(argv[1]);
    if (argc > 2) N  = (uint32_t)atoi(argv[2]);
    if (argc > 3) L  = (uint32_t)atoi(argv[3]);
    if (argc > 4) T  = (uint32_t)atoi(argv[4]);
    if (argc > 5) devId = atoi(argv[5]);
    if (argc > 6) coreNum = (uint32_t)atoi(argv[6]);

    const uint32_t P = (N >= 1) ? (N - 1) : 0;
    const uint32_t W = P * T;

    const char* ioDirEnv = getenv("EH_IO_DIR");
    std::string ioDir = ioDirEnv ? ioDirEnv : ".";
    std::string inDir  = ioDir + "/input";
    std::string outDir = ioDir + "/output";

    printf("=== engram_hash direct invoke ===\n");
    printf("NT=%u N=%u L=%u T=%u  P=%u W=%u  dev=%d cores=%u\n",
           NT, N, L, T, P, W, devId, coreNum);

    // Byte sizes (row-major contiguous).
    size_t ngramBytes = (size_t)NT * N * sizeof(int32_t);
    size_t multBytes  = (size_t)L * N * sizeof(int64_t);
    size_t vocabBytes = (size_t)L * P * T * sizeof(int32_t);
    size_t offBytes   = (size_t)L * W * sizeof(int32_t);
    size_t outBytes   = (size_t)L * NT * W * sizeof(int32_t);

    // Host buffers.
    int32_t* hNgram = (int32_t*)malloc(ngramBytes);
    int64_t* hMult  = (int64_t*)malloc(multBytes);
    int32_t* hVocab = (int32_t*)malloc(vocabBytes);
    int32_t* hOff   = (int32_t*)malloc(offBytes);
    int32_t* hOut   = (int32_t*)malloc(outBytes);
    if (!hNgram || !hMult || !hVocab || !hOff || !hOut) {
        ERROR_LOG("host malloc failed"); return -1;
    }
    memset(hOut, 0, outBytes);

    // Load inputs from gen_data.py dumps.
    size_t rd = 0;
    if (!ReadFile(inDir + "/ngram_token_ids.bin", rd, hNgram, ngramBytes) ||
        !ReadFile(inDir + "/multipliers.bin",     rd, hMult,  multBytes) ||
        !ReadFile(inDir + "/vocab_sizes.bin",     rd, hVocab, vocabBytes) ||
        !ReadFile(inDir + "/offsets.bin",         rd, hOff,   offBytes)) {
        ERROR_LOG("failed to read input .bin files from %s (run gen_data.py first)", inDir.c_str());
        return -1;
    }

    // ACL init.
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtStream stream;
    aclrtCreateStream(&stream);

    // Device buffers.
    void *dNgram, *dMult, *dVocab, *dOff, *dOut;
    aclrtMalloc(&dNgram, ngramBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dMult,  multBytes,  ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dVocab, vocabBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dOff,   offBytes,   ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dOut,   outBytes,   ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(dNgram, ngramBytes, hNgram, ngramBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dMult,  multBytes,  hMult,  multBytes,  ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dVocab, vocabBytes, hVocab, vocabBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dOff,   offBytes,   hOff,   offBytes,   ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dOut,   outBytes,   hOut,   outBytes,   ACL_MEMCPY_HOST_TO_DEVICE);

    // Tiling.
    EngramHashTilingData td;
    ComputeEngramHashTiling(NT, N, L, T, coreNum, td);
    printf("tiling: tokensPerCore=%u tailTokens=%u blockNum=%u tileTokens=%u lastTile=%u inAligned=%u outAligned=%u\n",
           td.tokensPerCore, td.tailTokens, td.blockNum, td.tileTokens,
           td.lastTileTokens, td.inAligned, td.outAligned);

    void* dTiling;
    aclrtMalloc(&dTiling, sizeof(EngramHashTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(dTiling, sizeof(EngramHashTilingData), &td,
                sizeof(EngramHashTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    // Launch.
    engram_hash_kernel(td.blockNum, nullptr, stream,
        dNgram, dMult, dVocab, dOff, dOut, dTiling);
    aclrtSynchronizeStream(stream);

    // Copy back + persist for verify.
    aclrtMemcpy(hOut, outBytes, dOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::string outPath = outDir + "/out.bin";
    if (!WriteFile(outPath, hOut, outBytes)) {
        ERROR_LOG("failed to write %s", outPath.c_str());
    } else {
        INFO_LOG("wrote %s (%zu bytes)", outPath.c_str(), outBytes);
    }

    // Cleanup.
    free(hNgram); free(hMult); free(hVocab); free(hOff); free(hOut);
    aclrtFree(dNgram); aclrtFree(dMult); aclrtFree(dVocab);
    aclrtFree(dOff); aclrtFree(dOut); aclrtFree(dTiling);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    printf("OK\n");
    return 0;
}
