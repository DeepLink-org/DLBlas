/**
 * engram_hash kernel — AIV-only scalar int64 N-gram hash
 * ASCEND910B2 / DAV_2201
 *
 * Pure integer scalar path (mul / xor / mod / add), bit-exact with the
 * PyTorch reference. Vector int64 element-wise ops are unsupported on
 * DAV_2201, and the XOR chain is a per-token sequential prefix, so the
 * scalar ALU is both semantically required and naturally bit-exact.
 *
 * Multi-core: split the token (NT) dimension across Vector cores; each
 * core loops over all L layers internally (reusing the ngram tile).
 *
 * Resident tables (multipliers/vocab_sizes/offsets) are tiny and shared
 * by every token, so each core loads them once into UB. Data movement
 * uses DataCopyPad throughout to be robust to non-32B-aligned lengths.
 */
#include "kernel_operator.h"
#include "engram_hash_tiling.h"
using namespace AscendC;

extern "C" __global__ __aicore__ void engram_hash_kernel(
    GM_ADDR ngram_token_ids,   // int32 [NT, N]
    GM_ADDR multipliers,       // int64 [L, N]
    GM_ADDR vocab_sizes,       // int32 [L, N-1, T]
    GM_ADDR offsets,           // int32 [L, W]
    GM_ADDR output,            // int32 [L, NT, W]
    GM_ADDR tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);

    auto* td = (__gm__ EngramHashTilingData*)tiling;
    const uint32_t NT = td->numTokens;
    const uint32_t N  = td->ngramSize;
    const uint32_t L  = td->numLayers;
    const uint32_t T  = td->numTables;
    const uint32_t W  = td->outWidth;      // (N-1)*T
    const uint32_t tokensPerCore = td->tokensPerCore;
    const uint32_t tileTokens    = td->tileTokens;

    // Defensive: N==1 → W==0 → nothing to produce.
    if (W == 0 || N == 0 || L == 0) return;

    const uint32_t bid = GetBlockIdx();
    if (bid >= td->blockNum) return;

    const uint32_t myTokens =
        (bid < td->blockNum - 1 || td->tailTokens == 0) ? tokensPerCore : td->tailTokens;
    if (myTokens == 0) return;
    const uint32_t tokenBase = bid * tokensPerCore;

    const uint32_t LN = L * N;   // multipliers count (int64)
    const uint32_t LW = L * W;   // vocab_sizes / offsets count (int32)

    // ── UB buffers ──
    TPipe pipe;
    TQue<TPosition::VECIN, 1>  mulQ, vocQ, offQ, ngQ;
    TQue<TPosition::VECOUT, 1> outQ;

    // Round buffer byte sizes up to 32B to satisfy UB allocation alignment.
    auto align32 = [](uint32_t bytes) -> uint32_t { return (bytes + 31u) / 32u * 32u; };
    // Per-layer stride in the output UB (elements), padded to 8 int32 (32B) so
    // each layer segment starts at a 32B-aligned UB address — required by
    // DataCopyPad(UB→GM). Without this, small W (e.g. W=1) puts odd layers at
    // non-aligned UB offsets and their DMA-OUT is silently dropped.
    const uint32_t outLayerStride = (tileTokens * W + 7u) / 8u * 8u;

    pipe.InitBuffer(mulQ, 1, align32(LN * sizeof(int64_t)));
    pipe.InitBuffer(vocQ, 1, align32(LW * sizeof(int32_t)));
    pipe.InitBuffer(offQ, 1, align32(LW * sizeof(int32_t)));
    pipe.InitBuffer(ngQ,  1, align32(tileTokens * N * sizeof(int32_t)));
    pipe.InitBuffer(outQ, 1, align32(L * outLayerStride * sizeof(int32_t)));

    // ── load resident tables once (per core) ──
    GlobalTensor<int64_t> mulGm;
    GlobalTensor<int32_t> vocGm, offGm;
    mulGm.SetGlobalBuffer((__gm__ int64_t*)multipliers, LN);
    vocGm.SetGlobalBuffer((__gm__ int32_t*)vocab_sizes, LW);
    offGm.SetGlobalBuffer((__gm__ int32_t*)offsets, LW);

    LocalTensor<int64_t> mulUb = mulQ.AllocTensor<int64_t>();
    {
        DataCopyExtParams p{1, LN * (uint32_t)sizeof(int64_t), 0, 0, 0};
        DataCopyPadExtParams<int64_t> pad{false, 0, 0, 0};
        DataCopyPad(mulUb, mulGm, p, pad);
    }
    mulQ.EnQue(mulUb);
    mulUb = mulQ.DeQue<int64_t>();

    LocalTensor<int32_t> vocUb = vocQ.AllocTensor<int32_t>();
    {
        DataCopyExtParams p{1, LW * (uint32_t)sizeof(int32_t), 0, 0, 0};
        DataCopyPadExtParams<int32_t> pad{false, 0, 0, 0};
        DataCopyPad(vocUb, vocGm, p, pad);
    }
    vocQ.EnQue(vocUb);
    vocUb = vocQ.DeQue<int32_t>();

    LocalTensor<int32_t> offUb = offQ.AllocTensor<int32_t>();
    {
        DataCopyExtParams p{1, LW * (uint32_t)sizeof(int32_t), 0, 0, 0};
        DataCopyPadExtParams<int32_t> pad{false, 0, 0, 0};
        DataCopyPad(offUb, offGm, p, pad);
    }
    offQ.EnQue(offUb);
    offUb = offQ.DeQue<int32_t>();

    GlobalTensor<int32_t> ngGm, outGm;
    ngGm.SetGlobalBuffer((__gm__ int32_t*)ngram_token_ids, NT * N);
    outGm.SetGlobalBuffer((__gm__ int32_t*)output, (uint64_t)L * NT * W);

    // ── token tile loop ──
    const uint32_t loops = (myTokens + tileTokens - 1) / tileTokens;
    for (uint32_t t = 0; t < loops; t++) {
        const uint32_t cur = (t == loops - 1) ? (myTokens - t * tileTokens) : tileTokens;
        const uint32_t tOff = tokenBase + t * tileTokens;   // global token start

        // ① DMA-IN ngram tile: [cur, N] contiguous rows from GM
        LocalTensor<int32_t> ngUb = ngQ.AllocTensor<int32_t>();
        {
            DataCopyExtParams p{1, cur * N * (uint32_t)sizeof(int32_t), 0, 0, 0};
            DataCopyPadExtParams<int32_t> pad{false, 0, 0, 0};
            DataCopyPad(ngUb, ngGm[tOff * N], p, pad);
        }
        ngQ.EnQue(ngUb);
        ngUb = ngQ.DeQue<int32_t>();

        // ② scalar compute
        LocalTensor<int32_t> outUb = outQ.AllocTensor<int32_t>();
        for (uint32_t l = 0; l < L; l++) {
            const uint32_t mulRow = l * N;   // multipliers[l, :]
            const uint32_t vocRow = l * W;   // vocab_sizes[l] flattened (width W)
            const uint32_t offRow = l * W;   // offsets[l, :]
            const uint32_t outLayer = l * outLayerStride;
            for (uint32_t j = 0; j < cur; j++) {
                const uint32_t ngRow = j * N;
                // h = int64(ngram[tk,0]) * mult[l,0]
                int64_t h = (int64_t)ngUb.GetValue(ngRow) * mulUb.GetValue(mulRow);
                const uint32_t outTokBase = outLayer + j * W;
                for (uint32_t i = 1; i < N; i++) {
                    h ^= (int64_t)ngUb.GetValue(ngRow + i) * mulUb.GetValue(mulRow + i);
                    const uint32_t colBase = (i - 1) * T;
                    for (uint32_t tb = 0; tb < T; tb++) {
                        const uint32_t col = colBase + tb;
                        const int64_t v = (int64_t)vocUb.GetValue(vocRow + col);
                        const int32_t idx = (int32_t)(h % v) + offUb.GetValue(offRow + col);
                        outUb.SetValue(outTokBase + col, idx);
                    }
                }
            }
        }
        ngQ.FreeTensor(ngUb);
        outQ.EnQue(outUb);
        outUb = outQ.DeQue<int32_t>();

        // ③ DMA-OUT per layer (segments are non-contiguous across layers in GM)
        for (uint32_t l = 0; l < L; l++) {
            const uint64_t dstOff = (uint64_t)l * NT * W + (uint64_t)tOff * W;
            const uint32_t srcOff = l * outLayerStride;
            DataCopyExtParams p{1, cur * W * (uint32_t)sizeof(int32_t), 0, 0, 0};
            DataCopyPad(outGm[dstOff], outUb[srcOff], p);
        }
        outQ.FreeTensor(outUb);
    }

    mulQ.FreeTensor(mulUb);
    vocQ.FreeTensor(vocUb);
    offQ.FreeTensor(offUb);
}
