// ============================================================================
// Ascend C Kernel 实现 - Expand Kernel Backward 算子
// 语义: o_grad.sum(dim=-2), 即沿 mhc_mult 维度做 ReduceSum
// 数据流: ARA-FullLoad, 归约轴 R=4 极小, 用 3 次 Add 替代 ReduceSum
// ============================================================================

#include "kernel_operator.h"
#include "expand_kenel_bwd_tiling.h"

using namespace AscendC;

class KernelExpandKernelBwd {
public:
    __aicore__ inline KernelExpandKernelBwd(TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR oGrad, GM_ADDR out,
                                const __gm__ ExpandKernelBwdTilingData* tiling)
    {
        this->tiling = tiling;

        uint64_t A1   = tiling->A1;
        uint64_t R    = tiling->R;
        uint64_t A0   = tiling->A0;
        uint64_t tileA0Len   = tiling->tileA0Len;
        uint64_t usedCoreNum = tiling->usedCoreNum;
        uint64_t tilesPerCore = tiling->tilesPerCore;
        uint64_t tailCoreTiles = tiling->tailCoreTiles;

        uint64_t blockIdx = GetBlockIdx();
        if (blockIdx == usedCoreNum - 1) {
            coreTiles = tailCoreTiles;
        } else {
            coreTiles = tilesPerCore;
        }
        startTile = blockIdx * tilesPerCore;
        endTile = startTile + coreTiles;

        inputStride  = R * A0;
        outputStride = A0;

        oGradGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(oGrad),
                                A1 * R * A0);
        outGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(out),
                              A1 * A0);

        pipe_->InitBuffer(inQueueX, DOUBLE_BUFFER,
                          R * tileA0Len * sizeof(half));
        pipe_->InitBuffer(outQueueY, DOUBLE_BUFFER,
                          tileA0Len * sizeof(half));
        // FP32 中间累加缓冲: [accF32 占用 tileA0Len floats, tmpF32 占用 tileA0Len floats]
        pipe_->InitBuffer(castBuf, 2 * tileA0Len * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        uint64_t A0        = tiling->A0;
        uint64_t R         = tiling->R;
        uint64_t tileA0Len = tiling->tileA0Len;

        for (uint64_t tileIdx = startTile; tileIdx < endTile; tileIdx++) {
            CopyIn(tileIdx);
            Compute(tileA0Len);
            CopyOut(tileIdx);
        }
    }

    __aicore__ inline void CopyIn(uint64_t tileIdx)
    {
        LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();

        uint64_t gmOffset = tileIdx * inputStride;
        DataCopyExtParams copyInParams;
        copyInParams.blockCount = static_cast<uint16_t>(tiling->R);
        copyInParams.blockLen   = static_cast<uint32_t>(tiling->tileA0Len * sizeof(half));
        copyInParams.srcStride  = static_cast<uint32_t>((tiling->A0 - tiling->tileA0Len) * sizeof(half));
        copyInParams.dstStride  = 0;
        copyInParams.rsv        = 0;
        DataCopyPadExtParams<half> padParams{false, 0, 0, static_cast<half>(0.0f)};

        DataCopyPad(xLocal, oGradGm[gmOffset], copyInParams, padParams);
        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint64_t tileA0Len)
    {
        LocalTensor<half> xLocal = inQueueX.DeQue<half>();
        LocalTensor<half> outLocal = outQueueY.AllocTensor<half>();

        // FP32 中间累加缓冲: [accF32 | tmpF32]
        LocalTensor<float> accF32 = castBuf.Get<float>();
        LocalTensor<float> tmpF32 = accF32[tileA0Len];

        // 4 行视图 (UB 中连续存储: [row0|row1|row2|row3])
        LocalTensor<half> row0 = xLocal;
        LocalTensor<half> row1 = xLocal[tileA0Len];
        LocalTensor<half> row2 = xLocal[tileA0Len * 2];
        LocalTensor<half> row3 = xLocal[tileA0Len * 3];

        int32_t count = static_cast<int32_t>(tileA0Len);

        // FP32 累加: accF32 = FP32(row0 + row1 + row2 + row3)
        Cast(accF32, row0, RoundMode::CAST_NONE, count);
        Cast(tmpF32, row1, RoundMode::CAST_NONE, count);
        Add(accF32, accF32, tmpF32, count);
        Cast(tmpF32, row2, RoundMode::CAST_NONE, count);
        Add(accF32, accF32, tmpF32, count);
        Cast(tmpF32, row3, RoundMode::CAST_NONE, count);
        Add(accF32, accF32, tmpF32, count);

        // FP32 → FP16 截断
        Cast(outLocal, accF32, RoundMode::CAST_ROUND, count);

        outQueueY.EnQue<half>(outLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint64_t tileIdx)
    {
        LocalTensor<half> outLocal = outQueueY.DeQue<half>();

        uint64_t gmOffset = tileIdx * outputStride;
        DataCopyExtParams copyOutParams;
        copyOutParams.blockCount = 1;
        copyOutParams.blockLen   = static_cast<uint32_t>(tiling->tileA0Len * sizeof(half));
        copyOutParams.srcStride  = 0;
        copyOutParams.dstStride  = 0;
        copyOutParams.rsv        = 0;

        DataCopyPad(outGm[gmOffset], outLocal, copyOutParams);
        outQueueY.FreeTensor(outLocal);
    }

private:
    TPipe* pipe_;
    const __gm__ ExpandKernelBwdTilingData* tiling;

    GlobalTensor<half> oGradGm;
    GlobalTensor<half> outGm;

    TQue<TPosition::VECIN, 1>  inQueueX;
    TQue<TPosition::VECOUT, 1> outQueueY;
    TBuf<> castBuf;  // FP32 中间累加缓冲

    uint64_t startTile;
    uint64_t endTile;
    uint64_t coreTiles;
    uint64_t inputStride;
    uint64_t outputStride;
};

// __vector__ 属性确保 kernel 仅在 VEC core 上运行，无需额外 AIC 检查
extern "C" __global__ __vector__ void expand_kenel_bwd_kernel(
    GM_ADDR oGrad, GM_ADDR out, GM_ADDR workspace, GM_ADDR tiling)
{
    TPipe pipe;
    KernelExpandKernelBwd op(&pipe);
    op.Init(oGrad, out, reinterpret_cast<__gm__ ExpandKernelBwdTilingData*>(tiling));
    op.Process();
}
