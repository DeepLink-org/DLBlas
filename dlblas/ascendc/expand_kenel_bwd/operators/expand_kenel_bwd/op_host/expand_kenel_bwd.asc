// ============================================================================
// Ascend C Kernel 直调 - Expand Kernel Backward 算子 (Host + Main)
// 语义: o_grad.sum(dim=-2), 即沿 mhc_mult 维度做 ReduceSum
// 输入 shape: (n0, n1, mhc_mult, h) → 合轴后 (A1, R, A0)
// 输出 shape: (n0, n1, h)           → 合轴后 (A1, A0)
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/expand_kenel_bwd_tiling.h"
#include "data_utils.h"

// 引用拆出的纯 kernel 文件
#include "../op_kernel/expand_kenel_bwd_kernel.asc"
#include <chrono>

// ============================================================================
// Host 端代码
// ============================================================================

struct ArgInfo {
    std::string fileName;
    size_t length;
};

// Tiling 参数计算
static void ComputeTiling(ExpandKernelBwdTilingData& tiling,
                          uint64_t A1, uint64_t R, uint64_t A0,
                          uint64_t blockDim)
{
    // Step 1: 确定 tileA0Len (对齐到 A0_TILE_BASE)
    uint64_t tileA0Len = ((A0 + A0_TILE_BASE - 1) / A0_TILE_BASE) * A0_TILE_BASE;

    // Step 2: A0 切片数
    uint64_t a0Outer = (A0 + tileA0Len - 1) / tileA0Len;

    // Step 3: 多核切分
    uint64_t totalTiles = A1 * a0Outer;
    uint64_t tilesPerCore = (totalTiles + blockDim - 1) / blockDim;
    uint64_t usedCoreNum = (totalTiles + tilesPerCore - 1) / tilesPerCore;
    uint64_t tailCoreTiles = totalTiles % tilesPerCore;
    if (tailCoreTiles == 0 && totalTiles > 0) {
        tailCoreTiles = tilesPerCore;
    }

    // Step 4: 填充 tiling 数据
    tiling.A1            = A1;
    tiling.R             = R;
    tiling.A0            = A0;
    tiling.tileA0Len     = tileA0Len;
    tiling.a0Outer       = a0Outer;
    tiling.totalTiles    = totalTiles;
    tiling.tilesPerCore  = tilesPerCore;
    tiling.tailCoreTiles = tailCoreTiles;
    tiling.usedCoreNum   = usedCoreNum;
    tiling.inputSize     = static_cast<uint32_t>(A1 * R * A0 * sizeof(half));
    tiling.outputSize    = static_cast<uint32_t>(A1 * A0 * sizeof(half));
}

// KernelCall 封装
aclrtSynchronizeStream(stream);
auto _t0 = std::chrono::high_resolution_clock::now();
static void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo>& inputsInfo, std::vector<ArgInfo>& outputsInfo,
    uint8_t* tilingData)
{
    std::vector<uint8_t*> inputHost(inputsInfo.size());
    std::vector<uint8_t*> inputDevice(inputsInfo.size());
    std::vector<uint8_t*> outputHost(outputsInfo.size());
    std::vector<uint8_t*> outputDevice(outputsInfo.size());
    uint8_t* tilingDevice = nullptr;

    aclrtMalloc((void**)&tilingDevice, sizeof(ExpandKernelBwdTilingData),
                ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(ExpandKernelBwdTilingData), tilingData,
                sizeof(ExpandKernelBwdTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void**)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void**)&inputDevice[i], inputsInfo[i].length,
                    ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length,
                 inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
                    inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void**)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void**)&outputDevice[i], outputsInfo[i].length,
                    ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // workspace: 本算子无需额外 workspace, 传 nullptr
    uint8_t* workspace = nullptr;

    expand_kenel_bwd_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], outputDevice[0], workspace, tilingDevice);
    aclrtSynchronizeStream(stream);
    auto _t1 = std::chrono::high_resolution_clock::now();
    double _kernel_us = std::chrono::duration<double, std::micro>(_t1 - _t0).count();
    printf("[PERF] kernel_time_us=%.2f\n", _kernel_us);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
                    outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // 获取 Vector 核数
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM,
                             &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // 算子 shape 参数: (n0, n1, mhc_mult, h) = (2, 1024, 4, 1280)
    uint64_t n0 = 2;
    uint64_t n1 = 1024;
    uint64_t mhc_mult = 4;
    uint64_t h = 1280;

    // 合轴: A1 = n0 * n1, R = mhc_mult, A0 = h
    uint64_t A1 = n0 * n1;
    uint64_t R  = mhc_mult;
    uint64_t A0 = h;

    uint64_t inputElements  = A1 * R * A0;
    uint64_t outputElements = A1 * A0;
    size_t inputByteSize  = inputElements * sizeof(half);
    size_t outputByteSize = outputElements * sizeof(half);

    // Tiling 计算
    uint64_t blockDim = static_cast<uint64_t>(availableCoreNum);
    ExpandKernelBwdTilingData tiling;
    ComputeTiling(tiling, A1, R, A0, blockDim);

    printf("=== Expand Kernel Backward Tiling Info ===\n");
    printf("  Shape: (%lu, %lu, %lu, %lu)\n", n0, n1, mhc_mult, h);
    printf("  Merged: A1=%lu, R=%lu, A0=%lu\n", A1, R, A0);
    printf("  tileA0Len=%lu, a0Outer=%lu\n", tiling.tileA0Len, tiling.a0Outer);
    printf("  totalTiles=%lu, tilesPerCore=%lu, tailCoreTiles=%lu\n",
           tiling.totalTiles, tiling.tilesPerCore, tiling.tailCoreTiles);
    printf("  blockDim=%lu, usedCoreNum=%lu\n", blockDim, tiling.usedCoreNum);
    printf("  inputSize=%u bytes, outputSize=%u bytes\n",
           tiling.inputSize, tiling.outputSize);

    // 输入输出文件
    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_o_grad.bin", inputByteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", outputByteSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    aclrtSynchronizeStream(stream);
    auto _t0 = std::chrono::high_resolution_clock::now();
    KernelCall(static_cast<uint32_t>(tiling.usedCoreNum), stream,
               inputsInfo, outputsInfo, reinterpret_cast<uint8_t*>(&tiling));

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
