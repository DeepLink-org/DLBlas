// ============================================================================
// Ascend C Kernel 实现 - Expand 算子
// ============================================================================
//
// 功能: x.unsqueeze(-2).expand(..., M, H).contiguous()
//
// 关键设计:
//   - tileH = AlignUp16(H)，确保所有 UB 操作 32B 对齐
//   - UB 内每份副本按 tileH 步长排列 (含 padding 尾)
//   - 输出时按 H 步长写入 GM (跳过 UB padding)
// ============================================================================

#include "kernel_operator.h"
#include "expand_kenel_fwd_tiling.h"

// UB 内扩展: 将 src[H] 复制 M 次到 dst[M * tileH]
// dst 步长为 tileH (对齐的)，确保 UB-internal DataCopy 的 32B 对齐
template <typename T>
__aicore__ inline void ExpandRows(
    AscendC::LocalTensor<T>& dst,
    const AscendC::LocalTensor<T>& src,
    int64_t M,
    int64_t count,    // 实际数据量 H
    int64_t stride)   // UB 步长 tileH (对齐的)
{
    for (int64_t m = 0; m < M; m++) {
        AscendC::DataCopy(dst[m * stride], src, static_cast<uint32_t>(count));
    }
}

template <typename T>
class KernelExpand {
public:
    __aicore__ inline KernelExpand() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
                                const __gm__ ExpandTilingData* tiling)
    {
        this->tiling = tiling;

        int64_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx >= tiling->usedCoreCnt) {
            this->rowStart = 0;
            this->rowEnd = 0;
            return;
        }
        this->rowStart = blockIdx * tiling->rowsPerCore;
        this->rowEnd = (blockIdx == tiling->usedCoreCnt - 1)
            ? tiling->totalRows
            : (blockIdx + 1) * tiling->rowsPerCore;
        if (this->rowEnd > tiling->totalRows) {
            this->rowEnd = tiling->totalRows;
        }

        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));

        // tileH 已对齐到 16 倍数 (32B)
        pipe_.InitBuffer(inQue, 2, tiling->tileH * sizeof(T));
        pipe_.InitBuffer(outQue, 1, tiling->M * tiling->tileH * sizeof(T));

        this->tilesPerRow = (tiling->H + tiling->tileH - 1) / tiling->tileH;
    }

    __aicore__ inline void Process()
    {
        if (rowStart >= rowEnd) return;

        for (int64_t row = rowStart; row < rowEnd; row++) {
            for (int64_t ti = 0; ti < tilesPerRow; ti++) {
                int64_t tileOff = ti * tiling->tileH;
                int64_t curTileH = (ti == tilesPerRow - 1) ? tiling->tailH : tiling->tileH;

                CopyIn(row, tileOff, curTileH);
                Expand(curTileH);
                CopyOut(row, tileOff, curTileH);
            }
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t row, int64_t tileOff, int64_t curTileH)
    {
        AscendC::LocalTensor<T> inBuf = inQue.AllocTensor<T>();
        int64_t offset = row * tiling->H + tileOff;

        AscendC::DataCopyPad(inBuf, xGm[offset],
            AscendC::DataCopyParams{1, static_cast<uint16_t>(curTileH * sizeof(T)), 0, 0},
            AscendC::DataCopyPadParams{false, 0, 0, 0});
        inQue.EnQue(inBuf);
    }

    __aicore__ inline void Expand(int64_t curTileH)
    {
        AscendC::LocalTensor<T> inBuf = inQue.DeQue<T>();
        AscendC::LocalTensor<T> outBuf = outQue.AllocTensor<T>();

        // UB 内扩展：按 tileH 步长排列副本（确保所有副本 UB 地址 32B 对齐）
        // outBuf 布局: [copy0(curTileH)|pad][copy1(curTileH)|pad]...[copyM-1(curTileH)|pad]
        // UB 填充是无害的，CopyOut 只读取有效数据
        ExpandRows<T>(outBuf, inBuf, tiling->M, curTileH, tiling->tileH);

        outQue.EnQue<T>(outBuf);
        inQue.FreeTensor(inBuf);
    }

    __aicore__ inline void CopyOut(int64_t row, int64_t tileOff, int64_t curTileH)
    {
        AscendC::LocalTensor<T> outBuf = outQue.DeQue<T>();

        // UB 中副本按 tileH 步长排列，GM 中按 H 步长排列
        // UB: outBuf[m * tileH .. m * tileH + curTileH - 1] = copy m data
        // GM: yGm[row*M*H + m*H + tileOff .. + curTileH - 1] = copy m destination
        for (int64_t m = 0; m < tiling->M; m++) {
            int64_t gmBase = row * tiling->M * tiling->H + m * tiling->H + tileOff;
            int64_t ubBase = m * tiling->tileH;
            AscendC::DataCopyPad(yGm[gmBase], outBuf[ubBase],
                AscendC::DataCopyParams{1, static_cast<uint16_t>(curTileH * sizeof(T)), 0, 0});
        }

        outQue.FreeTensor(outBuf);
    }

private:
    AscendC::TPipe pipe_;
    const __gm__ ExpandTilingData* tiling;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;

    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQue;

    int64_t rowStart;
    int64_t rowEnd;
    int64_t tilesPerRow;
};

// ============================================================================
// 核函数入口
// ============================================================================
extern "C" __global__ __vector__ void expand_kenel_fwd_kernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR tiling)
{
    const __gm__ ExpandTilingData* td = reinterpret_cast<__gm__ ExpandTilingData*>(tiling);

    if (td->dtypeSize == 2) {
        KernelExpand<half> op;
        op.Init(x, y, td);
        op.Process();
    } else if (td->dtypeSize == 4) {
        KernelExpand<float> op;
        op.Init(x, y, td);
        op.Process();
    }
}
