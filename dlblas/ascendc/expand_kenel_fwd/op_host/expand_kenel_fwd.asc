// ============================================================================
// Ascend C Kernel 直调 - Expand 算子（Host + Main 入口）
// ============================================================================
//
// 用法: ./expand_kenel_fwd <B> <S> <H> <M> [dtype]
//   dtype: 0=FP16 (default), 1=FP32
//   Input file:  ./input/x_input.bin  (flattened B*S*H elements)
//   Output file: ./output/output.bin  (flattened B*S*M*H elements)
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
#include "acl/acl.h"
#include "../op_kernel/expand_kenel_fwd_tiling.h"
#include "data_utils.h"

// 引用 kernel 文件
#include "../op_kernel/expand_kenel_fwd_kernel.asc"

struct ArgInfo {
    std::string fileName;
    size_t length;
};

// 安全取整 (向上取整)
static inline int64_t CeilDiv(int64_t a, int64_t b) {
    return (a + b - 1) / b;
}

// 向上对齐到 16 的倍数 (32 字节对齐)
static inline int64_t AlignUp16(int64_t x) {
    return ((x + 15) / 16) * 16;
}

void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo>& inputsInfo, std::vector<ArgInfo>& outputsInfo,
    uint8_t* tilingData)
{
    std::vector<uint8_t*> inputHost(inputsInfo.size());
    std::vector<uint8_t*> inputDevice(inputsInfo.size());
    std::vector<uint8_t*> outputHost(outputsInfo.size());
    std::vector<uint8_t*> outputDevice(outputsInfo.size());
    uint8_t* tilingDevice = nullptr;

    aclrtMalloc(reinterpret_cast<void**>(&tilingDevice), sizeof(ExpandTilingData),
                ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(ExpandTilingData), tilingData,
                sizeof(ExpandTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost(reinterpret_cast<void**>(&inputHost[i]), inputsInfo[i].length);
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice[i]), inputsInfo[i].length,
                    ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
                    inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost(reinterpret_cast<void**>(&outputHost[i]), outputsInfo[i].length);
        aclrtMalloc(reinterpret_cast<void**>(&outputDevice[i]), outputsInfo[i].length,
                    ACL_MEM_MALLOC_HUGE_FIRST);
    }

    expand_kenel_fwd_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], outputDevice[0], tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
                    outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

int32_t main(int32_t argc, char* argv[])
{
    // 解析命令行参数: B S H M [dtype]
    if (argc < 5) {
        std::cerr << "Usage: " << argv[0]
                  << " <B> <S> <H> <M> [dtype: 0=FP16 1=FP32]"
                  << std::endl;
        return 1;
    }
    int64_t B = std::stoll(argv[1]);
    int64_t S = std::stoll(argv[2]);
    int64_t H = std::stoll(argv[3]);
    int64_t M = std::stoll(argv[4]);
    int dtypeFlag = (argc >= 6) ? std::stoi(argv[5]) : 0;  // default FP16

    size_t dtypeSize = (dtypeFlag == 1) ? 4 : 2;
    std::string dtypeStr = (dtypeFlag == 1) ? "FP32" : "FP16";

    std::cout << "=== expand_kenel_fwd ===" << std::endl;
    std::cout << "  B=" << B << " S=" << S << " H=" << H << " M=" << M
              << " dtype=" << dtypeStr << std::endl;

    int64_t totalRows = B * S;
    int64_t inputElements = totalRows * H;
    int64_t outputElements = totalRows * M * H;

    std::cout << "  totalRows=" << totalRows
              << " inputElements=" << inputElements
              << " outputElements=" << outputElements << std::endl;

    // ACL 初始化
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // 获取设备核数
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }
    std::cout << "  availableCoreNum=" << availableCoreNum << std::endl;

    // ==========================================================================
    // Tiling 计算
    // ==========================================================================

    // 计算 tileH: UB buffer 需要对齐到 16 倍数 (32B)
    // tileH = AlignUp16(H)，确保 UB buffer 有足够空间容纳 DataCopyPad 的 padding
    // 当 H 超出 UB 容量时沿 H 切分 (极端场景)
    int64_t paddedH = AlignUp16(H);
    int64_t maxTileH = static_cast<int64_t>(UB_BUDGET_BYTES) /
                       ((M + 2) * static_cast<int64_t>(dtypeSize));
    // maxTileH 也对齐到 16
    maxTileH = (maxTileH / 16) * 16;

    int64_t tileH;
    int64_t tilesPerRow;
    int64_t tailH;
    if (paddedH <= maxTileH) {
        // 整行处理，无需切 tile
        tileH = paddedH;
        tilesPerRow = 1;
        tailH = H;
    } else {
        // 超大 H: 沿 H 切分 (极端场景，实际中极少发生)
        tileH = (maxTileH / 16) * 16;  // AlignDown16
        if (tileH < 16) tileH = 16;
        tilesPerRow = CeilDiv(H, tileH);
        tailH = H - (tilesPerRow - 1) * tileH;
    }

    // 多核分配
    int64_t usedCoreCnt = 1;
    if (availableCoreNum > 0 && totalRows > 0) {
        usedCoreCnt = std::min(availableCoreNum, totalRows);
    }
    int64_t rowsPerCore = CeilDiv(totalRows, usedCoreCnt);

    // 总 tile 数
    int64_t totalTiles = totalRows * tilesPerRow;

    uint32_t blockNum = static_cast<uint32_t>(usedCoreCnt);

    // 填充 Tiling 结构体
    ExpandTilingData tiling;
    tiling.totalRows = totalRows;
    tiling.H = H;
    tiling.M = M;
    tiling.tileH = tileH;
    tiling.rowsPerCore = rowsPerCore;
    tiling.usedCoreCnt = usedCoreCnt;
    tiling.totalTiles = totalTiles;
    tiling.tailH = tailH;
    tiling.dtypeSize = static_cast<uint32_t>(dtypeSize);

    std::cout << "  Tiling: tileH=" << tileH << " tilesPerRow=" << tilesPerRow
              << " tailH=" << tailH
              << " rowsPerCore=" << rowsPerCore
              << " usedCoreCnt=" << usedCoreCnt << std::endl;

    // ==========================================================================
    // 输入输出配置
    // ==========================================================================
    size_t inputByteSize = inputElements * dtypeSize;
    size_t outputByteSize = outputElements * dtypeSize;

    std::vector<ArgInfo> inputsInfo = {
        {"./input/x_input.bin", inputByteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", outputByteSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(blockNum, stream, inputsInfo, outputsInfo,
               reinterpret_cast<uint8_t*>(&tiling));

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    std::cout << "=== expand_kenel_fwd completed ===" << std::endl;
    return 0;
}
